#!/usr/bin/env node
'use strict';
const assert = require('node:assert/strict');
const A = require('../glide-path/aircraft-flight.js');
const html = require('node:fs').readFileSync(require('node:path').join(__dirname, '../glide-path/index.html'), 'utf8');
const ids = [...html.matchAll(/\bid="([^"]+)"/g)].map(m => m[1]);
assert.equal(new Set(ids).size, ids.length, 'flight controls must not shadow existing planner element IDs');
const point = (t_ms, location = 'gps', lat_deg = 44, lon_deg = -103) => ({ t_ms, utc_ms: null, location, lat_deg, lon_deg, alt_m: 1000, state: 'flight' });
const bundle = track => ({ schema: 'p4-flight', version: 1, source: 'recorded', frame: 'WGS84', track, photos: [], events: [] });
const input = bundle([point(100), point(1100), point(2100, 'missing', null, null), point(3100), point(4100, 'estimated'), point(10000, 'estimated')]);
const flight = A.parse(JSON.stringify(input));
assert.deepEqual(A.segments(flight.track).map(s => [s.location, s.points.length]), [['gps', 2], ['gps', 1], ['estimated', 1], ['estimated', 1]], 'GPS loss, source changes and long gaps split the track');
assert.equal(A.at(flight.track, 2050).t_ms, 1100, 'replay selects the preceding measured sample');
assert.equal(A.at(flight.track, 2500).location, 'missing', 'GPS loss remains visible while replaying');
assert.equal(A.at(flight.track, 10), null);
assert.equal(A.validate({ ...input, source: 'simulation' }).source, 'simulation');
for (const p of [point(0, 'gps', 91), point(0, 'gps', NaN), point(0, 'gps', '44'), point(0, 'missing'), { ...point(0), gps_valid: false }, { ...point(0), t_ms: -1 }, { ...point(0), utc_ms: '2026-11-16' }]) assert.throws(() => A.validate(bundle([p])));
assert.throws(() => A.validate(bundle([point(2), point(1)])), /increase/);
assert.throws(() => A.validate(bundle([point(1), point(1)])), /increase/);
assert.throws(() => A.validate({ ...input, schema: 'anything' }));
assert.throws(() => A.validate({ ...input, version: 2 }));
assert.throws(() => A.validate({ ...input, frame: 'local' }));
assert.throws(() => A.parse(' '.repeat(A.MAX_BYTES + 1)), /20 MB/);
assert.equal(A.segments([point(0, 'gps', 44, 179), point(1000, 'gps', 44, -179)]).length, 2, 'no world-spanning line at the date line');
const photo = { ...point(100), name: '20261116/IMG00001.JPG' };
assert.equal(A.validate({ ...input, photos: [photo] }).photos[0].name, photo.name);
for (const name of ['../../IMG00001.JPG', 'https://attacker/photo.jpg', 'IMG00001.JPG?x=1', '<img>.JPG']) assert.throws(() => A.validate({ ...input, photos: [{ ...photo, name }] }));
assert.throws(() => A.validate({ ...input, photos: [photo, photo] }), /Duplicate/);
assert.throws(() => A.validate({ ...input, events: [{ t_ms: 0, code: 'bad\nline' }] }));
const metadata = { schema: 'p4c-photo', version: 1, file: photo.name, captured_ms: 100, utc_ms: 1794816000000, flight_state: 'flight', location: { source: 'gps', lat_deg: 44, lon_deg: -103, alt_m: 1000 }, attitude: { valid: true, roll_deg: 12, pitch_deg: -3 } };
const imported = A.validate(metadata);
assert.equal(imported.source, 'recorded'); assert.equal(imported.photos[0].name, photo.name); assert.equal(imported.photos[0].roll_deg, 12); assert.equal(imported.photos[0].utc_ms, metadata.utc_ms);
const missing = { ...metadata, location: { source: 'unavailable', lat_deg: null, lon_deg: null, alt_m: null } };
assert.equal(A.validate([missing]).photos[0].location, 'missing', 'unavailable GPS is preserved, never replaced by the last fix');
assert.throws(() => A.validate({ ...metadata, location: { ...metadata.location, source: 'invented' } }));
assert.throws(() => A.validate({ ...input, track: Array.from({ length: 100001 }, (_, t) => point(t)) }));
console.log('Aircraft import: versions, limits, finite coordinates, fix validity, time order, gaps, replay, simulation labels, sidecars and filename paths passed.');
