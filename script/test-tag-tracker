#!/usr/bin/env node
// Check the maths behind /tag-tracker/ (tag-tracker/tracker-core.js), in Node.
//   1. rotations and poses: Rodrigues, compose, inverse, poses relative to a reference tag
//   2. intrinsics: the field-of-view guess, rescaling a calibration, checking an imported one, projection
//   3. history: trimming to the span, and axes every `every` seconds (with a tracking gap)
//   4. the 3D plot's orbit camera, grid steps, calibration-view signatures and coverage, settings
//   4b. the board on a screen: whole-pixel squares that fit with a margin, turned when that's bigger
//   5. SE(3): logs and exps, LM pose refinement and its covariance (checked by Monte Carlo), the mirror-image
//      ambiguity, rigid objects of several tags, rotation means, and the Kalman filter (smoothing, velocity,
//      resolving flips by prediction, gating an outlier, restarting after a real jump)
//   5b. several cameras: moving poses into the rig, information-weighted fusion, multi-camera calibration (three
//      cameras, one placed only through another, one that shares nothing), re-expressing a saved rig, late frames
//   5c. choosing between a face-on tag's mirror-image poses (by the other cameras, then by the last pose), and the
//      Stream tab's messages (JSON lines and CSV)
//   5e. one pose from every camera's corners: the joint fit (against one camera, against fusing each camera's pose,
//      its covariance by Monte Carlo, moving tags from unsynchronised cameras, a bad corner) and the filter fed corners;
//      and the search windows for the next frame
//   5f. recordings and notes (the export formats, timed note lines), cleaning Whisper's text, voice commands, and the
//      voice gate that ends an utterance after a pause
//   5g. motion sensors (nrf-controller boards): their bytes, their clocks on the page's, how a board sits on its
//      object (with mirror-image outliers), and the filter with a gyro and VQF's tilt against without
//   5h. the robot: home pose, IK against FK, elbows out and low, steady joints, out of reach, calibration with one,
//      two or three tags (and in Mirror view); one tag on a phone's screen; the robot's settings and voice commands
//   5d. (with python3) the UDP bridge: a WebSocket in, one datagram out per message, and pages from elsewhere refused
//   6. (only with OpenCV.js installed) the worker's detection and calibration on rendered images:
//      a ChArUco calibration recovers a known camera, and tag poses come back within a few millimetres.
//      Also 6b: the board as the page shows it on a screen (turned too) is found, and the link's QR code decodes.
//      To run it: npm i --no-save @techstark/opencv-js@4.12.0-release.1
const path = require('path');
const C = require(path.join(__dirname, '..', 'tag-tracker/tracker-core.js'));
let failed = false;
function check(ok, msg) { console.log((ok ? '  ok   ' : '  FAIL ') + msg); if (!ok) failed = true; }
let seed = 7; const rnd = () => { seed = (seed * 1103515245 + 12345) % 2147483648; return seed / 2147483648; };
const near = (a, b, tol) => a.every((x, i) => Math.abs(x - b[i]) <= tol);
function rotXYZ(a, b, c) {
  const Rx = [1, 0, 0, 0, Math.cos(a), -Math.sin(a), 0, Math.sin(a), Math.cos(a)];
  const Ry = [Math.cos(b), 0, Math.sin(b), 0, 1, 0, -Math.sin(b), 0, Math.cos(b)];
  const Rz = [Math.cos(c), -Math.sin(c), 0, Math.sin(c), Math.cos(c), 0, 0, 0, 1];
  return C.mul3(Rz, C.mul3(Ry, Rx));
}

console.log('1. rotations and poses');
{
  const R = C.rodrigues([0, 0, Math.PI / 2]);
  check(near(R, [0, -1, 0, 1, 0, 0, 0, 0, 1], 1e-12), 'a quarter turn about z');
  const r = [0.3, -0.7, 0.2], Rr = C.rodrigues(r);
  check(near(C.mul3(Rr, C.tr3(Rr)), [1, 0, 0, 0, 1, 0, 0, 0, 1], 1e-12), 'Rodrigues gives an orthonormal matrix');
  check(Math.abs(C.angleOf(Rr) - C.norm(r)) < 1e-12, 'its angle is the vector\'s length');
  check(near(C.rodrigues([0, 0, 0]), [1, 0, 0, 0, 1, 0, 0, 0, 1], 0), 'zero rotation is the identity');
  const a = { R: rotXYZ(0.2, 0.5, -0.3), t: [0.1, -0.2, 1.5] }, b = { R: rotXYZ(-0.4, 0.1, 1.2), t: [-0.3, 0.05, 2.1] };
  const id = C.compose(C.inverse(a), a);
  check(near(id.R, [1, 0, 0, 0, 1, 0, 0, 0, 1], 1e-12) && near(id.t, [0, 0, 0], 1e-12), 'a pose times its inverse is the identity');
  const rel = C.relative(a, b), back = C.compose(a, rel);
  check(near(back.R, b.R, 1e-12) && near(back.t, b.t, 1e-12), 'relative(a, b) composed with a gives b back');
  const v = C.toView({ R: [1, 0, 0, 0, 1, 0, 0, 0, 1], t: [0.1, 0.2, 1] });
  check(near(v.t, [0.1, 1, -0.2], 1e-12), 'the plot puts depth along Y and camera "down" as -Z');
  const self = C.inFrame(a, a);
  check(near(self.t, [0, 0, 0], 1e-12) && near(C.mulv(self.R, [0, 1, 0]), [0, 0, 1], 1e-12), 'the reference tag sits at the origin of its own frame, its y axis pointing up');
  const above = C.inFrame({ R: a.R, t: C.add(a.t, C.mulv(a.R, [0, 0.1, 0.02])) }, a);
  check(near(above.t, [0, -0.02, 0.1], 1e-12), 'a point 10 cm up the reference tag plots 10 cm up, and in front of its face is -Y');
  check(Math.abs(C.mul3(C.TAG_TO_VIEW, C.tr3(C.TAG_TO_VIEW))[0] - 1) < 1e-12, 'the frame turns are rotations');
}

console.log('2. intrinsics');
{
  const g = C.guessIntrinsics(1280, 720, 90);
  check(Math.abs(g.fx - 640) < 1e-9 && g.cx === 639.5 && g.cy === 359.5 && g.guess, 'a 90° camera at 1280 wide has f = 640 px');
  check(Math.abs(C.hfov(g) - 90) < 1e-9, 'and its field of view reads back as 90°');
  const cal = { w: 1280, h: 720, fx: 900, fy: 901, cx: 641, cy: 358, dist: [0.1, -0.2, 0, 0, 0], rms: 0.3 };
  const s = C.scaleIntrinsics(cal, 640, 360);
  check(Math.abs(s.fx - 450) < 1e-9 && Math.abs(s.cx - 320.25) < 1e-9 && s.dist[0] === 0.1, 'a 1280×720 calibration scales to 640×360');
  check(C.scaleIntrinsics(cal, 640, 480) === null, 'but not to 640×480, where the crop is unknown');
  check(C.checkCalibration(cal) === null && C.checkCalibration({ w: 1 }) !== null && C.checkCalibration(Object.assign({}, cal, { dist: [1, 'x', 0, 0] })) !== null, 'imported calibrations are checked');
  const P = [0.1, -0.05, 2], q = C.project({ fx: 1000, fy: 1000, cx: 640, cy: 360, dist: [0, 0, 0, 0, 0] }, P);
  check(near(q, [690, 335], 1e-9), 'pinhole projection');
  const qd = C.project({ fx: 1000, fy: 1000, cx: 640, cy: 360, dist: [-0.2, 0, 0, 0, 0] }, [0.5, 0, 1]);
  check(Math.abs(qd[0] - (640 + 1000 * 0.5 * (1 - 0.2 * 0.25))) < 1e-9, 'radial distortion pulls the edge in (barrel)');
  const n = C.depthNoise({ fx: 1700 }, 0.1, 2, 0.2);
  check(n > 0.002 && n < 0.003, `depth noise of a 10 cm tag at 2 m, f = 1700 px, 0.2 px corners: ${(n * 1000).toFixed(1)} mm`);
}

console.log('3. history and axis samples');
{
  const H = new C.History(), pose = { R: [1, 0, 0, 0, 1, 0, 0, 0, 1], t: [0, 0, 1] };
  for (let k = 0; k <= 60; k++) H.push(5, k / 30, pose); // 2 s at 30 fps
  H.push(5, 1, pose); // repeated time is ignored
  H.trim(2, 1);
  const a = H.get(5);
  check(a.length === 31 && Math.abs(a[0].time - 1) < 1e-9, 'trimmed to the last 1 s (' + a.length + ' samples)');
  const ax = C.axisSamples(a, 2, 1, 0.1);
  check(ax.length === 11, 'axes every 0.1 s over 1 s: 11 of them');
  check(ax.every((s, i) => Math.abs(s.time - (1 + i * 0.1)) <= 1 / 60 + 1e-9), 'each within half a frame of its 0.1 s mark, oldest first');
  const G = new C.History();
  for (let k = 0; k <= 60; k++) if (k < 30 || k > 45) G.push(1, k / 30, pose); // lost from 1.0 to 1.5 s
  const gx = C.axisSamples(G.get(1), 2, 1, 0.1);
  check(gx.length === 6 && gx.every((s) => s.time < 1 + 1e-9 || s.time > 1.5), `a tracking gap leaves a gap (${gx.length} axes)`);
  check(C.axisSamples(G.get(1), 2, 1, 0.25).length === 3, 'axes every 0.25 s: the marks that fall outside the gap');
  const S = new C.History();
  for (let k = 0; k <= 20; k++) S.push(2, k / 10, pose); // 10 fps, slower than the axis step
  check(C.axisSamples(S.get(2), 2, 1, 0.05).length === 11, 'a camera slower than the step draws one axis per frame, never the same frame twice');
  H.trim(10, 1);
  check(H.ids().length === 0, 'a track with nothing recent is dropped');
}

console.log('4. plot, calibration views, settings');
{
  const o = C.orbit({ yaw: 0.3, pitch: 0.4, dist: 2, target: [0, 1, 0], fov: 50, w: 800, h: 600 });
  const c = o.project([0, 1, 0]);
  check(Math.abs(c[0] - 400) < 1e-9 && Math.abs(c[1] - 300) < 1e-9 && Math.abs(c[2] - 2) < 1e-9, 'the orbit target lands in the middle, at the orbit distance');
  const up = o.project([0, 1, 0.1]), right = o.project(C.add([0, 1, 0], o.right.map((x) => x * 0.1)));
  check(up[1] < 300 && right[0] > 400, 'up is up and right is right on screen');
  check(o.project(o.eye) === null, 'points behind the eye are not drawn');
  check(C.niceStep(1, 10) === 0.1 && C.niceStep(3, 10) === 0.2 && C.niceStep(0.7, 10) === 0.05, 'grid steps of 1, 2 and 5');
  const grid = [];
  for (let j = 0; j < 5; j++) for (let i = 0; i < 8; i++) grid.push([300 + i * 40, 200 + j * 40]);
  const sA = C.viewSignature(grid, 1280, 720), sB = C.viewSignature(grid.map((p) => [p[0] + 400, p[1]]), 1280, 720);
  check(C.signatureDistance(sA, sA) === 0 && C.signatureDistance(sA, sB) > 0.25, 'moving the board across the frame is a new view');
  const ids = grid.map((_, i) => i);
  check(C.cornerMotion({ ids, pts: grid }, { ids, pts: grid.map((p) => [p[0] + 2, p[1]]) }) === 2, 'corner motion between frames, matched by id');
  check(C.cornerMotion({ ids: [1, 2], pts: [[0, 0], [1, 1]] }, { ids: [1, 2], pts: [[0, 0], [1, 1]] }) === Infinity, 'fewer than 4 shared corners is not "still"');
  const cov = C.coverage([grid], 1280, 720, 4, 3);
  check(cov.fraction > 0 && cov.fraction < 0.5, `one central view covers ${(cov.fraction * 100).toFixed(0)}% of a 4×3 grid`);
  const st = C.clampSettings({ span: 0.05, every: 5, axisLen: 'x' });
  check(st.span === 0.1 && st.every === 0.1 && st.axisLen === C.DEFAULTS.axisLen, 'settings are clamped (span ≥ 0.1 s, axes no sparser than the span)');
  check(C.DEFAULTS.span === 1 && C.DEFAULTS.every === 0.1, 'defaults: 1 s of history, axes every 0.1 s');
  // quaternions: identity, a quarter turn about each axis, and a round trip through many random rotations
  const qnear = (a, b) => a.every((x, i) => Math.abs(x - b[i]) < 1e-9);
  const h = Math.SQRT1_2;
  check(qnear(C.quatOf([1, 0, 0, 0, 1, 0, 0, 0, 1]), [1, 0, 0, 0]), 'quaternion of the identity is (1, 0, 0, 0)');
  check(qnear(C.quatOf(C.rodrigues([Math.PI / 2, 0, 0])), [h, h, 0, 0]) && qnear(C.quatOf(C.rodrigues([0, Math.PI / 2, 0])), [h, 0, h, 0]) && qnear(C.quatOf(C.rodrigues([0, 0, Math.PI / 2])), [h, 0, 0, h]),
    'a quarter turn about x, y or z is (√½, √½ along that axis)');
  check(qnear(C.quatOf(C.rodrigues([Math.PI, 0, 0])), [0, 1, 0, 0]), 'a half turn: w = 0');
  let qworst = 0;
  for (let i = 0; i < 500; i++) {
    const r = [Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5].map((x) => x * 6.2), th = C.norm(r);
    const q = C.quatOf(C.rodrigues(r)), sgn = Math.cos(th / 2) < 0 ? -1 : 1;
    const want = [Math.cos(th / 2), ...r.map((x) => (x / th) * Math.sin(th / 2))].map((x) => x * sgn);
    qworst = Math.max(qworst, ...q.map((x, j) => Math.abs(x - want[j])));
  }
  check(qworst < 1e-9, `quaternion from a rotation matrix matches the axis–angle formula (worst ${qworst.toExponential(1)})`);
  check(qnear(C.quatNear([0.1, -0.9, 0.3, 0.3], [-0.1, 0.9, -0.3, -0.3]), [-0.1, 0.9, -0.3, -0.3]) && qnear(C.quatNear([1, 0, 0, 0], null), [1, 0, 0, 0]), 'a plotted quaternion keeps the sign nearest the last one');
  const R0 = C.rodrigues([0.3, -0.7, 1.1]), turn = C.rodrigues([0, 0, 0.4]);
  check(qnear(C.quatOf(C.tared({ R: R0, t: [1, 2, 3] }, R0).R), [1, 0, 0, 0]) && C.tared({ R: R0, t: [1, 2, 3] }, R0).t[2] === 3, 'tare: the orientation it was tared at reads as the identity; position is untouched');
  check(qnear(C.quatOf(C.tared({ R: C.mul3(R0, turn), t: [0, 0, 0] }, R0).R), C.quatOf(turn)), 'tare: a turn after taring reads as that turn, in the tag’s own axes');
  check(C.tared({ R: R0, t: [0, 0, 0] }, null).R === R0, 'no tare leaves the pose as it is');
  const pl = C.parseIdList('3, 10-12 7;10 4–5 0..1', 587), pb = C.parseIdList('2, x, 9-3, 600, 586', 587);
  check(pl.ids.join() === '3,10,11,12,7,4,5,0,1' && !pl.bad.length, 'tag IDs to print: lists and ranges, in order, no repeats');
  check(pb.ids.join() === '2,586' && pb.bad.join() === 'x,9-3,600', 'tag IDs to print: what isn’t an ID in the family is reported');
  check(C.parseIdList('0-586', 587, 50).ids.length === 50, 'tag IDs to print: at most the limit');
  check(C.paperFor('en-US') === 'letter' && C.paperFor('fr-CA') === 'letter' && C.paperFor('es-MX') === 'letter' && C.paperFor('en-GB') === 'a4' && C.paperFor('de-DE') === 'a4' && C.paperFor('en') === 'a4' && C.paperFor('') === 'a4',
    'paper: US Letter for the US, Canada and Mexico; A4 for the UK, Germany, and when the region is unknown');
  const sqA4 = C.maxBoardSquare('a4'), sqL = C.maxBoardSquare('letter'), tA4 = C.maxTagSize('a4', 8), tL = C.maxTagSize('letter', 8);
  // the default 25 mm board and 80 mm tags must print at full size on both
  check(sqA4 >= 25 && sqL >= 25 && 9 * sqL <= 279.4 - 24 && 6 * sqA4 + 30 <= 210 - 24, `paper: the board fits both at full size up to ${sqA4} mm squares on A4 and ${sqL} mm on US Letter`);
  check(tA4 >= 80 && tL >= 80 && tA4 * 1.25 <= 210 - 24 && tL * 1.25 + 30 <= 279.4 - 24, `paper: a tag36h11 fits both up to ${tA4} mm on A4 and ${tL} mm on US Letter`);
  check(C.clampSettings({}).mirror === false && C.clampSettings({ flip: 1 }).flip === true && C.clampSettings({}).blur === false && C.clampSettings({ blur: 1 }).blur === true, 'mirror, flip and blur are booleans, off by default');
  // a 1280 × 720 picture in a 1000 × 1000 box: 1000 × 562.5, letterboxed 218.75 px top and bottom
  const near = (a, b) => Math.abs(a[0] - b[0]) < 1e-9 && Math.abs(a[1] - b[1]) < 1e-9;
  const dm = (m, f) => C.displayMap(1000, 1000, 1280, 720, m, f);
  check(near(dm(false, false)(0, 0), [0, 218.75]) && near(dm(false, false)(1280, 720), [1000, 781.25]), 'display map: letterboxed like object-fit: contain');
  check(near(dm(true, false)(0, 0), [1000, 218.75]) && near(dm(false, true)(0, 0), [0, 781.25]) && near(dm(true, true)(640, 360), [500, 500]),
    'display map: mirror swaps left and right, flip top and bottom, the centre stays put');
}

console.log('4b. the board on a screen');
{
  const fits = (f, W, H) => f.w + f.px <= W && f.h + f.px <= H; // half a square of white on each side
  let f = C.boardFit(2048, 1536, 9, 6, 0.5);
  check(f.px === 204 && !f.rotate && f.w === 9 * 204 && f.h === 6 * 204 && fits(f, 2048, 1536), `iPad landscape (2048 × 1536): ${f.px} px squares, board ${f.w} × ${f.h}`);
  f = C.boardFit(1536, 2048, 9, 6, 0.5);
  check(f.px === 204 && f.rotate && f.w === 6 * 204 && f.h === 9 * 204 && fits(f, 1536, 2048), 'held upright it turns the board a quarter rather than shrink it');
  f = C.boardFit(3840, 2160, 9, 6, 0.5);
  check(f.px === 308 && !f.rotate && fits(f, 3840, 2160) && Number.isInteger(f.px), `a 4K monitor: ${f.px} px squares, whole pixels`);
  let worst = Infinity;
  for (let i = 0; i < 300; i++) {
    const W = 200 + Math.floor(rnd() * 4000), H = 200 + Math.floor(rnd() * 4000), g = C.boardFit(W, H, 9, 6, 0.5);
    if (!fits(g, W, H) || !Number.isInteger(g.px)) { worst = -1; break; }
    worst = Math.min(worst, Math.max(C.boardFit(W, H, 9, 6, 0.5).px, 0));
  }
  check(worst >= 0, 'on 300 random screens it always fits with its margin, in whole pixels');
  check(C.boardFit(5, 5, 9, 6, 0.5).px === 0, 'a screen too small for the board gives 0 (the page says so)');
}

console.log('5. SE(3)');
{
  const gauss = () => { let u = 0; for (let i = 0; i < 12; i++) u += rnd(); return u - 6; };
  const randRot = (amp) => C.rodrigues([gauss() * amp, gauss() * amp, gauss() * amp]);
  const angDeg = (A, B) => C.angleOf(C.mul3(C.tr3(A), B)) * 180 / Math.PI;
  let worst = 0;
  for (let i = 0; i < 50; i++) { const r = [gauss(), gauss(), gauss()], n = C.norm(r), v = n > 3.1 ? C.mulv([1, 0, 0, 0, 1, 0, 0, 0, 1], r.map((x) => x / n * 3.1)) : r; worst = Math.max(worst, C.norm(C.sub(C.so3Log(C.rodrigues(v)), v))); }
  const nearPi = C.so3Log(C.rodrigues([0, Math.PI - 1e-6, 0]));
  check(worst < 1e-9 && Math.abs(C.norm(nearPi) - Math.PI) < 1e-5, 'log undoes exp on SO(3), including next to a half turn');
  const e = C.se3Exp([0.1, 0, 0, 0, 0, Math.PI / 2]);
  check(Math.abs(e.t[0] - 0.2 / Math.PI) < 1e-12 && Math.abs(e.t[1] - 0.2 / Math.PI) < 1e-12, 'SE(3) exp: moving along x while turning a quarter about z ends on the arc');

  const cam = { w: 1280, h: 720, fx: 1000, fy: 1000, cx: 639.5, cy: 359.5, dist: [0, 0, 0, 0, 0] };
  const camD = Object.assign({}, cam, { dist: [-0.25, 0.08, 0.001, -0.0005, 0] });
  const flipX = C.rodrigues([Math.PI, 0, 0]); // tag faces the camera
  const truth = { R: C.mul3(rotXYZ(0.3, -0.4, 0.7), flipX), t: [0.12, -0.05, 1.0] };
  const obj = C.tagCorners(0.08);
  const shoot = (c, pose, objs, sig) => objs.map((X) => { const q = C.project(c, C.add(C.mulv(pose.R, X), pose.t)); return [q[0] + sig * gauss(), q[1] + sig * gauss()]; });
  const start = { R: C.mul3(randRot(0.05), truth.R), t: C.add(truth.t, [0.02, -0.01, 0.05]) };
  const exact = C.refinePose(camD, obj, shoot(camD, truth, obj, 0), start);
  check(C.norm(C.sub(exact.t, truth.t)) < 1e-7 && angDeg(exact.R, truth.R) < 1e-5, `LM on SE(3) recovers the pose exactly through lens distortion (${exact.iters} iterations)`);
  // Monte Carlo: does the covariance match the scatter?
  const errs = [], sig = 0.2;
  let pred = null;
  for (let k = 0; k < 400; k++) {
    const r = C.refinePose(cam, obj, shoot(cam, truth, obj, sig), truth, { sigma: sig });
    errs.push(C.sub(r.t, truth.t).concat(C.so3Log(C.mul3(r.R, C.tr3(truth.R)))));
    pred = pred || r.cov;
  }
  const varOf = (i) => errs.reduce((s, e2) => s + e2[i] * e2[i], 0) / errs.length;
  const ratios = [0, 1, 2, 3, 4, 5].map((i) => Math.sqrt(varOf(i) / pred[i][i]));
  check(ratios.every((x) => x > 0.75 && x < 1.3), `covariance matches 400 noisy trials: measured/predicted σ = ${ratios.map((x) => x.toFixed(2)).join(', ')}`);
  const ratioQ = Math.sqrt(pred[2][2]) / C.depthNoise(cam, 0.08, 1.0, sig);
  check(ratioQ > 1 / 3 && ratioQ < 3, `depth σ ${(Math.sqrt(pred[2][2]) * 1000).toFixed(2)} mm: the same order as the back-of-envelope ${(C.depthNoise(cam, 0.08, 1.0, sig) * 1000).toFixed(2)} mm, which ignores tilt`);

  // the mirror-image ambiguity: a small, nearly face-on tag far away
  const far = { R: C.mul3(rotXYZ(0.12, 0.1, 0.3), flipX), t: [0.05, 0.02, 2.5] };
  const fromWrong0 = C.solveTag(cam, shoot(cam, far, obj, 0).flat(), 0.08, C.flipPose(far));
  check(fromWrong0.length === 2 && fromWrong0.some((r) => angDeg(r.R, far.R) < 0.01), 'two candidate poses fit a far, nearly face-on tag; one is the true pose even when OpenCV starts on the other');
  const fromWrong = C.solveTag(cam, shoot(cam, far, obj, 0.2).flat(), 0.08, C.flipPose(far));
  check(fromWrong[1].rms < 1.0, `and the wrong one fits nearly as well (${fromWrong[0].rms.toFixed(2)} vs ${fromWrong[1].rms.toFixed(2)} px): the image alone can't choose`);

  // a rigid object: three tags on three faces of a 6 cm cube
  const h = 0.03, size = 0.05;
  const members = [
    { id: 10, R: [1, 0, 0, 0, 1, 0, 0, 0, 1], t: [0, 0, h], size },
    { id: 11, R: C.rodrigues([0, Math.PI / 2, 0]), t: [h, 0, 0], size },
    { id: 12, R: C.rodrigues([-Math.PI / 2, 0, 0]), t: [0, h, 0], size },
  ];
  const bodyTruth = { R: C.mul3(rotXYZ(0.5, 0.6, 0.2), rotXYZ(Math.PI, 0, Math.PI / 4)), t: [-0.05, 0.03, 0.9] };
  const dets = [];
  for (const m of members) {
    const tagPose = C.compose(bodyTruth, { R: m.R, t: m.t });
    if (C.mulv(tagPose.R, [0, 0, 1])[2] > -0.05) continue; // facing away: not visible
    const corners = shoot(cam, tagPose, C.tagCorners(size), 0.2).flat();
    const raw = C.solveTag(cam, corners, size, tagPose)[0];
    dets.push(Object.assign({ id: m.id, corners }, m.id === 11 ? C.flipPose(raw) : raw)); // one tag starts on the wrong pose
  }
  const bs = C.solveBody(cam, { members }, dets);
  check(dets.length >= 2, `${dets.length} of the cube's tags face the camera`);
  check(bs.length && C.norm(C.sub(bs[0].t, bodyTruth.t)) < 0.002 && angDeg(bs[0].R, bodyTruth.R) < 0.5, `one pose from all their corners: ${(C.norm(C.sub(bs[0].t, bodyTruth.t)) * 1000).toFixed(2)} mm, ${angDeg(bs[0].R, bodyTruth.R).toFixed(2)}° off`);
  check(bs.length === 1 || bs[1].rms > 3 * bs[0].rms, `tags on different faces leave no mirror-image doubt (next best ${bs[1] ? bs[1].rms.toFixed(1) + ' px' : 'none'})`);

  // rotation mean
  const R0 = rotXYZ(0.4, -0.2, 1.1), samp = [];
  for (let k = 0; k < 40; k++) samp.push({ R: C.mul3(randRot(0.02), R0), t: [0.1 + 0.001 * gauss(), 0, 0] });
  samp.push({ R: C.mul3(C.rodrigues([0, 0, 1]), R0), t: [0.3, 0, 0] }); // an outlier
  const mp = C.meanPose(samp, 5, 0.02);
  check(angDeg(mp.R, R0) < 0.5 && Math.abs(mp.t[0] - 0.1) < 0.001 && mp.used === 40, `mean pose on SO(3) × R³ drops the outlier (${mp.used} of 41 kept, ${angDeg(mp.R, R0).toFixed(2)}° off)`);

  // the filter, on a pose moving at constant velocity, measured with 4 mm and 1.5° noise
  const v = [0.3, -0.1, 0.2], w = [0.5, 1.0, -0.4], dt = 1 / 30;
  const at = (k) => ({ R: C.mul3(C.rodrigues(w.map((x) => x * k * dt)), truth.R), t: C.add(truth.t, v.map((x) => x * k * dt)) });
  const mcov = [[16e-6, 0, 0, 0, 0, 0], [0, 16e-6, 0, 0, 0, 0], [0, 0, 16e-6, 0, 0, 0], [0, 0, 0, 7e-4, 0, 0], [0, 0, 0, 0, 7e-4, 0], [0, 0, 0, 0, 0, 7e-4]];
  const noisy = (p) => ({ R: C.mul3(C.rodrigues([0.026 * gauss(), 0.026 * gauss(), 0.026 * gauss()]), p.R), t: C.add(p.t, [0.004 * gauss(), 0.004 * gauss(), 0.004 * gauss()]), cov: mcov, rms: 0.2 });
  const runFilter = (preset) => {
    const F = new C.PoseFilter(preset);
    let eRaw = 0, eF = 0, aRaw = 0, aF = 0, out;
    for (let k = 0; k < 150; k++) {
      const tr = at(k), z = noisy(tr);
      out = F.update(k * dt, [z]);
      if (k >= 45) { eRaw += C.norm(C.sub(z.t, tr.t)) ** 2; eF += C.norm(C.sub(out.pose.t, tr.t)) ** 2; aRaw += angDeg(z.R, tr.R) ** 2; aF += angDeg(out.pose.R, tr.R) ** 2; }
    }
    return { rp: Math.sqrt(eF / eRaw), ra: Math.sqrt(aF / aRaw), out };
  };
  // the same filter, cut down to one axis, against a textbook linear Kalman filter
  {
    const q = C.MOTION.balanced.qa, r = 16e-6, F = new C.PoseFilter({ qa: q, qw: 1 });
    let x = [0, 0], P = [[r + 1e-6, 0], [0, 1]], worstDiff = 0;
    for (let k = 0; k < 200; k++) {
      const z = 0.3 * k * dt + 0.004 * gauss();
      if (k === 0) x = [z, 0];
      else {
        x = [x[0] + x[1] * dt, x[1]];
        P = [[P[0][0] + 2 * dt * P[0][1] + dt * dt * P[1][1] + q * dt ** 3 / 3, P[0][1] + dt * P[1][1] + q * dt * dt / 2], [P[0][1] + dt * P[1][1] + q * dt * dt / 2, P[1][1] + q * dt]];
        const S = P[0][0] + r + 1e-6, K = [P[0][0] / S, P[1][0] / S], y = z - x[0];
        x = [x[0] + K[0] * y, x[1] + K[1] * y];
        P = [[(1 - K[0]) * P[0][0], (1 - K[0]) * P[0][1]], [P[1][0] - K[1] * P[0][0], P[1][1] - K[1] * P[0][1]]];
      }
      const o = F.update(k * dt, [{ R: [1, 0, 0, 0, 1, 0, 0, 0, 1], t: [z, 0, 1], cov: [[r, 0, 0, 0, 0, 0], [0, r, 0, 0, 0, 0], [0, 0, r, 0, 0, 0], [0, 0, 0, 1e-3, 0, 0], [0, 0, 0, 0, 1e-3, 0], [0, 0, 0, 0, 0, 1e-3]], rms: 0.1 }]);
      worstDiff = Math.max(worstDiff, Math.abs(o.pose.t[0] - x[0]));
    }
    check(worstDiff < 1e-4, `on one axis it matches a textbook linear Kalman filter to ${(worstDiff * 1e6).toFixed(1)} µm`);
  }
  const sm = runFilter(C.MOTION.smooth), ba = runFilter(C.MOTION.balanced), re = runFilter(C.MOTION.responsive);
  check(sm.rp < ba.rp && ba.rp < re.rp && re.rp < 1, `error vs raw, position: smooth ${(sm.rp * 100).toFixed(0)}%, balanced ${(ba.rp * 100).toFixed(0)}%, responsive ${(re.rp * 100).toFixed(0)}%`);
  check(sm.ra < 0.6 && ba.ra < 0.8, `and angle: smooth ${(sm.ra * 100).toFixed(0)}%, balanced ${(ba.ra * 100).toFixed(0)}%, responsive ${(re.ra * 100).toFixed(0)}%`);
  check(C.norm(C.sub(sm.out.pose.v, v)) < 0.1 && C.norm(C.sub(sm.out.pose.w, w)) < 0.4, `it estimates velocity: v (${sm.out.pose.v.map((x) => x.toFixed(2)).join(', ')}) m/s, truth (${v.join(', ')})`);

  // flips: the wrong mirror image is often the better fit, and fits about as well
  const G = new C.PoseFilter(C.MOTION.balanced);
  let bad = 0, bestWrong = 0;
  for (let k = 0; k < 90; k++) {
    const tr = at(k), z = noisy(tr), zf = Object.assign(C.flipPose(tr), { cov: mcov, rms: 0.21 });
    const flipFar = angDeg(zf.R, tr.R) > 10;
    const cands = k >= 5 && rnd() < 0.4 ? [zf, z] : [z, zf];
    if (cands[0] === zf && flipFar) bestWrong++;
    const r = G.update(k * dt, cands);
    if (k >= 5 && r.pose && angDeg(r.pose.R, tr.R) > 5) bad++;
  }
  check(bestWrong > 15 && bad === 0, `with the wrong mirror image fitting best in ${bestWrong} frames, the filter follows the right one in all of them`);

  // gating: one wild measurement is skipped; a real jump restarts the track
  const Hf = new C.PoseFilter(C.MOTION.balanced);
  for (let k = 0; k < 30; k++) Hf.update(k * dt, [noisy(at(k))]);
  const wild = Object.assign(noisy(at(30)), { t: C.add(at(30).t, [0.3, 0, 0]) });
  const rj = Hf.update(30 * dt, [wild]);
  check(rj.rejected === true && rj.pose === null, `a measurement 30 cm off the prediction is skipped (d² = ${rj.d2.toFixed(0)})`);
  let last;
  for (let k = 31; k < 35; k++) last = Hf.update(k * dt, [Object.assign(noisy(at(k)), { t: C.add(at(k).t, [0.3, 0, 0]) })]);
  check(last.pose && Math.abs(last.pose.t[0] - at(34).t[0] - 0.3) < 0.02, 'but when the tag really is there, the track restarts on it after 3 frames');
  check(C.sigmaAlong(mcov, [0, 0, 1]) - 0.004 < 1e-12, 'σ along a direction from a covariance');
}

console.log('5b. several cameras: moving poses into the rig, fusing them, and placing the cameras');
{
  const ang = (A, B) => C.angleOf(C.mul3(C.tr3(A), B)) * 180 / Math.PI;
  const mm = (a, b) => C.norm(C.sub(a, b)) * 1000;
  const gauss = () => { let u = 0; for (let i = 0; i < 12; i++) u += rnd(); return u - 6; };
  // toRig: the pose and its covariance turn with the camera
  const T = { R: rotXYZ(0.1, -0.6, 0.2), t: [0.5, -0.1, 0.3] }, p = { R: rotXYZ(0.3, 0.2, -0.1), t: [0.05, 0.02, 1.2], cov: [0, 1, 2, 3, 4, 5].map((i) => [0, 1, 2, 3, 4, 5].map((j) => (i === j ? (i < 3 ? 1e-6 : 1e-4) : 0))) };
  p.cov[2][2] = 1e-4; // depth is the uncertain direction
  const q = C.toRig(T, p), dz = C.mulv(T.R, [0, 0, 1]);
  check(mm(q.t, C.add(C.mulv(T.R, p.t), T.t)) < 1e-9 && ang(q.R, C.mul3(T.R, p.R)) < 1e-9, 'toRig: a pose seen by a camera, moved into the rig frame');
  check(Math.abs(C.sigmaAlong(q.cov, dz) - 0.01) < 1e-9, 'toRig: the uncertain direction (the camera’s line of sight) turns with the camera');
  // fusePoses: two cameras looking from different sides each know depth poorly; together they pin it down
  const truth = { R: rotXYZ(0.2, 0.1, 0.4), t: [0.1, 0, 1.3] };
  const camCov = (d) => { const A = [0, 1, 2, 3, 4, 5].map((i) => [0, 1, 2, 3, 4, 5].map((j) => (i === j ? (i < 3 ? 1e-6 : 1e-5) : 0))); for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) A[i][j] += 4e-4 * d[i] * d[j]; return A; };
  const d1 = [0, 0, 1], d2 = [Math.SQRT1_2, 0, Math.SQRT1_2];
  const a = { R: C.mul3(C.rodrigues([0.002, 0, 0]), truth.R), t: C.add(truth.t, [0, 0, 0.02]), cov: camCov(d1) };
  const b = { R: C.mul3(C.rodrigues([-0.002, 0, 0]), truth.R), t: C.add(truth.t, [0.014, 0, 0.014]), cov: camCov(d2) };
  const f = C.fusePoses([a, b]);
  check(mm(f.t, truth.t) < 3 && ang(f.R, truth.R) < 0.01, `fusePoses: two cameras each 2 cm off along their line of sight agree on a pose ${mm(f.t, truth.t).toFixed(1)} mm from the truth`);
  check(C.sigmaAlong(f.cov, d1) < 0.5 * C.sigmaAlong(a.cov, d1), 'fusePoses: and it is much more certain along either camera’s line of sight');

  // calibrateRig: three cameras round a scene, a board held still in many poses
  const cam = { w: 1280, h: 720, fx: 900, fy: 900, cx: 639.5, cy: 359.5, dist: [0, 0, 0, 0, 0] };
  const camD = Object.assign({}, cam, { fx: 1000, fy: 1002, dist: [-0.2, 0.05, 0.0005, -0.0003, 0] });
  const center = [0, 0, 1.3];
  const rig = [{ R: [1, 0, 0, 0, 1, 0, 0, 0, 1], t: [0, 0, 0] }, C.lookAt([-0.9, -0.2, 0.5], center), C.lookAt([1.0, -0.3, 0.6], center)];
  const cams = [cam, camD, cam];
  const sq = 0.06, obj = [];
  for (let r = 1; r < 6; r++) for (let c = 1; c < 9; c++) obj.push([c * sq, r * sq, 0]);
  // the board faces back towards the cameras (its z into the board), turned a little each time
  const boardAt = (k) => {
    const pos = C.add(center, [0.25 * Math.sin(k * 1.7), 0.15 * Math.cos(k * 2.3), 0.2 * Math.sin(k * 0.9)]);
    const R = C.mul3(rotXYZ(0.35 * Math.sin(k * 1.1), 0.35 * Math.cos(k * 1.9), 0.4 * Math.sin(k * 0.7)), [1, 0, 0, 0, 1, 0, 0, 0, 1]);
    return { R, t: C.sub(pos, C.mulv(R, [4.5 * sq, 3 * sq, 0])) };
  };
  const observe = (B, j, noise) => {
    const P = C.compose(C.inverse(rig[j]), B), pts = [];
    if (C.mulv(P.R, [0, 0, 1])[2] < 0.2) return null; // seen too edge-on, or from behind
    for (const X of obj) { const u = C.project(cams[j], C.add(C.mulv(P.R, X), P.t)); if (!u || u[0] < 0 || u[1] < 0 || u[0] > 1279 || u[1] > 719) return null; pts.push([u[0] + noise * gauss(), u[1] + noise * gauss()]); }
    // the starting pose a camera's own solvePnP would give: close, not exact
    const pose = { R: C.mul3(C.rodrigues([0.01 * gauss(), 0.01 * gauss(), 0.01 * gauss()]), P.R), t: C.add(P.t, [0.01 * gauss(), 0.01 * gauss(), 0.02 * gauss()]) };
    return { cam: j, obj, pts, pose };
  };
  const makeViews = (n, noise, which) => {
    const out = [];
    for (let k = 0; out.length < n && k < 500; k++) {
      const B = boardAt(k), obs = which(k).map((j) => observe(B, j, noise)).filter(Boolean);
      if (obs.length >= 2) out.push({ obs });
    }
    return out;
  };
  const views = makeViews(15, 0.2, () => [0, 1, 2]);
  const sol = C.calibrateRig(cams, views);
  const err = (j) => [mm(sol.poses[j].t, rig[j].t), ang(sol.poses[j].R, rig[j].R)];
  const [e1, e2] = [err(1), err(2)];
  check(views.length === 15 && e1[0] < 2 && e2[0] < 2 && e1[1] < 0.1 && e2[1] < 0.1,
    `three cameras from 15 views with 0.2 px noise: camera 2 within ${e1[0].toFixed(2)} mm and ${e1[1].toFixed(3)}°, camera 3 within ${e2[0].toFixed(2)} mm and ${e2[1].toFixed(3)}°`);
  check(sol.rms > 0.15 && sol.rms < 0.4 && sol.perCam.every((q) => q.rms < 0.4), `the fit’s RMS error is the corner noise (${sol.rms.toFixed(3)} px; per camera ${sol.perCam.map((q) => q.rms.toFixed(2)).join(', ')})`);
  // camera 3 never sees the board together with camera 1: it is placed through camera 2
  const chain = makeViews(16, 0.2, (k) => (k % 2 ? [0, 1] : [1, 2]));
  const sc = C.calibrateRig(cams, chain), ec = [mm(sc.poses[2].t, rig[2].t), ang(sc.poses[2].R, rig[2].R)];
  check(chain.every((v) => !(v.obs.some((o) => o.cam === 0) && v.obs.some((o) => o.cam === 2))) && ec[0] < 3 && ec[1] < 0.15,
    `a camera that never shares a view with camera 1 is placed through another: ${ec[0].toFixed(2)} mm, ${ec[1].toFixed(3)}°`);
  // a fourth camera that shares nothing is left unplaced
  const s4 = C.calibrateRig(cams.concat([cam]), views);
  check(s4.poses[3] === null && s4.poses[1] && s4.perCam[3].views === 0, 'a camera that shares no views is left unplaced');
  // the starting chain alone is much worse than the joint fit
  const raw = C.calibrateRig(cams, views, { iters: 0 });
  check(mm(raw.poses[2].t, rig[2].t) > 3 * e2[0], `the joint fit beats chaining the cameras’ own board poses (${mm(raw.poses[2].t, rig[2].t).toFixed(1)} mm before, ${e2[0].toFixed(2)} mm after)`);
  // placeCameras: a saved rig, re-expressed in the frame of whichever camera is now first
  const saved = { keys: ['a', 'b', 'c'], poses: sol.poses };
  const pl = C.placeCameras(saved, ['b', 'c', 'x']);
  const want = C.compose(C.inverse(sol.poses[1]), sol.poses[2]);
  check(ang(pl[0].R, [1, 0, 0, 0, 1, 0, 0, 0, 1]) < 1e-9 && mm(pl[1].t, want.t) < 1e-9 && pl[2] === null, 'placeCameras: the rig re-expressed from another first camera; an unknown camera is unplaced');
  check(C.placeCameras(saved, ['x', 'a'])[1] === null, 'placeCameras: with the first camera not in the rig, nothing else is placed');
  // arrangeTiles: tiles as big as their pictures, where their cameras sit, never overlapping
  const overlap = (a, b) => a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;
  const lay = C.arrangeTiles([{ key: 1, w: 1280, h: 720, pos: [0, 0] }, { key: 2, w: 1920, h: 1080, pos: [-0.85, 0.25] }, { key: 3, w: 640, h: 480, pos: [0.8, 0.35] }, { key: 4, w: 1280, h: 720, pos: null }]);
  const at = (k) => lay.find((r) => r.key === k), cx = (r) => r.x + r.w / 2, cy = (r) => r.y + r.h / 2;
  check(lay.every((a, i) => lay.every((b, j) => i === j || !overlap(a, b))) && Math.min(...lay.map((r) => r.x)) === 0 && Math.min(...lay.map((r) => r.y)) === 0, 'tiles: none overlap, and the arrangement starts at (0, 0)');
  check(cx(at(2)) < cx(at(1)) && cx(at(1)) < cx(at(3)) && cy(at(3)) < cy(at(1)) && cy(at(2)) < cy(at(1)), 'tiles: left of camera 1 is drawn left, higher is drawn higher');
  check(at(2).w === 1920 && at(3).h === 480 && at(4).y >= Math.max(at(1).y + at(1).h, at(2).y + at(2).h, at(3).y + at(3).h), 'tiles: each as big as its picture; a camera with no position goes below');
  const twin = C.arrangeTiles([{ key: 1, w: 1280, h: 720, pos: [0, 0] }, { key: 2, w: 1280, h: 720, pos: [0.001, 0] }, { key: 3, w: 640, h: 480, pos: null }]);
  check(twin[0].y === twin[1].y && twin[1].x === 1320 && twin[2].y === 760, 'tiles: two cameras in the same place (or none placed) fall back to rows of two');
  // the filter takes frames slightly out of order (as several cameras deliver them) without restarting
  const Pf = new C.PoseFilter(C.MOTION.balanced), z = (t) => ({ R: truth.R, t: C.add(truth.t, [0.1 * t, 0, 0]), rms: 0.2, cov: camCov(d1) });
  Pf.update(0, [z(0)]); Pf.update(0.033, [z(0.033)]);
  const late = Pf.update(0.02, [z(0.02)]), old = Pf.update(-0.2, [z(-0.2)]);
  check(!late.restarted && late.pose && old.restarted, 'the filter takes a frame 13 ms late as current, and restarts on one far older');
}

console.log('5c. mirror-image choice, and the Stream messages');
{
  const deg = (a, b) => (C.angleOf(C.mul3(C.tr3(a), b)) * 180) / Math.PI;
  const truth = { R: rotXYZ(Math.PI + 0.12, 0.08, 0.3), t: [0.05, -0.02, 1.6] }, mirror = C.flipPose(truth);
  const sep = deg(truth.R, mirror.R);
  const T = { ...truth, rms: 0.31 }, M = { ...mirror, rms: 0.29 }; // noise has the mirror image fitting a little better
  check(sep > 8, `a face-on tag at 1.6 m: its mirror-image pose is ${sep.toFixed(1)}° away`);
  check(C.plausible([M, T]).length === 2 && C.plausible([M, { ...truth, rms: 2.5 }]).length === 1, 'plausible: both fit about as well; one clearly worse is dropped');
  check(C.chooseCand([M, T], [], null) === M, 'with nothing else to go on, the best fit');
  check(C.chooseCand([M, T], [], truth.R) === T && C.chooseCand([T, M], [], mirror.R) === M, 'with one camera, the one nearest the last pose (it doesn\'t flip back and forth)');
  const other = [rotXYZ(Math.PI + 0.13, 0.07, 0.31)]; // another camera, seeing it unambiguously
  check(C.chooseCand([M, T], [other], mirror.R) === T, 'another camera\'s view outweighs the last pose');
  check(C.chooseCand([M, { ...truth, rms: 2.5 }], [other], truth.R) === M, 'a candidate that fits clearly worse is never chosen');
  check(C.chooseCand([], [], null) === null, 'no candidates, nothing chosen');
  // messages
  const rows = [{ track: 0, name: 'Left, "hand"', p: [0.123456, -0.00001, 1], q: [1, 0, 0, 0] }, { track: 'b:x', name: 'Cube', p: [0, 0, 0], q: [0.5, 0.5, 0.5, 0.5] }];
  const j = C.streamMessage('json', 1731234567.12345, rows, 'camera');
  const o = JSON.parse(j);
  check(j.endsWith('\n') && j.indexOf('\n') === j.length - 1, 'JSON: one line per message');
  check(o.t === 1731234567.123 && o.frame === 'camera' && o.tracks.length === 2 && o.tracks[0].track === 0 && o.tracks[1].track === 'b:x', 'JSON: time to the millisecond, the frame, each track by key');
  check(o.tracks[0].p[0] === 0.1235 && Object.is(o.tracks[0].p[1], 0) && o.tracks[0].name === 'Left, "hand"', 'JSON: metres to 0.1 mm, no "-0", names intact');
  const csv = C.streamMessage('csv', 1731234567.12345, rows).split('\n');
  check(C.STREAM_CSV_HEADER.split(',').length === 10 && csv.length === 3 && csv[2] === '', 'CSV: ten columns, one line per track');
  check(csv[0] === '1731234567.123,0,"Left, ""hand""",0.1235,0,1,1,0,0,0' && csv[1] === '1731234567.123,b:x,Cube,0,0,0,0.5,0.5,0.5,0.5', 'CSV: a name with a comma or quote is quoted');
  check(o.view === 'in person' && JSON.parse(C.streamMessage('json', 1, rows, 'camera', 'mirror')).view === 'mirror', 'JSON: says which view (in person or mirror)');
  // Mirror view: x → −x, orientations conjugated by diag(−1, 1, 1)
  const P = { R: rotXYZ(0.4, -0.7, 1.1), t: [0.2, 1.1, -0.3] }, Mp = C.mirrorPose(P), det = (R) => R[0] * (R[4] * R[8] - R[5] * R[7]) - R[1] * (R[3] * R[8] - R[5] * R[6]) + R[2] * (R[3] * R[7] - R[4] * R[6]);
  const q = C.quatOf(P.R), qm = C.quatOf(Mp.R), same = (a, b) => near(a, b, 1e-12) || near(a, b.map((x) => -x), 1e-12);
  check(near(Mp.t, [-0.2, 1.1, -0.3], 0) && Math.abs(det(Mp.R) - 1) < 1e-12 && near(C.mul3(Mp.R, C.tr3(Mp.R)), [1, 0, 0, 0, 1, 0, 0, 0, 1], 1e-12), 'mirror view: x changes sign, and an orientation stays a rotation');
  check(same(qm, [q[0], q[1], -q[2], -q[3]]), 'mirror view: a quaternion (w, x, y, z) becomes (w, x, −y, −z)');
  // the mirror image of a point carried by the pose is the mirrored pose carrying the mirrored point
  const X = [0.03, -0.02, 0.01], img = C.add(C.mulv(P.R, X), P.t), viaM = C.add(C.mulv(Mp.R, [-X[0], X[1], X[2]]), Mp.t);
  check(near(viaM, [-img[0], img[1], img[2]], 1e-12) && near(C.mirrorPose(Mp).R, P.R, 0), 'mirror view: it is the mirror image of the posed object, and twice is no change');
  const R0 = rotXYZ(0.1, 0.2, -0.3), a = C.mirrorPose(C.tared(P, R0)), b = C.tared(Mp, C.mirrorR(R0));
  check(near(a.R, b.R, 1e-12) && near(a.t, b.t, 1e-12), 'mirror view: a tare mirrored with the data gives the same tared pose');
  check(C.streamMessage('csv', 1, []) === '' && JSON.parse(C.streamMessage('json', 1, [], 'Body')).tracks.length === 0, 'nothing in view: no CSV line, an empty JSON list');
}

console.log('5e. one pose from every camera\'s corners, and where to look next');
{
  const cam = C.guessIntrinsics(1280, 720, 70), center = [0, 0.05, 1.35];
  const rigs = [{ R: [1, 0, 0, 0, 1, 0, 0, 0, 1], t: [0, 0, 0] }, C.lookAt([-0.8, -0.25, 0.45], center), C.lookAt([0.75, -0.4, 0.55], center)];
  let g = 11; const gauss = () => { let u = 0; for (let i = 0; i < 12; i++) { g = (g * 1103515245 + 12345) % 2147483648; u += g / 2147483648; } return u - 6; };
  const obj = C.tagCorners(0.08);
  // pixels of a tag at pose P (rig frame) in camera T, with noise
  const see = (T, P, sd) => obj.map((o) => { const X = C.add(C.mulv(P.R, o), P.t), Xc = C.mulv(C.tr3(T.R), C.sub(X, T.t)), q = C.project(cam, Xc); return [q[0] + sd * gauss(), q[1] + sd * gauss()]; });
  const inCam = (T, P) => ({ R: C.mul3(C.tr3(T.R), P.R), t: C.mulv(C.tr3(T.R), C.sub(P.t, T.t)) });
  const errs = (P, Q) => [C.norm(C.sub(P.t, Q.t)) * 1000, (C.angleOf(C.mul3(C.tr3(P.R), Q.R)) * 180) / Math.PI];
  const truth = { R: rotXYZ(Math.PI + 0.15, -0.25, 0.4), t: [-0.1, 0.05, 1.3] };
  // 1. one camera, no time offset: the same as refinePose
  {
    const img = see(rigs[0], truth, 0.3), a = C.refinePose(cam, obj, img, truth, { sigma: 0.3 }), b = C.refineJoint([C.sighting(cam, rigs[0], obj, img, 0.3, 0)], truth, { k: Infinity });
    check(errs(a, b)[0] < 1e-6 && errs(a, b)[1] < 1e-6, 'one camera: the joint fit is the single-camera fit');
  }
  // 2. three cameras, 0.3 px noise: the joint fit against camera 1 alone and against fusing each camera's own pose
  {
    const N = 150, sd = 0.3, eJ = [0, 0], eF = [0, 0], e1 = [0, 0];
    let m2 = 0;
    for (let k = 0; k < N; k++) {
      const imgs = rigs.map((T) => see(T, truth, sd)), own = rigs.map((T, i) => C.toRig(T, C.refinePose(cam, obj, imgs[i], inCam(T, truth), { sigma: sd })));
      const J = C.refineJoint(rigs.map((T, i) => C.sighting(cam, T, obj, imgs[i], sd, 0)), C.fusePoses(own)), F = C.fusePoses(own);
      [[J, eJ], [F, eF], [own[0], e1]].forEach(([P, acc]) => { const e = errs(P, truth); acc[0] += e[0] ** 2; acc[1] += e[1] ** 2; });
      const y = C.sub(J.t, truth.t).concat(C.so3Log(C.mul3(J.R, C.tr3(truth.R)))), Ci = C.minv(J.cov);
      m2 += y.reduce((s, v, i) => s + v * Ci[i].reduce((q, w, j) => q + w * y[j], 0), 0);
    }
    const rm = (a) => a.map((x) => Math.sqrt(x / N));
    const [J, F, O] = [rm(eJ), rm(eF), rm(e1)];
    check(J[0] < O[0] / 2 && J[1] < O[1] / 2, `three cameras: ${J[0].toFixed(2)} mm, ${J[1].toFixed(3)}°, against camera 1 alone ${O[0].toFixed(2)} mm, ${O[1].toFixed(3)}°`);
    check(J[0] <= F[0] * 1.02 && J[1] <= F[1] * 1.02, `the joint fit is at least as good as fusing each camera's pose (${F[0].toFixed(2)} mm, ${F[1].toFixed(3)}°)`);
    check(m2 / N > 4.5 && m2 / N < 8, `its covariance matches its errors (mean Mahalanobis² ${(m2 / N).toFixed(2)}, 6 expected)`);
  }
  // 3. a moving tag, cameras 20 ms apart: the velocity carries each frame to one time
  {
    const vel = { v: [0.5, -0.2, 0.1], w: [0.4, 1.6, -0.3] }, at = (dt) => ({ R: C.mul3(C.rodrigues(vel.w.map((x) => x * dt)), truth.R), t: C.add(truth.t, vel.v.map((x) => x * dt)) });
    const dts = [0, -0.02, -0.04], vs = rigs.map((T, i) => C.sighting(cam, T, obj, see(T, at(dts[i]), 0), 0.3, dts[i]));
    const moved = C.refineJoint(vs, truth, { vel }), still = C.refineJoint(vs, truth, {});
    check(errs(moved, truth)[0] < 0.1 && errs(still, truth)[0] > 5, `unsynchronised cameras: ${errs(moved, truth)[0].toFixed(3)} mm with the motion, ${errs(still, truth)[0].toFixed(1)} mm without`);
  }
  // 4. one corner 25 px off: the Huber weight keeps it from dragging the fit
  {
    const imgs = rigs.map((T) => see(T, truth, 0.3)); imgs[1][2][0] += 25;
    const vs = rigs.map((T, i) => C.sighting(cam, T, obj, imgs[i], 0.3, 0));
    const rob = C.refineJoint(vs, truth), ls = C.refineJoint(vs, truth, { k: Infinity });
    check(errs(rob, truth)[0] < errs(ls, truth)[0] / 2 && errs(rob, truth)[1] < errs(ls, truth)[1] / 2, `a corner 25 px off: ${errs(rob, truth)[0].toFixed(2)} mm, ${errs(rob, truth)[1].toFixed(2)}° robust; ${errs(ls, truth)[0].toFixed(2)} mm, ${errs(ls, truth)[1].toFixed(2)}° least squares`);
  }
  // 5. the filter fed corners: three cameras in turn, a moving tag, against the same filter fed each camera's pose
  {
    const vel = { v: [0.2, 0, -0.1], w: [0, 0.8, 0] }, at = (t) => ({ R: C.mul3(C.rodrigues(vel.w.map((x) => x * t)), truth.R), t: C.add(truth.t, vel.v.map((x) => x * t)) });
    const fc = new C.PoseFilter(C.MOTION.balanced), fp = new C.PoseFilter(C.MOTION.balanced), ec = [], ep = [];
    let rej = 0;
    for (let k = 0; k < 90; k++) {
      const t = k / 90, i = k % 3, P = at(t), img = see(rigs[i], P, 0.4), own = C.toRig(rigs[i], C.refinePose(cam, obj, img, inCam(rigs[i], P), { sigma: 0.4 }));
      const a = fc.updateCorners(t, [C.sighting(cam, rigs[i], obj, img, 0.4, 0)], own), b = fp.update(t, [own]);
      if (!a.pose) rej++;
      if (k >= 45) { ec.push(errs(a.pose || fc.pose(), P)); ep.push(errs(b.pose || fp.pose(), P)); }
    }
    const rms = (a, j) => Math.sqrt(a.reduce((s, e) => s + e[j] ** 2, 0) / a.length);
    check(rej === 0 && rms(ec, 0) <= rms(ep, 0) * 1.05 && rms(ec, 1) <= rms(ep, 1) * 1.05, `filter fed corners: ${rms(ec, 0).toFixed(2)} mm, ${rms(ec, 1).toFixed(3)}°; fed poses: ${rms(ep, 0).toFixed(2)} mm, ${rms(ep, 1).toFixed(3)}° (moving, three cameras in turn)`);
    // a frame 20 ms older than the state is taken at its own time, not restarted; a frame 40 px off is rejected
    const late = fc.updateCorners(1 - 0.02, [C.sighting(cam, rigs[1], obj, see(rigs[1], at(1 - 0.02), 0.4), 0.4, 0)], null);
    const bad = see(rigs[2], at(1.01), 0.4).map((q) => [q[0] + 40, q[1] - 30]), off = fc.updateCorners(1.01, [C.sighting(cam, rigs[2], obj, bad, 0.4, 0)], null);
    check(late.pose && !late.restarted && off.rejected, 'the filter takes a late frame at its own time, and rejects one whose corners are 50 px off');
  }
  // 6. a nearly face-on tag seen by camera 1 alone, 0.5 px noise: one view can't tell it from its mirror image, so both
  //    filters wander, but the one fed corners less than the one fed poses
  {
    const face = { R: rotXYZ(Math.PI + 0.06, 0.05, 0.2), t: [0, 0.02, 1.6] }, run = (corners) => {
      g = 11; const f = new C.PoseFilter(C.MOTION.balanced); f.init(0, face);
      let s2 = 0, n = 0;
      for (let k = 1; k < 120; k++) {
        const img = see(rigs[0], face, 0.5), cands = C.solveTag(cam, img.flat(), 0.08, C.refinePose(cam, obj, img, face, {}), { sigma: 'auto' });
        const r = corners ? f.updateCorners(k / 30, [C.sighting(cam, rigs[0], obj, img, 0.5, 0)], null) : f.update(k / 30, cands);
        if (r && r.pose) { s2 += errs(r.pose, face)[1] ** 2; n++; }
      }
      return Math.sqrt(s2 / n);
    };
    const a = run(true), b = run(false);
    check(a < b, `a face-on tag, one camera: ${a.toFixed(1)}° RMS fed corners, ${b.toFixed(1)}° fed poses (only a second view really settles it)`);
  }
  // 7. search windows
  {
    const sq = (x, y, s) => [[x, y], [x + s, y], [x + s, y + s], [x, y + s]];
    const a = C.planSearch([{ pts: sq(100, 100, 50), pad: 20 }, { pts: sq(175, 110, 40), pad: 20 }, { pts: sq(900, 500, 60), pad: 30 }], 1280, 720);
    check(a && a.rois.length === 2 && a.rois[0].x === 80 && a.rois[0].w === 155 && a.frac < 0.1, 'two tags close together share one window; a far one has its own');
    const b = C.planSearch([{ pts: sq(-30, 690, 40), pad: 20 }], 1280, 720);
    check(b && b.rois[0].x === 0 && b.rois[0].y + b.rois[0].h === 720, 'a window is kept inside the picture');
    check(C.planSearch([{ pts: sq(100, 100, 600), pad: 100 }], 1280, 720) === null && C.planSearch([], 1280, 720) === null, 'windows over half the picture, or nothing to look for: search it all');
    check(C.planSearch([{ pts: [[640, 360]], pad: 2 }], 1280, 720).rois[0].w === 64, 'a window is at least 64 px across');
  }
}

console.log('5f. recordings, notes and voice');
{
  check(C.fmtStamp(0) === '0:00.0' && C.fmtStamp(72.46) === '1:12.4' && C.fmtStamp(3725.07) === '1:02:05.0' && C.fmtStamp(9.99) === '0:09.9', 'times since the start read m:ss.s (h:mm:ss.s past an hour), never rounded up');
  const notes = C.parseNotes('Trial 3, left hand\n0:12.4  Tag slipped\n\n1:02:05.0 Second camera bumped\n  3:30 \n10:00.5 Done.');
  check(notes.length === 4 && notes[0].t === null && notes[0].text === 'Trial 3, left hand', 'a line with no time is a note about the whole recording; blank lines and bare times are skipped');
  check(notes[1].t === 12.4 && notes[2].t === 3725 && notes[3].t === 600.5 && notes[3].text === 'Done.', 'a line that starts with a time is a note at that time');
  for (const s of [0, 9.95, 72.46, 3725.07, 5999.9]) { const n = C.parseNotes(`${C.fmtStamp(s)}  x`)[0]; if (!(n && Math.abs(n.t - s) < 0.1)) check(false, `a stamp reads back (${s})`); }
  check(C.parseNotes('12:345 x')[0].t === null && C.parseNotes('1:5 x')[0].t === null, 'something that only looks like a time is text');

  const row = (track, x) => ({ track, name: track === 2 ? 'Body, front' : 'Hand', p: [x, 0.2, -0.0000001], q: [1, 0, 0, 0] });
  const rec = { start: 1700000000, end: 1700000003, samples: [
    { t: 1700000000.5, frame: 'camera', view: 'in person', rows: [row(2, 0.1), row(5, 0.3)] },
    { t: 1700000002, frame: 'camera', view: 'mirror', rows: [row(2, 0.12)] },
  ] };
  const ns = C.parseNotes('Setup A\n0:01.0 Flip');
  const csv = C.recordingCsv(rec, ns).trim().split('\n');
  check(csv[0] === C.STREAM_CSV_HEADER + ',note' && csv.length === 6, 'CSV: the Stream columns plus a note column, a row per pose and per note');
  check(csv[1] === '1700000000.000,,,,,,,,,,Setup A' && csv[4] === '1700000001.000,,,,,,,,,,Flip', 'CSV: notes at their Unix times, among the poses (one about the whole recording at its start)');
  check(csv[2] === '1700000000.500,2,"Body, front",0.1,0.2,0,1,0,0,0,' && csv[5].startsWith('1700000002.000,2,'), 'CSV: pose rows as the Stream tab writes them, with an empty note');
  check(csv.every((l) => l.split(/,(?=(?:[^"]*"[^"]*")*[^"]*$)/).length === 11), 'CSV: every row has all eleven columns');
  const js = JSON.parse(C.recordingJson(rec, ns));
  check(js.format === 'tag-tracker-recording/1' && js.start === 1700000000 && js.end === 1700000003, 'JSON: format, start and end in Unix seconds');
  check(js.notes[0].t === null && js.notes[1].t === 1700000001 && js.samples[1].view === 'mirror' && js.samples[0].tracks[1].p[0] === 0.3, 'JSON: notes in Unix time (null: the whole recording), each sample like a Stream message');
  check(C.recordingCsv({ start: 5, samples: [] }, []).trim() === C.STREAM_CSV_HEADER + ',note', 'an empty recording is just the header');

  check(C.tidySpeech(' [BLANK_AUDIO] ') === '' && C.tidySpeech('(music) *coughs*') === '', 'Whisper\'s non-speech marks alone give nothing');
  check(C.tidySpeech(' the tag slipped , again') === 'The tag slipped, again.' && C.tidySpeech('Is it on?') === 'Is it on?', 'speech gets a capital, tight commas and an ending');
  const ins = (v, a, b, t) => C.insertSpeech(v, a, b, t);
  let r = ins('', 0, 0, 'Hello.');
  check(r.value === 'Hello.' && r.caret === 6, 'into an empty box as it is');
  r = ins('The tag', 7, 7, 'Slipped off.');
  check(r.value === 'The tag slipped off.' && r.caret === 20, 'carrying on a sentence: a space, and lower case');
  r = ins('Done. ', 6, 6, 'Next one.');
  check(r.value === 'Done. Next one.', 'after a full stop and a space: as it is');
  r = ins('A B', 2, 2, 'I moved it.');
  check(r.value === 'A I moved it. B', '"I" keeps its capital, and a space goes after when text follows');
  r = ins('keep this OLD end', 10, 13, 'New.');
  check(r.value === 'keep this new. end', 'a selection is replaced');

  const cmd = (t) => (C.voiceCommand(t) || {}).cmd || null;
  check(cmd('Calibrate.') === 'calib' && cmd('Go to the calibrate tab.') === 'calib' && cmd('Stream!') === 'stream' && cmd('Switch to tracking, please.') === 'track', 'a tab by name, with or without "go to ... tab"');
  check(cmd('Start recording.') === 'record' && cmd('Stop.') === 'stop' && cmd('Stop recording.') === 'stop' && cmd('Clear tare.') === 'untare' && cmd('Tare.') === 'tare' && cmd('Reset view.') === 'reset', 'recording, tare and view commands');
  check(cmd('Calibrate again after lunch.') === null && cmd('The stream dropped out.') === null && cmd('') === null, 'a sentence that only mentions a command is a note');
  const n = C.voiceCommand('Note: calibrate the second camera');
  check(n.cmd === 'note' && n.text === 'Calibrate the second camera.' && C.voiceCommand('Note.') === null && C.voiceCommand('Take a note stop').text === 'Stop.', '"Note ..." is always a note, even of a command\'s word');
  check(Object.values(C.VOICE_COMMANDS).flat().every((p) => C.voiceCommand(p[0].toUpperCase() + p.slice(1) + '.').cmd !== 'note' && C.voiceCommand(p + '.')), 'every listed phrase, as Whisper writes it, is recognised');

  // the voice gate, fed a level every 20 ms
  const run = (levels, opts) => {
    const g = new C.VoiceGate(opts); g.reset(0); const ev = [];
    levels.forEach((l, i) => { const e = g.step(l, i * 20); if (e) ev.push([e, i * 20, g.start]); });
    return ev;
  };
  const quiet = (ms) => Array(ms / 20).fill(0.003), loud = (ms) => Array(ms / 20).fill(0.08);
  let ev = run([...quiet(500), ...loud(800), ...quiet(400), ...loud(300), ...quiet(2000)]);
  check(ev.length === 2 && ev[0][0] === 'start' && ev[0][2] === 500 && ev[1][0] === 'end' && ev[1][1] === 2000 + 1400, 'speech starts where it got loud; a short pause doesn\'t end it, a long one does');
  ev = run([...quiet(300), 0.08, 0.08, ...quiet(9000)]);
  check(ev.length === 1 && ev[0][0] === 'none' && ev[0][1] === 8000, 'a click is not speech, and nothing said in 8 s gives up');
  ev = run([...quiet(7900), ...loud(400), ...quiet(1600)]);
  check(ev[0][0] === 'start' && ev[1][0] === 'end', 'starting to talk just before the wait runs out still counts');
}

console.log('5g. motion sensors');
{
  let g = 5; const u01 = () => { g = (g * 1103515245 + 12345) % 2147483648; return g / 2147483648; }, gauss = () => { let x = 0; for (let i = 0; i < 12; i++) x += u01(); return x - 6; };
  const deg = (R1, R2) => (C.angleOf(C.mul3(C.tr3(R1), R2)) * 180) / Math.PI;
  // bytes
  const smp = [{ tUs: 4294967000, gyro: [-1200, 5, 32767], accel: [16384, -8192, 0], q: [0.5, -0.5, 0.5, -0.5], rest: true }, { tUs: 4807, gyro: [1, -1, 0], accel: [0, 0, -16384], q: [1, 0, 0, 0], rest: false }];
  const d = C.decodeImuBatch(C.encodeImuBatch(4294967295, [1.25, -0.5, 0], smp)), info = C.decodeBoardInfo(C.encodeBoardInfo(0xd892, 208, 0.07, 0.000244));
  check(d && d.samples.length === 2 && d.samples[1].seq === 0 && d.samples[0].gyro[2] === 32767 && d.samples[0].rest && !d.samples[1].rest && d.samples[0].q[1] === -0.5 && d.biasDps[0] === 1.25, 'a batch decodes as nrf-controller sends it (sequence wraps, signs, at-rest flag, bias)');
  check(info.boardId === 'D892' && info.imuRateHz === 208 && Math.abs(info.gyroDpsPerLsb - 0.07) < 1e-7 && C.decodeImuBatch(new DataView(new ArrayBuffer(13))) === null, 'board info decodes; a short or foreign packet is refused');
  // clock: 40 ppm fast, starting near the 32-bit wrap; arrivals 2 ms + up to ~30 ms late
  {
    const clk = new C.BoardClock(), t0 = 100, ppm = 40e-6, start = 4294967296 - 3e6;
    let worst = 0;
    for (let k = 0; k < 1200; k++) {
      const host = t0 + k * 0.0385, bUs = start + (host - t0) * 1e6 * (1 + ppm), ext = clk.unwrap(Math.round(bUs) % 4294967296);
      clk.add(ext, host + 0.002 + -Math.log(1 - u01()) * 0.008);
      if (k > 400) worst = Math.max(worst, Math.abs(clk.toHost(ext) - (host + 0.002)));
    }
    check(worst < 0.0015 && Math.abs(clk.k + ppm) < 10e-6, `a board's clock (40 ppm fast, across the 32-bit wrap) on the page's: within ${(worst * 1000).toFixed(2)} ms of arrival minus the least delay (the page gains ${(clk.k * 1e6).toFixed(1)} ppm per board second)`);
  }
  // lining up: the object turns about several axes; camera 0.5°, IMU 0.3°; one camera pose in ten is its mirror image
  const Wt = C.mul3(C.rodrigues([Math.PI / 2, 0, 0]), C.rodrigues([0, 0, 1.1])), Mt = C.mul3(C.rodrigues([0, 0, Math.PI / 2]), C.rodrigues([0.1, -0.05, 0.03]));
  const turn = (t) => C.mul3(C.rodrigues([0.6 * Math.sin(0.7 * t), 0.5 * Math.sin(1.1 * t + 1), 0.4 * Math.sin(0.9 * t + 2)]), C.rodrigues([Math.PI, 0, 0]));
  const noisy = (R, sd) => C.mul3(C.rodrigues([gauss() * sd, gauss() * sd, gauss() * sd]), R);
  const pairsOf = (fn, n) => Array.from({ length: n }, (_, k) => { const Rc = fn(k * 0.2); return { Rc: k % 10 === 7 ? C.mul3(C.rodrigues([0.3, 0, 0]), Rc) : noisy(Rc, 0.009), Q: noisy(C.mul3(C.tr3(Wt), C.mul3(Rc, C.tr3(Mt))), 0.005) }; });
  const L = C.lineUp(pairsOf(turn, 60));
  check(!L.error && deg(L.M, Mt) < 0.6 && deg(L.W, Wt) < 0.6, `lined up from 60 poses: the board on its object within ${L.M ? deg(L.M, Mt).toFixed(2) : '?'}°, VQF's world in the rig within ${L.W ? deg(L.W, Wt).toFixed(2) : '?'}° (${L.used} of 60 kept)`);
  check(C.lineUp(pairsOf((t) => C.mul3(C.rodrigues([0, 0.8 * Math.sin(t), 0]), C.rodrigues([Math.PI, 0, 0])), 60)).error === 'turn', 'turned about one axis only, it asks for more turning');
  // the filter: a turning object at 1.3 m, one camera, 0.5 px corners; with the gyro (0.02 rad/s) and VQF's tilt (1°,
  // heading free) against without. And the face-on tag one camera can't settle: the tilt settles it.
  const cam = C.guessIntrinsics(1280, 720, 70), I = { R: [1, 0, 0, 0, 1, 0, 0, 0, 1], t: [0, 0, 0] }, obj = C.tagCorners(0.08), up = C.mulv(Wt, [0, 0, 1]);
  const see = (P, sd) => obj.map((o) => { const q = C.project(cam, C.add(C.mulv(P.R, o), P.t)); return [q[0] + sd * gauss(), q[1] + sd * gauss()]; });
  const run = (poseAt, imu, n) => {
    const f = new C.PoseFilter(C.MOTION.balanced), e = [];
    f.init(0, poseAt(0));
    for (let k = 1; k < n; k++) {
      const t = k / 30, P = poseAt(t);
      if (imu) for (let j = 0; j < 7; j++) { // seven IMU readings a frame, 20 ms late
        const ti = t - 0.02 - j * 0.0048, Ri = poseAt(ti).R, Rn = poseAt(ti + 0.001).R, w = C.so3Log(C.mul3(Rn, C.tr3(Ri))).map((x) => x / 0.001 + 0.02 * gauss());
        f.updateRate(ti, w, 0.02);
        f.updateTilt(ti, noisy(Ri, 0.015), up, 0.02, 0.5);
      }
      const r = f.updateCorners(t, [C.sighting(cam, I, obj, see(P, 0.5), 0.5, 0)], null);
      if (k > 30 && r && r.pose) e.push(deg(r.pose.R, P.R));
    }
    return Math.sqrt(e.reduce((a, x) => a + x * x, 0) / e.length);
  };
  const moving = (t) => ({ R: turn(t), t: [0.1 * Math.sin(t), 0.05, 1.3] });
  const a = run(moving, true, 150), b = run(moving, false, 150);
  check(a < b * 0.7, `a turning tag, one camera: ${a.toFixed(2)}° RMS with the motion sensor, ${b.toFixed(2)}° without`);
  const face = () => ({ R: C.mul3(C.rodrigues([0.06, 0.05, 0.2]), C.rodrigues([Math.PI, 0, 0])), t: [0, 0.02, 1.6] });
  const fa = run(face, true, 120), fb = run(face, false, 120);
  check(fa < 2 && fa < fb / 3, `a face-on tag one camera can't settle: ${fa.toFixed(2)}° RMS with the sensor's tilt, ${fb.toFixed(2)}° without`);
  const f = new C.PoseFilter(C.MOTION.balanced); f.init(0, moving(0));
  check(f.updateRate(0.6, [0, 0, 0], 0.02) === null, 'a motion sensor alone never keeps a track alive (nothing half a second after the last camera frame)');
}

console.log('5h. the robot: arms, inverse kinematics, calibration; tags on a screen; its settings');
{
  const RC = require(path.join(__dirname, '..', 'tag-tracker/robot-core.js'));
  const m = RC.model(), D = Math.PI / 180, N = 2000;
  const rotErr = (A, B) => C.norm(C.so3Log(C.mul3(C.tr3(A), B)));
  const randQ = () => RC.JOINTS.map((j) => j.lo + (j.hi - j.lo) * rnd());
  const palm = (f, side) => [-side * f.R[1], -side * f.R[4], -side * f.R[7]], fingers = (f) => [-f.R[2], -f.R[5], -f.R[8]];
  const L = RC.fk(m, 1, RC.HOME), Rt = RC.fk(m, -1, RC.HOME);
  check(near(C.sub(L.elbow, L.shoulder), [0, 0, -m.upper], 1e-12) && near(C.sub(L.wrist, L.elbow), [m.fore, 0, 0], 1e-12) && near(fingers(L), [1, 0, 0], 1e-12), 'home: the upper arm hangs straight down, the forearm and fingers point forward');
  check(near(palm(L, 1), [0, -1, 0], 1e-12) && near(palm(Rt, -1), [0, 1, 0], 1e-12) && near(Rt.wrist, [L.wrist[0], -L.wrist[1], L.wrist[2]], 1e-12), 'the palms face inward, and the right arm is the left one\'s mirror image');
  const h = RC.ik(m, 1, L, null);
  check(near(h.q, RC.HOME, 1e-6) && h.reach, 'the home wrist pose solves back to the home angles');

  let worstP = 0, worstR = 0, over1 = 0, over5 = 0;
  for (let k = 0; k < N; k++) {
    const side = k % 2 ? 1 : -1, T = RC.fk(m, side, randQ()), s = RC.ik(m, side, T, null), F = RC.fk(m, side, s.q);
    worstP = Math.max(worstP, C.norm(C.sub(F.t, T.t))); worstR = Math.max(worstR, rotErr(F.R, T.R));
    if (s.limits > D) over1++;
    if (s.limits > 5 * D) over5++;
  }
  check(worstP < 1e-9 && worstR < 1e-7, `IK then FK lands on the wrist pose (${N} random reachable poses): within ${worstP.toExponential(1)} m and ${worstR.toExponential(1)} rad`);
  check(over1 <= N * 0.005 && over5 <= N * 0.002, `... with every joint within its limits but for ${over1} poses beyond 1° (${over5} beyond 5°)`);

  // the spare degree of freedom: where an elbow can sit below the hand and out to the side, it does
  let nPref = 0, worstLow = 0, worstOut = 0;
  for (let k = 0; k < N; k++) {
    const side = k % 2 ? 1 : -1, T = RC.fk(m, side, randQ());
    if (T.elbow[2] > T.wrist[2] || side * (T.elbow[1] - T.shoulder[1]) < 0) continue;
    const s = RC.ik(m, side, T, null);
    if (s.limits > 1e-3) continue;
    nPref++; worstLow = Math.max(worstLow, s.elbow[2] - s.wrist[2]); worstOut = Math.max(worstOut, -side * (s.elbow[1] - T.shoulder[1]));
  }
  check(nPref > 200 && worstLow < 0.01 && worstOut < 0.01, `elbows stay below the hands and out to the side wherever they can (${nPref} poses; at worst ${(worstLow * 100).toFixed(2)} cm above, ${(worstOut * 100).toFixed(2)} cm in)`);
  const front = { R: L.R, t: [0.3, 0.05, 0.12] }, pref = RC.ik(m, 1, front, null), free = RC.ik(m, 1, front, { q: RC.HOME, elbow: [0.1, -0.1, 0.4] }, { prefer: false });
  check(pref.elbow[2] <= pref.wrist[2] + 1e-6 && pref.elbow[1] >= L.shoulder[1] - 1e-6 && (free.elbow[2] > free.wrist[2] || free.elbow[1] < L.shoulder[1]), 'hands together in front of the chest: the elbows drop out to the sides (with the preference off they stay up and in where they were)');

  // steadiness along a smooth path
  const qa = [40 * D, 20 * D, 10 * D, 70 * D, 10 * D, 10 * D, 0], qb = [110 * D, 40 * D, -30 * D, 40 * D, -40 * D, 20 * D, 20 * D];
  let prev = null, worstStep = 0, worstE = 0;
  for (let i = 0; i <= 300; i++) {
    const f = i / 300, s = RC.ik(m, 1, RC.fk(m, 1, qa.map((x, j) => x + (qb[j] - x) * f)), prev);
    if (prev) { worstStep = Math.max(worstStep, ...s.q.map((x, j) => Math.abs(x - prev.q[j]))); worstE = Math.max(worstE, C.norm(C.sub(s.elbow, prev.elbow))); }
    prev = s;
  }
  check(worstStep < 3 * D && worstE < 0.01, `a smooth wrist path gives smooth joints: at most ${(worstStep / D).toFixed(2)}° and ${(worstE * 1000).toFixed(1)} mm of elbow per step`);

  // out of reach
  const far = { R: L.R, t: C.add(L.shoulder, [0.5, 0.2, 0.3]) }, fs = RC.ik(m, 1, far, null), Ff = RC.fk(m, 1, fs.q);
  const dist = C.norm(C.sub(far.t, L.shoulder)), along = C.add(L.shoulder, C.sub(far.t, L.shoulder).map((x) => (x * (m.upper + m.fore)) / dist));
  check(!fs.reach && Math.abs(fs.gap - (dist - m.upper - m.fore)) < 1e-12 && near(Ff.t, along, 1e-9) && rotErr(Ff.R, far.R) < 1e-7, 'a wrist out of reach: the arm points straight at it, says how far short it is, and still turns the hand');

  // calibration. A person 1.6 m from the camera, facing it (the plotted frame: x right, y away, z up), so their
  // left is +x. Their wrist tags sit a little off the robot's home wrists, turned any way.
  const body = { R: [1, 0, 0, 0, 0, -1, 0, 1, 0], t: [0, 1.6, 0] };
  const chest0 = { R: RC.upright([0, -1, 0]), t: body.t };
  const tagAt = (side, off) => ({ R: C.rodrigues([rnd() * 3 - 1.5, rnd() * 3 - 1.5, rnd() * 3 - 1.5]), t: C.add(RC.place(chest0, RC.fk(m, side, RC.HOME).t), off) });
  const lt = tagAt(1, [0.02, -0.03, 0.01]), rt = tagAt(-1, [-0.01, 0.02, 0.03]);
  const solve = (cal, poses) => RC.targets(cal, poses).arms.map((a) => ({ key: a.key, side: a.side, s: RC.ik(m, a.side, a.target, null) }));
  let cal = RC.calibrate(m, { body, arms: [{ key: 'R', pose: rt }, { key: 'L', pose: lt }] });
  let got = solve(cal, { body, arms: { L: lt, R: rt } });
  check(got.find((a) => a.key === 'L').side === 1 && got.find((a) => a.key === 'R').side === -1 && got.every((a) => near(a.s.q, RC.HOME, 1e-6)), 'calibrating in the start pose: each wrist tag drives the arm on its side, and both arms are at home');
  const G = { R: C.rodrigues([0.2, -0.4, 0.9]), t: [0.3, -0.2, 0.5] }, g = (p) => C.compose(G, p);
  const moved = solve(cal, { body: g(body), arms: { L: g(lt), R: g(rt) } });
  check(moved.every((a) => near(a.s.q, RC.HOME, 1e-6)), 'walking and turning the whole person moves the robot, not its joints');
  const spin = { R: C.mul3(lt.R, C.rodrigues([0, 0.8, 0])), t: lt.t }, tg = RC.targets(cal, { body, arms: { L: spin, R: rt } }).arms[1].target;
  check(near(tg.t, RC.fk(m, 1, RC.HOME).t, 1e-12) && Math.abs(C.angleOf(C.mul3(C.tr3(RC.fk(m, 1, RC.HOME).R), tg.R)) - 0.8) < 1e-9, 'turning a wrist turns the hand in place (no swing from where the tag sits)');
  const reach = RC.targets(cal, { body, arms: { L: { R: lt.R, t: C.add(lt.t, [0, -0.1, 0.05]) }, R: rt } }).arms[1].target;
  check(near(C.sub(reach.t, RC.fk(m, 1, RC.HOME).t), [0.1, 0, 0.05], 1e-12), 'a wrist moved 10 cm toward the camera and 5 cm up: the hand moves 10 cm forward and 5 cm up');
  // no body tag: the chest faces the camera, put so the home wrists land on the tags
  cal = RC.calibrate(m, { body: null, arms: [{ key: 'L', pose: lt }, { key: 'R', pose: rt }] }, { toward: [0, 0, 0] });
  got = solve(cal, { body: null, arms: { L: lt, R: rt } });
  check(got.every((a) => near(a.s.q, RC.HOME, 0.05)) && got.find((a) => a.key === 'L').side === 1 && cal.chest.R[1] > 0.99, 'two wrist tags and no body: two arms, facing the camera, near home');
  cal = RC.calibrate(m, { body: null, arms: [{ key: 'R', pose: rt, side: -1 }] }, { toward: [0, 0, 0] });
  got = solve(cal, { body: null, arms: { R: rt } });
  check(got.length === 1 && got[0].side === -1 && near(got[0].s.q, RC.HOME, 1e-6), 'one wrist tag: one arm, exactly at home');
  cal = RC.calibrate(m, { body: C.mirrorPose(body), arms: [{ key: 'L', pose: C.mirrorPose(lt) }, { key: 'R', pose: C.mirrorPose(rt) }] });
  check(cal.arms.find((a) => a.key === 'L').side === -1, 'arms take their sides from where the wrists are: mirrored poses swap them');

  // a tag on a phone's screen, and the settings
  const tf = C.tagFit(1170, 2532, 8, 1);
  check(tf.px === 117 && tf.size === 936 && C.tagFit(9, 9, 8, 1).px === 0, 'one tag on a screen: whole pixels per cell, a cell of white round it');
  const st = C.clampSettings({ show3d: 'x', robot: { body: '', left: 'b:hand', upper: 5, back: -1, elbows: 0 } });
  check(st.show3d === 'robot' && st.robot.body === 'auto' && st.robot.left === 'b:hand' && st.robot.upper === 1 && st.robot.back === 0 && st.robot.elbows === false && st.robot.joints === true && st.setup === true && C.clampSettings({ setup: false }).setup === false, 'robot settings: roles, lengths clamped, switches, and the setup guide on unless turned off');
  // the shaded robot's meshes (robot-gl.js): every surface sound, for the default lengths and for a small person
  const RGL = require(path.join(__dirname, '..', 'tag-tracker/robot-gl.js'));
  let parts = 0, verts = 0, bad = 0;
  for (const [lens, look] of [[{}, 'pearl'], [{ upper: 0.2, fore: 0.18, half: 0.12, up: 0.05, back: 0 }, 'pearl'], [{}, 'machine'], [{}, 'companion']]) {
    const M = RGL.meshes(RC.model(lens), look), all = [...M.body, ...M.bar, ...M.mount[1], ...M.mount[-1], ...M.upper, ...M.fore, ...M.foreLight, ...M.hand[1], ...M.hand[-1]];
    for (const p of all) {
      const { pos, nrm, idx } = p.mesh, n = pos.length / 3;
      parts++; verts += n;
      if (n > 65535 || [...idx].some((i) => i >= n)) bad++;
      for (let i = 0; i < n; i++) if (![pos[3 * i], pos[3 * i + 1], pos[3 * i + 2]].every(isFinite) || Math.abs(Math.hypot(nrm[3 * i], nrm[3 * i + 1], nrm[3 * i + 2]) - 1) > 1e-4) { bad++; break; }
    }
  }
  check(bad === 0 && parts > 160, `the shaded robot's ${parts} meshes (${verts} vertices; each look, and a small person's lengths): finite points, unit normals, 16-bit indices in range`);
  check(RGL.STYLES.every((s) => C.clampSettings({ robot: { style: s } }).robot.style === s) && C.clampSettings({ robot: { style: 'x' } }).robot.style === 'pearl', 'every look is a setting; an unknown one is Pearl');
  const cmd = (t) => (C.voiceCommand(t) || {}).cmd || null;
  check(cmd('Calibrate robot.') === 'robot' && cmd('Calibrate.') === 'calib' && cmd('Open settings.') === 'settings', '"calibrate robot" is not "calibrate", and "settings" opens the tab');
}

// The UDP bridge (tag-tracker/udp-bridge.py), driven as the page drives it.
function testBridge() {
  const { spawnSync, spawn } = require('child_process'), dgram = require('dgram'), net = require('net');
  if (spawnSync('python3', ['--version']).status !== 0 || typeof WebSocket !== 'function') {
    console.log('5d. the UDP bridge: skipped (needs python3 and Node 22 or later)');
    return Promise.resolve();
  }
  console.log('5d. the UDP bridge');
  const freePort = () => new Promise((res) => { const s = net.createServer().listen(0, '127.0.0.1', () => { const p = s.address().port; s.close(() => res(p)); }); });
  const wait = (ms) => new Promise((r) => setTimeout(r, ms));
  return (async () => {
    const wsPort = await freePort(), udp = dgram.createSocket('udp4'), got = [];
    await new Promise((r) => udp.bind(0, '127.0.0.1', r));
    udp.on('message', (m) => got.push(m.toString()));
    const br = spawn('python3', [path.join(__dirname, '..', 'tag-tracker/udp-bridge.py'), '--port', String(wsPort)], { stdio: ['ignore', 'pipe', 'pipe'] });
    try {
      for (let i = 0; i < 50; i++) { await wait(100); if (await new Promise((r) => { const c = net.connect(wsPort, '127.0.0.1', () => { c.destroy(); r(true); }); c.on('error', () => r(false)); })) break; }
      const ws = new WebSocket(`ws://127.0.0.1:${wsPort}/?to=127.0.0.1:${udp.address().port}`);
      const hello = await new Promise((res, rej) => { ws.onmessage = (e) => res(JSON.parse(e.data)); ws.onerror = () => rej(new Error('no connection')); setTimeout(() => rej(new Error('no hello')), 3000); });
      check(hello.bridge === 'tag-tracker-udp' && hello.to === `127.0.0.1:${udp.address().port}`, 'it answers with where it sends');
      const big = 'x'.repeat(3000) + '\n', huge = 'y'.repeat(70000);
      ws.send('{"t":1}\n'); ws.send(big); ws.send(huge); ws.send('last\n');
      for (let i = 0; i < 30 && got.length < 3; i++) await wait(50);
      check(got.length === 3 && got[0] === '{"t":1}\n' && got[1] === big && got[2] === 'last\n', 'each message is one datagram, in order (one of 3 kB too); one too big for UDP is dropped');
      ws.close();
      // a page from another site is refused before any WebSocket opens
      const reply = await new Promise((res) => {
        const c = net.connect(wsPort, '127.0.0.1', () => c.write(`GET /?to=127.0.0.1:9 HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nOrigin: https://elsewhere.example\r\n\r\n`));
        let d = ''; c.on('data', (b) => { d += b; }); c.on('close', () => res(d)); c.on('error', () => res(d));
      });
      check(/^HTTP\/1\.1 403/.test(reply), 'a page from another site is refused (403)');
    } finally { br.kill(); udp.close(); }
  })().catch((e) => { check(false, 'the bridge: ' + e.message); });
}

let cvPkg = null;
try { cvPkg = require.resolve('@techstark/opencv-js', { paths: [process.cwd(), path.join(__dirname, '..')] }); } catch (e) { cvPkg = null; }
const bridged = testBridge();
if (!cvPkg) bridged.then(() => {
  console.log('6. detection and calibration: skipped (OpenCV.js not installed)');
  finish();
});
else bridged.then(async () => {
  console.log('6. detection and calibration (OpenCV.js)');
  const factory = require(path.join(__dirname, '..', 'tag-tracker/worker.js'));
  const cv = await factory.ready(require(cvPkg));
  const V = factory(cv, C);
  const W = 1280, Hh = 720, cam = { w: W, h: Hh, fx: 1000, fy: 1000, cx: 639.5, cy: 359.5, dist: [0, 0, 0, 0, 0] };

  // Render a flat picture `src` into the camera. A maps a source pixel index (u, v, 1) to plane coordinates
  // (X, Y, 1) in metres; the plane sits at pose (R, t). Rendered 3× larger and averaged down, so edges are
  // anti-aliased like a real sensor's.
  function render(src, A, R, t, bg) {
    const S = 3, Ks = [cam.fx * S, 0, (cam.cx + 0.5) * S - 0.5, 0, cam.fy * S, (cam.cy + 0.5) * S - 0.5, 0, 0, 1];
    const M = [R[0], R[1], t[0], R[3], R[4], t[1], R[6], R[7], t[2]];
    const Hm = cv.matFromArray(3, 3, cv.CV_64F, C.mul3(Ks, C.mul3(M, A)));
    const big = new cv.Mat(), out = new cv.Mat();
    cv.warpPerspective(src, big, Hm, new cv.Size(W * S, Hh * S), cv.INTER_LINEAR, cv.BORDER_CONSTANT, new cv.Scalar(bg));
    cv.resize(big, out, new cv.Size(W, Hh), 0, 0, cv.INTER_AREA);
    Hm.delete(); big.delete();
    // a little sensor noise
    const d = out.data;
    for (let i = 0; i < d.length; i++) d[i] = Math.max(0, Math.min(255, d[i] + Math.round((rnd() - 0.5) * 6)));
    return out;
  }
  const toMat = (img) => { const m = new cv.Mat(img.h, img.w, cv.CV_8UC1); m.data.set(img.data); return m; };

  // Calibration: a board with 25 mm squares, from 12 random poses.
  const px = 120, square = 0.025, bimg = toMat(V.boardImage(px));
  const Ab = [square / px, 0, 0.5 * square / px, 0, square / px, 0.5 * square / px, 0, 0, 1];
  const views = [];
  let boardMs = 0, poseMm = 0, poseDeg = 0, poses = 0;
  for (let v = 0; v < 12; v++) {
    const R = rotXYZ((rnd() - 0.5) * 0.9, (rnd() - 0.5) * 0.9, (rnd() - 0.5) * 0.6);
    const ctr = C.mulv(R, [4.5 * square, 3 * square, 0]);
    const t = C.sub([(rnd() - 0.5) * 0.25, (rnd() - 0.5) * 0.15, 0.35 + rnd() * 0.3], ctr);
    const img = render(bimg, Ab, R, t, 140);
    const t0 = Date.now(), b = V.detectBoard(img);
    boardMs += Date.now() - t0;
    V.setGray(img.data, W, Hh);
    if (b.ids.length >= 6) {
      views.push({ ids: b.ids, pts: b.pts });
      // the board's pose in the camera, as used to place several cameras
      const bp = V.boardPose(b.ids, b.pts, cam, square);
      if (bp) { poses++; poseMm = Math.max(poseMm, C.norm(C.sub(bp.t, t)) * 1000); poseDeg = Math.max(poseDeg, C.angleOf(C.mul3(C.tr3(R), bp.R)) * 180 / Math.PI); }
    }
    img.delete();
  }
  check(views.length >= 10, `the board is found in ${views.length} of 12 views (${(boardMs / 12).toFixed(0)} ms each)`);
  check(poses === views.length && poseMm < 2 && poseDeg < 0.3, `the board's pose in the camera (for placing cameras) within ${poseMm.toFixed(2)} mm and ${poseDeg.toFixed(3)}° in all ${poses} views`);
  const k = V.calibrate(views, W, Hh, square);
  check(k.rms < 0.5, `calibration RMS ${k.rms.toFixed(3)} px`);
  check(Math.abs(k.fx / cam.fx - 1) < 0.01 && Math.abs(k.fy / cam.fy - 1) < 0.01, `focal length within 1%: fx ${k.fx.toFixed(1)}, fy ${k.fy.toFixed(1)} (truth 1000)`);
  check(Math.abs(k.cx - cam.cx) < 6 && Math.abs(k.cy - cam.cy) < 6, `principal point within 6 px: (${k.cx.toFixed(1)}, ${k.cy.toFixed(1)})`);
  check(k.dist[4] === 0 && Math.abs(k.dist[0]) < 0.1, `k3 held at 0, k1 small (${k.dist[0].toFixed(3)})`);
  bimg.delete();

  // Tracking: an 8 cm tag36h11 at 1 m and 2 m, at random tilts.
  V.setFamily('APRILTAG_36h11', 'precise');
  const tpx = 400, size = 0.08, tag = V.tagImage('APRILTAG_36h11', 42, tpx);
  const tm = toMat(tag), pad = new cv.Mat();
  cv.copyMakeBorder(tm, pad, 100, 100, 100, 100, cv.BORDER_CONSTANT, new cv.Scalar(255));
  const q = size / tpx, o = -(100 + tpx / 2) + 0.5;
  const At = [q, 0, q * o, 0, -q, -q * o, 0, 0, 1]; // y up the tag
  let ms = 0, n = 0;
  for (const z of [1, 2]) {
    const errs = [], angs = [], rawAng = [];
    for (let i = 0; i < 6; i++) {
      // the tag's z comes out of its face, so a tag facing the camera is turned half a turn about x
      const R = C.mul3(rotXYZ((rnd() - 0.5) * 0.9, (rnd() - 0.5) * 0.9, rnd() * 6.28), rotXYZ(Math.PI, 0, 0)), t = [(rnd() - 0.5) * 0.4 * z, (rnd() - 0.5) * 0.2 * z, z];
      const img = render(pad, At, R, t, 150);
      const t0 = Date.now(), found = V.track(img, cam, { 42: size }, 0.05, [], false).tags;
      ms += Date.now() - t0; n++;
      img.delete();
      const f = found.find((x) => x.id === 42);
      if (!f || !f.t) { errs.push(Infinity); rawAng.push(Infinity); continue; }
      // the refined candidate nearest the truth: the image alone may not say which of two mirror images it is
      const near = f.cands.map((c) => ({ e: C.norm(C.sub(c.t, t)) * 1000, a: (C.angleOf(C.mul3(C.tr3(R), c.R)) * 180) / Math.PI })).sort((p, q) => p.a - q.a)[0];
      errs.push(near.e); angs.push(near.a);
      rawAng.push((C.angleOf(C.mul3(C.tr3(R), f.R)) * 180) / Math.PI);
    }
    const worst = Math.max(...errs), lim = z === 1 ? 3 : 25; // depth noise grows as z²: about 1% at 2 m for a 40 px tag
    check(worst < lim, `8 cm tag at ${z} m: position error ${errs.map((e) => e.toFixed(1)).join(', ')} mm (all under ${lim})`);
    check(angs.length === 6 && Math.max(...angs) < 5, `and its rotation within ${Math.max(...angs).toFixed(2)}° (under 5°); OpenCV's own pose alone: up to ${Math.max(...rawAng).toFixed(1)}°`);
  }
  check(ms / n < 100, `detection and SE(3) refinement on 1280×720 with sensor noise: ${(ms / n).toFixed(0)} ms per frame in Node (under 100)`);
  // Searching only a window round where the tag should be finds the same corners as searching the whole picture, in
  // whole-picture pixels, and costs a fraction of the time.
  {
    const R = C.mul3(rotXYZ(0.25, -0.2, 0.7), rotXYZ(Math.PI, 0, 0)), img = render(pad, At, R, [0.12, -0.05, 1.2], 150);
    const whole = V.track(img, cam, { 42: size }, 0.05, [], false).tags.find((x) => x.id === 42), cs = whole.corners;
    const xs = [cs[0], cs[2], cs[4], cs[6]], ys = [cs[1], cs[3], cs[5], cs[7]];
    const plan = C.planSearch([{ pts: [0, 1, 2, 3].map((k) => [cs[2 * k] + 9, cs[2 * k + 1] - 6]), pad: 0.4 * (Math.max(...xs) - Math.min(...xs)) + 12 }], img.cols, img.rows);
    const r = plan.rois[0], part = img.roi(new cv.Rect(r.x, r.y, r.w, r.h)), win = part.clone();
    const got = V.track([{ img: win, x: r.x, y: r.y }], cam, { 42: size }, 0.05, [], false).tags.find((x) => x.id === 42);
    const d = got ? Math.max(...got.corners.map((v, i) => Math.abs(v - cs[i]))) : Infinity;
    let tW = Date.now(); for (let i = 0; i < 20; i++) V.detectTags(img, cam, {}, size); tW = (Date.now() - tW) / 20;
    let tR = Date.now(); for (let i = 0; i < 20; i++) V.detectTags(win, cam, {}, size, r.x, r.y); tR = (Date.now() - tR) / 20;
    check(d < 0.01 && got.cands.length > 0, `a search window (${(plan.frac * 100).toFixed(0)}% of the picture, the tag moved 11 px since) finds the same corners (within ${d.toFixed(4)} px)`);
    check(tR < tW / 3, `and takes ${tR.toFixed(1)} ms against ${tW.toFixed(1)} ms for the whole picture`);
    part.delete(); win.delete(); img.delete();
  }
  // Repeated frames must not leak WebAssembly memory.
  const img = render(pad, At, C.mul3(rotXYZ(0.2, 0.1, 0.3), rotXYZ(Math.PI, 0, 0)), [0, 0, 1], 150);
  const heap0 = cv.HEAPU8 ? cv.HEAPU8.length : 0;
  for (let i = 0; i < 150; i++) { V.detectTags(img, cam, {}, size); V.detectBoard(img); }
  const heap1 = cv.HEAPU8 ? cv.HEAPU8.length : 0;
  check(heap1 === heap0, `150 frames of detection don't grow the WebAssembly heap (${(heap0 / 1e6).toFixed(0)} MB)`);
  img.delete(); tm.delete(); pad.delete();
  check(V.familySize('APRILTAG_36h11') === 587 && V.familySize('APRILTAG_16h5') === 30, 'family sizes: 587 tags in 36h11, 30 in 16h5');

  // 6b. The board on a screen (/tag-tracker/#board): the page draws boardImage(px) at the fitted size, turned a
  // quarter clockwise when the screen is upright, on white. Every inner corner must still be found, at screen size
  // and seen smaller by a camera. And the share panel's QR code (qrcode-generator, drawn module by module with a
  // 4-module quiet zone, as the page's qrSvg does) must decode to the link.
  console.log('6b. the board on a screen, and the link\'s QR code');
  for (const [Wd, Hd] of [[2048, 1536], [1536, 2048]]) {
    const f = C.boardFit(Wd, Hd, 9, 6, 0.5), g = toMat(V.boardImage(f.px)), r = new cv.Mat(), scr = new cv.Mat(), small = new cv.Mat();
    if (f.rotate) cv.rotate(g, r, cv.ROTATE_90_CLOCKWISE); else g.copyTo(r);
    cv.copyMakeBorder(r, scr, f.px, f.px, f.px, f.px, cv.BORDER_CONSTANT, new cv.Scalar(255));
    cv.resize(scr, small, new cv.Size(Math.round(scr.cols * 0.3), Math.round(scr.rows * 0.3)), 0, 0, cv.INTER_AREA);
    const a = V.detectBoard(scr).ids.length, b = V.detectBoard(small).ids.length;
    check(a === 40 && b === 40, `${Wd} × ${Hd}${f.rotate ? ', turned' : ''}: all 40 inner corners found at screen size (${a}) and at 30% (${b})`);
    [g, r, scr, small].forEach((m) => m.delete());
  }
  {
    const qrcode = require(path.join(__dirname, '..', 'tag-tracker/lib/qrcode-generator/qrcode.js'));
    const url = 'https://tsmorz.github.io/tag-tracker/#board', q = qrcode(0, 'M'); q.addData(url); q.make();
    const n = q.getModuleCount(), z = 4, k = 6, s = (n + 2 * z) * k, qm = new cv.Mat(s, s, cv.CV_8UC1, new cv.Scalar(255));
    for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) if (q.isDark(r, c)) {
      for (let y = 0; y < k; y++) qm.data.fill(0, ((r + z) * k + y) * s + (c + z) * k, ((r + z) * k + y) * s + (c + z + 1) * k);
    }
    const det = new cv.QRCodeDetector(), pts = new cv.Mat(), st = new cv.Mat(), txt = det.detectAndDecode(qm, pts, st);
    check(txt === url, `the QR code reads back as the link (${n} × ${n} modules): ${txt || 'nothing'}`);
    [qm, pts, st].forEach((m) => m.delete()); det.delete();
  }
  finish();
}).catch((e) => { console.log('  FAIL ' + (e && e.stack || e)); failed = true; finish(); });

function finish() {
  if (failed) { console.log('\nFAIL'); process.exit(1); }
  console.log('\nOK');
}
