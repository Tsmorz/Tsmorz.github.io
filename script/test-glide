#!/usr/bin/env node
// Check the maths behind /glide-path/ (glide-path/glide-core.js), in Node.
//   1. still air on flat ground: every direction reaches (start height − margin) × L/D
//   2. wind: downwind, upwind and crosswind ground glide ratios; tracks that can't be flown
//   3. terrain: a ridge stops the glide where the path minus the margin meets it; a low ridge is cleared
//   4. reachAt agrees with the rays
//   5. map maths: pixel ↔ lon/lat round trip, metres per pixel, Terrarium decoding
//   6. saved areas: the tile list per zoom, and deleting keeps tiles another area still uses
//   6b. contours: a plane, a cone (closed rings), a saddle either side of the line, a window against the whole grid, missing heights, spacing
//   7. the service worker (sw.js) in a mock: terrain from saved/recent caches offline, the recent cache capped,
//      the page from cache offline or on a stalled network, street-map tiles left alone
//   8. the old address: /glide-reach/ redirects, and its sw.js retires the old service worker
const path = require('path');
const fs = require('fs');
const vm = require('vm');
const G = require(path.join(__dirname, '..', 'glide-path/glide-core.js'));
let failed = false;
function check(ok, msg) { console.log((ok ? '  ok   ' : '  FAIL ') + msg); if (!ok) failed = true; }
function near(got, want, tol, label) { check(Math.abs(got - want) <= tol, `${label}: ${got.toFixed(2)} (wanted ${want} ± ${tol})`); }
const E = 90 * 2, W = 270 * 2, N = 0; // ray index for 720 rays

const base = { n: 720, h0: 220, margin: 20, Va: 10, GR: 15, windSpeed: 0, windFromDeg: 270, ds: 5, maxD: 20000 };
const flat = () => 0;

console.log('1. still air, flat ground');
let R = G.castRays(base, flat);
near(R.dmax[N], 3000, 5, 'north reach = 200 m × 15');
near(R.dmax[E], 3000, 5, 'east reach');
check([...R.kind].every(k => k === 0), 'every ray ends on the ground');
near(R.grg[E], 15, 1e-6, 'ground glide ratio = L/D in still air');

console.log('2. wind');
R = G.castRays({ ...base, windSpeed: 5, windFromDeg: 270 }, flat); // from the west, blowing east
near(R.dmax[E], 4500, 5, 'downwind: (10 + 5)/(10/15) × 200');
near(R.dmax[W], 1500, 5, 'upwind: (10 − 5)/(10/15) × 200');
near(R.dmax[N], Math.sqrt(75) / (10 / 15) * 200, 5, 'crosswind: crab angle costs ground speed');
R = G.castRays({ ...base, windSpeed: 12, windFromDeg: 270 }, flat);
check(R.kind[W] === 2 && R.dmax[W] === 0, 'wind faster than the glider: upwind is not flyable');
check(R.kind[E] === 0 && R.dmax[E] > 6000, 'and downwind goes further');
near(G.groundSpeed(Math.PI / 2, 10, 5, 0), Math.sqrt(75), 1e-9, 'groundSpeed: 5 m/s from the north on an east track');

console.log('3. terrain');
const ridge = h => (e) => (e > 1500 && e < 1700 ? h : 0);
R = G.castRays(base, ridge(300));
near(R.dmax[E], 1500, 5, 'a 300 m ridge 1.5 km east stops the glide at its face');
near(R.dmax[W], 3000, 5, 'the other way is unaffected');
R = G.castRays(base, ridge(100));
near(R.dmax[E], 1500, 5, 'a 100 m ridge: path − margin is exactly 100 m there, so it stops');
R = G.castRays(base, ridge(80));
near(R.dmax[E], 3000, 5, 'an 80 m ridge is cleared');
R = G.castRays({ ...base, maxD: 1000 }, (e, n) => (Math.hypot(e, n) > 800 ? NaN : 0));
check(R.kind[E] === 1 && R.dmax[E] <= 800, 'running off the terrain data is flagged, not counted as a landing');

console.log('4. reachAt');
R = G.castRays(base, flat);
check(G.reachAt(R, Math.PI / 2, 2000) > 0, '2 km east is reachable');
check(!G.reachAt(R, Math.PI / 2, 3500), '3.5 km east is not');
R = G.castRays(base, ridge(300));
check(!G.reachAt(R, Math.PI / 2, 2500), 'behind the ridge is not');

console.log('4b. route search round terrain (reachGrid)');
{
  const cell = 20, W = 500, c = 250; // 10 km × 10 km grid, launch in the middle
  const grid = f => { const t = new Float32Array(W * W); for (let j = 0; j < W; j++) for (let i = 0; i < W; i++) t[j * W + i] = f((i - c) * cell, (c - j) * cell); return t; };
  const run = (terr, extra = {}) => G.reachGrid({ cell, si: c, sj: c, h0: 220, margin: 20, Va: 10, GR: 15, windSpeed: 0, windFromDeg: 270, ...extra }, terr, W, W);
  const at = (r, e, n) => r.alt[(c - Math.round(n / cell)) * W + c + Math.round(e / cell)];
  const ok = v => v > -Infinity;
  let r = run(grid(() => 0));
  const dirs = [0, 13, 27, 45, 70, 90, 200, 300];
  check(dirs.every(d => ok(at(r, 2880 * Math.sin(d * Math.PI / 180), 2880 * Math.cos(d * Math.PI / 180)))), 'flat ground: 2.88 km is reachable in every direction (true reach 3 km)');
  check(dirs.every(d => !ok(at(r, 3060 * Math.sin(d * Math.PI / 180), 3060 * Math.cos(d * Math.PI / 180)))), 'and 3.06 km in none');
  near(at(r, 2000, 0), 220 - 2000 / 15, 1, 'height over a spot 2 km east is 220 − 2000/15');
  r = run(grid(() => 0), { windSpeed: 5 });
  check(ok(at(r, 4400, 0)) && !ok(at(r, 4600, 0)) && ok(at(r, -1440, 0)) && !ok(at(r, -1560, 0)), 'wind 5 m/s from the west: 4.5 km downwind, 1.5 km upwind, as the rays');
  // a 300 m wall 1 km east, with a 200 m gap to the south-east
  const wall = gap => (e, n) => (e >= 1000 && e < 1100 && !(gap && n > -1200 && n < -1000) ? 300 : 0);
  const behind = [1500, 0];
  const rays = G.castRays({ ...base, maxD: 4900 }, (e, n) => wall(true)(e, n));
  check(rays.dmax[E] < 1000, 'straight east, the wall stops the glide');
  r = run(grid(wall(true)));
  // shortest way round: to the gap's near corner, along it, then to the target; the grid may lose up to ~3% more
  const L = Math.hypot(1000, 1000) + 100 + Math.hypot(400, 1000), h = at(r, ...behind), best = 220 - L / 15, worst = 220 - 1.03 * L / 15;
  check(ok(h) && h <= best + 0.5 && h >= worst, `round the wall through the gap reaches 1.5 km east (${h.toFixed(1)} m; best possible ${best.toFixed(1)} m)`);
  const route = G.routeTo(r.parent, r.alt, (c - behind[1] / cell) * W + c + behind[0] / cell);
  const thru = route.some(i => { const e = (i % W - c) * cell, n = (c - Math.floor(i / W)) * cell; return e >= 1000 && e < 1100 && n > -1200 && n < -1000; });
  check(route[0] === c * W + c && thru, `the route starts at the launch and goes through the gap (${route.length} cells)`);
  let falls = true; for (let k = 1; k < route.length; k++) if (r.alt[route[k]] >= r.alt[route[k - 1]]) falls = false;
  check(falls, 'and loses height at every step');
  r = run(grid(wall(false)));
  check(!ok(at(r, ...behind)), 'with no gap, behind the wall stays out of reach');
  check(!r.edge, 'a reach that fits inside the grid is not flagged at the edge');
  r = G.reachGrid({ cell, si: 5, sj: 5, h0: 220, margin: 20, Va: 10, GR: 15, windSpeed: 0, windFromDeg: 0 }, new Float32Array(100), 10, 10);
  check(r.edge, 'one that runs off the grid is');
  const big = new Float32Array(896 * 896), t0 = Date.now();
  G.reachGrid({ cell: 27.4, si: 448, sj: 448, h0: 500, margin: 20, Va: 10, GR: 15, windSpeed: 0, windFromDeg: 0 }, big, 896, 896);
  const ms = Date.now() - t0;
  check(ms < 5000, `a full page-sized grid (896 × 896, all reachable) runs in ${ms} ms`);
}

console.log('4c. no height limit, line of sight and units');
{
  // a 100 m plateau that drops to a plain 200 m east of the launch; launch 120 m above the plateau
  const plateau = (e) => (e < 200 ? 100 : 0);
  const o = { ...base, h0: 220, maxD: 6000 };
  let R = G.castRays(o, plateau);
  near(R.dmax[E], 3000, 5, 'no height limit: 200 m of height × 15 = 3 km east, over the plain too');
  const prof = G.glideAlong(o, plateau, Math.PI / 2, 300);
  const high = Math.max(...prof.glide.map((h, k) => (h === h ? h - prof.ground[k] : 0)));
  check(high > 200 && prof.kind === 0 && Math.abs(prof.d[prof.end] - R.dmax[E]) <= 5,
    `glideAlong agrees with the rays and keeps its height over low ground (${high.toFixed(0)} m above it, no cap)`);
  const W2 = 500, c = 250, cell = 20, terr = new Float32Array(W2 * W2);
  for (let j = 0; j < W2; j++) for (let i = 0; i < W2; i++) terr[j * W2 + i] = plateau((i - c) * cell);
  const run = extra => G.reachGrid({ cell, si: c, sj: c, h0: 220, margin: 20, Va: 10, GR: 15, windSpeed: 0, windFromDeg: 0, ...extra }, terr, W2, W2);
  const reachE = r => { let i = c; while (i + 1 < W2 && r.alt[c * W2 + i + 1] > -Infinity) i++; return (i - c) * cell; };
  const gFree = reachE(run({}));
  check(Math.abs(gFree - 3000) <= 60, `the route search agrees: ${gFree} m east`);
  const rs = run({ maxR: 600 });
  let farthest = 0; for (let i = 0; i < W2 * W2; i++) if (rs.alt[i] > -Infinity) farthest = Math.max(farthest, Math.hypot(i % W2 - c, Math.floor(i / W2) - c) * cell);
  check(farthest <= 600 && farthest > 560, `staying in sight (600 m): nothing past ${farthest.toFixed(0)} m`);
  check(G.RULES === undefined && G.ruleFor === undefined, 'the height rules are gone from the core');
  check(G.Units.imperial.h(121.92) === '400 ft' && G.Units.metric.h(121.92) === '122 m', 'heights: 121.92 m reads 400 ft or 122 m');
  check(G.Units.imperial.d(3500) === '2.2 mi' && G.Units.imperial.d(200) === '656 ft' && G.Units.metric.d(3500) === '3.5 km', 'distances: 3.5 km = 2.2 mi, 200 m = 656 ft');
  check(G.Units.imperial.v(10) === '22 mph' && G.Units.metric.v(10) === '10 m/s', 'speeds: 10 m/s = 22 mph');
  check(G.Units.imperial.a(2.589988) === '1.0 mi²', 'areas: 2.59 km² = 1 mi²');
}

console.log('5. map maths');
const [px, py] = G.lonLatToPx(-103.2498, 44.0877, 13);
const [lo, la] = G.pxToLonLat(px, py, 13);
near(lo, -103.2498, 1e-9, 'longitude round trip'); near(la, 44.0877, 1e-9, 'latitude round trip');
check(Math.floor(px / 256) === 1746 && Math.floor(py / 256) === 2975, 'M Hill is z13 tile 1746/2975 (textbook formula: y = 2975.996)');
near(G.mppAt(0, 13), 19.109, 0.001, 'metres per pixel at z13 on the equator');
near(G.mppAt(44.0877, 13), 13.72, 0.01, 'and at 44° N');
check(G.chooseZoom(3000, 44.09, 3) === 13, 'a 3 km glide fits zoom 13 (3 tiles of 3.5 km each way)');
check(G.chooseZoom(15000, 44.09, 3) === 12 && G.chooseZoom(25000, 44.09, 3) === 11, '15 km needs zoom 12, 25 km zoom 11');
check(G.chooseZoom(1e6, 44.09, 3) === 9, 'and it never goes coarser than zoom 9');
check(G.decodeTerrarium(128, 0, 0) === 0, 'Terrarium (128, 0, 0) is sea level');
check(G.decodeTerrarium(132, 76, 128) === 1100.5, 'Terrarium (132, 76, 128) is 1100.5 m');

console.log('6. saved areas');
const t = G.areaTiles(44.0877, -103.2498, 13, 4, 9, 3);
const byZ = z => t.filter(k => k[0] === z).length;
check(byZ(13) === 81, `9 × 9 tiles at z13 (${byZ(13)})`);
check([12, 11, 10, 9].every(z => byZ(z) === 49), `7 × 7 at each of zooms 12 to 9, for longer glides (${byZ(12)}, ${byZ(11)}, ${byZ(10)}, ${byZ(9)})`);
check(new Set(t.map(k => k.join('/'))).size === t.length, 'no tile listed twice');
const t13 = t.filter(k => k[0] === 13), xs = t13.map(k => k[1]), ys = t13.map(k => k[2]);
check(Math.min(...xs) === 1742 && Math.max(...xs) === 1750 && Math.min(...ys) === 2971 && Math.max(...ys) === 2979, 'centred on the launch tile');
const key = a => G.areaTiles(a[0], a[1], 13, 4, 9, 3).map(k => k.join('/'));
const a1 = key([44.0877, -103.2498]), a2 = key([44.10, -103.20]), a3 = key([47.49, 11.10]);
const gone = G.tilesOnlyIn(a1, [a2, a3]);
check(gone.length > 0 && gone.length < a1.length, `deleting one of two overlapping areas frees ${gone.length} of ${a1.length} tiles`);
check(gone.every(k => !a2.includes(k)), 'and none the other area still uses');
check(G.tilesOnlyIn(a3, [a1, a2]).length === a3.length, 'an area far away frees all its tiles');

console.log('6b. contours');
{
  const segs = c => { const o = []; for (const arr of [c.minor, c.major]) for (let i = 0; i < arr.length; i += 4) o.push(arr.slice(i, i + 4)); return o; };
  const grid = (w, h, f) => { const g = new Float32Array(w * h); for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) g[y * w + x] = f(x, y); return g; };
  // a plane rising 7 m a pixel eastward: every 20 m is a straight north-south line at x = 20k/7
  let c = G.contours(grid(64, 64, x => 7 * x), 64, 64, 20);
  let s = segs(c), worst = 0;
  for (const [x1, y1, x2, y2] of s) if (x1 > 2 && x1 < 61) { worst = Math.max(worst, Math.abs(x1 - x2), Math.abs(x1 * 7 / 20 - Math.round(x1 * 7 / 20)) * 20 / 7); }
  check(s.length > 0 && worst < 1e-4, `a plane: straight lines at the right spacing (worst ${worst.toExponential(1)} px)`);
  check(c.major.length > 0 && c.major.every((v, i) => i % 2 || Math.abs(v * 7 % 100) < 1e-3), 'every 5th line (each 100 m) is a major one');
  check(G.contours(grid(32, 32, () => 500), 32, 32, 20).minor.length === 0, 'flat ground: no lines');
  check(G.contours(grid(32, 32, () => 500), 32, 32, 20).major.length === 0, 'not even at an exact level (500 m)');
  // a cone 10 m down per pixel from 1000 m at the centre: rings at radius (1000 − level) / 10
  const cx = 40.3, cy = 39.7;
  c = G.contours(grid(80, 80, (x, y) => 1000 - 10 * Math.hypot(x - cx, y - cy)), 80, 80, 50);
  s = segs(c); worst = 0; let rings = new Set();
  for (const [x1, y1, x2, y2] of s) for (const [x, y] of [[x1, y1], [x2, y2]]) {
    const r = Math.hypot(x - cx, y - cy); if (r < 3 || r > 37) continue;
    const want = Math.round(r / 5) * 5; worst = Math.max(worst, Math.abs(r - want)); rings.add(want);
  }
  check(worst < 0.2 && rings.size === 7, `a cone: rings every 5 px from r = 5 to 35 (${rings.size} rings, worst ${worst.toFixed(3)} px off)`);
  // each ring is closed: every endpoint is shared by exactly two segments
  const ends = new Map();
  for (const [x1, y1, x2, y2] of s.filter(([x1, y1]) => Math.hypot(x1 - cx, y1 - cy) < 37)) for (const k of [`${x1.toFixed(4)},${y1.toFixed(4)}`, `${x2.toFixed(4)},${y2.toFixed(4)}`]) ends.set(k, (ends.get(k) || 0) + 1);
  check(ends.size > 100 && [...ends.values()].every(n => n === 2), 'and closed: every end meets exactly one other');
  // a saddle in the middle of cell (10, 10): h = s0 + 40 (x − 10.5)(y − 10.5), which smoothing leaves alone. Its corners
  // are s0 ± 10; the 100 m line must join the high corners (top-left, bottom-right) through the cell when the saddle
  // is above 100 m (s0 = 103), and cut them off when it is below (s0 = 97)
  const saddle = s0 => {
    const q = segs(G.contours(grid(21, 21, (x, y) => s0 + 40 * (x - 10.5) * (y - 10.5)), 21, 21, 20));
    const inCell = q.filter(([x1, y1, x2, y2]) => Math.min(x1, x2, y1, y2) >= 10 && Math.max(x1, x2, y1, y2) <= 11);
    const side = (x, y) => y === 10 ? 'T' : x === 11 ? 'R' : y === 11 ? 'B' : 'L';
    return inCell.map(([x1, y1, x2, y2]) => [side(x1, y1), side(x2, y2)].sort().join('')).sort().join(' ');
  };
  check(saddle(103) === 'BL RT', `a saddle above the line joins the high corners (${saddle(103)})`);
  check(saddle(97) === 'BR LT', `and one below it cuts them off (${saddle(97)})`);
  // a window cut from a bigger grid, with a 2 px margin, draws exactly the same lines inside it
  const big = grid(96, 96, (x, y) => 600 + 80 * Math.sin(x / 9) * Math.cos(y / 13) + 3 * x);
  const all = segs(G.contours(big, 96, 96, 20)), x0 = 30, y0 = 22, ww = 36;
  const win = new Float32Array(ww * ww); for (let y = 0; y < ww; y++) for (let x = 0; x < ww; x++) win[y * ww + x] = big[(y + y0) * 96 + x + x0];
  const key = ([a, b, cc, d]) => [a, b, cc, d].map(v => v.toFixed(4)).join(',');
  const inner = q => q[0] >= x0 + 2 && q[2] >= x0 + 2 && q[1] >= y0 + 2 && q[3] >= y0 + 2 && q[0] <= x0 + ww - 3 && q[2] <= x0 + ww - 3 && q[1] <= y0 + ww - 3 && q[3] <= y0 + ww - 3;
  const fromAll = new Set(all.filter(inner).map(key));
  const fromWin = new Set(segs(G.contours(win, ww, ww, 20)).map(q => [q[0] + x0, q[1] + y0, q[2] + x0, q[3] + y0]).filter(inner).map(key));
  check(fromAll.size > 50 && fromAll.size === fromWin.size && [...fromAll].every(k => fromWin.has(k)), `a window matches the whole grid inside its 2 px margin (${fromWin.size} segments)`);
  const hole = grid(16, 16, x => 30 * x); hole[8 * 16 + 8] = NaN;
  const hs = segs(G.contours(hole, 16, 16, 20));
  check(hs.length > 0 && hs.every(q => [[q[0], q[1]], [q[2], q[3]]].every(([x, y]) => !(x > 6 && x < 10 && y > 6 && y < 10))), 'no lines in the cells round a missing height');
  // the sight ring for the 3D map: every point r metres from the centre (haversine), closed
  const hav = (a, b) => { const R = 6371008.8, r = Math.PI / 180, dl = (b[0] - a[0]) * r, dn = (b[1] - a[1]) * r;
    const h = Math.sin(dl / 2) ** 2 + Math.cos(a[0] * r) * Math.cos(b[0] * r) * Math.sin(dn / 2) ** 2; return 2 * R * Math.asin(Math.sqrt(h)); };
  const ringPts = G.circle(44.09, -103.25, 600, 64);
  const ringErr = Math.max(...ringPts.map(p => Math.abs(hav([44.09, -103.25], p) - 600)));
  check(ringPts.length === 65 && ringPts[0][0] === ringPts[64][0] && ringPts[0][1] === ringPts[64][1], 'the sight ring for the 3D map is closed');
  check(ringErr < 0.5, `and every point on it is 600 m out (worst ${ringErr.toFixed(3)} m off)`);
  // the fly-by's 2 m model sailplane: mirror-symmetric, normals unit length and pointing out, every index in range
  const gm = G.gliderMesh(), nv = gm.pos.length / 3;
  let gBad = 0, gx = [Infinity, -Infinity], gz = [Infinity, -Infinity];
  for (let i = 0; i < nv; i++) {
    const l = Math.hypot(gm.nrm[3 * i], gm.nrm[3 * i + 1], gm.nrm[3 * i + 2]); if (!(Math.abs(l - 1) < 1e-4)) gBad++;
    gx = [Math.min(gx[0], gm.pos[3 * i]), Math.max(gx[1], gm.pos[3 * i])]; gz = [Math.min(gz[0], gm.pos[3 * i + 2]), Math.max(gz[1], gm.pos[3 * i + 2])];
  }
  const key3 = (i, sx) => [sx * gm.pos[3 * i], gm.pos[3 * i + 1], gm.pos[3 * i + 2]].map(v => Math.round(v * 1e4) + 0).join();
  const mirror = new Set(); for (let i = 0; i < nv; i++) mirror.add(key3(i, 1));
  let unmatched = 0; for (let i = 0; i < nv; i++) if (!mirror.has(key3(i, -1))) unmatched++;
  check(nv < 65536 && gm.idx.every(i => i < nv) && gm.idx.length % 3 === 0, `the glider mesh: ${nv} vertices, ${gm.idx.length / 3} triangles, indices in range`);
  check(Math.abs(gx[1] - gx[0] - 2) < 0.01 && Math.abs(gx[0] + gx[1]) < 1e-6 && gz[1] - gz[0] > 1.1 && gz[1] - gz[0] < 1.25,
    `a 2 m span (${(gx[1] - gx[0]).toFixed(3)} m), ${(gz[1] - gz[0]).toFixed(2)} m long, centred`);
  check(gBad === 0 && unmatched === 0, `unit normals (${gBad} bad) and mirror-symmetric (${unmatched} vertices without a mirror image)`);
  // outward: at each wing station the highest point faces up and the lowest down; the fuselage's widest points face out sideways
  const stations = new Map();
  for (let i = 0; i < nv; i++) {
    const x = gm.pos[3 * i]; if (Math.abs(x) < 0.15 || Math.abs(x) > 0.9) continue; // the wings, clear of the fuselage and the tips
    const k = x.toFixed(4), y = gm.pos[3 * i + 1], s0 = stations.get(k) || { top: null, bot: null };
    if (!s0.top || y > gm.pos[3 * s0.top + 1]) s0.top = i;
    if (!s0.bot || y < gm.pos[3 * s0.bot + 1]) s0.bot = i;
    stations.set(k, s0);
  }
  let up = 0, upOk = 0, side = 0, sideOk = 0;
  for (const { top, bot } of stations.values()) { up += 2; if (gm.nrm[3 * top + 1] > 0.7) upOk++; if (gm.nrm[3 * bot + 1] < -0.7) upOk++; }
  for (let i = 0; i < nv; i++) {
    const [x, y, z] = [gm.pos[3 * i], gm.pos[3 * i + 1], gm.pos[3 * i + 2]], nx = gm.nrm[3 * i];
    if (z > -0.4 && z < -0.05 && Math.abs(x) > 0.012 && Math.abs(x) < 0.04 && Math.abs(y) < 0.004) { side++; if (nx * Math.sign(x) > 0.8) sideOk++; }
  }
  check(up > 10 && upOk === up && side > 4 && sideOk === side, `normals point out: wing tops up and bottoms down (${upOk}/${up}), fuselage sides out (${sideOk}/${side})`);
  const st = z => G.contourStep(z, 'metric')[0], sti = z => Math.round(G.contourStep(z, 'imperial')[0] * G.FT);
  check([9, 10, 11, 12, 13, 14, 17].map(st).join() === '200,200,100,50,20,10,10', `metric spacing by zoom: ${[9, 10, 11, 12, 13, 14, 17].map(st).join(', ')} m`);
  check([10, 11, 12, 13, 14].map(sti).join() === '500,250,200,80,40', `imperial: ${[10, 11, 12, 13, 14].map(sti).join(', ')} ft`);
}

console.log('6c. plan values, serialization and destination diagnosis');
{
  const GP = require('../glide-path/glide-plan.js');
  const throws = fn => { try { fn(); return false; } catch { return true; } };
  const p = GP.parameters({ gr: 17.3, va: 11.27, agl: 123.456, ws: 2.15, vis: 777, mg: 23.4, sl: 11.5, wd: -10, pb: 721, curve: true });
  const before = JSON.stringify(p);
  for (const k of Object.keys(GP.SPEC)) for (const unit of ['metric', 'imperial']) {
    const displayed = GP.display(k, p[k], unit), recovered = GP.inputValue(k, displayed, unit);
    check(Math.abs(recovered - p[k]) <= 0.00051 / GP.factor(k, unit), `${k} numeric display round trip (${unit})`);
  }
  check(JSON.stringify(p) === before, 'rendering either unit system never mutates SI flight values');
  check(p.wd === 350 && p.pb === 1, 'numeric bearings wrap through north');
  check(throws(() => GP.inputValue('va', NaN, 'metric')) && throws(() => GP.inputValue('gr', 0, 'metric')), 'invalid exact values rejected');
  // A legacy imperial value can be outside the metric slider's visual limits; opening the page preserves it.
  near(GP.parameters({ agl: 1000 / G.FT }).agl, 1000 / G.FT, 1e-12, 'imperial max remains intact');
  const plan = { version: 1, launch: { lat: 44.08, lon: -103.25 }, params: p, target: { lat: 44.081, lon: -103.249 }, units: 'imperial' };
  const restored = GP.decode(GP.encode(plan));
  check(GP.samePlan(plan, restored) && restored.units === 'imperial', 'shared links preserve launch, all settings, destination and display units');
  check(GP.samePlan(plan, { ...restored, units: 'metric' }), 'changing display units is not an edited flight plan');
  check(!GP.samePlan(plan, { ...restored, target: null }), 'clearing the destination changes a plan');
  check(!GP.samePlan(plan, { ...restored, launch: { lat: 44.09, lon: -103.25 } }), 'moving the launch changes a plan');
  check(GP.differences(p, { ...p, ws: p.ws + 1 }).join() === 'ws', 'changed settings identify the modified field');
  check(throws(() => GP.decode('%broken')) && throws(() => GP.decode('x'.repeat(12001))) && throws(() => GP.encode({ ...plan, version: 2 })), 'malformed, oversized and unsupported plans rejected');
  check(throws(() => GP.encode({ ...plan, launch: { lat: 90, lon: 0 } })) && throws(() => GP.encode({ ...plan, params: { ...p, va: Infinity } })), 'invalid coordinates and model values rejected');
  check(JSON.stringify(GP.aircraft(p)) === JSON.stringify({ gr: p.gr, va: p.va, vis: p.vis }), 'aircraft preset only includes aircraft parameters');
  const params = GP.parameters({ agl: 120, vis: 1000 }), W = 11, cell = 20, terr = new Float32Array(W * W);
  const result = G.reachGrid({ cell, si: 5, sj: 5, h0: 120, margin: params.mg, Va: params.va, GR: params.gr, windSpeed: 0, windFromDeg: 0, maxR: params.vis }, terr, W, W);
  const input = { params, grid: { terr, GW: W, cell }, result, index: 5 * W + 8, distance: 60, bearing: Math.PI / 2, ground: 0, slope: 4 };
  const info = GP.inspect(input);
  check(info.reachable && info.potential && info.kind === 'potential', 'reachable ground within the slope limit is potential landing ground');
  near(info.arrival, 116, 1e-4, 'destination arrival AGL');
  near(info.routeDistance, 60, 1e-4, 'route distance');
  near(info.clearance, 116, 1e-4, 'minimum clearance on the path');
  check(GP.inspect({ ...input, slope: NaN }).kind === 'slope', 'missing slope is distinct from steep ground');
  check(GP.inspect({ ...input, slope: 20 }).kind === 'steep', 'steep destinations keep route and arrival information');
  check(GP.inspect({ ...input, distance: 1001 }).kind === 'sight', 'destination beyond sight gets a specific reason');
  check(GP.inspect({ ...input, ground: NaN }).kind === 'missing', 'missing destination terrain is explicit');
  check(GP.inspect({ ...input, result: null }).kind === 'pending', 'old or absent search results show a pending diagnosis');
  const blocked = { ...result, alt: new Float32Array(W * W).fill(-Infinity) };
  check(GP.inspect({ ...input, result: blocked }).kind === 'blocked', 'terrain/clearance failure diagnosed');
  check(GP.inspect({ ...input, result: blocked, missing: true }).kind === 'incomplete', 'missing coverage is distinguished from blocked terrain');
  check(GP.inspect({ ...input, result: blocked, params: { ...params, ws: 15, wd: 90 } }).kind === 'wind', 'wind with no forward progress diagnosed');
  const rays = G.castRays({ ...base, h0: 120 }, flat); rays.h0 = 120;
  const direct = GP.inspect({ ...input, params: { ...params, curve: false }, rays });
  check(direct.reachable && !direct.cells.length && direct.routeDistance === 60, 'straight-only inspection works without a route search');
  near(direct.arrival, 116, 1e-4, 'straight-only arrival AGL');
  const heights = new Float32Array(W * W).fill(100), ground = new Float32Array(W * W);
  heights[5 * W + 5] = 120; ground[5 * W + 6] = 89;
  const intermediate = GP.routeStats([5 * W + 5, 6 * W + 7], heights, ground, W, 20);
  near(intermediate.clearance, 21, 1e-6, 'minimum clearance includes terrain crossed between knight-move endpoints');
}

console.log('6d. lee-ridge screening and local model wind');
{
  const S = require('../glide-path/soaring-core.js'), W=121, cell=10, mid=60;
  const make = fn => Float32Array.from({length:W*W},(_,i)=>fn((i%W-mid)*cell,(Math.floor(i/W)-mid)*cell));
  const o={cell,si:mid,sj:mid,maxR:450,windSpeed:8,windFromDeg:270};
  const ridge=make(x=>200-Math.abs(x)*(x<0?.12:.6));
  const found=S.scan(o,ridge,W);
  check(found.state==='candidates' && found.candidates.length>0,'sharp crest with an exposed rise and steep lee is a candidate');
  check(found.candidates.every(c=>c.distance<=450 && c.rise>=15 && c.drop>=15 && c.leeAngle>=8),'candidate evidence satisfies stated geometry thresholds inside sight');
  check(found.candidates.every((a,i)=>found.candidates.slice(i+1).every(b=>Math.hypot(a.x-b.x,a.y-b.y)*cell>=160)),'neighbouring crest cells become separated sites, not a cloud of duplicate pins');
  check(S.scan({...o,windFromDeg:90},ridge,W).state==='none','reversing wind rejects this ridge because its new lee is too shallow');
  check(S.scan({...o,windFromDeg:0},ridge,W).state==='none','wind along the ridge does not produce a cross-ridge candidate');
  check(S.scan(o,make(()=>100),W).state==='none','flat ground never qualifies');
  check(S.scan(o,make(x=>100+x*.4),W).state==='none','a slope without a crest never qualifies');
  check(S.scan({...o,windSpeed:0},ridge,W).state==='calm','calm air has no directional lee-side inference');
  check(S.scan({...o,cell:55},ridge,W).state==='coarse','coarse terrain does not assert fine ridge geometry');
  check(S.scan(o,make(()=>NaN),W).state==='missing','missing terrain is reported and cannot qualify');
  const gap=ridge.slice();for(let y=0;y<W;y++)for(let x=mid-1;x<=mid+1;x++)gap[y*W+x]=NaN;
  check(!S.scan(o,gap,W).candidates.length,'missing crest cells cannot be interpolated into a candidate');
  const p=S.section(found.candidates[0],ridge,W,W,cell);
  check(p.d.length===p.ground.length && p.d.every((d,i)=>!i||d>p.d[i-1]),'wind-aligned profile has an ordered distance axis');
  check(p.xy[0][0]<p.xy.at(-1)[0] && Math.abs(p.xy[0][1]-p.xy.at(-1)[1])<1e-6,'westerly wind profile runs west to east, upwind to lee');
  const peak=Math.max(...p.ground);check(Math.abs(peak-found.candidates[0].height)<2,'the profile crosses the selected crest');
  const before=Array.from(ridge);S.scan(o,ridge,W);check(before.every((v,i)=>v===ridge[i]),'screening leaves the glide terrain unchanged');
  const a=S.flow(0),b=S.flow(90);check(Math.abs(a.x)<1e-8 && a.y===1 && b.x===-1 && Math.abs(b.y)<1e-8,'meteorological FROM bearings produce south/west flow in grid rows');
  const url=new URL(S.windURL(44.077964,-103.245844));check(url.searchParams.get('wind_speed_unit')==='ms' && url.searchParams.get('timeformat')==='unixtime' && url.searchParams.get('current').includes('wind_speed_10m'),'forecast request explicitly selects SI wind, 10 m height and UTC time');
  const now=1794622500000,data={current_units:{time:'unixtime',wind_speed_10m:'m/s',wind_direction_10m:'°',wind_gusts_10m:'m/s'},current:{time:now/1000,wind_speed_10m:8.2,wind_direction_10m:270,wind_gusts_10m:11.3}};
  const wind=S.parseWind(data,now);check(wind.speed===8.2 && wind.from===270 && wind.gust===11.3 && wind.time===now,'forecast parser preserves mean, FROM direction, gust and valid time separately');
  const bad=fn=>{try{fn();return false;}catch{return true;}};
  check(bad(()=>S.parseWind({...data,current_units:{...data.current_units,wind_speed_10m:'km/h'}},now)),'unexpected provider units are rejected');
  check(bad(()=>S.parseWind({...data,current:{...data.current,wind_speed_10m:null}},now)),'missing mean wind is not interpreted as calm');
  check(bad(()=>S.parseWind(data,now+3*3600000)) && bad(()=>S.parseWind(data,now-3600000)),'old or implausibly future wind cannot replace current manual wind');
  let screenReply;
  const ctx={SoaringCore:S,GlideCore:G,Float32Array,Int32Array,performance,importScripts(){},postMessage(m){screenReply=m;}};
  vm.createContext(ctx);vm.runInContext(fs.readFileSync(path.join(__dirname,'../glide-path/glide-worker.js'),'utf8'),ctx);
  ctx.onmessage({data:{screenGrid:{id:4,terr:ridge,W}}});ctx.onmessage({data:{screen:{...o,key:'first'},screenGridId:4}});
  check(screenReply.screen && screenReply.key==='first' && screenReply.result.candidates.length>0,'worker returns independent ridge-screen results tagged with their parameter key');
  ctx.onmessage({data:{screen:{...o,key:'old'},screenGridId:3}});check(screenReply.result.state==='stale','a stale terrain job still replies so the UI queue can advance');
  const siteData=JSON.parse(require('child_process').execFileSync('ruby',['-ryaml','-rjson','-e',"puts JSON.generate(YAML.safe_load_file('_data/glide.yml'))"],{cwd:path.join(__dirname,'..'),encoding:'utf8'}));
  check(siteData.name==='Dyna-soar' && siteData.landmark.lat===44.077964 && siteData.landmark.lon===-103.245844,'Dyna-soar defaults to the surveyed Dinosaur Park statue coordinates');
}

console.log('6e. mass-consistent terrain wind and spatial glide integration');
{
 const W=require('../glide-path/wind-core.js'),nx=32,cell=20,centre=(nx-1)/2;
 const terrain=fn=>Float32Array.from({length:nx*nx},(_,i)=>fn((i%nx-centre)*cell,(Math.floor(i/nx)-centre)*cell));
 const options={nx,ny:nx,cell,x0:-nx*cell/2,y0:nx*cell/2,lat:44,lon:-103,height:30,roughness:.03,fallback:{east:6,north:0},terrain:terrain(()=>100)};
 const flat=W.solve(options),flatAt=W.at(flat,0,0,30);
 near(flatAt.up,0,1e-6,'flat terrain has no inferred vertical air');
 check(flat.diagnostics.divergence<1e-7 && flat.diagnostics.converged,'flat uniform wind already satisfies mass conservation');
 const samples=[{lat:44,lon:-103.1,speed:6,from:359,time:1},{lat:44,lon:-102.9,speed:6,from:1,time:1}];
 const v=W.regional(W.anchors(samples),44,-103,10,.03);check(v.north< -5.9&&Math.abs(v.east)<1e-8,'regional bearings interpolate across north as vectors, not 180 degrees');
 const h=W.regional(W.anchors([{...samples[0],speed80:12,from80:270}]),44,-103.1,80,.03);near(h.east,12,1e-8,'80 m forecast is retained as a separate wind layer');
 const hill=terrain(x=>100+35*Math.exp(-1*(x/100)**2)),before=Array.from(hill),t=performance.now();
 const f=W.solve({...options,terrain:hill}),elapsed=performance.now()-t;
 check(f.state==='terrain'&&f.diagnostics.converged&&f.diagnostics.divergence<f.diagnostics.initialDivergence*.025,'ridge solve reduces divergence by at least 97.5%');
 const up=W.at(f,-100,0,30),lee=W.at(f,100,0,30),crest=W.at(f,0,0,30);
 check(up.up>.2&&lee.up<-.2,'ridge gives upflow on its windward side and downflow on its lee');
 check(crest.east>flatAt.east,'terrain produces crest speed-up');
 const reversed=W.solve({...options,terrain:hill,fallback:{east:-6,north:0}});
 check(W.at(reversed,-100,0,30).up<-.2&&W.at(reversed,100,0,30).up>.2,'reversing the ambient wind reverses lift and sink sides');
 check(before.every((v,i)=>v===hill[i]),'terrain solve does not mutate source heights');
 const missing=hill.slice();missing[100]=NaN;const failedField=W.solve({...options,terrain:missing});
 check(failedField.state==='missing'&&!failedField.east,'missing terrain cannot invent local flow');
 const outside=W.at(f,100000,0,30);check(outside.mode==='regional'&&outside.up===0,'outside terrain-model bounds falls back explicitly to regional horizontal wind');
 const layer=W.compact(f),poison={...layer,up:new Float32Array(nx*nx).fill(100)};
 const baseRun={cell,si:16,sj:16,h0:220,margin:20,Va:10,GR:15,windSpeed:0,windFromDeg:0,maxR:250};
 const a=G.reachGrid({...baseRun,wind:layer},new Float32Array(nx*nx),nx,nx),b=G.reachGrid({...baseRun,wind:poison},new Float32Array(nx*nx),nx,nx);
 check(a.alt.every((v,i)=>v===b.alt[i]),'arbitrary vertical air never extends reach: route search uses horizontal wind only');
 const rayOptions={n:8,h0:220,margin:20,Va:10,GR:15,windSpeed:0,windFromDeg:0,ds:2,maxD:7000};
 const uniformWind={east:5,north:0},uniform=G.castRays({...rayOptions,windSpeed:5,windFromDeg:270},()=>0),spatial=G.castRays({...rayOptions,windAt:()=>uniformWind},()=>0);
 check(spatial.dmax.every((v,i)=>Math.abs(v-uniform.dmax[i])<=2),'constant spatial vectors reproduce legacy uniform ray reaches');
 const split=G.castRays({...rayOptions,windAt:(e)=>({east:e<500?5:-5,north:0})},()=>0);
 near(G.reachAltitude(split,Math.PI/2,1000),220-500/(15*1.5)-500/(15*.5),.01,'straight arrival integrates changing headwind/tailwind over the path');
 const profile=G.glideAlong({...rayOptions,windAt:(e)=>({east:e<500?5:-5,north:0})},()=>0,Math.PI/2);
 const k=profile.d.indexOf(1000);near(profile.glide[k],G.reachAltitude(split,Math.PI/2,1000),.001,'profile and ray arrival share the same spatial wind integration');
 const stop=G.castRays({...rayOptions,windAt:e=>({east:e<500?5:-15,north:0})},()=>0);check(stop.kind[2]===2&&stop.dmax[2]<=502,'unflyable wind later in a track stops that ray');
 const gc={nx:2,ny:2,cell:10000,x0:-5000,y0:5000,height:10,east:new Float32Array(4).fill(5),north:new Float32Array(4),samples:[],roughness:.03,fallback:{east:5,north:0},lat:44,lon:-103};
 const r0=G.reachGrid({...baseRun,windSpeed:5,windFromDeg:270},new Float32Array(nx*nx),nx,nx),r1=G.reachGrid({...baseRun,wind:gc},new Float32Array(nx*nx),nx,nx);
 check(r0.alt.every((v,i)=>v===r1.alt[i]),'constant gridded wind reproduces the uniform route search');
 const gp=require('../glide-path/glide-plan.js'),plan={version:1,launch:{lat:44,lon:-103},params:gp.parameters(),target:null,units:'metric',windModel:{enabled:true,height:80,roughness:.3,samples:W.anchors(samples)}};
 check(gp.samePlan(plan,gp.decode(gp.encode(plan))),'saved/shared plans preserve wind-model settings and forecast anchors');
 check(!gp.samePlan(plan,{...plan,windModel:{...plan.windModel,height:30}}),'changing the assumed wind layer marks a plan changed');
 const legacy=gp.validatePlan({...plan,windModel:undefined});check(legacy.windModel.enabled===false,'legacy plans retain their original uniform wind assumption');
 check(elapsed<2500,`ridge solve runs off-thread in a bounded time (${elapsed.toFixed(0)} ms for 32×32×24)`);
}

console.log('7. service worker');
(async () => {
  // Minimal Cache Storage, fetch and service-worker globals, enough for sw.js.
  const stores = new Map();
  const keyOf = r => (typeof r === 'string' ? new URL(r, 'https://tsmorz.github.io/glide-path/sw.js').href : r.url);
  const mkCache = () => { const m = new Map(); return {
    match: async r => m.get(keyOf(r)), put: async (r, res) => { m.set(keyOf(r), res); },
    delete: async r => m.delete(keyOf(r)), keys: async () => [...m.keys()].map(url => ({ url })), addAll: async urls => { for (const u of urls) m.set(keyOf(u), resp('shell:' + u)); }, size: () => m.size, _m: m }; };
  const caches = { open: async n => { if (!stores.has(n)) stores.set(n, mkCache()); return stores.get(n); },
    keys: async () => [...stores.keys()], delete: async n => stores.delete(n) };
  function resp(body, ok = true) { return { ok, body, clone() { return resp(body, ok); } }; }
  let net = 'up', calls = [];
  const fetchMock = async req => { const u = keyOf(req); calls.push(u);
    if (net === 'down') throw new TypeError('offline');
    if (net === 'stall') return new Promise(() => {});
    return resp('net:' + u); };
  const handlers = {};
  const ctx = { self: null, caches, fetch: fetchMock, URL, setTimeout, Promise, console,
    location: new URL('https://tsmorz.github.io/glide-path/sw.js') };
  ctx.self = { addEventListener: (t, f) => { handlers[t] = f; }, skipWaiting: () => {}, clients: { claim: () => {} } };
  vm.createContext(ctx);
  vm.runInContext(fs.readFileSync(path.join(__dirname, '..', 'glide-path/sw.js'), 'utf8'), ctx);
  const run = async (t, ev) => { let p; ev.waitUntil = x => { p = x; }; ev.respondWith = x => { p = x; }; handlers[t](ev); return p; };
  const get = (url, mode = 'cors') => run('fetch', { request: { url, method: 'GET', mode } });

  await run('install', {});
  check((await caches.open('glide-shell-' + vm.runInContext('VERSION', ctx))).size() === 26, 'install caches the page, its script and styles, the core, the planning logic, the worker, the 3D view, the manifest, icons, Leaflet and MapLibre');
  let verification;
  await run('message', { data: { type: 'verify-shell' }, ports: [{ postMessage: r => { verification = r; } }] });
  check(verification.present === 26 && verification.total === 26, 'offline verification checks every installed page file');
  const shellCache = await caches.open('glide-shell-' + vm.runInContext('VERSION', ctx));
  await shellCache.delete('glide-plan.js');
  await run('message', { data: { type: 'verify-shell' }, ports: [{ postMessage: r => { verification = r; } }] });
  check(verification.present === 25 && verification.total === 26, 'verification detects an evicted planning script');
  await shellCache.put('glide-plan.js', resp('shell:glide-plan.js'));
  const shellFiles = vm.runInContext('SHELL_FILES', ctx).filter(f => f !== './');
  const missing = shellFiles.filter(f => !fs.existsSync(path.join(__dirname, '..', 'glide-path', f)));
  check(!missing.length, `every file in SHELL_FILES exists${missing.length ? ' (missing: ' + missing.join(', ') + ')' : ''}`);
  stores.set('glide-shell-v0', mkCache());
  await run('activate', {});
  check(!stores.has('glide-shell-v0'), 'activate drops an old version of the page');

  const tile = n => `https://s3.amazonaws.com/elevation-tiles-prod/terrarium/13/1746/${n}.png`;
  let r = await get(tile(1));
  check(r.body === 'net:' + tile(1) && (await (await caches.open('glide-terrain-runtime')).match(tile(1))), 'a terrain tile seen online is kept');
  net = 'down';
  r = await get(tile(1));
  check(r && r.body === 'net:' + tile(1), 'and served offline');
  await (await caches.open('glide-terrain-saved')).put(tile(2), resp('saved'));
  r = await get(tile(2));
  check(r && r.body === 'saved', 'a tile from a saved area is served offline');
  let threw = false; try { await get(tile(3)); } catch (e) { threw = true; }
  check(threw, 'an unsaved tile offline fails (the page then says the area is not saved)');

  net = 'up';
  const rt = await caches.open('glide-terrain-runtime');
  for (let i = 0; i < 640; i++) await get(tile(100 + i));
  await new Promise(res => setTimeout(res, 50));
  check(rt.size() <= 600 && !(await rt.match(tile(100))) && (await rt.match(tile(739))), `the recent-tile cache stays at 600, oldest dropped first (${rt.size()})`);

  net = 'down';
  r = await get('https://tsmorz.github.io/glide-path/', 'navigate');
  check(r && r.body.startsWith('shell:'), 'the page opens offline');
  r = await get('https://tsmorz.github.io/glide-path/?from=homescreen', 'navigate');
  check(r && r.body.startsWith('shell:'), 'with a query string too');
  net = 'stall';
  const t0 = Date.now();
  r = await get('https://tsmorz.github.io/glide-path/lib/leaflet/leaflet.js');
  check(r && r.body.startsWith('shell:') && Date.now() - t0 < 3500, `a stalled network falls back to the cached copy after ~3 s (${Date.now() - t0} ms)`);
  net = 'up';
  check(await get('https://tile.openstreetmap.org/13/1746/2975.png') === undefined, 'street-map tiles are not intercepted');
  check(await get('https://tsmorz.github.io/recipes/', 'navigate') === undefined, 'nor the rest of the site');

  console.log('8. the old address (/glide-reach/)');
  {
    // its sw.js replaces the service worker installed there before the move: it unregisters, sends open tabs to
    // /glide-path/ and deletes no caches (the terrain is shared with the new page)
    const h = {}, went = [];
    let unreg = 0, deleted = 0;
    const tabs = [{ url: 'https://tsmorz.github.io/glide-reach/?lat=44.1#map', navigate: async u => { went.push(u); } }];
    const c2 = { URL, Promise, console,
      caches: { delete: async () => { deleted++; }, keys: async () => ['glide-terrain-saved'] },
      self: { addEventListener: (ty, f) => { h[ty] = f; }, skipWaiting: () => {},
              registration: { unregister: async () => { unreg++; return true; } },
              clients: { matchAll: async () => tabs, claim: async () => {} } } };
    vm.createContext(c2);
    vm.runInContext(fs.readFileSync(path.join(__dirname, '..', 'glide-reach/sw.js'), 'utf8'), c2);
    let p; h.install({ waitUntil: x => { p = x; } }); await p;
    p = null; h.activate({ waitUntil: x => { p = x; } }); await p;
    check(unreg === 1, 'the old service worker unregisters itself');
    check(went.length === 1 && went[0] === 'https://tsmorz.github.io/glide-path/?lat=44.1#map', `and sends open tabs to the new address (${went[0]})`);
    check(deleted === 0 && !h.fetch, 'without deleting caches or answering requests');
    const redirect = fs.readFileSync(path.join(__dirname, '..', 'glide-reach/index.html'), 'utf8');
    check(redirect.includes('location.replace("/glide-path/" + location.search + location.hash)'), 'its index.html redirects, keeping query and hash');
  }

  if (failed) { console.log('\nFAILED'); process.exit(1); }
  console.log('\nAll glide-path checks passed.');
})();
