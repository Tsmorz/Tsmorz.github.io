#!/usr/bin/env node
// Check the maths behind /glide-path/ (glide-path/glide-core.js), in Node.
//   1. still air on flat ground: every direction reaches (start height − margin) × L/D
//   2. wind: downwind, upwind and crosswind ground glide ratios; tracks that can't be flown
//   3. terrain: a ridge stops the glide where the path minus the margin meets it; a low ridge is cleared
//   4. reachAt agrees with the rays
//   5. map maths: pixel ↔ lon/lat round trip, metres per pixel, Terrarium decoding
//   6. saved areas: the tile list per zoom, and deleting keeps tiles another area still uses
//   6b. contours: a plane, a cone (closed rings), a saddle either side of the line, a window against the whole grid, missing heights, spacing
//   7. the service worker (sw.js) in a mock: terrain from saved/recent caches offline, the recent cache capped,
//      the page from cache offline or on a stalled network, street-map tiles left alone
//   8. the old address: /glide-reach/ redirects, and its sw.js retires the old service worker
const path = require('path');
const fs = require('fs');
const vm = require('vm');
const G = require(path.join(__dirname, '..', 'glide-path/glide-core.js'));
let failed = false;
function check(ok, msg) { console.log((ok ? '  ok   ' : '  FAIL ') + msg); if (!ok) failed = true; }
function near(got, want, tol, label) { check(Math.abs(got - want) <= tol, `${label}: ${got.toFixed(2)} (wanted ${want} ± ${tol})`); }
const E = 90 * 2, W = 270 * 2, N = 0; // ray index for 720 rays

const base = { n: 720, h0: 220, margin: 20, Va: 10, GR: 15, windSpeed: 0, windFromDeg: 270, ds: 5, maxD: 20000 };
const flat = () => 0;

console.log('1. still air, flat ground');
let R = G.castRays(base, flat);
near(R.dmax[N], 3000, 5, 'north reach = 200 m × 15');
near(R.dmax[E], 3000, 5, 'east reach');
check([...R.kind].every(k => k === 0), 'every ray ends on the ground');
near(R.grg[E], 15, 1e-6, 'ground glide ratio = L/D in still air');

console.log('2. wind');
R = G.castRays({ ...base, windSpeed: 5, windFromDeg: 270 }, flat); // from the west, blowing east
near(R.dmax[E], 4500, 5, 'downwind: (10 + 5)/(10/15) × 200');
near(R.dmax[W], 1500, 5, 'upwind: (10 − 5)/(10/15) × 200');
near(R.dmax[N], Math.sqrt(75) / (10 / 15) * 200, 5, 'crosswind: crab angle costs ground speed');
R = G.castRays({ ...base, windSpeed: 12, windFromDeg: 270 }, flat);
check(R.kind[W] === 2 && R.dmax[W] === 0, 'wind faster than the glider: upwind is not flyable');
check(R.kind[E] === 0 && R.dmax[E] > 6000, 'and downwind goes further');
near(G.groundSpeed(Math.PI / 2, 10, 5, 0), Math.sqrt(75), 1e-9, 'groundSpeed: 5 m/s from the north on an east track');

console.log('3. terrain');
const ridge = h => (e) => (e > 1500 && e < 1700 ? h : 0);
R = G.castRays(base, ridge(300));
near(R.dmax[E], 1500, 5, 'a 300 m ridge 1.5 km east stops the glide at its face');
near(R.dmax[W], 3000, 5, 'the other way is unaffected');
R = G.castRays(base, ridge(100));
near(R.dmax[E], 1500, 5, 'a 100 m ridge: path − margin is exactly 100 m there, so it stops');
R = G.castRays(base, ridge(80));
near(R.dmax[E], 3000, 5, 'an 80 m ridge is cleared');
R = G.castRays({ ...base, maxD: 1000 }, (e, n) => (Math.hypot(e, n) > 800 ? NaN : 0));
check(R.kind[E] === 1 && R.dmax[E] <= 800, 'running off the terrain data is flagged, not counted as a landing');

console.log('4. reachAt');
R = G.castRays(base, flat);
check(G.reachAt(R, Math.PI / 2, 2000) > 0, '2 km east is reachable');
check(!G.reachAt(R, Math.PI / 2, 3500), '3.5 km east is not');
R = G.castRays(base, ridge(300));
check(!G.reachAt(R, Math.PI / 2, 2500), 'behind the ridge is not');

console.log('4b. route search round terrain (reachGrid)');
{
  const cell = 20, W = 500, c = 250; // 10 km × 10 km grid, launch in the middle
  const grid = f => { const t = new Float32Array(W * W); for (let j = 0; j < W; j++) for (let i = 0; i < W; i++) t[j * W + i] = f((i - c) * cell, (c - j) * cell); return t; };
  const run = (terr, extra = {}) => G.reachGrid({ cell, si: c, sj: c, h0: 220, margin: 20, Va: 10, GR: 15, windSpeed: 0, windFromDeg: 270, ...extra }, terr, W, W);
  const at = (r, e, n) => r.alt[(c - Math.round(n / cell)) * W + c + Math.round(e / cell)];
  const ok = v => v > -Infinity;
  let r = run(grid(() => 0));
  const dirs = [0, 13, 27, 45, 70, 90, 200, 300];
  check(dirs.every(d => ok(at(r, 2880 * Math.sin(d * Math.PI / 180), 2880 * Math.cos(d * Math.PI / 180)))), 'flat ground: 2.88 km is reachable in every direction (true reach 3 km)');
  check(dirs.every(d => !ok(at(r, 3060 * Math.sin(d * Math.PI / 180), 3060 * Math.cos(d * Math.PI / 180)))), 'and 3.06 km in none');
  near(at(r, 2000, 0), 220 - 2000 / 15, 1, 'height over a spot 2 km east is 220 − 2000/15');
  r = run(grid(() => 0), { windSpeed: 5 });
  check(ok(at(r, 4400, 0)) && !ok(at(r, 4600, 0)) && ok(at(r, -1440, 0)) && !ok(at(r, -1560, 0)), 'wind 5 m/s from the west: 4.5 km downwind, 1.5 km upwind, as the rays');
  // a 300 m wall 1 km east, with a 200 m gap to the south-east
  const wall = gap => (e, n) => (e >= 1000 && e < 1100 && !(gap && n > -1200 && n < -1000) ? 300 : 0);
  const behind = [1500, 0];
  const rays = G.castRays({ ...base, maxD: 4900 }, (e, n) => wall(true)(e, n));
  check(rays.dmax[E] < 1000, 'straight east, the wall stops the glide');
  r = run(grid(wall(true)));
  // shortest way round: to the gap's near corner, along it, then to the target; the grid may lose up to ~3% more
  const L = Math.hypot(1000, 1000) + 100 + Math.hypot(400, 1000), h = at(r, ...behind), best = 220 - L / 15, worst = 220 - 1.03 * L / 15;
  check(ok(h) && h <= best + 0.5 && h >= worst, `round the wall through the gap reaches 1.5 km east (${h.toFixed(1)} m; best possible ${best.toFixed(1)} m)`);
  const route = G.routeTo(r.parent, r.alt, (c - behind[1] / cell) * W + c + behind[0] / cell);
  const thru = route.some(i => { const e = (i % W - c) * cell, n = (c - Math.floor(i / W)) * cell; return e >= 1000 && e < 1100 && n > -1200 && n < -1000; });
  check(route[0] === c * W + c && thru, `the route starts at the launch and goes through the gap (${route.length} cells)`);
  let falls = true; for (let k = 1; k < route.length; k++) if (r.alt[route[k]] >= r.alt[route[k - 1]]) falls = false;
  check(falls, 'and loses height at every step');
  r = run(grid(wall(false)));
  check(!ok(at(r, ...behind)), 'with no gap, behind the wall stays out of reach');
  check(!r.edge, 'a reach that fits inside the grid is not flagged at the edge');
  r = G.reachGrid({ cell, si: 5, sj: 5, h0: 220, margin: 20, Va: 10, GR: 15, windSpeed: 0, windFromDeg: 0 }, new Float32Array(100), 10, 10);
  check(r.edge, 'one that runs off the grid is');
  const big = new Float32Array(896 * 896), t0 = Date.now();
  G.reachGrid({ cell: 27.4, si: 448, sj: 448, h0: 500, margin: 20, Va: 10, GR: 15, windSpeed: 0, windFromDeg: 0 }, big, 896, 896);
  const ms = Date.now() - t0;
  check(ms < 5000, `a full page-sized grid (896 × 896, all reachable) runs in ${ms} ms`);
}

console.log('4c. no height limit, line of sight and units');
{
  // a 100 m plateau that drops to a plain 200 m east of the launch; launch 120 m above the plateau
  const plateau = (e) => (e < 200 ? 100 : 0);
  const o = { ...base, h0: 220, maxD: 6000 };
  let R = G.castRays(o, plateau);
  near(R.dmax[E], 3000, 5, 'no height limit: 200 m of height × 15 = 3 km east, over the plain too');
  const prof = G.glideAlong(o, plateau, Math.PI / 2, 300);
  const high = Math.max(...prof.glide.map((h, k) => (h === h ? h - prof.ground[k] : 0)));
  check(high > 200 && prof.kind === 0 && Math.abs(prof.d[prof.end] - R.dmax[E]) <= 5,
    `glideAlong agrees with the rays and keeps its height over low ground (${high.toFixed(0)} m above it, no cap)`);
  const W2 = 500, c = 250, cell = 20, terr = new Float32Array(W2 * W2);
  for (let j = 0; j < W2; j++) for (let i = 0; i < W2; i++) terr[j * W2 + i] = plateau((i - c) * cell);
  const run = extra => G.reachGrid({ cell, si: c, sj: c, h0: 220, margin: 20, Va: 10, GR: 15, windSpeed: 0, windFromDeg: 0, ...extra }, terr, W2, W2);
  const reachE = r => { let i = c; while (i + 1 < W2 && r.alt[c * W2 + i + 1] > -Infinity) i++; return (i - c) * cell; };
  const gFree = reachE(run({}));
  check(Math.abs(gFree - 3000) <= 60, `the route search agrees: ${gFree} m east`);
  const rs = run({ maxR: 600 });
  let farthest = 0; for (let i = 0; i < W2 * W2; i++) if (rs.alt[i] > -Infinity) farthest = Math.max(farthest, Math.hypot(i % W2 - c, Math.floor(i / W2) - c) * cell);
  check(farthest <= 600 && farthest > 560, `staying in sight (600 m): nothing past ${farthest.toFixed(0)} m`);
  check(G.RULES === undefined && G.ruleFor === undefined, 'the height rules are gone from the core');
  check(G.Units.imperial.h(121.92) === '400 ft' && G.Units.metric.h(121.92) === '122 m', 'heights: 121.92 m reads 400 ft or 122 m');
  check(G.Units.imperial.d(3500) === '2.2 mi' && G.Units.imperial.d(200) === '656 ft' && G.Units.metric.d(3500) === '3.5 km', 'distances: 3.5 km = 2.2 mi, 200 m = 656 ft');
  check(G.Units.imperial.v(10) === '22 mph' && G.Units.metric.v(10) === '10 m/s', 'speeds: 10 m/s = 22 mph');
  check(G.Units.imperial.a(2.589988) === '1.0 mi²', 'areas: 2.59 km² = 1 mi²');
}

console.log('5. map maths');
const [px, py] = G.lonLatToPx(-103.2498, 44.0877, 13);
const [lo, la] = G.pxToLonLat(px, py, 13);
near(lo, -103.2498, 1e-9, 'longitude round trip'); near(la, 44.0877, 1e-9, 'latitude round trip');
check(Math.floor(px / 256) === 1746 && Math.floor(py / 256) === 2975, 'M Hill is z13 tile 1746/2975 (textbook formula: y = 2975.996)');
near(G.mppAt(0, 13), 19.109, 0.001, 'metres per pixel at z13 on the equator');
near(G.mppAt(44.0877, 13), 13.72, 0.01, 'and at 44° N');
check(G.chooseZoom(3000, 44.09, 3) === 13, 'a 3 km glide fits zoom 13 (3 tiles of 3.5 km each way)');
check(G.chooseZoom(15000, 44.09, 3) === 12 && G.chooseZoom(25000, 44.09, 3) === 11, '15 km needs zoom 12, 25 km zoom 11');
check(G.chooseZoom(1e6, 44.09, 3) === 9, 'and it never goes coarser than zoom 9');
check(G.decodeTerrarium(128, 0, 0) === 0, 'Terrarium (128, 0, 0) is sea level');
check(G.decodeTerrarium(132, 76, 128) === 1100.5, 'Terrarium (132, 76, 128) is 1100.5 m');

console.log('6. saved areas');
const t = G.areaTiles(44.0877, -103.2498, 13, 4, 9, 3);
const byZ = z => t.filter(k => k[0] === z).length;
check(byZ(13) === 81, `9 × 9 tiles at z13 (${byZ(13)})`);
check([12, 11, 10, 9].every(z => byZ(z) === 49), `7 × 7 at each of zooms 12 to 9, for longer glides (${byZ(12)}, ${byZ(11)}, ${byZ(10)}, ${byZ(9)})`);
check(new Set(t.map(k => k.join('/'))).size === t.length, 'no tile listed twice');
const t13 = t.filter(k => k[0] === 13), xs = t13.map(k => k[1]), ys = t13.map(k => k[2]);
check(Math.min(...xs) === 1742 && Math.max(...xs) === 1750 && Math.min(...ys) === 2971 && Math.max(...ys) === 2979, 'centred on the launch tile');
const key = a => G.areaTiles(a[0], a[1], 13, 4, 9, 3).map(k => k.join('/'));
const a1 = key([44.0877, -103.2498]), a2 = key([44.10, -103.20]), a3 = key([47.49, 11.10]);
const gone = G.tilesOnlyIn(a1, [a2, a3]);
check(gone.length > 0 && gone.length < a1.length, `deleting one of two overlapping areas frees ${gone.length} of ${a1.length} tiles`);
check(gone.every(k => !a2.includes(k)), 'and none the other area still uses');
check(G.tilesOnlyIn(a3, [a1, a2]).length === a3.length, 'an area far away frees all its tiles');

console.log('6b. contours');
{
  const segs = c => { const o = []; for (const arr of [c.minor, c.major]) for (let i = 0; i < arr.length; i += 4) o.push(arr.slice(i, i + 4)); return o; };
  const grid = (w, h, f) => { const g = new Float32Array(w * h); for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) g[y * w + x] = f(x, y); return g; };
  // a plane rising 7 m a pixel eastward: every 20 m is a straight north-south line at x = 20k/7
  let c = G.contours(grid(64, 64, x => 7 * x), 64, 64, 20);
  let s = segs(c), worst = 0;
  for (const [x1, y1, x2, y2] of s) if (x1 > 2 && x1 < 61) { worst = Math.max(worst, Math.abs(x1 - x2), Math.abs(x1 * 7 / 20 - Math.round(x1 * 7 / 20)) * 20 / 7); }
  check(s.length > 0 && worst < 1e-4, `a plane: straight lines at the right spacing (worst ${worst.toExponential(1)} px)`);
  check(c.major.length > 0 && c.major.every((v, i) => i % 2 || Math.abs(v * 7 % 100) < 1e-3), 'every 5th line (each 100 m) is a major one');
  check(G.contours(grid(32, 32, () => 500), 32, 32, 20).minor.length === 0, 'flat ground: no lines');
  check(G.contours(grid(32, 32, () => 500), 32, 32, 20).major.length === 0, 'not even at an exact level (500 m)');
  // a cone 10 m down per pixel from 1000 m at the centre: rings at radius (1000 − level) / 10
  const cx = 40.3, cy = 39.7;
  c = G.contours(grid(80, 80, (x, y) => 1000 - 10 * Math.hypot(x - cx, y - cy)), 80, 80, 50);
  s = segs(c); worst = 0; let rings = new Set();
  for (const [x1, y1, x2, y2] of s) for (const [x, y] of [[x1, y1], [x2, y2]]) {
    const r = Math.hypot(x - cx, y - cy); if (r < 3 || r > 37) continue;
    const want = Math.round(r / 5) * 5; worst = Math.max(worst, Math.abs(r - want)); rings.add(want);
  }
  check(worst < 0.2 && rings.size === 7, `a cone: rings every 5 px from r = 5 to 35 (${rings.size} rings, worst ${worst.toFixed(3)} px off)`);
  // each ring is closed: every endpoint is shared by exactly two segments
  const ends = new Map();
  for (const [x1, y1, x2, y2] of s.filter(([x1, y1]) => Math.hypot(x1 - cx, y1 - cy) < 37)) for (const k of [`${x1.toFixed(4)},${y1.toFixed(4)}`, `${x2.toFixed(4)},${y2.toFixed(4)}`]) ends.set(k, (ends.get(k) || 0) + 1);
  check(ends.size > 100 && [...ends.values()].every(n => n === 2), 'and closed: every end meets exactly one other');
  // a saddle in the middle of cell (10, 10): h = s0 + 40 (x − 10.5)(y − 10.5), which smoothing leaves alone. Its corners
  // are s0 ± 10; the 100 m line must join the high corners (top-left, bottom-right) through the cell when the saddle
  // is above 100 m (s0 = 103), and cut them off when it is below (s0 = 97)
  const saddle = s0 => {
    const q = segs(G.contours(grid(21, 21, (x, y) => s0 + 40 * (x - 10.5) * (y - 10.5)), 21, 21, 20));
    const inCell = q.filter(([x1, y1, x2, y2]) => Math.min(x1, x2, y1, y2) >= 10 && Math.max(x1, x2, y1, y2) <= 11);
    const side = (x, y) => y === 10 ? 'T' : x === 11 ? 'R' : y === 11 ? 'B' : 'L';
    return inCell.map(([x1, y1, x2, y2]) => [side(x1, y1), side(x2, y2)].sort().join('')).sort().join(' ');
  };
  check(saddle(103) === 'BL RT', `a saddle above the line joins the high corners (${saddle(103)})`);
  check(saddle(97) === 'BR LT', `and one below it cuts them off (${saddle(97)})`);
  // a window cut from a bigger grid, with a 2 px margin, draws exactly the same lines inside it
  const big = grid(96, 96, (x, y) => 600 + 80 * Math.sin(x / 9) * Math.cos(y / 13) + 3 * x);
  const all = segs(G.contours(big, 96, 96, 20)), x0 = 30, y0 = 22, ww = 36;
  const win = new Float32Array(ww * ww); for (let y = 0; y < ww; y++) for (let x = 0; x < ww; x++) win[y * ww + x] = big[(y + y0) * 96 + x + x0];
  const key = ([a, b, cc, d]) => [a, b, cc, d].map(v => v.toFixed(4)).join(',');
  const inner = q => q[0] >= x0 + 2 && q[2] >= x0 + 2 && q[1] >= y0 + 2 && q[3] >= y0 + 2 && q[0] <= x0 + ww - 3 && q[2] <= x0 + ww - 3 && q[1] <= y0 + ww - 3 && q[3] <= y0 + ww - 3;
  const fromAll = new Set(all.filter(inner).map(key));
  const fromWin = new Set(segs(G.contours(win, ww, ww, 20)).map(q => [q[0] + x0, q[1] + y0, q[2] + x0, q[3] + y0]).filter(inner).map(key));
  check(fromAll.size > 50 && fromAll.size === fromWin.size && [...fromAll].every(k => fromWin.has(k)), `a window matches the whole grid inside its 2 px margin (${fromWin.size} segments)`);
  const hole = grid(16, 16, x => 30 * x); hole[8 * 16 + 8] = NaN;
  const hs = segs(G.contours(hole, 16, 16, 20));
  check(hs.length > 0 && hs.every(q => [[q[0], q[1]], [q[2], q[3]]].every(([x, y]) => !(x > 6 && x < 10 && y > 6 && y < 10))), 'no lines in the cells round a missing height');
  const st = z => G.contourStep(z, 'metric')[0], sti = z => Math.round(G.contourStep(z, 'imperial')[0] * G.FT);
  check([9, 10, 11, 12, 13, 14, 17].map(st).join() === '200,200,100,50,20,10,10', `metric spacing by zoom: ${[9, 10, 11, 12, 13, 14, 17].map(st).join(', ')} m`);
  check([10, 11, 12, 13, 14].map(sti).join() === '500,250,200,80,40', `imperial: ${[10, 11, 12, 13, 14].map(sti).join(', ')} ft`);
}

console.log('7. service worker');
(async () => {
  // Minimal Cache Storage, fetch and service-worker globals, enough for sw.js.
  const stores = new Map();
  const keyOf = r => (typeof r === 'string' ? new URL(r, 'https://tsmorz.github.io/glide-path/sw.js').href : r.url);
  const mkCache = () => { const m = new Map(); return {
    match: async r => m.get(keyOf(r)), put: async (r, res) => { m.set(keyOf(r), res); },
    delete: async r => m.delete(keyOf(r)), keys: async () => [...m.keys()].map(url => ({ url })), addAll: async urls => { for (const u of urls) m.set(keyOf(u), resp('shell:' + u)); }, size: () => m.size, _m: m }; };
  const caches = { open: async n => { if (!stores.has(n)) stores.set(n, mkCache()); return stores.get(n); },
    keys: async () => [...stores.keys()], delete: async n => stores.delete(n) };
  function resp(body, ok = true) { return { ok, body, clone() { return resp(body, ok); } }; }
  let net = 'up', calls = [];
  const fetchMock = async req => { const u = keyOf(req); calls.push(u);
    if (net === 'down') throw new TypeError('offline');
    if (net === 'stall') return new Promise(() => {});
    return resp('net:' + u); };
  const handlers = {};
  const ctx = { self: null, caches, fetch: fetchMock, URL, setTimeout, Promise, console,
    location: new URL('https://tsmorz.github.io/glide-path/sw.js') };
  ctx.self = { addEventListener: (t, f) => { handlers[t] = f; }, skipWaiting: () => {}, clients: { claim: () => {} } };
  vm.createContext(ctx);
  vm.runInContext(fs.readFileSync(path.join(__dirname, '..', 'glide-path/sw.js'), 'utf8'), ctx);
  const run = async (t, ev) => { let p; ev.waitUntil = x => { p = x; }; ev.respondWith = x => { p = x; }; handlers[t](ev); return p; };
  const get = (url, mode = 'cors') => run('fetch', { request: { url, method: 'GET', mode } });

  await run('install', {});
  check((await caches.open('glide-shell-' + vm.runInContext('VERSION', ctx))).size() === 16, 'install caches the page, its script and styles, the core, the worker, the manifest, icons and Leaflet');
  stores.set('glide-shell-v0', mkCache());
  await run('activate', {});
  check(!stores.has('glide-shell-v0'), 'activate drops an old version of the page');

  const tile = n => `https://s3.amazonaws.com/elevation-tiles-prod/terrarium/13/1746/${n}.png`;
  let r = await get(tile(1));
  check(r.body === 'net:' + tile(1) && (await (await caches.open('glide-terrain-runtime')).match(tile(1))), 'a terrain tile seen online is kept');
  net = 'down';
  r = await get(tile(1));
  check(r && r.body === 'net:' + tile(1), 'and served offline');
  await (await caches.open('glide-terrain-saved')).put(tile(2), resp('saved'));
  r = await get(tile(2));
  check(r && r.body === 'saved', 'a tile from a saved area is served offline');
  let threw = false; try { await get(tile(3)); } catch (e) { threw = true; }
  check(threw, 'an unsaved tile offline fails (the page then says the area is not saved)');

  net = 'up';
  const rt = await caches.open('glide-terrain-runtime');
  for (let i = 0; i < 640; i++) await get(tile(100 + i));
  await new Promise(res => setTimeout(res, 50));
  check(rt.size() <= 600 && !(await rt.match(tile(100))) && (await rt.match(tile(739))), `the recent-tile cache stays at 600, oldest dropped first (${rt.size()})`);

  net = 'down';
  r = await get('https://tsmorz.github.io/glide-path/', 'navigate');
  check(r && r.body.startsWith('shell:'), 'the page opens offline');
  r = await get('https://tsmorz.github.io/glide-path/?from=homescreen', 'navigate');
  check(r && r.body.startsWith('shell:'), 'with a query string too');
  net = 'stall';
  const t0 = Date.now();
  r = await get('https://tsmorz.github.io/glide-path/lib/leaflet/leaflet.js');
  check(r && r.body.startsWith('shell:') && Date.now() - t0 < 3500, `a stalled network falls back to the cached copy after ~3 s (${Date.now() - t0} ms)`);
  net = 'up';
  check(await get('https://tile.openstreetmap.org/13/1746/2975.png') === undefined, 'street-map tiles are not intercepted');
  check(await get('https://tsmorz.github.io/recipes/', 'navigate') === undefined, 'nor the rest of the site');

  console.log('8. the old address (/glide-reach/)');
  {
    // its sw.js replaces the service worker installed there before the move: it unregisters, sends open tabs to
    // /glide-path/ and deletes no caches (the terrain is shared with the new page)
    const h = {}, went = [];
    let unreg = 0, deleted = 0;
    const tabs = [{ url: 'https://tsmorz.github.io/glide-reach/?lat=44.1#map', navigate: async u => { went.push(u); } }];
    const c2 = { URL, Promise, console,
      caches: { delete: async () => { deleted++; }, keys: async () => ['glide-terrain-saved'] },
      self: { addEventListener: (ty, f) => { h[ty] = f; }, skipWaiting: () => {},
              registration: { unregister: async () => { unreg++; return true; } },
              clients: { matchAll: async () => tabs, claim: async () => {} } } };
    vm.createContext(c2);
    vm.runInContext(fs.readFileSync(path.join(__dirname, '..', 'glide-reach/sw.js'), 'utf8'), c2);
    let p; h.install({ waitUntil: x => { p = x; } }); await p;
    p = null; h.activate({ waitUntil: x => { p = x; } }); await p;
    check(unreg === 1, 'the old service worker unregisters itself');
    check(went.length === 1 && went[0] === 'https://tsmorz.github.io/glide-path/?lat=44.1#map', `and sends open tabs to the new address (${went[0]})`);
    check(deleted === 0 && !h.fetch, 'without deleting caches or answering requests');
    const redirect = fs.readFileSync(path.join(__dirname, '..', 'glide-reach/index.html'), 'utf8');
    check(redirect.includes('location.replace("/glide-path/" + location.search + location.hash)'), 'its index.html redirects, keeping query and hash');
  }

  if (failed) { console.log('\nFAILED'); process.exit(1); }
  console.log('\nAll glide-path checks passed.');
})();
