#!/usr/bin/env ruby
# frozen_string_literal: true

# Validate _data/*.yml against what the pages assume — the things a Jekyll build
# and html-proofer don't catch:
#   * required fields are present (projects need name + blurb)
#   * any local project image path points at a real file
#
# Pure stdlib (YAML ships with Ruby), no bundler, no build. Runs anywhere Ruby does.

require "yaml"

root = File.expand_path("..", __dir__)
Dir.chdir(root)

errors = []

# Case-sensitive existence check. macOS's default filesystem is case-insensitive,
# so File.exist? happily returns true for "Van-Life.jpg" when the file is really
# "van-life.jpg" — then it 404s on the case-sensitive Linux CI runner. Compare the
# exact basename against the directory's real entries so we catch it locally too.
def file_present?(path)
  dir = File.dirname(path)
  return false unless Dir.exist?(dir)

  Dir.children(dir).include?(File.basename(path))
end

def load_yaml(path, errors)
  YAML.safe_load_file(path) || []
rescue => e
  errors << "#{path}: could not parse (#{e.message})"
  []
end

# --- projects ---
load_yaml("_data/projects.yml", errors).each_with_index do |proj, i|
  label = proj["name"] || "project ##{i + 1}"
  errors << "projects.yml: #{label} is missing `name`"  if proj["name"].to_s.strip.empty?
  errors << "projects.yml: #{label} is missing `blurb`" if proj["blurb"].to_s.strip.empty?

  img = proj["image"].to_s
  if img.start_with?("/") && !file_present?(File.join(root, img))
    errors << "projects.yml: #{label} image not found (check exact spelling/case): #{img}"
  end
end

# --- recipes (read by assets/js/recipes.js) ---
# Each recipe needs an id (its URL hash), a name, a blurb, ingredients that carry a weight in grams or a `qty`, and steps.
# [[kind:arg]] tokens must be a known kind, and [[i:id]] must name an ingredient of the same recipe.
recipes = load_yaml("_data/recipes.yml", errors)
ids = recipes.map { |r| r["id"] }
recipes.each_with_index do |r, i|
  label = "recipes.yml: #{r["name"] || "recipe ##{i + 1}"}"
  errors << "#{label} needs an id made of lowercase letters, digits and dashes" unless r["id"].to_s.match?(/\A[a-z0-9-]+\z/)
  errors << "#{label} has a duplicate id" if ids.count(r["id"]) > 1
  %w[name blurb].each { |k| errors << "#{label} is missing `#{k}`" if r[k].to_s.strip.empty? }
  groups = r["ingredients"]
  items = groups.is_a?(Array) ? groups.flat_map { |g| g.is_a?(Hash) && g["items"].is_a?(Array) ? g["items"] : [] } : []
  errors << "#{label} needs ingredients as a list of groups, each with `items`" if items.empty?
  items.each do |it|
    errors << "#{label}: an ingredient is missing `name`" if it["name"].to_s.strip.empty?
    unless (it["g"].is_a?(Numeric) && it["g"].positive?) || !it["qty"].to_s.strip.empty?
      errors << "#{label}: #{it["name"]} needs `g` (a positive number of grams) or `qty`"
    end
  end
  have = items.map { |it| it["id"] }.compact
  errors << "#{label} has two ingredients with the same id" if have.uniq.size != have.size
  errors << "#{label} needs steps" unless r["steps"].is_a?(Array) && r["steps"].all? { |s| s.is_a?(String) && !s.strip.empty? } && !r["steps"].empty?
  texts = Array(r["steps"]) + Array(r["notes"]) + [r["makes"], r["time"]].compact + items.flat_map { |it| [it["note"], it["qty"]].compact }
  texts.each do |t|
    t.to_s.scan(/\[\[(\w+):([^\]]*)\]\]/) do |kind, arg|
      if kind == "i"
        errors << "#{label}: [[i:#{arg}]] names no ingredient" unless have.include?(arg)
      elsif !%w[g t len ml].include?(kind) || !arg.match?(/\A-?[\d.]+(-[\d.]+)?\z/)
        errors << "#{label}: bad token [[#{kind}:#{arg}]]"
      end
    end
    errors << "#{label}: unbalanced [[ ]] in #{t.to_s[0, 40].inspect}" if t.to_s.scan("[[").size != t.to_s.scan(/\[\[\w+:[^\]]*\]\]/).size
  end
end

# --- page front matter ---
# Jekyll skips a page whose front matter isn't valid YAML (an unquoted ": " in a description is
# enough), and the build still succeeds: the page just isn't there. Catch it here instead.
Dir.glob("*.{md,html}").sort.each do |path|
  text = File.read(path, encoding: "UTF-8")
  next unless text.start_with?("---")
  fm = text.split(/^---\s*$/, 3)[1]
  begin
    YAML.safe_load(fm.to_s)
  rescue => e
    errors << "#{path}: front matter is not valid YAML (#{e.message.lines.first.strip}); quote values that contain \": \""
  end
end

# --- lab predictions and checks (_data/labs/*.yml, read by assets/js/lab/lab.js) ---
# A quiz card needs a question, 2+ options, an answer that indexes one of them and an "explain"
# (a prediction also needs a "try").
Dir.glob("_data/labs/*.yml").sort.each do |path|
  doc = load_yaml(path, errors)
  (doc.is_a?(Hash) ? doc["tabs"] || [] : []).each do |tab|
    where = "#{path} tab #{tab["id"]}"
    { "predict" => %w[question try explain], "check" => %w[question explain] }.each do |key, need|
      Array(tab[key].is_a?(Hash) ? [tab[key]] : tab[key]).each_with_index do |pr, i|
        qw = "#{where} #{key} #{i + 1}"
        need.each { |k| errors << "#{qw}: needs #{k}" if pr[k].to_s.strip.empty? }
        opts = pr["options"]
        if !opts.is_a?(Array) || opts.size < 2
          errors << "#{qw}: needs at least two options"
        elsif !pr["answer"].is_a?(Integer) || !pr["answer"].between?(0, opts.size - 1)
          errors << "#{qw}: answer must index one of its #{opts.size} options (0-based)"
        elsif pr["why"] && pr["why"].size != opts.size
          errors << "#{qw}: why needs one entry per option"
        end
      end
    end
    # ARIVA: every lesson has a goal, a recall, a prediction, a note, tasks, a closing check and a recap.
    if path.end_with?("controls.yml")
      errors << "#{path}: needs a top-level problem statement" if doc["problem"].to_s.strip.empty? && tab == doc["tabs"].first
      %w[goal predict note tasks check recap].each { |k| errors << "#{where}: needs #{k} (ARIVA)" if tab[k].to_s.strip.empty? }
      errors << "#{where}: needs a demo" unless (doc["demos"] || []).any? { |d| d["id"] == tab["demo"] }
      ids = (doc["tabs"] || []).map { |t| t["id"] }
      errors << "#{where}: needs lists unknown lesson(s)" unless Array(tab["needs"]).all? { |n| ids.include?(n) && n != tab["id"] }
      errors << "#{where}: needs a recall line" if tab["recall"].to_s.strip.empty?
    end
  end
end

if errors.empty?
  puts "OK — _data content is consistent with the files on disk."
else
  warn "Data check failed:"
  errors.each { |e| warn "  - #{e}" }
  exit 1
end
