#!/usr/bin/env node
// Check the maths behind /controls/modern/ (assets/js/modern-core.js):
//   1. CBF: the filter leaves safe commands alone, and with it on the robot never enters
//      an obstacle, over many random scenes and both nominal controllers
//   2. Verify: interval bounds are sound (they contain every sampled output) for the small
//      net and the swing-up net; the certified radius never exceeds the attack radius;
//      splitting never loosens the bound; the committed small net still imitates LQR
//   3. MIMO: the spinning satellite's textbook numbers — each loop alone has a 90° phase
//      margin and no gain limit, yet both at once fail at 1/√(1 + a²) ≈ 10%
// Pure Node, no dependencies, no build.
'use strict';
const fs = require('fs');
const path = require('path');
const root = path.resolve(__dirname, '..');
const M = require(path.join(root, 'assets/js/modern-core.js'));

let failed = false;
function check(ok, msg) { console.log((ok ? '  ok   ' : '  FAIL ') + msg); if (!ok) failed = true; }
let seed = 4242;
function rand() { seed = (seed * 1103515245 + 12345) % 2147483648; return seed / 2147483648; }

console.log('1. CBF safety filter');
{
  const obs = [{ x: 4, y: 3, r: 1 }, { x: 7, y: 2, r: 0.8 }];
  const far = M.cbfFilter([1, 1], [0.5, 0.2], obs, 2);
  check(Math.hypot(far.u[0] - 0.5, far.u[1] - 0.2) < 1e-12, 'leaves a command alone when it is already safe');

  let worstH = Infinity, scenes = 0;
  for (let n = 0; n < 60; n++) {
    const obstacles = [0, 1, 2].map(() => ({ x: 2 + rand() * 6, y: 1 + rand() * 4, r: 0.4 + rand() * 0.6 }));
    let p = [0.5 + rand() * 0.5, 0.5 + rand() * 5];
    if (obstacles.some((o) => Math.hypot(p[0] - o.x, p[1] - o.y) < o.r + 0.1)) continue;
    const goal = [9.5, rand() * 6], alpha = 0.5 + rand() * 4, dt = 0.01;
    let heading = rand() * 6.28;
    for (let k = 0; k < 2000; k++) {
      let un;
      if (n % 2) { heading += (rand() - 0.5) * 0.6; un = [1.5 * Math.cos(heading), 1.5 * Math.sin(heading)]; }
      else { un = [goal[0] - p[0], goal[1] - p[1]]; const m = Math.hypot(un[0], un[1]); if (m > 1.5) un = un.map((v) => v * 1.5 / m); }
      const u = M.cbfFilter(p, un, obstacles, alpha).u;
      p = [p[0] + u[0] * dt, p[1] + u[1] * dt];
      obstacles.forEach((o) => { worstH = Math.min(worstH, Math.hypot(p[0] - o.x, p[1] - o.y) - o.r); });
    }
    scenes++;
  }
  check(worstH > -0.02, `${scenes} random scenes: closest approach to any obstacle edge ${worstH.toFixed(3)} (never inside)`);
}

console.log('2. verification');
const net = JSON.parse(fs.readFileSync(path.join(root, 'assets/models/verify-net.json'), 'utf8'));
{
  let rms = 0, n = 0;
  for (let k = 0; k < 500; k++) {
    const s = [0.4 * (2 * rand() - 1), 0.6 * (2 * rand() - 1), 0.15 * (2 * rand() - 1), 0.45 * (2 * rand() - 1)];
    const lqr = Math.max(-10, Math.min(10, net.lqr_gains.reduce((a, g, i) => a + g * s[i], 0)));
    rms += (M.smallForward(net, s) - lqr) ** 2; n++;
  }
  rms = Math.sqrt(rms / n);
  check(rms < 0.3, `small net imitates LQR near upright (RMS ${rms.toFixed(3)} N)`);

  let unsound = 0, looser = 0, ordered = 0;
  for (let k = 0; k < 300; k++) {
    const sc = [0.3 * (2 * rand() - 1), 0.3 * (2 * rand() - 1), 0.4 * (2 * rand() - 1), 1.2 * (2 * rand() - 1)];
    const eps = 0.002 + 0.05 * rand();
    const box = M.queryBox(sc, eps), F = M.smallBounds(net, box.lo, box.hi);
    for (let j = 0; j < 30; j++) {
      const s = box.lo.map((l, i) => l + rand() * (box.hi[i] - l));
      const f = M.smallForward(net, s);
      if (f < F[0] - 1e-9 || f > F[1] + 1e-9) unsound++;
    }
    const d0 = M.certifiedDeviation(net, sc, eps, 0).dev, d2 = M.certifiedDeviation(net, sc, eps, 2).dev;
    if (d2 > d0 + 1e-9) looser++;
    const att = M.attackDeviation(net, sc, eps).dev;
    if (att > d2 + 1e-9) ordered++;
  }
  check(unsound === 0, `small net: interval bounds contain all 9000 sampled outputs (${unsound} outside)`);
  check(looser === 0, `splitting never loosens the bound (${looser} cases)`);
  check(ordered === 0, `attacks never beat the certified bound (${ordered} cases)`);

  let bad = 0;
  for (let k = 0; k < 20; k++) {
    const sc = [0, 0, 0.3 * (2 * rand() - 1), (2 * rand() - 1)];
    const rc = M.certifiedRadius(net, sc, 0.5, 1, 0.1), ra = M.attackRadius(net, sc, 0.5, 0.1);
    if (rc > ra + 1e-6) bad++;
  }
  check(bad === 0, `certified radius ≤ attack radius at 20 random states (${bad} violations)`);

  // Swing-up net: soundness on a few boxes (slow-ish, ~5 ms per bound).
  const meta = JSON.parse(fs.readFileSync(path.join(root, 'assets/models/swingup-tqc.json'), 'utf8'));
  const bin = fs.readFileSync(path.join(root, 'assets/models/swingup-tqc.bin'));
  const big = M.loadBigNet(meta, bin.buffer.slice(bin.byteOffset, bin.byteOffset + bin.byteLength));
  let bigUnsound = 0;
  [0.0005, 0.002, 0.01].forEach((eps) => {
    const b = M.bigQueryBox(0.05, -0.03, eps), F = M.bigBounds(big, b.lo, b.hi);
    for (let j = 0; j < 20; j++) {
      const t1 = 0.05 + eps * (2 * rand() - 1), t2 = -0.03 + eps * (2 * rand() - 1);
      const r1 = M.RATE_PER_ANGLE * eps * (2 * rand() - 1), r2 = M.RATE_PER_ANGLE * eps * (2 * rand() - 1);
      const f = M.bigForward(big, [0, 0, Math.cos(t1), Math.sin(t1), r1, Math.cos(t2), Math.sin(t2), r2, 1, 1]);
      if (f < F[0] - 1e-6 || f > F[1] + 1e-6) bigUnsound++;
    }
  });
  check(bigUnsound === 0, `swing-up net: interval bounds contain all sampled outputs (${bigUnsound} outside)`);
  const w = []; const b = M.bigQueryBox(0, 0, 0.001); M.bigBounds(big, b.lo, b.hi, w);
  check(w.length === M.BIG_STAGES.length, `swing-up net reports one width per stage (${w.length} of ${M.BIG_STAGES.length})`);
  const ws = []; const sb = M.queryBox([0, 0, 0, 0], 0.001); M.smallBounds(net, sb.lo, sb.hi, ws);
  check(ws.length === M.SMALL_STAGES.length, `small net reports one width per stage (${ws.length} of ${M.SMALL_STAGES.length})`);
}

console.log('3. MIMO: spinning satellite');
{
  check(M.satStable(0, 0), 'nominal loop is stable');
  check(!M.satStable(0.2, -0.2), '+20% / −20% on the two inputs is unstable');
  let axesOk = true;
  for (let d = -0.95; d <= 5; d += 0.05) { if (!M.satStable(d, 0) || !M.satStable(0, d)) axesOk = false; }
  check(axesOk, 'one gain at a time, anywhere from −95% to +500%, stays stable');
  [0, 1].forEach((i) => {
    const m = M.loopMargins((w) => M.satLoop(i, w), 0.01, 100, 2000);
    check(Math.abs(m.pm - 90) < 0.5 && m.gmUp === null && m.gmDown === null,
      `loop ${i + 1} alone: phase margin ${m.pm.toFixed(1)}°, no gain limit either way`);
  });
  const sm = M.satSimultaneousMargin(), exact = 1 / Math.sqrt(1 + M.SAT.a ** 2);
  check(Math.abs(sm - exact) < 1e-3, `both at once: fails at ${(sm * 100).toFixed(2)}% (exact ${(exact * 100).toFixed(2)}%)`);
  // Simulation agrees with the stability test.
  let x = [0.01, -0.003];
  for (let k = 0; k < 400; k++) x = M.satStep(x, 0.2, -0.2, 0.01);
  check(Math.hypot(...M.satOutput(x)) > 1, 'simulation at +20% / −20% grows');
}

if (failed) { console.log('\ntest-modern: FAILED'); process.exit(1); }
console.log('\ntest-modern: all checks passed');
