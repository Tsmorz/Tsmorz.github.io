{
  "permissions": {
    "allow": [
      "Bash(task *)",
      "Bash(script/*)",
      "Bash(node script/*)",
      "Bash(node --check *)",
      "Bash(bundle exec jekyll build *)",
      "Bash(bundle exec htmlproofer *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin development)",
      "Bash(git push -q origin development)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(jq *)",
      "Bash(ruby -v)",
      "Bash(node -v)"
    ],
    "deny": [
      "Bash(git push * main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-js.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
