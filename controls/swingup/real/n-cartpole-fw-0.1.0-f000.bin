  <script>
    // Theme before first paint: ?theme=dark|light (not remembered), else the saved choice, else the OS.
    (function () {
      try {
        var q = /[?&]theme=(dark|light)/.exec(location.search);
        var t = q ? q[1] : localStorage.getItem('theme');
        if (t) document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <nav class="nav" aria-label="Device">
      <a class="nav-brand" href="./" aria-label="Dashboard home">
        <svg class="logo logo-cartpole" viewBox="3 6.6 28 28" width="38" height="38" aria-hidden="true">
          <line class="logo-ground" x1="6.5" y1="29" x2="28.5" y2="29" stroke-width="1.5" stroke-linecap="round"/>
          <g transform="translate(4.5 0)">
            <rect class="logo-cart" x="9.5" y="22.5" width="13" height="6" rx="1.5"/>
            <g stroke-width="2.2" stroke-linecap="round">
              <line class="logo-rod" x1="16.0" y1="26.0" x2="14.8" y2="14.1"/>
              <line class="logo-rod" x1="14.8" y1="14.1" x2="3.2" y2="17.2"/>
            </g>
            <circle class="logo-b1" cx="14.8" cy="14.1" r="2.6"/>
            <circle class="logo-b2" cx="3.2" cy="17.2" r="2.6"/>
          </g>
        </svg>
        <span class="brand-host"><span id="hostname">cartpole</span><span class="brand-sub">.local</span></span>
      </a>
      <div class="tabs" role="tablist" aria-label="Sections">
        <button class="tab" type="button" role="tab" id="tab-btn-live" data-tab="live" aria-controls="tab-live" aria-selected="true">Live</button>
        <button class="tab" type="button" role="tab" id="tab-btn-health" data-tab="health" aria-controls="tab-health" aria-selected="false" tabindex="-1">Health</button>
        <button class="tab" type="button" role="tab" id="tab-btn-record" data-tab="record" aria-controls="tab-record" aria-selected="false" tabindex="-1">Record</button>
        <button class="tab" type="button" role="tab" id="tab-btn-settings" data-tab="settings" aria-controls="tab-settings" aria-selected="false" tabindex="-1">Settings</button>
      </div>
      <div class="nav-chips">
        <span class="chip chip-conn" id="conn" data-state="connecting" role="status" aria-live="polite"><span class="dot"></span><span id="conn-text">connecting</span></span>
        <button class="chip chip-run" id="run-chip" type="button" data-run="" title="Controller state. Esc disarms from any tab."><span class="dot"></span><span id="run-chip-text">вЂ”</span></button>
        <span class="chip chip-rec" id="rec-chip" hidden title="Recording for system identification"><span class="dot"></span>REC <b id="rec-chip-t">0.0 s</b></span>
        <span class="chip chip-backend" id="backend" data-backend="" title="Plant backend">вЂ”</span>
        <a class="chip chip-hide-md chip-model" id="model-chip" href="#settings" title="Model on the device (details in Settings)">model <b id="model-label">вЂ”</b></a>
      </div>
      <button class="theme-toggle" type="button" role="switch" aria-label="Dark mode" title="Toggle color theme">
        <span class="tt-opt tt-light"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5.4"/><path d="M12 2.5v1.5M12 21.5V20M2.5 12H4M21.5 12H20M5.3 5.3l1.1 1.1M18.7 5.3l-1.1 1.1M5.3 18.7l1.1-1.1M18.7 18.7l-1.1-1.1"/></svg></span>
        <span class="tt-opt tt-dark"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path transform="translate(1.3 -1.3)" d="M5.6 5.6A9 9 0 0 0 18.4 18.4A12 12 0 0 1 5.6 5.6Z"/></svg></span>
      </button>
    </nav>
  </header>

  <div class="stale-banner" id="stale-banner" role="status" aria-live="polite" hidden><span class="dot"></span><span id="stale-text">Connection lost: the values below are frozen.</span><button class="banner-btn" type="button" onclick="location.reload()">Reload</button></div>

  <main id="main">
  <div class="tab-panel" id="tab-live" role="tabpanel" aria-labelledby="tab-btn-live">
    <section class="wrap page-head">
      <div>
        <span class="eyebrow" id="eyebrow">esp32-s3 В· double pendulum on a cart</span>
        <h1 class="page-title">Live controller</h1>
        <p class="page-sub">The TQC policy runs on the chip's second core every control tick. Arm it, pick a target pose, and watch the network think. Esc disarms from any tab.</p>
      </div>
      <ul class="head-facts" aria-label="At a glance">
        <li><b id="fact-rate">вЂ”</b>control rate</li>
        <li><b id="fact-exec">вЂ”</b>loop load</li>
        <li><b id="fact-miss">вЂ”</b>misses / min</li>
        <li><b id="fact-link">вЂ”</b>telemetry</li>
      </ul>
    </section>

    <div class="wrap">
      <div class="sim-layout">
        <div class="sim-canvas-wrap sim-stack">
          <div class="sim-cell">
            <canvas class="sim-canvas" id="scene" aria-label="The cart and both links as the controller estimates them. Dashed outlines: the target pose. The lime marker on the rail is the cart setpoint."></canvas>
            <div class="scene-overlay">
              <div class="run-block">
                <span class="run-badge" id="run-badge" data-run="idle"><span class="run-dot"></span><span id="run-text">IDLE</span><span class="run-reason" id="run-reason"></span></span>
                <span class="run-sub" id="run-sub"></span>
                <span class="run-last" id="run-last"></span>
              </div>
              <div class="reach" id="reach" aria-live="polite" hidden>
                <span class="reach-val" id="reach-val">-</span>
                <span class="reach-lbl" id="reach-lbl">time to target (s)</span>
                <span class="reach-state" id="reach-state"></span>
              </div>
            </div>
          </div>
          <div class="sim-cell"><canvas class="sim-states" id="plot" aria-label="Last 6 seconds of cart position, link angles, and force (command solid, applied dashed)"></canvas></div>
        </div>

        <aside class="sim-panel" aria-label="Controller">
          <h3>Controller</h3>
          <button class="arm-btn" data-arm type="button" aria-pressed="false" title="Arm sends the commands to the drive. Esc disarms from anywhere on the page.">
            <span class="arm-dot" aria-hidden="true"></span><span class="arm-label">Arm</span><span class="arm-key">esc</span>
          </button>
          <div class="mode-toggle" role="group" aria-label="Who is in control">
            <button class="mode-btn" type="button" data-mode="manual" aria-pressed="false">Manual</button>
            <button class="mode-btn" type="button" data-mode="ai" aria-pressed="false">AI</button>
          </div>
          <p class="panel-hint" id="mode-hint"><strong>AI:</strong> the network drives to the target and balances around the slider position.</p>

          <h3>Target</h3>
          <div class="goal-grid" id="goal-grid" role="group" aria-label="Target pose">
            <button class="goal-btn goal-btn-random" type="button" id="goal-random" aria-pressed="false" title="A new target 1 s after each one is reached, until you pick a specific target">
              <span class="goal-label">Random</span>
            </button>
          </div>

          <div class="pid-group">
            <label for="xref">Cart x<sub>ref</sub> <span id="xref-val">+0.00 m</span></label>
            <input type="range" id="xref" min="-0.25" max="0.25" step="0.01" value="0" aria-describedby="xref-hint">
            <div class="range-scale"><span id="xref-min">в€’0.25</span><span>0</span><span id="xref-max">+0.25</span></div>
          </div>
          <p class="panel-hint" id="xref-hint">Double-click the slider to centre.</p>

          <div id="sim-tools" hidden>
            <h3>Reset pose <span class="h3-tag">sim</span></h3>
            <div class="pose-row" id="pose-row" role="group" aria-label="Restart the simulated plant at a pose"></div>
          </div>
          <div id="rig-tools" hidden>
            <h3>Calibrate <span class="h3-tag">rig, disarmed</span></h3>
            <div class="btn-row">
              <button class="sim-btn" type="button" id="zero-angles" title="With both links hanging at rest: Оёв‚Ѓ = ПЂ, П† = 0">Zero angles</button>
              <button class="sim-btn" type="button" id="zero-cart" title="The cart's current position becomes x = 0">Zero cart</button>
            </div>
            <p class="panel-hint" id="cal-line"></p>
          </div>
          <p class="panel-msg" id="cmd-msg" aria-live="polite"></p>

          <h3 class="panel-push">State <span class="h3-tag" id="ro-tick"></span></h3>
          <table class="readout" aria-label="State: the controller's estimate, the encoder readings and (sim) the true state">
            <thead><tr><th scope="col"></th><th scope="col" title="What the policy sees (EKF or differenced encoders)">est</th><th scope="col" title="Calibrated encoder readings (positions only)">meas</th><th scope="col" id="ro-true-h" title="The simulator's true state">true</th></tr></thead>
            <tbody id="ro-rows"></tbody>
          </table>
          <dl class="kv kv-tight" id="ro-kv"><dt>force</dt><dd>вЂ”</dd></dl>
        </aside>
      </div>

      <section class="nn-netviz" aria-labelledby="net-title">
        <div class="nn-netviz-head">
          <h3 id="net-title">Inside the network</h3>
          <span class="nn-meta" id="nn-meta"></span>
          <div class="nn-legend" aria-hidden="true">
            <span class="nn-legend-cap">в€’</span><span class="nn-legend-bar"></span><span class="nn-legend-cap">+</span>
            <span class="nn-legend-txt">activation</span>
          </div>
        </div>
        <div class="su-net-scroll"><canvas class="su-net" id="net" aria-label="Diagram of the policy network with live activations"></canvas></div>
        <p class="su-net-hint">Swipe sideways to see the whole network.</p>
        <p class="eqn-note" id="net-note">Each square is one neuron, violet when positive and green when negative. Your browser downloads the device's own weights and runs the same forward pass on every observation the controller streams. In delta mode the output is a force <em>rate</em> (N/s) that the controller integrates into the force command; it drives the cart only when the device is armed in AI mode, otherwise it is a dimmed preview.</p>
      </section>
    </div>
  </div>
  <div class="tab-panel wrap" id="tab-health" role="tabpanel" aria-labelledby="tab-btn-health" hidden>
    <div class="tab-head"><h2 class="tab-title">Health</h2><p class="tab-sub">Loop timing, the two cores and their tasks, memory, and the link to this page.</p></div>
    <div class="cards">
              <section class="card" id="card-health" aria-labelledby="h-health">
                <div class="card-head"><span class="card-label">loop</span><h3 id="h-health">Control loop</h3><span class="tag" id="budget-tag">вЂ”</span></div>
                <div class="meter" id="loop-meter">
                  <div class="meter-top"><span>exec / period</span><span><b id="loop-exec">вЂ”</b> / <span id="loop-period">вЂ”</span></span></div>
                  <div class="meter-track" style="margin-top:.9rem">
                    <span class="meter-fill" id="seg-pol"></span>
                    <span class="meter-fill seg-est" id="seg-est"></span>
                    <span class="meter-fill seg-rest" id="seg-rest"></span>
                    <span class="meter-budget" style="left:80%" data-label="80 % budget"></span>
                    <span class="meter-max" id="loop-max" style="left:0"></span>
                  </div>
                  <div class="meter-legend"><span><i style="background:var(--viz-1)"></i>policy</span><span><i style="background:var(--viz-4)"></i>estimator</span><span><i style="background:var(--viz-7);opacity:.55"></i>rest</span><span><i style="background:var(--viz-2)"></i>max</span></div>
                </div>
                <div class="spark"><canvas id="spark" aria-label="Execution time of each streamed tick over the last 6 seconds, against the period and the 80 % budget"></canvas></div>
                <div class="spark spark-long"><canvas id="spark-long" aria-label="The last 5 minutes: average and worst execution time per status message against the control period, with red marks where deadlines were missed"></canvas></div>
                <dl class="kv">
                  <dt>policy</dt><dd id="h-pol">вЂ”</dd>
                  <dt>estimator</dt><dd id="h-est">вЂ”</dd>
                  <dt>exec max</dt><dd id="h-max">вЂ”</dd>
                  <dt>deadline misses</dt><dd id="h-miss">вЂ”</dd>
                  <dt>real-time factor</dt><dd id="h-rt">вЂ”</dd>
                </dl>
                <p class="panel-hint" id="h-note"></p>
              </section>
              <section class="card span-2 row-2" id="card-cores" aria-labelledby="h-cores">
                <div class="card-head"><span class="card-label">freertos</span><h3 id="h-cores">Cores &amp; tasks</h3><span class="tag" id="layout-tag">вЂ”</span></div>
                <div class="card-split">
                  <div class="meter core-meter">
                    <div class="meter-top"><span>core 0 В· PRO</span><b id="core0-load">вЂ”</b></div>
                    <div class="meter-track"><span class="meter-fill" id="core0-fill"></span><span class="meter-budget" style="left:80%" data-label=""></span></div>
                    <span class="meter-sub">Wi-Fi В· lwIP В· httpd В· telemetry</span>
                  </div>
                  <div class="meter core-meter">
                    <div class="meter-top"><span>core 1 В· APP</span><b id="core1-load">вЂ”</b></div>
                    <div class="meter-track"><span class="meter-fill" id="core1-fill"></span><span class="meter-budget" style="left:80%" data-label=""></span></div>
                    <span class="meter-sub">the control loop, alone</span>
                  </div>
                </div>
                <div class="table-wrap">
                  <table class="tasks" aria-label="FreeRTOS tasks">
                    <thead><tr><th scope="col">task</th><th scope="col">core</th><th scope="col">prio</th><th scope="col">cpu</th><th scope="col">stack free</th></tr></thead>
                    <tbody id="task-rows"><tr><td colspan="5" class="muted">waiting for the deviceвЂ¦</td></tr></tbody>
                  </table>
                </div>
                <p class="check-line" id="layout-check"></p>
              </section>
              <section class="card" id="card-device" aria-labelledby="h-device">
                <div class="card-head"><span class="card-label">device</span><h3 id="h-device">Memory &amp; link</h3><span class="tag" id="up-tag">вЂ”</span></div>
                <dl class="kv" id="dev-kv"><dt>internal free</dt><dd>вЂ”</dd></dl>
                <p class="panel-hint">Telemetry is what this page receives: frames per second against the device's rate, and gaps in the tick count (frames lost on Wi-Fi).</p>
              </section>
              <section class="card span-2" id="card-io" aria-labelledby="h-io">
                <div class="card-head"><span class="card-label">rig</span><h3 id="h-io">Sensors &amp; drive</h3><span class="tag" id="io-tag">вЂ”</span></div>
                <div id="io-body"><p class="panel-hint">Waiting for the deviceвЂ¦</p></div>
              </section>
              <section class="card" id="card-log" aria-labelledby="h-log">
                <div class="card-head"><span class="card-label">events</span><h3 id="h-log">Event log</h3><span class="tag" id="log-tag">вЂ”</span></div>
                <ol class="events" id="events" reversed><li class="muted">Waiting for the deviceвЂ¦</li></ol>
                <p class="panel-hint">Faults, arming, uploads, Wi-Fi and calibration; local time once the device's clock is set over the internet, else time since that boot (hover for both). The device keeps the latest 40 through crashes, watchdog resets and reboots (not a power-off), so the entries before a reset explain it.</p>
              </section>
    </div>
  </div>
  <div class="tab-panel wrap" id="tab-record" role="tabpanel" aria-labelledby="tab-btn-record" hidden>
    <div class="tab-head"><h2 class="tab-title">Record</h2><p class="tab-sub">Log every control tick, with optional excitation, for system identification.</p></div>
    <div class="cards">
              <section class="card span-3" id="card-record" aria-labelledby="h-record">
                <div class="card-head"><span class="card-label">sysid</span><h3 id="h-record">Record</h3><span class="tag" id="rec-tag">вЂ”</span></div>
                <div class="rec-ctrl">
                  <button class="arm-btn arm-btn-sm" data-arm type="button" aria-pressed="false" title="Arm sends the commands to the drive. Esc disarms from anywhere on the page.">
                    <span class="arm-dot" aria-hidden="true"></span><span class="arm-label">Arm</span><span class="arm-key">esc</span>
                  </button>
                  <div class="mode-toggle" role="group" aria-label="Who is in control">
                    <button class="mode-btn" type="button" data-mode="manual" aria-pressed="false">Manual</button>
                    <button class="mode-btn" type="button" data-mode="ai" aria-pressed="false">AI</button>
                  </div>
                  <span class="rec-ctrl-note" id="rec-ctrl-note"></span>
                </div>
                <div class="preset-row" id="rec-presets" role="group" aria-label="Recording preset"></div>
                <div class="card-split">
                  <div style="display:flex;flex-direction:column;gap:.6rem;min-width:0">
                    <p class="notice" id="rec-setup"></p>
                    <p class="notice bad" id="rec-warn" hidden></p>
                    <div class="rec-fields">
                      <div class="field"><label for="rec-seconds">length (s)</label><input id="rec-seconds" type="number" min="1" max="600" step="1"></div>
                      <div class="field"><label for="rec-kind">excitation</label><select id="rec-kind"><option value="none">none</option><option value="chirp">chirp</option><option value="prbs">PRBS</option><option value="steps">steps</option><option value="sine">sine</option></select></div>
                      <div class="field" data-for="chirp prbs steps sine"><label for="rec-amp">amplitude (N)</label><input id="rec-amp" type="number" min="0" max="10" step="0.1"></div>
                      <div class="field" data-for="chirp sine"><label for="rec-f0">f0 (Hz)</label><input id="rec-f0" type="number" min="0.01" max="50" step="0.05"></div>
                      <div class="field" data-for="chirp"><label for="rec-f1">f1 (Hz)</label><input id="rec-f1" type="number" min="0.01" max="50" step="0.1"></div>
                      <div class="field" data-for="prbs steps"><label for="rec-period" id="rec-period-l">bit (s)</label><input id="rec-period" type="number" min="0.005" max="10" step="0.005"></div>
                      <div class="field" data-for="chirp prbs steps sine"><label for="rec-duration">signal (s)</label><input id="rec-duration" type="number" min="0.5" max="600" step="0.5"></div>
                      <div class="field" data-for="prbs"><label for="rec-seed">seed</label><input id="rec-seed" type="number" min="0" max="4294967295" step="1"></div>
                    </div>
                    <div class="field"><label for="rec-note">note (saved in the file)</label><input id="rec-note" maxlength="63" spellcheck="false" placeholder="e.g. ring-down 1, links 2 cm off centre"></div>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:.6rem;min-width:0">
                    <div class="meter">
                      <div class="meter-top"><span id="rec-state">no recording yet</span><b id="rec-secs">вЂ”</b></div>
                      <div class="progress" style="height:12px"><i id="rec-bar"></i></div>
                    </div>
                    <dl class="kv" id="rec-kv"><dt>samples</dt><dd>вЂ”</dd></dl>
                    <div class="btn-row">
                      <button class="sim-btn primary" type="button" id="rec-start">Start recording</button>
                      <button class="sim-btn" type="button" id="rec-stop" disabled>Stop</button>
                    </div>
                    <div class="btn-row">
                      <button class="sim-btn" type="button" id="rec-try" title="Run the excitation without recording, e.g. to try an amplitude">Excite only</button>
                      <button class="sim-btn" type="button" id="rec-dl" disabled>Download .ncpr</button>
                    </div>
                    <p class="panel-msg" id="rec-msg" aria-live="polite"></p>
                  </div>
                </div>
                <div class="rec-plot"><canvas class="sim-states" id="rec-plot" aria-label="Last 6 seconds of cart position and force (command solid, applied dashed)"></canvas></div>
                <p class="panel-hint" id="rec-ids"></p>
              </section>
    </div>
  </div>
  <div class="tab-panel wrap" id="tab-settings" role="tabpanel" aria-labelledby="tab-btn-settings" hidden>
    <div class="tab-head"><h2 class="tab-title">Settings</h2><p class="tab-sub">Network, firmware and model updates, and the device itself.</p></div>
    <div class="cards">
              <section class="card span-2" id="card-wifi" aria-labelledby="h-wifi">
                <div class="card-head"><span class="card-label">net</span><h3 id="h-wifi">Wi-Fi</h3><span class="tag" id="wifi-tag">вЂ”</span></div>
                <div class="card-split">
                  <div class="col">
                    <dl class="kv" id="wifi-kv"><dt>mode</dt><dd>вЂ”</dd></dl>
                    <form class="form form-inline" id="host-form" autocomplete="off">
                      <div class="field"><label for="host-name">hostname</label>
                        <div class="input-suffix"><input id="host-name" maxlength="32" spellcheck="false" autocapitalize="off" pattern="[a-z0-9]([a-z0-9\-]{0,30}[a-z0-9])?" title="1вЂ“32 of aвЂ“z, 0вЂ“9 and -"><span>.local</span></div></div>
                      <button class="sim-btn" type="submit" id="host-save">Rename</button>
                    </form>
                    <button class="sim-btn danger" type="button" id="wifi-forget" title="Erase the saved network and reboot into the setup access point">Forget networkвЂ¦</button>
                    <p class="panel-msg" id="host-msg" aria-live="polite"></p>
                  </div>
                  <form class="form" id="wifi-form" autocomplete="off">
                    <div class="field"><label for="wifi-ssid">network (SSID)</label><input id="wifi-ssid" name="ssid" maxlength="32" required spellcheck="false" autocapitalize="off"></div>
                    <div class="field"><label for="wifi-pass">password</label><input id="wifi-pass" name="password" type="password" maxlength="64" autocapitalize="off"></div>
                    <p class="panel-hint">The device tries the network first and saves it only if it joins (no reboot). In setup mode its access point <code>cartpole-XXXX</code> stays up for a moment so you can read the result. A 2.4&nbsp;GHz network is required.</p>
                    <button class="sim-btn primary" type="submit" id="wifi-save">Join network</button>
                    <p class="panel-msg" id="wifi-msg" aria-live="polite"></p>
                  </form>
                </div>
              </section>
              <section class="card" id="card-system" aria-labelledby="h-system">
                <div class="card-head"><span class="card-label">chip</span><h3 id="h-system">System</h3><span class="tag" id="sys-tag">вЂ”</span></div>
                <dl class="kv" id="sys-kv"><dt>chip</dt><dd>вЂ”</dd></dl>
                <button class="sim-btn" type="button" id="reboot">Reboot</button>
              </section>
              <section class="card span-2" id="card-update" aria-labelledby="h-update">
                <div class="card-head"><span class="card-label">ota</span><h3 id="h-update">Update</h3><span class="tag" id="ota-tag">вЂ”</span></div>
                <div class="card-split">
                  <div style="display:flex;flex-direction:column;gap:.7rem;min-width:0">
                    <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-describedby="dz-sub">
                      <svg class="dz-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V4M7.5 8.5 12 4l4.5 4.5"/><path d="M4 14v4.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V14"/></svg>
                      <span class="dz-title">Drop a firmware image or a model</span>
                      <span class="dz-sub" id="dz-sub"><code>n-cartpole-fw-&lt;ver&gt;.bin</code> or <code>.ncpm</code> В· or click to choose</span>
                      <input type="file" id="file-input" accept=".bin,.ncpm,application/octet-stream" hidden>
                    </div>
                    <div class="file-panel" id="file-panel" hidden></div>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:.6rem;min-width:0">
                    <dl class="kv" id="ota-kv"><dt>running</dt><dd>вЂ”</dd></dl>
                    <div>
                      <div class="meter-top" style="margin-bottom:.25rem"><span>releases</span><a class="link-arrow" href="https://github.com/Tsmorz/n-cartpole/releases" target="_blank" rel="noopener">GitHub</a></div>
                      <ul class="releases" id="releases"><li class="muted rel-hint">Firmware images (<code>n-cartpole-fw-*.bin</code>) are attached to the <code>fw-v*</code> releases.</li></ul>
                    </div>
                  </div>
                </div>
              </section>
              <section class="card" id="card-model" aria-labelledby="h-model">
                <div class="card-head"><span class="card-label">.ncpm</span><h3 id="h-model">Model</h3><a class="tag" id="model-dl" href="api/model" download hidden>download</a></div>
                <dl class="kv" id="model-kv"><dt>model</dt><dd>вЂ”</dd></dl>
                <p class="check-line" id="model-check"></p>
              </section>
    </div>
  </div>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <p>n-cartpole firmware <span id="foot-ver"></span> В· <a href="https://github.com/Tsmorz/n-cartpole" target="_blank" rel="noopener">Tsmorz/n-cartpole</a></p>
      <p id="foot-chip"></p>
    </div>
  </footer>

  <script src="app.js"></script>
</body>
</html>
@p␀␀/* n-cartpole dashboard вЂ” served by the ESP32-S3 controller (firmware/web/).

   Vanilla JS, no build step, no libraries. Talks to the device's API
   (firmware/docs/design.md): GET /api/info, WebSocket /ws (binary telemetry
   frames + status JSON at 2 Hz), POST /api/cmd, and the uploads.

   - The telemetry layout is ncp_telemetry.h (232-byte packed little-endian
     frames behind a 4-byte header); TLM below decodes those exact offsets.
   - The model blob is ncp_model.h (.ncpm: 512-byte header, then float32/float16/int8
     weights in forward order with the RunningNorm folded in). The page fetches
     /api/model and runs the same network on every streamed observation to draw
     its activations. The forward pass, scene, plots, goal pictograms and network
     diagram are ported from the personal site's /controls/swingup/ page
     (personal-site/assets/js/swingup.js: createPolicy, drawScene, drawPlot,
     drawNet, goalIcon), generalised to the blob's dims.

   firmware/tools/mock_device.py serves this page with a simulated plant. */
(function () {
  'use strict';

  /* ================================================================
     Formats: ncp_telemetry.h and ncp_model.h
  ================================================================ */
  var MAX_LINKS = 4, MAX_STATE = 2 + 2 * MAX_LINKS, MAX_POS = 1 + MAX_LINKS, MAX_HIST = 8;
  var MAX_OBS = 2 + 3 * MAX_LINKS + MAX_LINKS + MAX_HIST;
  var TLM = {
    VERSION: 1, HDR: 4, FRAME: 232,
    tick: 0, run: 4, mode: 5, goal: 6, flags: 7,
    est: 8, meas: 8 + 4 * MAX_STATE, truth: 8 + 4 * (MAX_STATE + MAX_POS),
    obs: 8 + 4 * (2 * MAX_STATE + MAX_POS),
    cmd: 212, applied: 216, x_ref: 220, loop_us: 224, policy_us: 226, est_us: 228, period_us: 230
  };
  var RUN = ['idle', 'armed', 'fault', 'maint'];
  var FLAG = { SETTLED: 1, RANDOM: 2, SIM: 4, TRUTH: 8 };
  var MODE = ['ai', 'manual'];
  var NCP = { HEADER: 512, GOAL: 1, DELTA: 2, EKF: 4 };

  function decodeFrame(dv, o) {
    function f32s(off, n) {
      var a = new Float32Array(n);
      for (var i = 0; i < n; i++) a[i] = dv.getFloat32(o + off + 4 * i, true);
      return a;
    }
    return {
      tick: dv.getUint32(o + TLM.tick, true),
      run: dv.getUint8(o + TLM.run), mode: dv.getUint8(o + TLM.mode),
      goal: dv.getUint8(o + TLM.goal), flags: dv.getUint8(o + TLM.flags),
      est: f32s(TLM.est, MAX_STATE), meas: f32s(TLM.meas, MAX_POS),
      truth: f32s(TLM.truth, MAX_STATE), obs: f32s(TLM.obs, MAX_OBS),
      cmd: dv.getFloat32(o + TLM.cmd, true), applied: dv.getFloat32(o + TLM.applied, true),
      x_ref: dv.getFloat32(o + TLM.x_ref, true),
      loop_us: dv.getUint16(o + TLM.loop_us, true), policy_us: dv.getUint16(o + TLM.policy_us, true),
      est_us: dv.getUint16(o + TLM.est_us, true), period_us: dv.getUint16(o + TLM.period_us, true)
    };
  }

  // ncp_header_t, byte for byte.
  function parseNcpm(buf) {
    if (buf.byteLength < NCP.HEADER) throw new Error('shorter than the 512-byte header');
    var dv = new DataView(buf, 0, NCP.HEADER), u8 = new Uint8Array(buf, 0, NCP.HEADER);
    if (String.fromCharCode(u8[0], u8[1], u8[2], u8[3]) !== 'NCPM') throw new Error('not an .ncpm model (magic)');
    function d(off) { return dv.getFloat64(off, true); }
    function arr(off, n) { var a = []; for (var i = 0; i < n; i++) a.push(d(off + 8 * i)); return a; }
    var h = {
      version: dv.getUint16(4, true), header_size: dv.getUint16(6, true),
      total_size: dv.getUint32(8, true), crc32: dv.getUint32(12, true), train_step: dv.getUint32(16, true),
      n_links: u8[20], n_blocks: u8[21], expand: u8[22], dtype: u8[23],
      hidden: dv.getUint16(24, true), obs_dim: dv.getUint16(26, true),
      flags: u8[28], action_history: u8[29], delay_steps: u8[30], n_goals: u8[31],
      goal_settle_steps: dv.getUint16(32, true),
      dt: d(40), force_max: d(48), force_slew: d(56), x_lim: d(64),
      M: d(72), g: d(80), b: d(88)
    };
    var n = Math.min(h.n_links, MAX_LINKS);
    h.masses = arr(120, n); h.lengths = arr(152, n); h.com = arr(184, n);
    h.goal_tol_angle = d(336); h.goal_tol_vel = d(344);
    var lab = '';
    for (var i = 352; i < 416 && u8[i]; i++) lab += String.fromCharCode(u8[i]);
    try { lab = decodeURIComponent(escape(lab)); } catch (e) { /* not UTF-8: keep bytes */ }
    h.label = lab;
    if (h.version !== 1) throw new Error('blob version ' + h.version + ' (this page reads 1)');
    if (h.n_links < 1 || h.n_links > MAX_LINKS || !h.hidden || !h.obs_dim || h.n_blocks > 4) throw new Error('dims out of range');
    h.goal = !!(h.flags & NCP.GOAL); h.delta = !!(h.flags & NCP.DELTA); h.ekf = !!(h.flags & NCP.EKF);
    if (!DTYPES[h.dtype]) throw new Error('weight dtype ' + h.dtype + ' (this page reads f32, f16, i8)');
    h.dtype_name = DTYPES[h.dtype];
    h.params = weightCount(h);
    h.expected_size = NCP.HEADER + weightBytes(h);
    return h;
  }

  var DTYPES = { 0: 'f32', 1: 'f16', 2: 'i8' };
  function weightCount(h) {
    var H = h.hidden, E = H * h.expand, D = h.obs_dim;
    return H * D + H + h.n_blocks * (2 * H + E * H + E + H * E + H) + 2 * H + H + 1;
  }
  // [int8 in an i8 blob?, rows, cols] per tensor in file order (ncp_model.h).
  function tensorShapes(h) {
    var H = h.hidden, E = H * h.expand, D = h.obs_dim, out = [[false, H, D], [false, H, 1]];
    for (var b = 0; b < h.n_blocks; b++) {
      out.push([false, H, 1], [false, H, 1], [true, E, H], [false, E, 1], [true, H, E], [false, H, 1]);
    }
    out.push([false, H, 1], [false, H, 1], [false, 1, H], [false, 1, 1]);
    return out;
  }
  function weightBytes(h) {   // ncp_weight_bytes
    if (h.dtype !== 2) return h.params * (h.dtype ? 2 : 4);
    return tensorShapes(h).reduce(function (a, t) {
      var n = t[1] * t[2];
      return a + (t[0] ? 4 * t[1] + Math.ceil(n / 4) * 4 : 4 * n);
    }, 0);
  }
  // An i8 blob's weights as float32 in file order: q В· scale of its row.
  function int8ToFloat(h, buffer) {
    var out = new Float32Array(h.params), pos = 0, off = NCP.HEADER;
    tensorShapes(h).forEach(function (t) {
      var rows = t[1], cols = t[2], n = rows * cols;
      if (!t[0]) {
        out.set(new Float32Array(buffer.slice(off, off + 4 * n)), pos);
        off += 4 * n;
      } else {
        var s = new Float32Array(buffer.slice(off, off + 4 * rows)), q = new Int8Array(buffer, off + 4 * rows, n);
        for (var r = 0; r < rows; r++) for (var c = 0; c < cols; c++) out[pos + r * cols + c] = q[r * cols + c] * s[r];
        off += 4 * rows + Math.ceil(n / 4) * 4;
      }
      pos += n;
    });
    return out;
  }

  var CRC_TABLE = null;
  function crc32(u8, skipFrom, skipTo) {   // zlib.crc32, reading [skipFrom, skipTo) as zeros
    if (!CRC_TABLE) {
      CRC_TABLE = new Uint32Array(256);
      for (var n = 0; n < 256; n++) {
        var c = n;
        for (var k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320 ^ (c >>> 1) : c >>> 1;
        CRC_TABLE[n] = c >>> 0;
      }
    }
    var crc = 0xFFFFFFFF;
    for (var i = 0; i < u8.length; i++) {
      var b = i >= skipFrom && i < skipTo ? 0 : u8[i];
      crc = CRC_TABLE[(crc ^ b) & 0xFF] ^ (crc >>> 8);
    }
    return (crc ^ 0xFFFFFFFF) >>> 0;
  }

  function halfToFloat(buffer, offset, count) {
    var dv = new DataView(buffer, offset), out = new Float32Array(count);
    for (var i = 0; i < count; i++) {
      var h = dv.getUint16(2 * i, true);
      var sign = h & 0x8000 ? -1 : 1, e = (h >> 10) & 0x1f, f = h & 0x3ff;
      out[i] = e === 0 ? sign * f * 5.960464477539063e-8
             : e === 31 ? (f ? NaN : sign * Infinity)
             : sign * (1 + f / 1024) * Math.pow(2, e - 15);
    }
    return out;
  }

  /* The SimBa actor's deterministic head (ncp_policy.h; swingup.js createPolicy):
     in_proj в†’ blocks Г— [h += fc2(relu(fc1(LN(h))))] в†’ LN в†’ mean; a = tanh(mean)В·Fmax. */
  function createPolicy(h, buffer) {
    var count = h.params, all;
    if (h.dtype === 0) {
      all = new Float32Array(buffer.slice(NCP.HEADER, NCP.HEADER + 4 * count));
    } else if (h.dtype === 2) {
      all = int8ToFloat(h, buffer);
    } else {
      all = halfToFloat(buffer, NCP.HEADER, count);
    }
    var H = h.hidden, E = H * h.expand, D = h.obs_dim, B = h.n_blocks, pos = 0;
    function take(n) { var t = all.subarray(pos, pos + n); pos += n; return t; }
    var T = { in_w: take(H * D), in_b: take(H), blocks: [] };
    for (var b = 0; b < B; b++) {
      T.blocks.push({ ln_w: take(H), ln_b: take(H), fc1_w: take(E * H), fc1_b: take(E), fc2_w: take(H * E), fc2_b: take(H) });
    }
    T.fl_w = take(H); T.fl_b = take(H); T.out_w = take(H); T.out_b = take(1);
    var x = new Float32Array(H), t = new Float32Array(H), u = new Float32Array(E);
    var trace = { obs: new Float32Array(D), h: [new Float32Array(H)], u: [], mean: 0, action: 0 };
    for (b = 0; b < B; b++) { trace.u.push(new Float32Array(E)); trace.h.push(new Float32Array(H)); }

    function linear(W, bias, inp, inDim, outDim, out) {
      for (var o = 0; o < outDim; o++) {
        var s = bias[o], row = o * inDim;
        for (var i = 0; i < inDim; i++) s += W[row + i] * inp[i];
        out[o] = s;
      }
    }
    function layerNorm(v, w, bias, out) {
      var mean = 0, va = 0, i;
      for (i = 0; i < H; i++) mean += v[i];
      mean /= H;
      for (i = 0; i < H; i++) { var dd = v[i] - mean; va += dd * dd; }
      var inv = 1 / Math.sqrt(va / H + 1e-5);
      for (i = 0; i < H; i++) out[i] = (v[i] - mean) * inv * w[i] + bias[i];
    }
    function act(obs) {
      for (var i = 0; i < D; i++) trace.obs[i] = obs[i] || 0;
      linear(T.in_w, T.in_b, trace.obs, D, H, x);
      trace.h[0].set(x);
      for (var bi = 0; bi < B; bi++) {
        var P = T.blocks[bi];
        layerNorm(x, P.ln_w, P.ln_b, t);
        linear(P.fc1_w, P.fc1_b, t, H, E, u);
        for (i = 0; i < E; i++) if (u[i] < 0) u[i] = 0;
        for (var o = 0; o < H; o++) {
          var s = P.fc2_b[o], row = o * E;
          for (var j = 0; j < E; j++) s += P.fc2_w[row + j] * u[j];
          x[o] += s;
        }
        trace.u[bi].set(u); trace.h[bi + 1].set(x);
      }
      layerNorm(x, T.fl_w, T.fl_b, t);
      var m = T.out_b[0];
      for (var k = 0; k < H; k++) m += T.out_w[k] * t[k];
      trace.mean = m; trace.action = Math.tanh(m) * h.force_max;
      return trace.action;
    }
    return { act: act, trace: trace };
  }

  // Goal index в†” label (n_cartpole.env.goals.goal_configs): bit k set = link k down; labels base link first.
  function goalLabel(n, g) { var s = ''; for (var k = 0; k < n; k++) s += (g >> k) & 1 ? 'D' : 'U'; return s; }
  function goalIndex(n, label) { var g = 0; for (var k = 0; k < n; k++) if (label[k] === 'D') g |= 1 << k; return g; }
  function goalTarget(n, g) { var t = []; for (var k = 0; k < n; k++) t.push((g >> k) & 1 ? Math.PI : 0); return t; }
  function wrapAngle(a) { a = (a + Math.PI) % (2 * Math.PI); if (a < 0) a += 2 * Math.PI; return a - Math.PI; }
  // Degrees in [в€’90В°, 270В°): up (0В°) and down (180В°) both away from the wrap, so neither flickers in sign.
  function lane(a) { return wrapAngle(a - Math.PI / 2) * 180 / Math.PI + 90; }

  // Labels of the network's inputs, from the blob's dims (ncp_ctrl.h step 2).
  function obsLayout(h) {
    var sub = ['в‚Ѓ', 'в‚‚', 'в‚ѓ', 'в‚„'], L = [{ l: 'x в€’ xref', s: h.x_lim || 0.5 }, { l: 'бє‹', s: 2 }];
    for (var k = 0; k < h.n_links; k++) {
      L.push({ l: 'cos Оё' + sub[k], s: 1 }, { l: 'sin Оё' + sub[k], s: 1 }, { l: 'ОёМ‡' + sub[k], s: 10 });
    }
    if (h.goal) for (k = 0; k < h.n_links; k++) L.push({ l: 'cos goal' + sub[k], s: 1, goal: true });
    h.hist_at = L.length;
    for (k = 0; k < h.action_history; k++) L.push({ l: 'F[tв€’' + (k + 1) + ']/Fmax', s: 1 });
    while (L.length < h.obs_dim) L.push({ l: 'o[' + L.length + ']', s: 1 });
    return L.slice(0, h.obs_dim);
  }

  /* ================================================================
     Page
  ================================================================ */
  var $ = function (id) { return document.getElementById(id); };
  var root = document.documentElement;
  function cssVar(name) { return getComputedStyle(root).getPropertyValue(name).trim(); }
  function clamp(v, lo, hi) { return Math.min(hi, Math.max(lo, v)); }
  function get(o, path, dflt) {
    var p = path.split('.');
    for (var i = 0; i < p.length; i++) { if (o == null) return dflt; o = o[p[i]]; }
    return o == null ? dflt : o;
  }
  function setText(id, v) { var e = $(id); if (e && e.textContent !== String(v)) e.textContent = v; }
  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); }
  function minus(s) { return String(s).replace(/^-/, 'в€’'); }
  function num(v, d) { var s = (+v).toFixed(d); if (/^-0\.?0*$/.test(s)) s = s.slice(1); return minus(s); }
  function signed(v, d) { var s = num(v, d); return s.charAt(0) === 'в€’' ? s : '+' + s; }
  function us(v) { return v == null ? 'вЂ”' : v >= 10000 ? (v / 1000).toFixed(1) + ' ms' : Math.round(v) + ' Вµs'; }
  function bytes(n) {
    if (n == null) return 'вЂ”';
    if (n >= 1048576) return (n / 1048576).toFixed(2) + ' MB';
    if (n >= 1024) return (n / 1024).toFixed(n >= 102400 ? 0 : 1) + ' KB';
    return n + ' B';
  }
  function duration(s) {
    if (s == null) return 'вЂ”';
    s = Math.max(0, Math.floor(s));
    var d = Math.floor(s / 86400), h = Math.floor(s / 3600) % 24, m = Math.floor(s / 60) % 60, x = s % 60;
    if (d) return d + 'd ' + h + 'h';
    if (h) return h + 'h ' + (m < 10 ? '0' : '') + m + 'm';
    if (m) return m + 'm ' + (x < 10 ? '0' : '') + x + 's';
    return x + 's';
  }
  function plural(n, w) { return n + ' ' + w + (n === 1 ? '' : 's'); }

  var S = {
    info: null, status: null, statusAt: 0,
    hdr: null, policy: null, layout: null,
    model: { state: 'idle', got: 0, total: 0, crc: null, error: '' },
    conn: 'connecting', everLive: false, lastMsg: 0,
    last: null, hist: [], frameKey: '',
    run: null, mode: null, goal: null, random: false, xref: 0, fault: '', backend: null,
    seg: null, pendingGoal: null, pendingUntil: 0,
    parity: null, netMs: 0, netFps: 0,
    rebooting: null, lastFrameSeen: 0,
    link: { frames: 0, fps: null, gaps: 0, lost: 0 },  // telemetry as this page receives it
    misses: [], missArm: null, statusRun: null,         // deadline misses over time, at arming
    loopHist: [], armConfirmed: false,
    events: { seq: -1, list: [], loading: false, seenBad: 0 },
    parityN: 0, parityAt: 0, stale: false
  };

  // Geometry and limits: from the blob header when it's loaded, else /api/info, else the rig defaults.
  function geom() {
    var h = S.hdr, m = get(S.info, 'model', null) || {};
    var n = (h && h.n_links) || m.n_links || 2;
    var L = h && h.lengths && h.lengths.length === n ? h.lengths : null;
    if (!L) { L = []; for (var k = 0; k < n; k++) L.push(0.25); }
    return {
      n: n, lengths: L, masses: (h && h.masses) || L.map(function () { return 0.12; }),
      x_lim: (h && h.x_lim) || m.x_lim || 0.5, dt: (h && h.dt) || m.dt || 0.005,
      fmax: (h && h.force_max) || m.force_max || 15, slew: (h && h.force_slew) || m.force_slew || 0,
      settle: (h && h.goal_settle_steps) || 50,
      tolA: (h && h.goal_tol_angle) || 0.3, tolV: (h && h.goal_tol_vel) || 1.5
    };
  }
  function goalLabels() {
    var n = geom().n, out = [];
    for (var g = 0; g < 1 << n; g++) out.push(goalLabel(n, g));
    return out;
  }
  // The pose the plant is resting in (within the "reached" tolerances), or null.
  function poseOf(st) {
    var G = geom();
    for (var g = 0; g < 1 << G.n; g++) {
      var t = goalTarget(G.n, g), ok = true;
      for (var k = 0; k < G.n && ok; k++) {
        if (!(Math.abs(wrapAngle(st[2 + 2 * k] - t[k])) < G.tolA) || !(Math.abs(st[3 + 2 * k]) < G.tolV)) ok = false;
      }
      if (ok) return goalLabel(G.n, g);
    }
    return null;
  }

  /* ---- Theme toggle (the site's site.js) ---- */
  (function () {
    var btn = document.querySelector('.theme-toggle');
    function isDark() {
      var t = root.getAttribute('data-theme');
      return t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
    }
    btn.setAttribute('aria-checked', isDark() ? 'true' : 'false');
    btn.addEventListener('click', function () {
      var next = isDark() ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      btn.setAttribute('aria-checked', next === 'dark' ? 'true' : 'false');
      try { localStorage.setItem('theme', next); } catch (e) {}
      rgbCache = {};
    });
  })();

  /* ---- HTTP helpers ---- */
  function fetchJSON(url, opts, timeoutMs) {
    opts = opts || {};
    var ctl = typeof AbortController !== 'undefined' ? new AbortController() : null, timer = null;
    if (ctl) { opts.signal = ctl.signal; timer = setTimeout(function () { ctl.abort(); }, timeoutMs || 5000); }
    opts.cache = 'no-store';
    return fetch(url, opts).then(function (r) {
      return r.text().then(function (t) {
        var j = null;
        try { j = t ? JSON.parse(t) : null; } catch (e) { j = null; }
        if (!r.ok) {
          var err = new Error((j && j.error) || ('HTTP ' + r.status));
          err.status = r.status;
          throw err;
        }
        return j;
      });
    }).finally(function () { if (timer) clearTimeout(timer); });
  }

  // A clickable address: http://<ip or host>/ (opens the dashboard there).
  function addrLink(host) { return host ? '<a href="http://' + esc(host) + '/">' + esc(host) + '</a>' : 'вЂ”'; }
  // Escape, then make IPv4 addresses and <name>.local names clickable.
  function linkify(text) {
    return esc(text).replace(/\b((?:\d{1,3}\.){3}\d{1,3}|[a-z0-9-]+\.local)\b/gi, function (m) { return addrLink(m); });
  }

  /* Copy on click: any element with data-copy. navigator.clipboard needs a secure context,
     which http://cartpole.local is not, so fall back to a hidden textarea + execCommand. */
  function copyText(t) {
    if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(t);
    return new Promise(function (ok, fail) {
      var a = document.createElement('textarea');
      a.value = t; a.setAttribute('readonly', ''); a.style.position = 'fixed'; a.style.opacity = '0';
      document.body.appendChild(a); a.select();
      try { document.execCommand('copy') ? ok() : fail(new Error('copy refused')); } catch (e) { fail(e); }
      a.remove();
    });
  }
  document.addEventListener('click', function (e) {
    var el = e.target.closest && e.target.closest('[data-copy]');
    if (!el) return;
    function tip(text) {
      el.setAttribute('data-tip', text); el.classList.add('copied');
      setTimeout(function () { el.classList.remove('copied'); }, 1600);
    }
    copyText(el.getAttribute('data-copy')).then(function () { tip('copied'); }).catch(function () {
      // The browser refused: select the text so a keyboard copy takes it.
      var r = document.createRange(); r.selectNodeContents(el);
      var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r);
      tip(/Mac|iPhone|iPad/.test(navigator.platform) ? 'press вЊC' : 'press Ctrl+C');
    });
  });
  function copyCode(t) { return '<code class="copy" data-copy="' + esc(t) + '" title="Click to copy">' + esc(t) + '</code>'; }

  /* "Go there" links: data-goto="tab:element-id" switches tab, scrolls to the element and
     briefly highlights it (e.g. the Calibrate buttons, the upload drop zone). */
  document.addEventListener('click', function (e) {
    var el = e.target.closest && e.target.closest('[data-goto]');
    if (!el) return;
    e.preventDefault();
    var parts = el.getAttribute('data-goto').split(':'), target = parts[1] && $(parts[1]);
    if (location.hash !== '#' + parts[0]) location.hash = parts[0]; else showTab(parts[0]);
    if (target) setTimeout(function () {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.classList.add('flash-hl');
      setTimeout(function () { target.classList.remove('flash-hl'); }, 1600);
    }, 60);
  });
  function goto(tabAndId, text) { return '<a href="#' + tabAndId.split(':')[0] + '" data-goto="' + tabAndId + '">' + esc(text) + '</a>'; }

  var msgTimer = null;
  function flash(id, text, kind, ms, html) {
    var e = $(id);
    if (!e) return;
    if (html) e.innerHTML = text; else e.textContent = text;
    e.className = 'panel-msg' + (kind ? ' ' + kind : '');
    clearTimeout(msgTimer);
    if (ms !== 0) msgTimer = setTimeout(function () { e.textContent = ''; e.className = 'panel-msg'; }, ms || 4000);
  }

  function send(cmd) {
    return fetchJSON('api/cmd', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cmd) }, 3000)
      .catch(function (e) {
        var k = Object.keys(cmd)[0];
        flash('cmd-msg', k + ': ' + (e.name === 'AbortError' ? 'no answer from the device' : e.message), 'bad', 5000);
        throw e;
      });
  }

  /* ---- Connection: WebSocket with backoff, info on every (re)connect ---- */
  var ws = null, wsTimer = null, backoff = 400;
  function setConn(state) {
    S.conn = state;
    renderStale();
    var c = $('conn');
    c.dataset.state = state;
    setText('conn-text', { live: 'live', connecting: 'connecting', reconnecting: 'reconnecting', rebooting: 'rebooting', offline: 'offline' }[state] || state);
    renderControls(true);
  }
  function connect() {
    clearTimeout(wsTimer);
    if (ws) { try { ws.onclose = null; ws.close(); } catch (e) {} ws = null; }
    if (S.conn !== 'rebooting') setConn(S.everLive ? 'reconnecting' : 'connecting');
    var sock;
    try {
      sock = new WebSocket((location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/ws');
    } catch (e) { scheduleReconnect(); return; }
    ws = sock;
    sock.binaryType = 'arraybuffer';
    sock.onopen = function () {
      backoff = 400;
      S.lastMsg = performance.now();
      loadInfo();
    };
    sock.onmessage = function (ev) {
      S.lastMsg = performance.now();
      if (S.conn !== 'live' && !(S.rebooting && performance.now() - S.rebooting.t0 < 2500)) { S.everLive = true; setConn('live'); }
      if (typeof ev.data === 'string') {
        var s = null;
        try { s = JSON.parse(ev.data); } catch (e) { return; }
        onStatus(s);
      } else {
        onTelemetry(ev.data);
      }
    };
    sock.onclose = function () {
      if (ws !== sock) return;
      ws = null;
      if (S.conn !== 'rebooting') setConn(S.everLive ? 'reconnecting' : 'connecting');
      scheduleReconnect();
    };
    sock.onerror = function () { try { sock.close(); } catch (e) {} };
  }
  function scheduleReconnect() {
    clearTimeout(wsTimer);
    wsTimer = setTimeout(connect, backoff);
    backoff = Math.min(Math.round(backoff * 1.6), 6000);
  }
  // A socket that stays open but goes quiet (Wi-Fi drop without a FIN) is dead too.
  setInterval(function () {
    if (ws && ws.readyState === 1 && performance.now() - S.lastMsg > 4000) { try { ws.close(); } catch (e) {} }
    S.link.fps = S.conn === 'live' ? S.link.frames : null;
    S.link.frames = 0;
    renderLink();
    renderStale();
    renderParity();
  }, 1000);

  /* Stale: the connection dropped, or the device stopped sending. Everything that shows a
     live value fades (CSS .stale) and a banner says since when. */
  function renderStale() {
    var now = performance.now();
    var quietFrames = S.last && now - S.lastFrameSeen > 1500, quietStatus = S.statusAt && now - S.statusAt > 3000;
    var stale = S.everLive && (S.conn !== 'live' || !!quietFrames || !!quietStatus);
    if (stale !== S.stale) { S.stale = stale; document.body.classList.toggle('stale', stale); }
    if (S.conn === 'live') {   // the socket is open but nothing arrives
      $('conn').dataset.state = stale ? 'reconnecting' : 'live';
      setText('conn-text', stale ? 'stale' : 'live');
    }
    $('stale-banner').hidden = !stale;
    if (stale) {
      var since = Math.max(S.lastFrameSeen || 0, S.statusAt || 0), ago = since ? (now - since) / 1000 : null;
      setText('stale-text', (S.conn === 'rebooting' ? 'The device is rebooting' : S.conn !== 'live' ? 'Connection lost' : 'The device stopped sending') +
        (ago != null ? ' ' + duration(ago) + ' ago' : '') + ': the values below are frozen.');
    }
  }

  function loadInfo() {
    return fetchJSON('api/info', null, 5000).then(function (info) {
      var prev = S.info;
      S.info = info || {};
      renderInfo();
      var m = get(S.info, 'model', null);
      var crc = m ? m.crc32 || m.label : null;
      if (!m) { if (S.model.state !== 'none') { S.policy = null; S.hdr = null; S.model = { state: 'none', got: 0, total: 0, crc: null, error: '' }; renderModel(); } }
      else if (crc !== S.model.crc || S.model.state === 'error' || S.model.state === 'none') loadModel(crc, m.bytes);
      if (S.rebooting && prev) rebootDone(prev);
      if (!releasesLoaded) loadReleases();
      return info;
    }).catch(function () { /* the socket's reconnect loop retries */ });
  }

  var LOOP_HIST_MS = 5 * 60 * 1000;

  /* ---- Event log: fetched when status.events_seq moves ---- */
  function loadEvents() {
    if (S.events.loading) return;
    S.events.loading = true;
    fetchJSON('api/events', null, 4000).then(function (j) {
      S.events.loading = false;
      if (!j) return;
      var wasSeq = S.events.seq;
      S.events.seq = j.seq; S.events.list = j.events || []; S.events.boot = j.boot; S.events.uptimeMs = j.uptime_ms; S.events.at = performance.now();
      // Errors that arrived while Health was not on screen mark its tab.
      var bad = S.events.list.filter(function (e) { return e.level === 'error'; });
      var newest = bad.length ? bad[bad.length - 1].seq : 0;
      if (wasSeq < 0) S.events.seenBad = newest;   // the backlog at page load is not news
      if (S.tab === 'health') S.events.seenBad = newest;
      S.events.newBad = newest > S.events.seenBad;
      renderEvents();
    }).catch(function () { S.events.loading = false; });
  }

  // Misses per minute over the last minute of status messages.
  function missRate() {
    var mh = S.misses;
    if (mh.length < 2) return null;
    var a = mh[0], b = mh[mh.length - 1], dt = (b.t - a.t) / 60000;
    return dt > 0.05 ? (b.n - a.n) / dt : null;
  }

  /* ---- Model: download the device's blob, with progress ---- */
  function loadModel(crc, size) {
    S.model = { state: 'loading', got: 0, total: size || 0, crc: crc, error: '' };
    S.policy = null;
    renderModel();
    fetch('api/model', { cache: 'no-store' }).then(function (r) {
      if (r.status === 404) { S.model.state = 'none'; return null; }
      if (!r.ok) throw new Error('HTTP ' + r.status);
      S.model.total = +r.headers.get('Content-Length') || S.model.total;
      if (!r.body || !r.body.getReader) return r.arrayBuffer();
      var reader = r.body.getReader(), chunks = [], got = 0;
      function pump() {
        return reader.read().then(function (res) {
          if (res.done) {
            var all = new Uint8Array(got), o = 0;
            chunks.forEach(function (c) { all.set(c, o); o += c.length; });
            return all.buffer;
          }
          chunks.push(res.value); got += res.value.length; S.model.got = got;
          return pump();
        });
      }
      return pump();
    }).then(function (buf) {
      if (!buf) { renderModel(); return; }
      var h = parseNcpm(buf);
      if (buf.byteLength < h.expected_size) throw new Error('truncated download');
      S.hdr = h;
      S.layout = obsLayout(h);
      S.policy = createPolicy(h, buf);
      S.parity = null; S.parityN = 0;
      S.model.state = 'ready';
      renderModel();
      buildGoalButtons();
      renderControls(true);
    }).catch(function (e) {
      S.model.state = 'error'; S.model.error = e.message || String(e);
      renderModel();
    });
  }

  /* ---- Telemetry ---- */
  var tlmWarned = false;
  function onTelemetry(buf) {
    if (buf.byteLength < TLM.HDR) return;
    var dv = new DataView(buf), ver = dv.getUint8(0), count = dv.getUint8(1), fs = dv.getUint16(2, true);
    if (ver !== TLM.VERSION || fs < TLM.FRAME) {
      if (!tlmWarned) { tlmWarned = true; flash('cmd-msg', 'Telemetry v' + ver + ' (' + fs + ' B frames): this page reads v1 вЂ” <a href="" onclick="location.reload();return false">reload it</a> after a firmware update.', 'bad', 0, true); }
      if (fs < TLM.FRAME) return;
    }
    for (var i = 0; i < count; i++) {
      var off = TLM.HDR + i * fs;
      if (off + TLM.FRAME > buf.byteLength) break;
      pushFrame(decodeFrame(dv, off));
    }
  }

  var HIST_S = 6;
  function pushFrame(f) {
    var G = geom(), last = S.last;
    if (last && f.tick < last.tick) { S.hist = []; S.seg = null; }   // the device rebooted
    S.link.frames++;
    if (last && f.tick > last.tick) {
      var rate = get(S.info, 'telemetry.rate_hz', 0), step = rate ? Math.max(1, Math.round(1 / (G.dt * rate))) : 0;
      var missed = step ? Math.round((f.tick - last.tick) / step) - 1 : 0;
      if (missed > 0) { S.link.gaps++; S.link.lost += missed; }
    }
    var prevRun = S.run;
    S.last = f; S.lastFrameSeen = performance.now();
    S.run = RUN[f.run] || 'idle'; S.mode = MODE[f.mode] || 'ai';
    S.goal = goalLabel(G.n, f.goal); S.random = !!(f.flags & FLAG.RANDOM); S.xref = f.x_ref;
    S.backend = f.flags & FLAG.SIM ? 'sim' : 'rig';
    if (S.run !== 'fault') S.fault = '';
    if (S.pendingGoal && (S.pendingGoal === S.goal || performance.now() > S.pendingUntil)) S.pendingGoal = null;

    // Time to target: clock restarts on a new goal, on arming, and on a pose reset.
    if (!S.seg || S.seg.goal !== f.goal || (S.run === 'armed' && prevRun !== 'armed') || S.seg.restart) {
      S.seg = { goal: f.goal, tick0: f.tick, from: poseOf(f.est), reach: null, was: false };
    }
    if (f.flags & FLAG.SETTLED) {
      if (S.seg.reach === null && S.run === 'armed') S.seg.reach = Math.max(0, (f.tick - S.seg.tick0 - G.settle) * G.dt);
      S.seg.was = true;
    }

    var th = [];
    for (var k = 0; k < G.n; k++) th.push(lane(f.est[2 + 2 * k]));
    S.hist.push({ tick: f.tick, x: f.est[0], xr: f.x_ref, th: th, cmd: f.cmd, applied: f.applied, loop: f.loop_us, period: f.period_us });
    var keep = HIST_S / G.dt;
    while (S.hist.length && S.hist[0].tick < f.tick - keep) S.hist.shift();
    if (S.hist.length > 2000) S.hist.shift();
    renderControls(false);
  }

  /* ---- Status (2 Hz) ---- */
  function onStatus(s) {
    S.status = s; S.statusAt = performance.now();
    var L = s.loop || {}, now = performance.now();
    if (L.misses != null) {
      var mh = S.misses;
      if (mh.length && L.misses < mh[mh.length - 1].n) { mh.length = 0; S.missArm = null; }   // rebooted
      mh.push({ t: now, n: L.misses });
      while (mh.length > 2 && now - mh[0].t > 60000) mh.shift();
      if (s.run === 'armed' && S.statusRun !== 'armed') S.missArm = L.misses;
    }
    S.statusRun = s.run;
    if (L.exec_avg_us != null) {
      var lh = S.loopHist, prevMiss = lh.length ? lh[lh.length - 1].misses : L.misses;
      lh.push({ t: now, avg: L.exec_avg_us, max: L.exec_max_us, missed: L.misses > prevMiss, misses: L.misses });
      while (lh.length && now - lh[0].t > LOOP_HIST_MS) lh.shift();
    }
    if (s.events_seq != null && s.events_seq !== S.events.seq) loadEvents();
    if (!S.last || performance.now() - S.lastFrameSeen > 1000) {
      if (s.run) S.run = s.run;
      if (s.mode) S.mode = s.mode;
      if (s.goal) S.goal = s.goal;
      if (s.random != null) S.random = !!s.random;
      if (s.x_ref != null) S.xref = s.x_ref;
    }
    S.fault = s.run === 'fault' ? s.fault || '' : '';
    if (s.backend) S.backend = s.backend;
    renderStatus();
    renderControls(true);
  }

  /* ---- Rendering: header, info cards ---- */
  function kv(id, rows) {
    var e = $(id);
    if (!e) return;
    e.innerHTML = rows.filter(Boolean).map(function (r) {
      if (r.head) return '<span class="kv-head">' + esc(r.head) + '</span>';
      return '<dt>' + esc(r[0]) + '</dt><dd' + (r[2] ? ' class="' + r[2] + '"' : '') + (r[3] ? ' title="' + esc(r[3]) + '"' : '') + '>' + (r.html ? r[1] : esc(r[1] == null ? 'вЂ”' : r[1])) + '</dd>';
    }).join('');
  }

  function renderInfo() {
    var I = S.info || {}, fw = I.fw || {}, chip = I.chip || {}, m = I.model, ota = I.ota || {};
    setText('hostname', I.hostname || location.hostname || 'cartpole');
    document.title = (I.hostname || 'cartpole') + ' В· live controller';
    var be = I.backend || S.backend || '';
    $('backend').dataset.backend = be;
    setText('backend', be ? be.toUpperCase() : 'вЂ”');
    $('backend').title = be === 'rig' ? 'Real hardware: commands go to the motor drive' : be === 'sim' ? 'Simulated plant on the chip' : 'Plant backend';
    setText('model-label', m ? m.label || 'unnamed' : 'none');
    setText('foot-ver', fw.version ? 'v' + fw.version : '');
    setText('foot-chip', [chip.model, chip.mhz && chip.mhz + ' MHz', chip.cores && plural(chip.cores, 'core'), fw.idf && 'ESP-IDF ' + fw.idf].filter(Boolean).join(' В· '));
    var dt = (m && m.dt) || geom().dt;
    setText('fact-rate', Math.round(1 / dt) + ' Hz');
    setText('eyebrow', [chip.model ? chip.model.toLowerCase() : 'esp32-s3', be === 'rig' ? 'real rig' : be === 'sim' ? 'simulated plant' : null, geom().n === 2 ? 'double pendulum on a cart' : plural(geom().n, 'link') + ' on a cart'].filter(Boolean).join(' В· '));
    $('sim-tools').hidden = be !== 'sim';
    $('rig-tools').hidden = be !== 'rig';

    kv('sys-kv', [
      { head: 'chip' },
      ['model', [chip.model, chip.revision != null ? 'rev ' + chip.revision : null].filter(Boolean).join(' ') || null],
      ['cpu', chip.mhz ? chip.cores + ' Г— ' + chip.mhz + ' MHz' : null],
      ['flash / psram', chip.flash_mb != null ? chip.flash_mb + ' MB / ' + (chip.psram_mb || 0) + ' MB' : null],
      { head: 'firmware' },
      fw.version ? Object.assign(['version', /^\d+\.\d+\.\d+$/.test(fw.version)
        ? '<a href="https://github.com/' + esc(fw.repo || 'Tsmorz/n-cartpole') + '/releases/tag/fw-v' + esc(fw.version) + '" target="_blank" rel="noopener" title="Release notes">v' + esc(fw.version) + '</a>'
        : esc('v' + fw.version), 'accent'], { html: true }) : ['version', null],
      ['backend', be ? (be === 'rig' ? 'rig (motor drive)' : 'sim (plant on the chip)') : null],
      ['esp-idf', fw.idf],
      ['built', fw.built],
      ['telemetry', I.telemetry ? 'v' + I.telemetry.version + ' В· ' + I.telemetry.frame_size + ' B В· ' + I.telemetry.rate_hz + ' Hz' : null],
      { head: 'this boot' },
      ['boot', I.boot != null ? '#' + I.boot : null],
      ['last reset', I.reset_reason, /crash|watchdog|brownout/.test(I.reset_reason || '') ? 'bad' : '', 'Why the chip last restarted']
    ]);
    var hn = $('host-name');
    if (I.hostname && document.activeElement !== hn) { hn.placeholder = I.hostname; if (!hn.value) hn.value = ''; }
    var sysTag = $('sys-tag');
    sysTag.textContent = be ? be + ' build' : 'вЂ”';
    sysTag.className = 'tag' + (be === 'rig' ? ' ok' : '');
    kv('ota-kv', [
      ['running', fw.version ? 'v' + fw.version + ' on ' + (ota.running || '?') : ota.running, 'accent'],
      ['next slot', ota.next],
      ['image state', ota.state, ota.state === 'valid' ? 'good' : ota.state ? 'accent' : '', 'pending: rolls back unless it runs healthy for 10 s'],
      ['project', fw.project]
    ]);
    var tag = $('ota-tag');
    tag.textContent = ota.state === 'pending' ? 'new image: pending' : ota.state ? 'image ' + ota.state : 'вЂ”';
    tag.className = 'tag' + (ota.state === 'valid' ? ' ok' : ota.state === 'pending' ? ' warn' : '');
    renderModel();
    renderStatus();
    renderReleases();
  }

  function renderModel() {
    var m = get(S.info, 'model', null), h = S.hdr, st = S.model.state;
    $('model-dl').hidden = !m;
    var why = get(S.info, 'model_error', '');
    if (!m && st !== 'loading') {
      kv('model-kv', [['model', 'none stored', 'bad'], why ? ['rejected', why, 'bad', 'The stored blob failed validation at boot'] : null,
        { head: 'to add one' }, ['export', 'task export-firmware'], ['then', 'drop the .ncpm on Update']].filter(Boolean).map(function (r) {
          if (r[0] === 'export') { r[1] = copyCode('task export-firmware -- --checkpoint <ckpt>'); r.html = true; }
          if (r[0] === 'then') { r[1] = goto('settings:dropzone', 'drop the .ncpm on Update в†’'); r.html = true; }
          return r;
        }));
    } else {
      m = m || {};
      var G = geom(), dtype = m.dtype || (h ? h.dtype_name : null);
      var goals = m.goals || (h && h.goal ? goalLabels() : null);
      kv('model-kv', [
        ['label', m.label || (h && h.label), 'accent'],
        ['trained', m.step != null ? (m.step / 1e6).toFixed(m.step % 1e6 ? 2 : 0) + ' M steps' : null],
        ['links', (m.n_links || G.n) + (goals && goals.length ? ' В· goals ' + goals.join(' ') : '')],
        { head: 'network' },
        ['shape', (m.hidden || (h && h.hidden)) + ' Г— ' + (m.blocks != null ? m.blocks : h && h.n_blocks) + ' blocks В· Г—' + (m.expand || (h && h.expand) || 4)],
        ['inputs', m.obs_dim || (h && h.obs_dim)],
        ['params', m.params != null ? (m.params / 1e6).toFixed(2) + ' M' : h ? (h.params / 1e6).toFixed(2) + ' M' : null],
        ['size', (m.bytes != null ? bytes(m.bytes) : h ? bytes(h.total_size) : 'вЂ”') + (dtype ? ' В· ' + dtype : '')],
        ['weights in', m.weights_in ? (m.weights_in === 'psram' ? 'PSRAM' : 'internal SRAM') : null],
        { head: 'control' },
        ['estimator', m.estimator ? (m.estimator === 'ekf' ? 'EKF' : 'differenced') : h ? (h.ekf ? 'EKF' : 'differenced') : null],
        ['action', m.action_mode ? m.action_mode + (m.action_history ? ' В· ' + m.action_history + ' past cmds' : '') : null],
        ['delay', m.delay_steps != null ? plural(m.delay_steps, 'step') : null],
        ['dt', G.dt ? (G.dt * 1000).toFixed(G.dt < 0.01 ? 1 : 0) + ' ms В· ' + Math.round(1 / G.dt) + ' Hz' : null],
        ['force', 'В±' + num(G.fmax, 2) + ' N' + (G.slew ? ' В· ' + num(G.slew, 0) + ' N/s' : '')],
        ['rail', 'В±' + num(G.x_lim, 2) + ' m'],
        ['crc32', m.crc32]
      ]);
    }
    if (h) {
      var xl = Math.round(h.x_lim / 2 * 100) / 100, sl = $('xref');
      sl.min = -xl; sl.max = xl;
      setText('xref-min', minus((-xl).toFixed(2))); setText('xref-max', '+' + xl.toFixed(2));
    }
    renderNetMeta();
  }

  function renderNetMeta() {
    var e = $('nn-meta'), h = S.hdr, st = S.model.state;
    if (st === 'loading') {
      var pct = S.model.total ? Math.round(100 * S.model.got / S.model.total) : null;
      e.textContent = 'downloading weights' + (pct != null ? ' В· ' + pct + ' %' : '') + ' В· ' + bytes(S.model.got) + (S.model.total ? ' / ' + bytes(S.model.total) : '');
      return;
    }
    if (!h) {
      var why = get(S.info, 'model_error', '');
      e.textContent = st === 'none' ? 'no model on the device' + (why ? ' В· stored one rejected: ' + why : '') : st === 'error' ? 'could not load the model: ' + S.model.error : '';
      if (st === 'none') e.insertAdjacentHTML('beforeend', ' В· ' + goto('settings:dropzone', 'upload one в†’'));
      return;
    }
    var parts = [h.hidden + ' Г— ' + h.n_blocks + ' blocks', (h.params / 1e6).toFixed(2) + ' M params', h.dtype_name];
    if (S.netMs) parts.push('forward ' + S.netMs.toFixed(1) + ' ms');
    var html = esc(parts.join(' В· '));
    if (S.parity != null) html += ' В· <span class="' + (S.parity < 0.05 ? 'ok' : '') + '" title="Mean |command the browser predicts в€’ command the device sent|">browser vs device |О”F| ' + S.parity.toFixed(3) + ' N</span>';
    e.innerHTML = html;
  }

  function renderStatus() {
    var s = S.status || {}, L = s.loop || {}, period = L.period_us || geom().dt * 1e6;
    // Health
    var ex = L.exec_avg_us, mx = L.exec_max_us, pol = L.policy_avg_us, est = L.est_avg_us;
    setText('loop-exec', us(ex)); setText('loop-period', us(period));
    var nominal = geom().dt * 1e6, load = ex != null ? ex / nominal : null, rtf = L.rt_factor;
    setText('fact-exec', load != null ? Math.round(100 * load) + ' %' : 'вЂ”');
    $('fact-exec').className = load != null && load > 0.8 ? 'bad' : '';
    $('fact-exec').title = 'Average execution against the ' + us(nominal) + ' control period' +
      (rtf != null && rtf < 0.995 ? '; the simulator runs in slow motion (Г—' + rtf.toFixed(2) + ') to fit it' : '');
    var rate = missRate(), sinceArm = S.missArm != null && L.misses != null && s.run === 'armed' ? L.misses - S.missArm : null;
    setText('fact-miss', rate != null ? num(rate, rate < 10 ? 1 : 0) : 'вЂ”');
    $('fact-miss').className = rate ? 'bad' : '';
    function pct(v) { return clamp(100 * (v || 0) / period, 0, 100); }
    var pp = pct(pol), pe = pct(est), pr = Math.max(0, pct(ex) - pp - pe);
    $('seg-pol').style.width = pp + '%';
    $('seg-est').style.left = pp + '%'; $('seg-est').style.width = pe + '%';
    $('seg-rest').style.left = (pp + pe) + '%'; $('seg-rest').style.width = pr + '%';
    $('loop-max').style.left = pct(mx) + '%';
    $('loop-meter').classList.toggle('over', ex != null && ex > 0.8 * period);
    setText('h-pol', us(pol)); setText('h-est', us(est));
    setText('h-max', mx != null ? us(mx) + ' (' + Math.round(100 * mx / period) + ' %)' : 'вЂ”');
    setText('h-miss', L.misses == null ? 'вЂ”' : (rate != null ? num(rate, 1) + ' /min' : 'вЂ¦') + (sinceArm != null ? ' В· ' + sinceArm + ' since armed' : '') + ' В· ' + L.misses + ' total');
    $('h-miss').className = rate ? 'bad' : L.misses ? 'accent' : '';
    $('h-miss').title = 'Rate over the last minute; the total counts since boot';
    var rt = L.rt_factor;
    setText('h-rt', rt != null ? 'Г—' + rt.toFixed(2) + (rt < 0.995 ? ' slow motion' : '') : 'вЂ”');
    var bt = $('budget-tag'), ok = L.budget_ok;
    if (ex == null) { bt.textContent = 'вЂ”'; bt.className = 'tag'; }
    else if (ok === false) { bt.textContent = 'over budget'; bt.className = 'tag bad'; }
    else if (rate) { bt.textContent = 'missing deadlines'; bt.className = 'tag warn'; }
    else { bt.textContent = 'within budget'; bt.className = 'tag ok'; }
    S.healthWarn = (ex != null && ok === false) || !!rate;
    renderIO(s.io, s.calib);
    healthAlert();
    setText('h-note', ok === false
      ? (S.backend === 'rig' ? 'Arming is refused while the loop runs over 80 % of its period: pick a smaller model.' : 'Over budget: the simulator stretches its period instead (slow motion), so the model can still be tried.')
      : 'The loop runs the estimator and the network every tick, armed or not, so its timing is known before arming.');

    // Cores & tasks
    var cores = s.cores || [];
    [0, 1].forEach(function (id) {
      var c = cores.filter(function (x) { return x.id === id; })[0];
      setText('core' + id + '-load', c ? c.load.toFixed(1) + ' %' : 'вЂ”');
      $('core' + id + '-fill').style.width = c ? clamp(c.load, 0, 100) + '%' : '0';
    });
    renderTasks(s.tasks);

    // Wi-Fi (Settings) and memory + link (Health)
    var w = s.wifi || {};
    setText('up-tag', s.uptime_s != null ? 'up ' + duration(s.uptime_s) : 'вЂ”');
    renderLink();
    var bars = '', r = w.rssi;
    if (r != null) {
      var lvl = r >= -55 ? 4 : r >= -65 ? 3 : r >= -75 ? 2 : 1;
      bars = '<span class="rssi" aria-hidden="true">' + [4, 6, 8, 11].map(function (hh, i) { return '<i class="' + (i < lvl ? 'on' : '') + '" style="height:' + hh + 'px"></i>'; }).join('') + '</span>';
    }
    kv('wifi-kv', [
      ['mode', w.mode ? (w.mode === 'ap' ? 'access point' : 'station') : null, 'accent'],
      [w.mode === 'ap' ? 'network' : 'joined', w.ssid],
      ['ip', addrLink(w.ip)],
      ['mdns', addrLink((get(S.info, 'hostname', null) || 'cartpole') + '.local')],
      w.mode === 'ap' ? null : ['signal', r != null ? bars + esc(r + ' dBm') : 'вЂ”']
    ].map(function (row) { if (row && (row[0] === 'signal' || row[0] === 'ip' || row[0] === 'mdns')) row.html = true; return row; }));
    var wt = $('wifi-tag');
    wt.textContent = w.mode === 'ap' ? 'AP В· setup' : w.mode ? 'STA' : 'вЂ”';
    wt.className = 'tag' + (w.mode === 'ap' ? ' warn' : w.mode ? ' ok' : '');
    S.wifiMode = w.mode;
    setTabAlert('settings', w.mode === 'ap' ? 'warn' : null);
    if (S.tabAuto) { S.tabAuto = false; if (w.mode === 'ap') showTab('settings'); }
    trackJoin(w.join);
    var ssid = $('wifi-ssid');
    if (w.ssid && !ssid.value && document.activeElement !== ssid && w.mode !== 'ap') ssid.placeholder = w.ssid;
  }

  var IDLE_TASKS = /^(IDLE\d?|ipc\d)$/;
  function renderTasks(tasks) {
    var body = $('task-rows'), check = $('layout-check'), tag = $('layout-tag');
    if (!tasks || !tasks.length) return;
    var bad = [];
    tasks.forEach(function (t) {
      if (t.name === 'ctrl' && t.core !== 1) bad.push('ctrl is not pinned to core 1');
      else if (t.name !== 'ctrl' && t.core === 1 && !IDLE_TASKS.test(t.name)) bad.push(t.name + ' shares core 1 with the control loop');
      else if (t.name !== 'ctrl' && t.core === -1 && !IDLE_TASKS.test(t.name)) bad.push(t.name + ' may run on core 1 (unpinned)');
    });
    var hasCtrl = tasks.some(function (t) { return t.name === 'ctrl'; });
    if (!hasCtrl) bad.push('no ctrl task');
    var sorted = tasks.slice().sort(function (a, b) {
      var ca = a.core === -1 ? 2 : a.core, cb = b.core === -1 ? 2 : b.core;
      if (cb !== ca) return ca === 1 ? -1 : cb === 1 ? 1 : ca - cb;
      var ia = IDLE_TASKS.test(a.name), ib = IDLE_TASKS.test(b.name);
      return ia !== ib ? (ia ? 1 : -1) : (b.cpu || 0) - (a.cpu || 0);
    });
    body.innerHTML = sorted.map(function (t) {
      var misplaced = (t.name === 'ctrl' && t.core !== 1) || (t.name !== 'ctrl' && t.core !== 0 && !IDLE_TASKS.test(t.name));
      var cls = (t.name === 'ctrl' ? 'hl' : IDLE_TASKS.test(t.name) ? 'idle' : '') + (misplaced ? ' misplaced' : '');
      var core = t.core === -1 ? 'any' : t.core;
      var cpu = t.cpu == null ? 'вЂ”' : t.cpu.toFixed(1) + ' %';
      return '<tr class="' + cls + '"><td>' + esc(t.name) + '</td><td><span class="core-badge c' + esc(core) + '">' + esc(core) + '</span></td><td>' + esc(t.prio != null ? t.prio : 'вЂ”') +
        '</td><td><span class="cpu-cell">' + cpu + '<span class="cpu-bar"><i style="width:' + clamp(t.cpu || 0, 0, 100) + '%"></i></span></span></td><td>' + (t.stack_free != null ? esc(t.stack_free) + ' B' : 'вЂ”') + '</td></tr>';
    }).join('');
    if (bad.length) {
      check.innerHTML = '<span class="bad">вњ•</span> ' + esc(bad.join('; '));
      tag.textContent = 'check pinning'; tag.className = 'tag bad';
    } else {
      check.innerHTML = '<span class="ok">вњ“</span> ctrl runs alone on core 1; Wi-Fi, lwIP, httpd and telemetry stay on core 0.';
      tag.textContent = 'pinning ok'; tag.className = 'tag ok';
    }
  }

  // Health в†’ Memory & link: the status heap figures plus the telemetry this page receives.
  function renderLink() {
    var s = S.status || {}, hp = s.heap || {}, w = s.wifi || {}, L = S.link, live = S.conn === 'live';
    var rate = get(S.info, 'telemetry.rate_hz', null), age = S.statusAt ? (performance.now() - S.statusAt) / 1000 : null;
    // In slow motion (sim over budget) the device sends fewer frames per second by design.
    var rtf = get(s, 'loop.rt_factor', 1) || 1, expect = rate ? Math.round(rate * Math.min(1, rtf)) : null;
    var low = live && L.fps != null && expect && L.fps < 0.8 * expect;
    setText('fact-link', live && L.fps != null ? L.fps + ' fps' : 'вЂ”');
    kv('dev-kv', [
      { head: 'memory' },
      ['internal free', hp.internal_free != null ? bytes(hp.internal_free) : null, '', 'heap_caps_get_free_size(MALLOC_CAP_INTERNAL)'],
      ['lowest since boot', hp.internal_min != null ? bytes(hp.internal_min) : null, hp.internal_min != null && hp.internal_min < 16384 ? 'bad' : '', 'Below ~16 KB, Wi-Fi and HTTP allocations start to fail'],
      ['largest free block', hp.internal_largest != null ? bytes(hp.internal_largest) : null, '', 'heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL): the biggest single internal allocation that can still succeed'],
      ['failed allocations', hp.alloc_failed != null ? String(hp.alloc_failed) : null, hp.alloc_failed ? 'bad' : '', 'Since boot, any heap; the event log says which and when'],
      ['psram free', hp.psram_free != null ? bytes(hp.psram_free) : null],
      { head: 'link' },
      ['wi-fi', w.mode === 'ap' ? 'access point (setup)' : w.rssi != null ? w.rssi + ' dBm' + (w.ssid ? ' В· ' + w.ssid : '') : null, w.mode === 'ap' ? 'accent' : w.rssi != null && w.rssi < -75 ? 'bad' : ''],
      ['telemetry', live && L.fps != null ? L.fps + (expect ? ' / ' + expect : '') + ' fps' + (rtf < 0.995 ? ' (slow motion Г—' + rtf.toFixed(2) + ')' : '') : live ? 'вЂ¦' : 'not connected', low ? 'bad' : live ? 'good' : ''],
      ['frames lost', live ? L.lost + (L.gaps ? ' in ' + plural(L.gaps, 'gap') : '') : null, L.lost ? 'accent' : ''],
      ['status age', age != null && live ? age.toFixed(1) + ' s' : null, age != null && age > 2 ? 'bad' : ''],
      ['device clock', s.unix ? when(s.unix) + ' (SNTP)' : S.status ? 'not set (no internet yet)' : null, s.unix ? '' : 'accent', 'Event-log and calibration times use it']
    ]);
  }

  // Health в†’ Sensors & drive (rig): encoders with the AS5048A diagnostics, e-stop, drive, zero refs.
  // Also the calibration line under Live в†’ Calibrate and the "last fault" line over the scene.
  var ioPrevBad = null;
  function renderIO(io, cal) {
    var body = $('io-body'), tag = $('io-tag'), s = S.status || {}, f = s.faults || {};
    // Last fault (any backend), while not in one
    var ago = f.ago_s != null ? f.ago_s + (performance.now() - S.statusAt) / 1000 : null;
    setText('run-last', S.conn === 'live' && f.count && S.run !== 'fault' ? 'last fault: ' + (f.last || '?') + (ago != null ? ' В· ' + duration(ago) + ' ago' : '') + (f.count > 1 ? ' В· ' + f.count + ' since boot' : '') : '');
    if (!io) return;
    if (!io.rig) {
      if (body.dataset.mode !== 'sim') {
        body.dataset.mode = 'sim';
        body.innerHTML = '<p class="panel-hint">The simulated plant has no encoders, e-stop or drive. On the rig backend this card shows the joint encoders (with the magnet diagnostics), the cart encoder, the e-stop input, the drive and the zero references.</p>';
      }
      tag.textContent = 'sim'; tag.className = 'tag';
      S.ioBad = false;
      return;
    }
    body.dataset.mode = 'rig';
    var problems = [], warns = [], enc = io.enc || [], names = ['joint 1 В· Оёв‚Ѓ', 'joint 2 В· П† = Оёв‚‚ в€’ Оёв‚Ѓ'];
    if (io.estop) problems.push('e-stop pressed');
    if (io.read_errors) problems.push(io.read_errors + ' bad reads in a row');
    var rows = enc.map(function (e, i) {
      var mag = 'not read yet', cls = '';
      if (e.agc != null) {
        var issues = [];
        if (e.comp_high) issues.push('field too weak (magnet too far)');
        if (e.comp_low) issues.push('field too strong (magnet too close)');
        if (e.cof) issues.push('CORDIC overflow');
        if (e.ocf === false) issues.push('offset compensation not finished');
        mag = issues.length ? issues.join(', ') : 'ok';
        cls = issues.length ? 'bad' : e.agc > 220 || e.agc < 20 ? 'accent' : 'good';
        mag += ' В· AGC ' + e.agc;
        if (issues.length) problems.push('encoder ' + (i + 1) + ': ' + issues.join(', '));
        else if (cls === 'accent') warns.push('encoder ' + (i + 1) + ': AGC ' + e.agc + ' near its limit');
      }
      var grew = ioPrevBad && e.bad > ioPrevBad[i];
      if (grew) warns.push('encoder ' + (i + 1) + ': bad reads rising');
      return '<tr><td>' + esc(names[i] || 'enc ' + (i + 1)) + '</td><td>' + e.raw + '</td><td>' + num(e.raw * 360 / 16384, 1) + 'В°</td>' +
        '<td class="' + cls + '">' + esc(mag) + '</td><td class="' + (grew ? 'bad' : e.bad ? 'accent' : '') + '">' + e.bad + '</td></tr>';
    });
    ioPrevBad = enc.map(function (e) { return e.bad; });
    cal = cal || {};
    if (!cal.angles) problems.push('angles not zeroed');
    if (!cal.cart) problems.push('cart not zeroed');
    var zeroLink = !cal.angles || !cal.cart ? ' ' + goto('live:rig-tools', 'Zero on Live в†’') : '';
    body.innerHTML =
      '<div class="table-wrap"><table class="tasks io-table" aria-label="Joint encoders"><thead><tr><th scope="col">encoder</th><th scope="col">raw</th><th scope="col">raw angle</th><th scope="col">magnet</th><th scope="col">bad reads</th></tr></thead><tbody>' + rows.join('') + '</tbody></table></div>' +
      '<dl class="kv">' + [
        ['e-stop', io.estop ? 'PRESSED' : 'released', io.estop ? 'bad' : 'good'],
        ['drive', io.drive ? 'enabled В· ' + Math.round(100 * (io.duty || 0)) + ' % ' + (io.dir < 0 ? 'в€’x' : '+x') : 'disabled (EN low)', io.drive ? 'accent' : ''],
        ['cart encoder', io.cart_count + ' counts'],
        { head: 'zero references' },
        ['angles', cal.angles ? setWhen(cal.angles_unix, cal.angles_boot) + (cal.off1 != null ? ' В· ' + num(cal.off1, 4) + ', ' + num(cal.off2, 4) + ' rad' : '') : 'not set', cal.angles ? 'good' : 'bad'],
        ['cart', cal.cart ? setWhen(cal.cart_unix, cal.cart_boot) + (cal.x_zero != null ? ' В· ' + num(cal.x_zero, 4) + ' m' : '') : 'not set', cal.cart ? 'good' : 'bad']
      ].map(function (r) {
        return r.head ? '<span class="kv-head">' + esc(r.head) + '</span>' : '<dt>' + esc(r[0]) + '</dt><dd class="' + (r[2] || '') + '">' + esc(r[1]) + '</dd>';
      }).join('') + '</dl>' +
      (problems.length || warns.length ? '<p class="check-line"><span class="' + (problems.length ? 'bad' : 'warn') + '">' + (problems.length ? 'вњ•' : '!') + '</span> ' + esc(problems.concat(warns).join('; ')) + zeroLink + '</p>'
        : '<p class="check-line"><span class="ok">вњ“</span> Encoders read cleanly, the magnets are in range, and both zero references are set.</p>');
    tag.textContent = io.estop ? 'e-stop' : problems.length ? (cal.angles && cal.cart ? 'check sensors' : 'not zeroed') : warns.length ? 'watch' : 'ok';
    tag.className = 'tag ' + (problems.length ? 'bad' : warns.length ? 'warn' : 'ok');
    S.ioBad = problems.length > 0;
    // Live в†’ Calibrate
    var cl = $('cal-line');
    cl.textContent = cal.angles && cal.cart ? 'Zeroed: angles ' + setWhen(cal.angles_unix, cal.angles_boot).replace(/^set /, '') + ', cart ' + setWhen(cal.cart_unix, cal.cart_boot).replace(/^set /, '') + '. Re-zero after moving a magnet or the belt.'
      : (!cal.angles && !cal.cart ? 'Neither zero reference is set' : !cal.angles ? 'The angles are not zeroed' : 'The cart is not zeroed') + ': arming is refused until both are.';
    cl.className = 'panel-hint' + (cal.angles && cal.cart ? '' : ' bad');
  }

  function healthAlert() {
    setTabAlert('health', S.events.newBad || S.ioBad ? 'bad' : S.healthWarn ? 'warn' : null);
  }

  // Unix seconds в†’ local "22 Oct 14:03" (today: just the time).
  function when(unix) {
    var d = new Date(unix * 1000), today = new Date().toDateString() === d.toDateString();
    var hm = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    return today ? hm : d.toLocaleDateString([], { day: 'numeric', month: 'short' }) + ' ' + hm;
  }
  // "set 22 Oct 14:03 (boot #5)" for a zero reference.
  function setWhen(unix, boot) {
    return 'set' + (unix ? ' ' + when(unix) : '') + (boot ? (unix ? ' (boot #' + boot + ')' : ' on boot #' + boot) : '');
  }
  function clock(ms) {
    var t = Math.max(0, Math.floor(ms / 1000)), h = Math.floor(t / 3600), m = Math.floor(t / 60) % 60, x = t % 60;
    return (h ? h + ':' + (m < 10 ? '0' : '') : '') + m + ':' + (x < 10 ? '0' : '') + x;
  }
  function renderEvents() {
    var E = S.events, list = $('events');
    if (!E.list.length) { list.innerHTML = '<li class="muted">Nothing yet.</li>'; return; }
    // Newest first, grouped by boot: entries from before a reset (crash, watchdog, brownout,
    // reboot) survive in the device's RTC memory and explain what happened.
    var html = [], prevBoot = null, multi = E.list.some(function (e) { return e.boot != null && e.boot !== E.boot; });
    E.list.slice().reverse().forEach(function (e) {
      if (multi && e.boot !== prevBoot) {
        html.push('<li class="ev-sep">' + (e.boot === E.boot ? 'this boot' : 'before the reset') + (e.boot != null ? ' В· boot #' + e.boot : '') + '</li>');
        prevBoot = e.boot;
      }
      html.push('<li class="ev ev-' + esc(e.level) + (multi && e.boot !== E.boot ? ' ev-prev' : '') + '"><time title="' + (e.unix ? esc(new Date(e.unix * 1000).toLocaleString()) + ' В· ' : '') + clock(e.t_ms) + ' after boot #' + e.boot + '">' + (e.unix ? when(e.unix) : clock(e.t_ms)) + '</time><span>' + linkify(e.msg) + '</span></li>');
    });
    list.innerHTML = html.join('');
    var nBad = E.list.filter(function (e) { return e.level === 'error'; }).length, nWarn = E.list.filter(function (e) { return e.level === 'warn'; }).length;
    var tag = $('log-tag');
    tag.textContent = nBad ? plural(nBad, 'error') : nWarn ? plural(nWarn, 'warning') : 'no errors';
    tag.className = 'tag ' + (nBad ? 'bad' : nWarn ? 'warn' : 'ok');
    healthAlert();
  }

  // Settings в†’ Model: does this page's forward pass of the device's blob give the device's command?
  function renderParity() {
    var e = $('model-check');
    if (!S.policy) { e.innerHTML = ''; return; }
    if (S.parity == null) {
      e.innerHTML = '<span class="muted">в—‹</span> Browser check: waiting. Arm in AI (no excitation) and this page compares its own forward pass of the blob with the command the device sends.';
      return;
    }
    var fresh = performance.now() - S.parityAt < 2000, ok = S.parity < 0.05;
    e.innerHTML = (ok ? '<span class="ok">вњ“</span> The browser\'s forward pass matches the device' : '<span class="bad">вњ•</span> The browser and the device disagree (blob, observation layout or action pipeline)') +
      ': mean <span class="nowrap">|О”F| ' + S.parity.toFixed(3) + ' N</span> over ' + S.parityN.toLocaleString('en-US') + ' ticks' + (fresh ? '.' : ' (last armed run).');
  }

  // Live в†’ time to target: only while the AI drives; counts up until the goal is reached.
  function renderReach() {
    var live = S.conn === 'live', seg = S.seg, f = S.last, G = geom();
    var show = live && S.run === 'armed' && S.mode === 'ai' && seg && f;
    $('reach').hidden = !show;
    if (!show) return;
    var settled = f.flags & FLAG.SETTLED, val, lbl, state, running = false;
    if (seg.from && seg.from === S.goal) {
      val = 'вЂ”'; lbl = 'holding at ' + S.goal; state = settled ? 'holding' : 'recovering';
    } else if (seg.reach != null) {
      val = seg.reach.toFixed(2); lbl = (seg.from ? seg.from + ' ' : '') + 'в†’ ' + S.goal + ' (s)'; state = settled ? 'holding' : 'knocked out В· recovering';
    } else {
      val = ((f.tick - seg.tick0) * G.dt).toFixed(1); lbl = (seg.from ? seg.from + ' ' : '') + 'в†’ ' + S.goal + ' (s)'; state = 'on its way'; running = true;
    }
    setText('reach-val', val); setText('reach-lbl', lbl); setText('reach-state', state);
    $('reach-val').classList.toggle('running', running);
  }

  // Live в†’ State: estimate / encoder readings / true state, refreshed ~10 Hz.
  var roKey = '';
  function renderReadout() {
    var f = S.last, G = geom(), n = G.n, truth = !!(f && (f.flags & FLAG.TRUTH)), body = $('ro-rows');
    var key = n + '|' + truth;
    if (key !== roKey) {
      roKey = key;
      var sub = 'в‚Ѓв‚‚в‚ѓв‚„', rows = [['x', 'm'], ['бє‹', 'm/s']];
      for (var k = 0; k < n; k++) rows.push(['Оё' + sub[k], 'В°'], ['ОёМ‡' + sub[k], 'В°/s']);
      body.innerHTML = rows.map(function (r) {
        return '<tr><th scope="row">' + r[0] + ' <span>' + r[1] + '</span></th><td></td><td></td><td class="ro-true"></td></tr>';
      }).join('');
      $('ro-true-h').hidden = !truth;
      body.querySelectorAll('.ro-true').forEach(function (td) { td.hidden = !truth; });
    }
    var cells = body.querySelectorAll('td'), D = 180 / Math.PI;
    function put(i, v, d) { var c = cells[i]; if (c) { var t = v == null || !isFinite(v) ? 'вЂ”' : num(v, d); if (c.textContent !== t) c.textContent = t; } }
    // Rows: x, бє‹, then Оёв‚– (В°, as the plot lanes) and ОёМ‡в‚– (В°/s); meas holds positions only: [x, Оёв‚Ѓ, вЂ¦].
    function val(v, r) { return r < 2 ? v : r % 2 === 0 ? lane(v) : v * D; }
    for (var r = 0; r < 2 + 2 * n; r++) {
      var ang = r >= 2 && r % 2 === 0, d = r === 0 ? 3 : r === 1 ? 2 : ang ? 1 : 0;
      var mi = r === 0 ? 0 : ang ? 1 + (r - 2) / 2 : -1;
      put(3 * r, f ? val(f.est[r], r) : null, d);
      put(3 * r + 1, f && mi >= 0 ? val(f.meas[mi], r) : null, d);
      put(3 * r + 2, f && truth ? val(f.truth[r], r) : null, d);
    }
    setText('ro-tick', f ? 'tick ' + f.tick : '');
    var margin = f ? G.x_lim - Math.abs(f.est[0]) : null;
    kv('ro-kv', [
      ['force cmd', f ? signed(f.cmd, 2) + ' N' : null],
      ['force applied', f ? signed(f.applied, 2) + ' N' : null],
      ['rail margin', margin != null ? num(margin, 3) + ' m' : null, margin != null && margin < 0.1 * G.x_lim ? 'bad' : ''],
      ['settled', f ? (f.flags & FLAG.SETTLED ? 'yes В· at ' + (S.goal || '?') : 'no') : null, f && (f.flags & FLAG.SETTLED) ? 'good' : '']
    ]);
  }

  /* ---- Controls ---- */
  // Pictogram of a target pose (swingup.js goalIcon): cart on a rail, link 1 then link 2.
  function goalIcon(label) {
    var cx = 16, cy = 26, L = 12, x = cx, y = cy, tilt = -0.1;
    var out = '<svg viewBox="0 0 32 52" focusable="false">' +
      '<line class="gi-rail" x1="2" y1="' + (cy + 3) + '" x2="30" y2="' + (cy + 3) + '"/>' +
      '<rect class="gi-cart" x="11" y="' + (cy - 2.5) + '" width="10" height="5" rx="1.5"/>';
    var Lk = L * 2 / Math.max(2, label.length);
    for (var k = 0; k < label.length; k++) {
      if (k > 0) tilt += label[k] === label[k - 1] ? 0.4 : 0.8;
      var th = (label[k] === 'D' ? Math.PI : 0) + tilt;
      var nx = x + Lk * Math.sin(th), ny = y - Lk * Math.cos(th);
      out += '<line class="gi-rod" x1="' + x.toFixed(1) + '" y1="' + y.toFixed(1) + '" x2="' + nx.toFixed(1) + '" y2="' + ny.toFixed(1) + '"/>' +
             '<circle class="gi-bob-' + (k % 2) + '" cx="' + nx.toFixed(1) + '" cy="' + ny.toFixed(1) + '" r="3"/>';
      x = nx; y = ny;
    }
    return out + '</svg>';
  }
  var GOAL_TITLES = { UU: 'Both up', UD: 'Оёв‚Ѓ up, Оёв‚‚ down', DU: 'Оёв‚Ѓ down, Оёв‚‚ up', DD: 'Both down' };
  var goalKey = '';
  function buildGoalButtons() {
    var labels = goalLabels(), key = labels.join(',');
    if (key === goalKey) return;
    goalKey = key;
    // 2 links: the site's 2 Г— 2 (rows: link 1 up, down; columns: link 2 up, down).
    var order = labels.length === 4 ? ['UU', 'UD', 'DU', 'DD'] : labels;
    var grid = $('goal-grid'), rnd = $('goal-random');
    Array.prototype.slice.call(grid.querySelectorAll('[data-goal]')).forEach(function (b) { b.remove(); });
    order.forEach(function (l) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'goal-btn'; b.dataset.goal = l;
      b.title = GOAL_TITLES[l] || l; b.setAttribute('aria-label', l + ': ' + (GOAL_TITLES[l] || l)); b.setAttribute('aria-pressed', 'false');
      b.innerHTML = '<span class="goal-icon" aria-hidden="true">' + goalIcon(l) + '</span><span class="goal-label">' + l + '</span>';
      b.addEventListener('click', function () {
        S.pendingGoal = l; S.pendingUntil = performance.now() + 1500; renderControls(true);
        send({ goal: l }).catch(function () { S.pendingGoal = null; renderControls(true); });
      });
      grid.insertBefore(b, rnd);
    });
    // Sim: restart the plant at any pose (hanging first).
    var row = $('pose-row');
    row.innerHTML = '';
    var poses = labels.slice().sort(function (a, b) { return (b.split('D').length) - (a.split('D').length); });
    poses.forEach(function (l) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'goal-btn'; b.dataset.pose = l;
      b.title = 'Restart the simulated plant at ' + l + (l.indexOf('U') < 0 ? ' (hanging)' : '');
      b.innerHTML = '<span class="goal-icon" aria-hidden="true">' + goalIcon(l) + '</span><span class="goal-label">' + (l.indexOf('U') < 0 ? 'hang' : l) + '</span>';
      b.addEventListener('click', function () {
        send({ reset: l }).then(function () { if (S.seg) S.seg.restart = true; flash('cmd-msg', 'Plant reset to ' + l + '.', 'good', 2000); }).catch(function () {});
      });
      row.appendChild(b);
    });
  }

  var ctrlKey = '';
  function renderControls(force) {
    var live = S.conn === 'live', run = S.run, armed = run === 'armed';
    var noModel = S.model.state === 'none' || get(S.info, 'model', 1) === null;
    var key = [live, run, S.mode, S.goal, S.random, S.fault, S.pendingGoal, noModel, S.backend, S.model.state, S.seg && S.seg.reach, S.last && (S.last.flags & FLAG.SETTLED)].join('|');
    if (!force && key === ctrlKey) return;
    ctrlKey = key;

    // Arm (Live and Record carry one each)
    document.querySelectorAll('[data-arm]').forEach(function (arm) {
      arm.classList.toggle('armed', armed);
      arm.classList.toggle('fault', run === 'fault');
      arm.setAttribute('aria-pressed', armed ? 'true' : 'false');
      arm.disabled = !live || run === 'maint' || run == null;
      arm.querySelector('.arm-label').textContent = armed ? 'Armed В· disarm' : run === 'fault' ? 'Re-arm' : run === 'maint' ? 'Writing flashвЂ¦' : 'Arm';
      var cal = get(S.status, 'calib', null);   // rig: say why arming will be refused before the click
      arm.title = !armed && cal && !(cal.angles && cal.cart) ? 'The rig refuses to arm until the angles and the cart are zeroed (Live в†’ Calibrate)'
        : 'Arm sends the commands to the drive. Esc disarms from anywhere on the page.';
    });
    // Header: the controller state, on every tab
    var rc = $('run-chip');
    rc.dataset.run = live ? run || '' : '';
    setText('run-chip-text', !live ? 'вЂ”' : (run || 'вЂ”').toUpperCase() + (run === 'fault' && S.fault ? ' В· ' + S.fault : ''));
    rc.title = armed ? 'Armed: click (or Esc) to disarm' : run === 'fault' ? 'Fault: ' + (S.fault || 'tripped') + '. Re-arm on Live.' : 'Controller state. Esc disarms from any tab.';
    setText('rec-ctrl-note', !live ? '' : run === 'fault' ? 'fault В· ' + (S.fault || 'tripped') : (S.mode === 'manual' ? 'Manual В· PD holds the cart at ' + signed(S.xref, 2) + ' m' : 'AI в†’ ' + (S.goal || '?')) + (armed ? '' : ' В· not driving'));

    // Mode
    document.querySelectorAll('.mode-btn[data-mode]').forEach(function (b) {
      var on = b.dataset.mode === S.mode;
      b.classList.toggle('active', on); b.setAttribute('aria-pressed', on ? 'true' : 'false');
      b.disabled = !live || (b.dataset.mode === 'ai' && noModel);
      b.title = b.dataset.mode === 'ai' && noModel ? 'No model on the device' : '';
    });
    $('mode-hint').innerHTML = S.mode === 'manual'
      ? '<strong>Manual:</strong> a PD loop (в‰¤ 10 N) drives the cart to the slider position вЂ” jog it, or nudge the links.'
      : '<strong>AI:</strong> the network drives to the target and balances around the slider position.';

    // Goals
    document.querySelectorAll('.goal-btn[data-goal]').forEach(function (b) {
      var on = b.dataset.goal === S.goal;
      b.classList.toggle('active', on && !S.pendingGoal);
      b.classList.toggle('pending', b.dataset.goal === S.pendingGoal);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
      b.disabled = !live;
    });
    var rnd = $('goal-random');
    rnd.classList.toggle('active', !!S.random); rnd.setAttribute('aria-pressed', S.random ? 'true' : 'false'); rnd.disabled = !live;
    document.querySelectorAll('.goal-btn[data-pose]').forEach(function (b) { b.disabled = !live; });
    $('zero-angles').disabled = $('zero-cart').disabled = !live || armed;
    $('xref').disabled = !live;
    if (!dragging) syncSlider();

    if (pending && !uploading && !pending.done) renderPending();
    dz.classList.toggle('locked', armed);
    renderRecord();

    // Overlay: run state + time to target
    var badge = $('run-badge');
    badge.dataset.run = live ? run || 'idle' : 'offline';
    setText('run-text', live ? (run || 'вЂ”').toUpperCase() : S.conn === 'rebooting' ? 'REBOOTING' : S.everLive ? 'OFFLINE' : 'CONNECTING');
    setText('run-reason', live && run === 'fault' ? ' В· ' + (S.fault || 'tripped') : live && run === 'maint' ? ' В· writing flash' : '');
    var sub = '';
    if (live && S.goal) {
      sub = S.mode === 'manual' ? 'Manual в†’ cart to ' + signed(S.xref, 2) + ' m' : 'AI в†’ ' + esc(S.goal) + (Math.abs(S.xref) > 0.004 ? ' at ' + signed(S.xref, 2) + ' m' : '');
      if (S.random && S.mode !== 'manual') sub += ' В· random';
      if (!armed) sub += ' <span class="muted">(not driving)</span>';
    }
    var se = $('run-sub');
    if (se.innerHTML !== sub) se.innerHTML = sub;
    renderReach();
  }

  // Arm / Disarm. Esc disarms from anywhere on the page.
  // The first arm of a page session on the rig asks once: it enables the motor drive.
  function requestArm(on) {
    if (on && S.backend === 'rig' && !S.armConfirmed) {
      if (!window.confirm('Arm the rig?\n\nThe motor drive is enabled and the cart can move fast. Keep clear of the rail. ' +
        'Esc (or the header state chip) disarms from any tab; the hardware e-stop cuts power.')) return Promise.resolve(null);
      S.armConfirmed = true;
    }
    return send({ arm: !!on });
  }
  document.querySelectorAll('[data-arm]').forEach(function (b) {
    b.addEventListener('click', function () { requestArm(S.run !== 'armed').catch(function () {}); });
  });
  $('run-chip').addEventListener('click', function () {
    if (S.run === 'armed') { send({ arm: false }).catch(function () {}); flash('cmd-msg', 'Disarmed.', 'good', 2000); }
    else if (S.tab !== 'live') location.hash = 'live';
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && S.run === 'armed') { send({ arm: false }).catch(function () {}); flash('cmd-msg', 'Disarmed (Esc).', 'good', 2000); }
  });
  document.querySelectorAll('.mode-btn[data-mode]').forEach(function (b) {
    b.addEventListener('click', function () { if (b.dataset.mode !== S.mode) send({ mode: b.dataset.mode }).catch(function () {}); });
  });
  $('goal-random').addEventListener('click', function () { send({ random: !S.random }).catch(function () {}); });

  // x_ref: throttled to ~20 Hz while dragging, the final value on release; double-click centres.
  var slider = $('xref'), dragging = false, lastSent = 0, sendTimer = null, releaseTimer = null;
  function syncSlider() {
    if (S.xref == null) return;
    slider.value = S.xref;
    setText('xref-val', signed(S.xref, 2) + ' m');
  }
  function sendXref(final) {
    var v = +(+slider.value).toFixed(2), now = performance.now();
    setText('xref-val', signed(v, 2) + ' m');
    clearTimeout(sendTimer);
    if (final || now - lastSent >= 50) { lastSent = now; send({ x_ref: v }).catch(function () {}); }
    else sendTimer = setTimeout(function () { sendXref(false); }, 50 - (now - lastSent));
  }
  slider.addEventListener('input', function () { dragging = true; clearTimeout(releaseTimer); sendXref(false); });
  slider.addEventListener('change', function () {
    sendXref(true);
    clearTimeout(releaseTimer);
    releaseTimer = setTimeout(function () { dragging = false; }, 400);   // let the device echo it back first
  });
  slider.addEventListener('dblclick', function () { slider.value = 0; dragging = true; sendXref(true); releaseTimer = setTimeout(function () { dragging = false; }, 400); });

  function zero(what, question) {
    if (S.run === 'armed') { flash('cmd-msg', 'Disarm first.', 'bad'); return; }
    if (!window.confirm(question)) return;
    send({ zero: what }).then(function () { flash('cmd-msg', what === 'angles' ? 'Angles zeroed: Оёв‚Ѓ = ПЂ, П† = 0.' : 'Cart zeroed: x = 0 here.', 'good'); }).catch(function () {});
  }
  $('zero-angles').addEventListener('click', function () {
    zero('angles', 'Zero the angle encoders?\n\nBoth links must hang straight down and be at rest: this sets Оёв‚Ѓ = ПЂ and the joint-2 angle П† = 0.');
  });
  $('zero-cart').addEventListener('click', function () {
    zero('cart', 'Zero the cart encoder?\n\nThe cart\'s current position becomes x = 0 (the centre of the rail): move it to the middle first.');
  });

  /* ================================================================
     Drawing (swingup.js drawScene / drawPlot / drawNet)
  ================================================================ */
  if (!CanvasRenderingContext2D.prototype.roundRect) {
    CanvasRenderingContext2D.prototype.roundRect = function (x, y, w, h, r) {
      var rad = Math.min(r, Math.min(w, h) / 2);
      this.moveTo(x + rad, y);
      this.arcTo(x + w, y, x + w, y + h, rad); this.arcTo(x + w, y + h, x, y + h, rad);
      this.arcTo(x, y + h, x, y, rad); this.arcTo(x, y, x + w, y, rad);
      this.closePath();
    };
  }
  // The CSS box sets each canvas's size; only the pixel buffer is sized here (never style.height).
  function sizeCanvas(cv) {
    var dpr = Math.min(window.devicePixelRatio || 1, 3);
    var W = cv.clientWidth || 300, H = cv.clientHeight || 150;
    if (cv.width !== Math.round(W * dpr) || cv.height !== Math.round(H * dpr)) { cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr); }
    var ctx = cv.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return { ctx: ctx, W: W, H: H };
  }
  var rgbCache = {};
  function rgb(name) {
    var c = cssVar(name);
    if (!rgbCache[c]) {
      var m = /^#([0-9a-f]{6})$/i.exec(c), n = m ? parseInt(m[1], 16) : 0x888888;
      rgbCache[c] = [n >> 16, (n >> 8) & 255, n & 255];
    }
    return rgbCache[c];
  }
  function mix(a, b, f) {
    return 'rgb(' + Math.round(a[0] + (b[0] - a[0]) * f) + ',' + Math.round(a[1] + (b[1] - a[1]) * f) + ',' + Math.round(a[2] + (b[2] - a[2]) * f) + ')';
  }
  function isDark() {
    var t = root.getAttribute('data-theme');
    return t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  // State/units panel, lower right (personal-site statebox.js): decimal points stacked.
  function drawStateBox(ctx, W, H, rows) {
    var LH = 14, PAD_X = 8, GAP = 6;
    ctx.save();
    ctx.font = '12px ' + cssVar('--mono');
    var parts = rows.map(function (r) {
      var s = num(r.value, 1), dot = s.indexOf('.');
      return { label: r.label, int: dot < 0 ? s : s.slice(0, dot), frac: dot < 0 ? '' : s.slice(dot), unit: r.unit || '' };
    });
    function widest(k) { return Math.max.apply(null, parts.map(function (p) { return ctx.measureText(p[k]).width; })); }
    var intW = ctx.measureText('в€’').width + Math.max.apply(null, parts.map(function (p) { return ctx.measureText(p.int.replace('в€’', '')).width; }));
    var labelW = widest('label'), fracW = widest('frac'), unitW = widest('unit');
    var bw = Math.ceil(PAD_X * 2 + labelW + GAP + intW + fracW + (unitW ? GAP + unitW : 0)), bh = rows.length * LH + 10;
    var bx = W - bw - 10, by = H - bh - 10;
    ctx.fillStyle = isDark() ? 'rgba(11,15,20,0.72)' : 'rgba(245,246,248,0.82)';
    ctx.beginPath(); ctx.roundRect(bx, by, bw, bh, 3); ctx.fill();
    ctx.strokeStyle = cssVar('--border'); ctx.lineWidth = 1; ctx.stroke();
    var xL = bx + PAD_X, xP = xL + labelW + GAP + intW, xU = xP + fracW + GAP;
    ctx.textBaseline = 'top'; ctx.fillStyle = cssVar('--text-muted');
    parts.forEach(function (p, i) {
      var y = by + 6 + i * LH;
      ctx.textAlign = 'left'; ctx.fillText(p.label, xL, y);
      ctx.textAlign = 'right'; ctx.fillText(p.int, xP, y);
      ctx.textAlign = 'left'; ctx.fillText(p.frac, xP, y);
      if (p.unit) ctx.fillText(p.unit, xU, y);
    });
    ctx.restore();
  }

  var sceneCv = $('scene'), plotCv = $('plot'), netCv = $('net'), sparkCv = $('spark');

  function drawScene() {
    var c = sizeCanvas(sceneCv), ctx = c.ctx, W = c.W, H = c.H;
    var bg = cssVar('--bg-soft'), border = cssVar('--border'), strong = cssVar('--border-strong');
    var muted = cssVar('--text-muted'), mono = cssVar('--mono'), font = cssVar('--font'), lime = cssVar('--lime');
    var col1 = cssVar('--pend-1'), col2 = cssVar('--pend-2'), colF = cssVar('--viz-4'), colCart = cssVar('--pend-cart'), colRod = cssVar('--pend-rod');
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
    var f = S.last, G = geom();
    if (!f) {
      ctx.fillStyle = muted; ctx.font = '13px ' + font; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(S.conn === 'rebooting' ? 'RebootingвЂ¦' : S.conn === 'live' ? 'Waiting for telemetryвЂ¦' : 'Connecting to the deviceвЂ¦', W / 2, H / 2);
      return;
    }
    var stale = performance.now() - S.lastFrameSeen > 1500 || S.conn !== 'live';
    var reach = G.lengths.reduce(function (a, b) { return a + b; }, 0), cartHalf = 0.08;
    var scale = Math.min((W - 40) / (2 * (G.x_lim + cartHalf) + 0.1), (H - 70) / (2 * reach + 0.04));
    var cx = W / 2, trackY = Math.round(H / 2 + 14);
    function sx(xm) { return cx + xm * scale; }
    if (stale) ctx.globalAlpha = 0.45;

    // Rail with hard stops where the cart centre reaches В±x_lim, ticks every 0.25 m.
    var railL = sx(-G.x_lim - cartHalf), railR = sx(G.x_lim + cartHalf);
    ctx.strokeStyle = strong; ctx.lineWidth = 4; ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(railL, trackY); ctx.lineTo(railR, trackY); ctx.stroke();
    ctx.lineCap = 'butt'; ctx.fillStyle = muted;
    [railL, railR].forEach(function (xp) { ctx.fillRect(xp - 3, trackY - 14, 6, 28); });
    ctx.font = '10px ' + mono; ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
    for (var m = -Math.floor(G.x_lim / 0.25) * 0.25; m <= G.x_lim + 1e-9; m += 0.25) {
      ctx.strokeStyle = border; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(sx(m), trackY + 8); ctx.lineTo(sx(m), trackY + 14); ctx.stroke();
      ctx.fillStyle = muted; ctx.globalAlpha = (stale ? 0.45 : 1) * 0.7;
      ctx.fillText(minus(m.toFixed(2)), sx(m), trackY + 26);
      ctx.globalAlpha = stale ? 0.45 : 1;
    }

    // x_ref: a lime marker on the rail (where Manual drives the cart, or the AI balances).
    var xr = sx(clamp(f.x_ref, -G.x_lim, G.x_lim));
    ctx.strokeStyle = lime; ctx.fillStyle = lime; ctx.lineWidth = 1.5;
    ctx.setLineDash([3, 3]); ctx.globalAlpha = (stale ? 0.45 : 1) * 0.55;
    ctx.beginPath(); ctx.moveTo(xr, trackY - 4); ctx.lineTo(xr, trackY - 22); ctx.stroke();
    ctx.setLineDash([]); ctx.globalAlpha = stale ? 0.45 : 1;
    ctx.beginPath(); ctx.moveTo(xr, trackY + 3); ctx.lineTo(xr - 6, trackY + 12); ctx.lineTo(xr + 6, trackY + 12); ctx.closePath(); ctx.fill();
    ctx.font = '10px ' + mono; ctx.fillStyle = cssVar('--lime-text');
    ctx.fillText('x_ref', xr, trackY - 26);

    var st = f.est, cartX = sx(st[0]);
    function bobR(k) { return Math.max(6, 0.028 * scale * Math.sqrt((G.masses[k] || 0.15) / 0.15)); }

    // The simulator's true state: a faint ghost behind the estimate.
    if (f.flags & FLAG.TRUTH) {
      var tx = sx(f.truth[0]), ty = trackY;
      ctx.globalAlpha = (stale ? 0.45 : 1) * 0.22;
      ctx.fillStyle = colCart;
      ctx.beginPath(); ctx.roundRect(tx - cartHalf * scale, trackY - Math.max(16, 0.07 * scale) / 2, 2 * cartHalf * scale, Math.max(16, 0.07 * scale), 3); ctx.fill();
      for (var q = 0; q < G.n; q++) {
        var th0 = f.truth[2 + 2 * q], nx = tx + G.lengths[q] * scale * Math.sin(th0), ny = ty - G.lengths[q] * scale * Math.cos(th0);
        ctx.strokeStyle = colRod; ctx.lineWidth = 3; ctx.lineCap = 'round';
        ctx.beginPath(); ctx.moveTo(tx, ty); ctx.lineTo(nx, ny); ctx.stroke();
        ctx.fillStyle = q % 2 ? col2 : col1;
        ctx.beginPath(); ctx.arc(nx, ny, bobR(q), 0, 2 * Math.PI); ctx.fill();
        tx = nx; ty = ny;
      }
      ctx.lineCap = 'butt'; ctx.globalAlpha = stale ? 0.45 : 1;
    }

    // Target pose, hung from the cart: dashed rods and hollow bobs.
    var target = goalTarget(G.n, f.goal), gx = cartX, gy = trackY;
    ctx.globalAlpha = (stale ? 0.45 : 1) * 0.45; ctx.setLineDash([4, 4]); ctx.lineWidth = 1.5;
    for (var gk = 0; gk < G.n; gk++) {
      var gnx = gx + G.lengths[gk] * scale * Math.sin(target[gk]), gny = gy - G.lengths[gk] * scale * Math.cos(target[gk]);
      ctx.strokeStyle = colRod;
      ctx.beginPath(); ctx.moveTo(gx, gy); ctx.lineTo(gnx, gny); ctx.stroke();
      ctx.setLineDash([]); ctx.strokeStyle = gk % 2 ? col2 : col1;
      ctx.beginPath(); ctx.arc(gnx, gny, bobR(gk) + 2, 0, 2 * Math.PI); ctx.stroke();
      ctx.setLineDash([4, 4]);
      gx = gnx; gy = gny;
    }
    ctx.setLineDash([]); ctx.globalAlpha = stale ? 0.45 : 1;

    // Cart
    var cw = 2 * cartHalf * scale, ch = Math.max(16, 0.07 * scale);
    ctx.fillStyle = colCart;
    ctx.beginPath(); ctx.roundRect(cartX - cw / 2, trackY - ch / 2, cw, ch, 3); ctx.fill();

    // Links (bob x = x + l sin Оё, height = l cos Оё)
    var px = cartX, py = trackY;
    for (var k = 0; k < G.n; k++) {
      var th = st[2 + 2 * k], len = G.lengths[k] * scale;
      var qx = px + len * Math.sin(th), qy = py - len * Math.cos(th);
      ctx.strokeStyle = colRod; ctx.lineWidth = 4; ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(qx, qy); ctx.stroke();
      ctx.fillStyle = k % 2 ? col2 : col1;
      ctx.beginPath(); ctx.arc(qx, qy, bobR(k), 0, 2 * Math.PI); ctx.fill();
      ctx.fillStyle = bg;
      ctx.beginPath(); ctx.arc(px, py, 3, 0, 2 * Math.PI); ctx.fill();
      px = qx; py = qy;
    }
    ctx.lineCap = 'butt';

    // Applied force
    if (Math.abs(f.applied) > 0.2) {
      var fl = f.applied / G.fmax * 60, ay = trackY + 40, fs = fl >= 0 ? 1 : -1;
      ctx.strokeStyle = colF; ctx.fillStyle = colF; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(cartX, ay); ctx.lineTo(cartX + fl, ay); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(cartX + fl + 3 * fs, ay); ctx.lineTo(cartX + fl - 6 * fs, ay - 5); ctx.lineTo(cartX + fl - 6 * fs, ay + 5); ctx.closePath(); ctx.fill();
    }
    ctx.globalAlpha = 1;

    // Legend, lower left (wide canvases only: on a phone the state box needs the corner)
    if (W >= 600) {
    ctx.font = '10px ' + mono; ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic'; ctx.fillStyle = muted;
    var ly = H - 14, lx = 14;
    function key(draw, text) { draw(lx, ly - 4); lx += 22; ctx.fillStyle = muted; ctx.fillText(text, lx, ly); lx += ctx.measureText(text).width + 16; }
    key(function (x, y) { ctx.fillStyle = col1; ctx.beginPath(); ctx.arc(x + 8, y, 4, 0, 2 * Math.PI); ctx.fill(); }, 'estimate');
    key(function (x, y) { ctx.strokeStyle = col1; ctx.globalAlpha = 0.6; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(x + 8, y, 5, 0, 2 * Math.PI); ctx.stroke(); ctx.globalAlpha = 1; }, 'target');
    if (f.flags & FLAG.TRUTH) key(function (x, y) { ctx.fillStyle = col1; ctx.globalAlpha = 0.28; ctx.beginPath(); ctx.arc(x + 8, y, 4, 0, 2 * Math.PI); ctx.fill(); ctx.globalAlpha = 1; }, 'true state');
    if (stale) { ctx.fillStyle = cssVar('--bad'); ctx.fillText('stale', lx, ly); }
    }

    var rows = [{ label: 'x', value: st[0], unit: 'm' }, { label: 'бє‹', value: st[1], unit: 'm/s' }];
    for (var li = 0; li < G.n; li++) rows.push({ label: 'Оё' + (li + 1), value: lane(st[2 + 2 * li]), unit: 'В°' });
    rows.push({ label: 'F', value: f.applied, unit: 'N' });
    drawStateBox(ctx, W, H, rows);
  }

  // Hover: a crosshair snaps to the nearest sample; the margin values follow it.
  var recPlotCv = $('rec-plot');
  [plotCv, recPlotCv].forEach(function (cv) {
    cv.hoverX = null;
    cv.addEventListener('pointermove', function (e) { cv.hoverX = e.clientX - cv.getBoundingClientRect().left; });
    cv.addEventListener('pointerleave', function () { cv.hoverX = null; });
  });

  // Live: x, every Оё and F. Record (compact): x and F, what an excitation does to the cart.
  function drawPlot(cv, compact) {
    var c = sizeCanvas(cv), ctx = c.ctx, W = c.W, H = c.H, G = geom(), plotHoverX = cv.hoverX;
    var bg = cssVar('--bg'), border = cssVar('--border'), muted = cssVar('--text-muted'), text = cssVar('--text'), mono = cssVar('--mono');
    var colors = [cssVar('--viz-1'), cssVar('--viz-2'), cssVar('--viz-3'), cssVar('--viz-4')];
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
    var lanes = [{ label: 'x (m)', lo: -G.x_lim, hi: G.x_lim, d: 2, get: function (s) { return s.x; }, ref: function (s) { return s.xr; } }];
    for (var k = 0; k < G.n && !compact; k++) (function (k) { lanes.push({ label: 'Оё' + 'в‚Ѓв‚‚в‚ѓв‚„'[k] + ' (В°)', lo: -90, hi: 270, d: 0, wrap: true, get: function (s) { return s.th[k]; } }); })(k);
    lanes.push({ label: 'F (N)', lo: -G.fmax, hi: G.fmax, d: 1, get: function (s) { return s.cmd; }, second: function (s) { return s.applied; } });
    var PAD_L = 74, PAD_R = 10, PAD_T = 4, PAD_B = 16;
    var rowH = (H - PAD_T - PAD_B) / lanes.length, pw = W - PAD_L - PAD_R;
    var hist = S.hist, n = hist.length, lastTick = n ? hist[n - 1].tick : 0, span = HIST_S / G.dt;
    function xPx(tick) { return PAD_L + pw * (1 - (lastTick - tick) / span); }
    var hk = -1;
    if (plotHoverX !== null && plotHoverX >= PAD_L && plotHoverX <= PAD_L + pw && n) {
      var tk = lastTick - (1 - (plotHoverX - PAD_L) / pw) * span, best = Infinity;
      for (var i = 0; i < n; i++) { var dd = Math.abs(hist[i].tick - tk); if (dd < best) { best = dd; hk = i; } }
    }
    var dots = [];
    lanes.forEach(function (s, si) {
      var yTop = PAD_T + si * rowH, mid = yTop + rowH / 2, col = colors[si % colors.length];
      if (s.label.charAt(0) === 'F') col = colors[3];
      function yPx(v) { return yTop + rowH * (0.08 + 0.84 * (s.hi - clamp(v, s.lo, s.hi)) / (s.hi - s.lo)); }
      ctx.strokeStyle = border; ctx.lineWidth = 0.5;
      if (si > 0) { ctx.beginPath(); ctx.moveTo(PAD_L, yTop); ctx.lineTo(W - PAD_R, yTop); ctx.stroke(); }
      ctx.beginPath(); ctx.moveTo(PAD_L, yPx(0)); ctx.lineTo(W - PAD_R, yPx(0)); ctx.stroke();
      if (s.wrap) {   // up (0В°) solid, down (180В°) dotted, each named at the right edge
        ctx.setLineDash([2, 3]); ctx.beginPath(); ctx.moveTo(PAD_L, yPx(180)); ctx.lineTo(W - PAD_R, yPx(180)); ctx.stroke(); ctx.setLineDash([]);
        ctx.font = '9px ' + mono; ctx.fillStyle = muted; ctx.textAlign = 'right'; ctx.textBaseline = 'bottom';
        ctx.fillText('up', W - PAD_R - 3, yPx(0) - 1); ctx.fillText('down', W - PAD_R - 3, yPx(180) - 1);
      }
      function trace(fn) {
        ctx.beginPath();
        var prev = null;
        for (var i = 0; i < n; i++) {
          var v = fn(hist[i]), xp = xPx(hist[i].tick), yp = yPx(v);
          var gapped = i > 0 && hist[i].tick - hist[i - 1].tick > 0.25 / G.dt;
          if (i === 0 || gapped || (s.wrap && Math.abs(v - prev) > 180)) ctx.moveTo(xp, yp); else ctx.lineTo(xp, yp);
          prev = v;
        }
        ctx.stroke();
      }
      if (s.ref) { ctx.strokeStyle = cssVar('--lime'); ctx.globalAlpha = 0.7; ctx.lineWidth = 1; ctx.setLineDash([3, 3]); trace(s.ref); ctx.setLineDash([]); ctx.globalAlpha = 1; }
      if (s.second) { ctx.strokeStyle = col; ctx.globalAlpha = 0.55; ctx.lineWidth = 1.2; ctx.setLineDash([4, 3]); trace(s.second); ctx.setLineDash([]); ctx.globalAlpha = 1; }
      ctx.strokeStyle = col; ctx.lineWidth = 1.4; trace(s.get);

      var hovered = hk >= 0, cur = n ? s.get(hist[hovered ? hk : n - 1]) : 0;
      if (hovered) dots.push({ y: yPx(cur), color: col });
      ctx.font = '10px ' + mono; ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
      var lw = ctx.measureText(s.label).width;
      ctx.fillStyle = col; ctx.fillRect(PAD_L - 6 - lw - 12, mid - 8.5, 8, 3);
      ctx.fillStyle = muted; ctx.fillText(s.label, PAD_L - 6, mid - 7);
      ctx.fillStyle = text; ctx.fillText(num(cur, s.d), PAD_L - 6, mid + 7);
      if (s.second && n) {
        ctx.fillStyle = muted; ctx.textAlign = 'right';
        ctx.fillText('cmd solid В· applied dashed', W - PAD_R - 4, yTop + 9);
      }
      if (s.ref && n) { ctx.fillStyle = cssVar('--lime-text'); ctx.textAlign = 'right'; ctx.fillText('x_ref dashed', W - PAD_R - 4, yTop + 9); }
    });
    // time axis
    ctx.font = '10px ' + mono; ctx.fillStyle = muted; ctx.textBaseline = 'alphabetic';
    for (var t = 0; t <= HIST_S; t += 1) {
      var xp = PAD_L + pw * (1 - t / HIST_S);
      ctx.textAlign = t === 0 ? 'right' : 'center';
      ctx.fillText(t === 0 ? 'now' : minus('-' + t + ' s'), xp, H - 4);
    }
    if (hk >= 0 && dots.length) {
      var hx = xPx(hist[hk].tick);
      ctx.strokeStyle = muted; ctx.globalAlpha = 0.6; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(hx, PAD_T); ctx.lineTo(hx, H - PAD_B); ctx.stroke(); ctx.globalAlpha = 1;
      dots.forEach(function (d) {
        ctx.fillStyle = bg; ctx.beginPath(); ctx.arc(hx, d.y, 5, 0, 2 * Math.PI); ctx.fill();
        ctx.fillStyle = d.color; ctx.beginPath(); ctx.arc(hx, d.y, 3.5, 0, 2 * Math.PI); ctx.fill();
      });
    }
    if (!n) {
      ctx.fillStyle = muted; ctx.font = '12px ' + cssVar('--font'); ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('No telemetry yet', PAD_L + pw / 2, H / 2);
    }
  }

  // Execution time of each streamed tick against the period and the 80 % budget.
  function drawSpark() {
    var c = sizeCanvas(sparkCv), ctx = c.ctx, W = c.W, H = c.H, G = geom();
    var period = get(S.status, 'loop.period_us', G.dt * 1e6), hist = S.hist, n = hist.length;
    ctx.fillStyle = cssVar('--bg'); ctx.fillRect(0, 0, W, H);
    var top = 10, bot = H - 6, lim = period * 1.1;
    function y(v) { return bot - clamp(v / lim, 0, 1.05) * (bot - top); }
    ctx.strokeStyle = cssVar('--border-strong'); ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0, y(period)); ctx.lineTo(W, y(period)); ctx.stroke();
    ctx.strokeStyle = cssVar('--lime'); ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(0, y(0.8 * period)); ctx.lineTo(W, y(0.8 * period)); ctx.stroke(); ctx.setLineDash([]);
    ctx.font = '9px ' + cssVar('--mono'); ctx.fillStyle = cssVar('--text-muted'); ctx.textAlign = 'left'; ctx.textBaseline = 'bottom';
    ctx.fillText('period ' + us(period), 6, y(period) - 1);
    ctx.fillStyle = cssVar('--lime-text'); ctx.fillText('80 %', 6, y(0.8 * period) - 1);
    if (!n) return;
    var lastTick = hist[n - 1].tick, span = HIST_S / G.dt;
    ctx.strokeStyle = cssVar('--viz-1'); ctx.lineWidth = 1.2; ctx.beginPath();
    for (var i = 0; i < n; i++) {
      var xp = W * (1 - (lastTick - hist[i].tick) / span), yp = y(hist[i].loop);
      if (i === 0) ctx.moveTo(xp, yp); else ctx.lineTo(xp, yp);
    }
    ctx.stroke();
    ctx.fillStyle = cssVar('--bad');
    for (i = 0; i < n; i++) if (hist[i].loop > 0.8 * period) { ctx.beginPath(); ctx.arc(W * (1 - (lastTick - hist[i].tick) / span), y(hist[i].loop), 2, 0, 2 * Math.PI); ctx.fill(); }
    ctx.fillStyle = cssVar('--text-muted'); ctx.textAlign = 'right';
    ctx.fillText('this tick ' + us(hist[n - 1].loop), W - 6, top + 2);
  }

  // The last 5 minutes from the 2 Hz status: average and worst execution per message against
  // the control period, red marks where deadlines were missed.
  var sparkLongCv = $('spark-long');
  function drawSparkLong() {
    var c = sizeCanvas(sparkLongCv), ctx = c.ctx, W = c.W, H = c.H, G = geom(), h = S.loopHist, n = h.length;
    var period = G.dt * 1e6, now = performance.now(), muted = cssVar('--text-muted'), mono = cssVar('--mono');
    ctx.fillStyle = cssVar('--bg'); ctx.fillRect(0, 0, W, H);
    var top = 12, bot = H - 16, peak = period;
    for (var i = 0; i < n; i++) peak = Math.max(peak, h[i].max || 0);
    var lim = Math.min(peak * 1.1, period * 4);
    function y(v) { return bot - clamp(v / lim, 0, 1.02) * (bot - top); }
    function x(t) { return W * (1 - (now - t) / LOOP_HIST_MS); }
    ctx.strokeStyle = cssVar('--border-strong'); ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0, y(period)); ctx.lineTo(W, y(period)); ctx.stroke();
    ctx.strokeStyle = cssVar('--lime'); ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(0, y(0.8 * period)); ctx.lineTo(W, y(0.8 * period)); ctx.stroke(); ctx.setLineDash([]);
    ctx.font = '9px ' + mono; ctx.textBaseline = 'bottom'; ctx.textAlign = 'left'; ctx.fillStyle = muted;
    ctx.fillText('period ' + us(period), 6, y(period) - 1);
    ctx.textBaseline = 'alphabetic';
    for (var m = 0; m <= 5; m++) { ctx.textAlign = m === 0 ? 'right' : m === 5 ? 'left' : 'center'; ctx.fillText(m === 0 ? 'now' : 'в€’' + m + ' min', W * (1 - m / 5) + (m === 0 ? -2 : m === 5 ? 2 : 0), H - 3); }
    if (!n) { ctx.textAlign = 'center'; ctx.fillText('collectingвЂ¦ (5 min of status messages)', W / 2, (top + bot) / 2); return; }
    function line(key, color, w) {
      ctx.strokeStyle = color; ctx.lineWidth = w; ctx.beginPath();
      for (var k = 0; k < n; k++) { var xp = x(h[k].t), yp = y(h[k][key]); if (k === 0 || h[k].t - h[k - 1].t > 3000) ctx.moveTo(xp, yp); else ctx.lineTo(xp, yp); }
      ctx.stroke();
    }
    line('max', cssVar('--viz-2'), 1);
    line('avg', cssVar('--viz-1'), 1.4);
    ctx.fillStyle = cssVar('--bad');
    for (i = 0; i < n; i++) if (h[i].missed) ctx.fillRect(x(h[i].t) - 1, bot - 4, 2, 6);
    ctx.textAlign = 'right'; ctx.fillStyle = muted; ctx.textBaseline = 'top';
    ctx.fillText('5 min В· avg / max per status', W - 6, 2);
  }

  /* ---- Network diagram: the SimBa actor with live activations (swingup.js drawNet) ---- */
  function drawNet() {
    var c = sizeCanvas(netCv), ctx = c.ctx, W = c.W, H = c.H;
    var bg = cssVar('--bg-soft'), text = cssVar('--text'), muted = cssVar('--text-muted');
    var border = cssVar('--border-strong'), mono = cssVar('--mono'), font = cssVar('--font');
    var neg = rgb('--nn-act-neg'), zero = rgb('--nn-act-zero'), pos = rgb('--nn-act-pos');
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
    ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
    var msgX = Math.min(W / 2, 200);   // stays in view when the canvas scrolls sideways on a phone
    if (!S.policy) {
      ctx.fillStyle = muted; ctx.font = '13px ' + font;
      var st = S.model.state;
      if (st === 'loading') {
        var fr = S.model.total ? S.model.got / S.model.total : 0;
        ctx.fillText('Loading the networkвЂ¦', msgX, H / 2 - 14);
        ctx.strokeStyle = border; ctx.lineWidth = 1; ctx.strokeRect(msgX - 110.5, H / 2 - 0.5, 221, 7);
        ctx.fillStyle = cssVar('--lime'); ctx.fillRect(msgX - 110, H / 2, 220 * fr, 6);
        ctx.fillStyle = muted; ctx.font = '11px ' + mono;
        ctx.fillText(bytes(S.model.got) + (S.model.total ? ' / ' + bytes(S.model.total) : ''), msgX, H / 2 + 24);
      } else if (st === 'none') {
        ctx.fillText('No model on the device', msgX, H / 2 - 6);
        ctx.font = '11px ' + font; ctx.fillText('Export one with task export-firmware and drop the .ncpm on Settings в†’ Update.', msgX, H / 2 + 14);
      } else if (st === 'error') {
        ctx.fillText('Could not load the network: ' + S.model.error, msgX, H / 2);
      } else {
        ctx.fillText(S.conn === 'live' ? 'Waiting for the modelвЂ¦' : 'ConnectingвЂ¦', msgX, H / 2);
      }
      return;
    }
    var h = S.hdr, tr = S.policy.trace, B = h.n_blocks, D = h.obs_dim, L = S.layout;
    function dims(nu) { var cols = Math.ceil(Math.sqrt(nu)); return { cols: cols, rows: Math.ceil(nu / cols) }; }
    var dh = dims(h.hidden), du = dims(h.hidden * h.expand);
    // On a phone the canvas is ~940 px wide inside a sideways-scrolling box, so the whole diagram is only
    // ~1x: draw the neuron grids bigger there (the labels are fine as they are).
    var phone = !!(window.matchMedia && window.matchMedia('(max-width: 760px)').matches);
    var cellH = Math.max(3, Math.min(phone ? 10 : 6, Math.floor((phone ? 150 : 100) / dh.cols))), cellU = Math.max(2, Math.min(phone ? 7 : 4, Math.floor((phone ? 196 : 132) / du.cols)));
    var hs = dh.cols * cellH, hsy = dh.rows * cellH, usx = du.cols * cellU, usy = du.rows * cellU;
    var gap = 40, rowH = Math.min(22, 236 / D), ix = 2, iy = 24;
    var x0 = 154, DW = x0 + hs + B * (gap + usx + gap + hs) + gap + 175, DH = Math.max(300, iy + D * rowH + 44);
    var sc = Math.min(W / DW, H / DH);
    ctx.save();
    ctx.translate(phone ? 4 : (W - DW * sc) / 2, (H - DH * sc) / 2);   // phone: any slack goes to the right, not the left
    ctx.scale(sc, sc);
    var gridY = Math.max(70, (DH - hsy) / 2 - 20);
    function grid(vals, bx, by, d, cell, signed, label, sub) {
      var m = 1e-6, i;
      for (i = 0; i < vals.length; i++) m = Math.max(m, Math.abs(vals[i]));
      for (i = 0; i < vals.length; i++) {
        var f = vals[i] / m;
        ctx.fillStyle = signed ? (f < 0 ? mix(zero, neg, -f) : mix(zero, pos, f)) : mix(zero, pos, Math.max(0, f));
        ctx.fillRect(bx + (i % d.cols) * cell, by + Math.floor(i / d.cols) * cell, cell, cell);
      }
      ctx.strokeStyle = border; ctx.lineWidth = 1; ctx.strokeRect(bx - .5, by - .5, d.cols * cell + 1, d.rows * cell + 1);
      ctx.fillStyle = text; ctx.font = '600 12px ' + font;
      ctx.fillText(label, bx + d.cols * cell / 2, by + d.rows * cell + 20);
      ctx.fillStyle = muted; ctx.font = '11px ' + font;
      ctx.fillText(sub, bx + d.cols * cell / 2, by + d.rows * cell + 35);
    }
    function arrow(a, b, y) {
      ctx.strokeStyle = muted; ctx.fillStyle = muted; ctx.lineWidth = 1.2;
      ctx.beginPath(); ctx.moveTo(a, y); ctx.lineTo(b, y); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(b, y); ctx.lineTo(b - 5, y - 3.5); ctx.lineTo(b - 5, y + 3.5); ctx.closePath(); ctx.fill();
    }
    // Inputs: one labelled bar each.
    ctx.font = '11px ' + mono;
    var full = [mix(zero, neg, 1), mix(zero, pos, 1)], zeroC = mix(zero, zero, 0);
    for (var k = 0; k < D; k++) {
      var cy = iy + k * rowH, v = clamp(tr.obs[k] / (L[k] ? L[k].s : 1), -1, 1), bh = Math.min(12, rowH - 4);
      ctx.textAlign = 'right'; ctx.fillStyle = L[k] && L[k].goal ? text : muted; ctx.fillText(L[k] ? L[k].l : '', ix + 78, cy + bh / 2 + 7);
      ctx.fillStyle = zeroC; ctx.fillRect(ix + 84, cy + 3, 40, bh);
      ctx.fillStyle = v < 0 ? full[0] : full[1];
      ctx.fillRect(ix + 104 + (v < 0 ? v * 20 : 0), cy + 3, Math.abs(v) * 20, bh);
      ctx.fillStyle = border; ctx.fillRect(ix + 104, cy + 1, 1, bh + 4);
    }
    ctx.textAlign = 'center'; ctx.fillStyle = text; ctx.font = '600 12px ' + font;
    ctx.fillText('Input', ix + 76, iy + D * rowH + 16);
    ctx.fillStyle = muted; ctx.font = '11px ' + font;
    ctx.fillText(D + ' numbers', ix + 76, iy + D * rowH + 31);
    var midY = gridY + hsy / 2;
    arrow(ix + 130, x0 - 4, midY);

    grid(tr.h[0], x0, gridY, dh, cellH, true, 'Embed', h.hidden + ' units');
    var cx = x0 + hs;
    for (var b = 0; b < B; b++) {
      arrow(cx + 4, cx + gap - 4, midY);
      var ux = cx + gap, uy = gridY - (usy - hsy) / 2;
      grid(tr.u[b], ux, uy, du, cellU, false, 'Block ' + (b + 1) + ' В· ReLU', h.hidden * h.expand + ' units');
      arrow(ux + usx + 4, ux + usx + gap - 4, midY);
      var hx2 = ux + usx + gap;
      grid(tr.h[b + 1], hx2, gridY, dh, cellH, true, 'Sum', 'h + fc2(вЂ¦)');
      ctx.strokeStyle = muted; ctx.setLineDash([3, 3]); ctx.lineWidth = 1;
      var sx0 = cx - hs / 2 + (b > 0 ? 14 : 0), sx1 = hx2 + hs / 2 - (b < B - 1 ? 14 : 0), top = gridY - 14 - Math.max(0, (usy - hsy) / 2);
      ctx.beginPath(); ctx.moveTo(sx0, gridY - 2); ctx.lineTo(sx0, top); ctx.lineTo(sx1, top); ctx.lineTo(sx1, gridY - 2); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = muted;
      ctx.beginPath(); ctx.moveTo(sx1, gridY - 1); ctx.lineTo(sx1 - 3.5, gridY - 7); ctx.lineTo(sx1 + 3.5, gridY - 7); ctx.closePath(); ctx.fill();
      ctx.font = '11px ' + font; ctx.textAlign = 'center';
      ctx.fillText('skip', (sx0 + sx1) / 2, top - 4);
      cx = hx2 + hs;
    }
    arrow(cx + 4, cx + gap - 4, midY);

    // Output: one number, squashed by tanh. Delta mode: a rate of change of the command.
    var ox = cx + gap + 8, f = Math.tanh(tr.mean), unit = h.delta ? ' N/s' : ' N', scaleOut = h.delta ? h.force_slew : h.force_max;
    // The net runs on every tick, armed or not; its output reaches the drive only when the device is
    // armed in AI mode. Otherwise this is a preview: dim it and say so.
    var drives = S.run === 'armed' && S.mode === 'ai';
    ctx.globalAlpha = drives ? 1 : 0.5;
    ctx.fillStyle = zeroC; ctx.fillRect(ox, midY - 48, 16, 96);
    ctx.fillStyle = f < 0 ? full[0] : full[1];
    ctx.fillRect(ox, f < 0 ? midY : midY - f * 48, 16, Math.abs(f) * 48);
    ctx.fillStyle = border; ctx.fillRect(ox - 3, midY, 22, 1);
    ctx.globalAlpha = 1;
    ctx.fillStyle = text; ctx.font = '600 13px ' + mono; ctx.textAlign = 'left';
    var out = f * scaleOut, val = num(out, h.delta ? 0 : 1);
    if (val.charAt(0) !== 'в€’') val = 'вЂ‡' + val;
    ctx.fillText(val + unit, ox + 24, midY + 4);
    // Above the number: is it reaching the drive? Below it, in delta mode: the number is a rate, and
    // the force it integrates to is what the drive gets.
    var fr = S.last;
    ctx.font = '11px ' + mono;
    var why = S.run === 'armed' ? 'manual В· not applied' : S.run === 'maint' ? 'writing flash' : (S.run || 'idle') + ' В· not applied';
    ctx.fillStyle = drives ? cssVar('--lime-text') : muted;
    ctx.fillText(drives ? 'driving the cart' : why, ox + 24, midY - 18);
    if (h.delta && fr) { ctx.fillStyle = muted; ctx.fillText('force ' + signed(fr.cmd, 2) + ' N', ox + 24, midY + 22); }
    ctx.textAlign = 'center'; ctx.font = '600 12px ' + font;
    ctx.fillText(h.delta ? 'Force rate' : 'Force', ox + 8, gridY + hsy + 20);
    ctx.fillStyle = muted; ctx.font = '11px ' + font;
    ctx.fillText('tanh В· ' + num(scaleOut, h.delta ? 0 : 1) + unit, ox + 8, gridY + hsy + 35);
    ctx.restore();
  }

  // One forward pass per new frame (в‰¤ 25 per second), then the parity check against the device's command.
  var lastNetTick = -1, lastNetAt = 0, netCount = 0, netWindow = 0;
  function runNet(now) {
    if (!S.policy || !S.last || S.last.tick === lastNetTick || now - lastNetAt < 38) return false;
    var f = S.last, h = S.hdr, G = geom(), t0 = performance.now();
    var a = S.policy.act(f.obs);
    S.netMs = S.netMs ? 0.9 * S.netMs + 0.1 * (performance.now() - t0) : performance.now() - t0;
    lastNetTick = f.tick; lastNetAt = now; netCount++;
    if (f.run === 1 && f.mode === 0 && !get(S.status, 'excite.active', false)) {   // an excitation is added to cmd: no parity then
      var pred;
      if (h.delta) {
        if (!h.action_history || !G.slew) pred = null;
        else pred = clamp(f.obs[h.hist_at] * h.force_max + clamp(a / h.force_max, -1, 1) * h.force_slew * h.dt, -h.force_max, h.force_max);
      } else pred = clamp(a, -h.force_max, h.force_max);
      if (pred != null) {
        var e = Math.abs(pred - f.cmd);
        S.parity = S.parity == null ? e : 0.95 * S.parity + 0.05 * e;
        S.parityN++; S.parityAt = performance.now();
      }
    }
    if (now - netWindow > 1000) { S.netFps = netCount; netCount = 0; netWindow = now; renderNetMeta(); }
    return true;
  }

  var lastStatusRender = 0, lastReadout = 0, lastLong = 0;
  function frame(now) {
    var ran = runNet(now);   // every tab: the parity check in Settings в†’ Model needs it
    if (S.tab === 'live') {
      drawScene();
      drawPlot(plotCv, false);
      if (now - lastReadout > 100) { lastReadout = now; renderReadout(); renderReach(); }
      if (ran || !S.policy || now - lastNetAt > 500) drawNet();
    }
    if (S.tab === 'record') drawPlot(recPlotCv, true);
    if (S.tab === 'health') { drawSpark(); if (now - lastLong > 1000) { lastLong = now; drawSparkLong(); } }
    if (S.model.state === 'loading' && now - lastStatusRender > 200) { lastStatusRender = now; renderNetMeta(); }
    requestAnimationFrame(frame);
  }

  /* ================================================================
     Update: one drop zone for firmware images (0xE9) and model blobs ("NCPM")
  ================================================================ */
  var dz = $('dropzone'), fileInput = $('file-input'), panel = $('file-panel'), pending = null, uploading = false;
  var ARMED_WHY = 'Disarm first: writing flash disables the cache, which stalls both cores вЂ” the control loop would miss its deadlines with the drive enabled.';

  function cstr(u8, at, n) {
    var s = '';
    for (var i = at; i < at + n && i < u8.length && u8[i]; i++) s += String.fromCharCode(u8[i]);
    return s;
  }
  // esp_app_desc_t sits right after the image header (24 B) and the first segment header (8 B).
  function parseAppImage(u8) {
    var dv = new DataView(u8.buffer, u8.byteOffset, Math.min(u8.length, 256));
    if (u8.length < 256 || dv.getUint32(32, true) !== 0xABCD5432) return null;
    return { version: cstr(u8, 48, 32), project: cstr(u8, 80, 32), time: cstr(u8, 112, 16), date: cstr(u8, 128, 16), idf: cstr(u8, 144, 32) };
  }

  function identify(file, buf) {
    var u8 = new Uint8Array(buf), out = { file: file, buf: buf, kind: null, rows: [], problems: [], warnings: [] };
    if (u8.length >= 4 && cstr(u8, 0, 4) === 'NCPM') {
      out.kind = 'model';
      var h;
      try { h = parseNcpm(buf); } catch (e) { out.problems.push(e.message); return out; }
      out.hdr = h;
      var crc = crc32(u8, 12, 16), crcOk = crc === h.crc32;
      if (h.total_size !== u8.length) out.problems.push('size: the header says ' + bytes(h.total_size) + ', the file is ' + bytes(u8.length) + ' (truncated?)');
      else if (h.expected_size !== u8.length) out.problems.push('size disagrees with the dims (' + bytes(h.expected_size) + ' expected)');
      if (!crcOk) out.problems.push('CRC mismatch: the file is corrupted');
      var cur = get(S.info, 'model', null), n = geom().n;
      if (S.backend === 'rig' && h.n_links !== n) out.problems.push('this rig has ' + plural(n, 'link') + '; the model was trained for ' + h.n_links);
      else if (h.n_links !== n) out.warnings.push('the current model has ' + plural(n, 'link') + '; this one ' + h.n_links);
      if (cur && cur.crc32 && parseInt(cur.crc32, 16) === h.crc32) out.warnings.push('this exact model is already on the device');
      var dt = h.dt, period = Math.round(dt * 1e6);
      out.rows = [
        ['label', h.label || '(none)', 'accent'],
        ['trained', (h.train_step / 1e6).toFixed(2) + ' M steps'],
        ['links', h.n_links + (h.goal ? ' В· goal-conditioned' : '')],
        ['network', h.hidden + ' Г— ' + h.n_blocks + ' blocks В· Г—' + h.expand + ' В· ' + (h.params / 1e6).toFixed(2) + ' M params'],
        ['inputs', h.obs_dim + (h.action_history ? ' (' + h.action_history + ' past cmds)' : '')],
        ['weights', bytes(u8.length) + ' В· ' + h.dtype_name],
        ['action', (h.delta ? 'delta' : 'absolute') + ' В· ' + (h.ekf ? 'EKF' : 'differenced') + ' В· delay ' + h.delay_steps],
        ['rate', Math.round(1 / dt) + ' Hz (' + period + ' Вµs period)'],
        ['limits', 'В±' + num(h.force_max, 2) + ' N В· ' + num(h.force_slew, 0) + ' N/s В· rail В±' + num(h.x_lim, 2) + ' m'],
        ['crc32', ('0000000' + h.crc32.toString(16)).slice(-8) + (crcOk ? ' вњ“' : ' вњ•'), crcOk ? 'good' : 'bad']
      ];
    } else if (u8.length && u8[0] === 0xE9) {
      out.kind = 'firmware';
      var d = parseAppImage(u8);
      if (/-factory\.bin$/i.test(file.name) || !d) {
        out.problems.push(d ? 'this is the USB factory image (bootloader + partition table + app at 0x0): use n-cartpole-fw-<ver>.bin for an update over the air'
          : 'no app descriptor: is this the factory image or a bootloader? Over the air takes n-cartpole-fw-<ver>.bin');
      }
      if (d && d.project !== 'n_cartpole_fw') out.problems.push('project "' + d.project + '" вЂ” this device only takes n_cartpole_fw images');
      if (!/^n-cartpole-fw-.*\.bin$/i.test(file.name) && !out.problems.length) out.warnings.push('unusual file name (releases are n-cartpole-fw-<ver>.bin)');
      out.desc = d;
      var running = get(S.info, 'fw.version', null);
      if (d && running && d.version === running) out.warnings.push('this version is already running');
      if (u8.length > 3 * 1024 * 1024) out.problems.push('larger than the 3 MB app slot');
      out.rows = d ? [
        ['project', d.project, d.project === 'n_cartpole_fw' ? 'good' : 'bad'],
        ['version', d.version, 'accent'],
        ['running now', running ? running : 'вЂ”'],
        ['built', (d.date + ' ' + d.time).trim()],
        ['esp-idf', d.idf],
        ['size', bytes(u8.length)],
        ['installs to', get(S.info, 'ota.next', 'the other slot')]
      ] : [['size', bytes(u8.length)]];
    } else {
      out.problems.push('neither a firmware image (first byte 0xE9) nor a model blob ("NCPM")');
    }
    return out;
  }

  function renderPending(note, noteKind) {
    if (!pending) { panel.hidden = true; return; }
    var p = pending, armed = S.run === 'armed', bad = p.problems.length > 0;
    var title = p.kind === 'model' ? 'Model blob' : p.kind === 'firmware' ? 'Firmware image' : 'Unknown file';
    var html = '<div class="file-title">' + title + ' <span class="mono">' + esc(p.file.name) + '</span></div>';
    if (p.rows.length) {
      html += '<dl class="kv">' + p.rows.map(function (r) { return '<dt>' + esc(r[0]) + '</dt><dd' + (r[2] ? ' class="' + r[2] + '"' : '') + '>' + esc(r[1]) + '</dd>'; }).join('') + '</dl>';
    }
    p.problems.forEach(function (m) { html += '<p class="notice bad">' + esc(m) + '</p>'; });
    p.warnings.forEach(function (m) { html += '<p class="notice">' + esc(m) + '</p>'; });
    if (!bad && armed) html += '<p class="notice bad">' + esc(ARMED_WHY) + '</p>';
    if (!bad && p.kind === 'firmware') html += '<p class="panel-hint">The device writes the image to <code>' + esc(get(S.info, 'ota.next', 'the other slot')) + '</code>, reboots into it, and keeps it only if it runs healthy for 10 s вЂ” otherwise it rolls back.</p>';
    if (!bad && p.kind === 'model') html += '<p class="panel-hint">Stored in the model partition and hot-loaded; no reboot. The controller is held in MAINT while flash is written.</p>';
    if (note) html += '<p class="notice ' + (noteKind || '') + '">' + note + '</p>';
    html += '<div class="progress-row" id="up-progress" hidden><span class="progress"><i id="up-bar"></i></span><span id="up-pct">0 %</span></div>';
    if (!p.done) {
      html += '<div class="btn-row"><button class="sim-btn primary" type="button" id="up-go"' + (bad || armed || uploading || S.conn !== 'live' ? ' disabled' : '') + '>' +
        (p.kind === 'firmware' && p.desc ? 'Install v' + esc(p.desc.version) + ' &amp; reboot' : p.kind === 'model' ? 'Upload model' : 'Upload') +
        '</button><button class="sim-btn" type="button" id="up-cancel"' + (uploading ? ' disabled' : '') + '>Cancel</button></div>';
    } else {
      html += '<div class="btn-row"><button class="sim-btn" type="button" id="up-cancel">Done</button></div>';
    }
    panel.innerHTML = html;
    panel.className = 'file-panel' + (bad ? ' bad' : '');
    panel.hidden = false;
    var go = $('up-go'), cancel = $('up-cancel');
    if (go) go.addEventListener('click', upload);
    if (cancel) cancel.addEventListener('click', function () { pending = null; renderPending(); });
  }

  function choose(file) {
    if (!file) return;
    if (uploading) return;
    file.arrayBuffer().then(function (buf) { pending = identify(file, buf); renderPending(); })
      .catch(function () { pending = { file: file, kind: null, rows: [], problems: ['could not read the file'], warnings: [] }; renderPending(); });
  }

  function upload() {
    var p = pending;
    if (!p || uploading) return;
    if (S.run === 'armed') { renderPending(esc(ARMED_WHY), 'bad'); return; }
    if (p.kind === 'firmware' && !window.confirm('Install firmware v' + p.desc.version + '?\n\nThe device reboots into it (the page reconnects by itself). If it doesn\'t run healthy for 10 s it rolls back to v' + get(S.info, 'fw.version', 'the current one') + '.')) return;
    uploading = true;
    renderPending();
    var bar = $('up-bar'), pct = $('up-pct'), row = $('up-progress');
    row.hidden = false;
    var xhr = new XMLHttpRequest();
    xhr.open('POST', p.kind === 'firmware' ? 'api/ota' : 'api/model');
    xhr.setRequestHeader('Content-Type', 'application/octet-stream');
    xhr.upload.onprogress = function (e) {
      if (!e.lengthComputable) return;
      var f = e.loaded / e.total;
      bar.style.width = (100 * f).toFixed(1) + '%';
      pct.textContent = f < 1 ? Math.round(100 * f) + ' %' : 'writing flashвЂ¦';
    };
    xhr.onload = function () {
      uploading = false;
      var j = null;
      try { j = JSON.parse(xhr.responseText); } catch (e) {}
      if (xhr.status >= 200 && xhr.status < 300 && j && j.ok !== false) {
        p.done = true;
        if (p.kind === 'firmware') {
          var from = get(S.info, 'fw.version', '?');
          S.rebooting = { from: from, to: j.version || p.desc.version, t0: performance.now() };
          setConn('rebooting');
          renderPending('Installed <b>v' + esc(S.rebooting.to) + '</b>. Rebooting вЂ” this page reconnects by itselfвЂ¦', 'good');
          waitForReboot();
        } else {
          renderPending('Model <b>' + esc(j.label || p.hdr.label) + '</b> stored and loaded.', 'good');
          loadInfo();
        }
      } else {
        var why = (j && j.error) || ('HTTP ' + xhr.status);
        if (xhr.status === 409) why += ' вЂ” ' + ARMED_WHY;
        renderPending('Upload refused: ' + esc(why), 'bad');
      }
    };
    xhr.onerror = function () { uploading = false; renderPending('The upload failed: the connection dropped.', 'bad'); };
    xhr.send(p.buf);
  }

  function waitForReboot() {
    // The socket drops when the device restarts; poll /api/info until it answers again.
    var tries = 0;
    (function poll() {
      tries++;
      if (!S.rebooting) return;
      fetchJSON('api/info', null, 2000).then(function (info) {
        if (performance.now() - S.rebooting.t0 < 2500) throw new Error('still the old boot');
        if (get(info, 'fw.version', null) === S.rebooting.from && S.rebooting.from !== S.rebooting.to && tries < 40) throw new Error('not yet');
        S.info = info; rebootDone(null); renderInfo(); connect();
      }).catch(function () { if (tries < 90) setTimeout(poll, 1500); else { S.rebooting = null; setConn('offline'); renderPending('The device has not come back after 2 minutes. Check its serial console.', 'bad'); } });
    })();
  }
  function rebootDone() {
    var r = S.rebooting;
    if (!r) return;
    S.rebooting = null;
    var now = get(S.info, 'fw.version', '?'), state = get(S.info, 'ota.state', '');
    if (pending && pending.kind === 'firmware') {
      renderPending(now === r.to
        ? 'Back online on <b>v' + esc(now) + '</b> (was v' + esc(r.from) + ')' + (state === 'pending' ? ' В· it marks itself valid after 10 s of healthy running.' : '.')
        : 'Back online, but still on v' + esc(now) + ' вЂ” the new image rolled back. Check the serial log.', now === r.to ? 'good' : 'bad');
    }
    if (S.conn === 'rebooting') setConn('reconnecting');
  }

  dz.addEventListener('click', function () { if (!uploading) fileInput.click(); });
  dz.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });
  fileInput.addEventListener('change', function () { choose(fileInput.files[0]); fileInput.value = ''; });
  ['dragenter', 'dragover'].forEach(function (ev) { dz.addEventListener(ev, function (e) { e.preventDefault(); dz.classList.add('over'); }); });
  ['dragleave', 'drop'].forEach(function (ev) { dz.addEventListener(ev, function (e) { e.preventDefault(); dz.classList.remove('over'); }); });
  dz.addEventListener('drop', function (e) { choose(e.dataTransfer && e.dataTransfer.files[0]); });
  // A file dropped anywhere else on the page shouldn't navigate away from the dashboard.
  window.addEventListener('dragover', function (e) { e.preventDefault(); });
  window.addEventListener('drop', function (e) { e.preventDefault(); });

  /* ---- Releases: the latest fw-v* tags, when the internet is reachable (quietly nothing offline) ---- */
  var releasesLoaded = false, releases = null;
  function semver(v) { return String(v).replace(/^fw-v|^v/, '').split(/[.-]/).map(function (x) { return parseInt(x, 10) || 0; }); }
  function newer(a, b) { a = semver(a); b = semver(b); for (var i = 0; i < 3; i++) { if ((a[i] || 0) !== (b[i] || 0)) return (a[i] || 0) > (b[i] || 0); } return false; }
  function loadReleases() {
    releasesLoaded = true;
    var repo = get(S.info, 'fw.repo', 'Tsmorz/n-cartpole');
    fetchJSON('https://api.github.com/repos/' + repo + '/releases?per_page=12', { headers: { Accept: 'application/vnd.github+json' } }, 5000)
      .then(function (list) {
        releases = (list || []).filter(function (r) { return /^fw-v/.test(r.tag_name) && !r.draft; }).slice(0, 4);
        renderReleases();
      }).catch(function () { /* offline (e.g. on the device's access point): keep the static hint */ });
  }
  function renderReleases() {
    if (!releases || !releases.length) return;
    var running = get(S.info, 'fw.version', null);
    $('releases').innerHTML = releases.map(function (r) {
      var asset = (r.assets || []).filter(function (a) { return /^n-cartpole-fw-.*\.bin$/.test(a.name) && !/factory/.test(a.name); })[0];
      var v = r.tag_name.replace(/^fw-v/, ''), badge = '';
      if (running && v === running) badge = '<span class="rel-badge">running</span>';
      else if (running && newer(v, running)) badge = '<span class="rel-badge">newer</span>';
      return '<li><a class="rel-tag" href="' + esc(r.html_url) + '" target="_blank" rel="noopener">' + esc(r.tag_name) + '</a>' + badge +
        '<span class="rel-date">' + esc((r.published_at || '').slice(0, 10)) + '</span>' +
        (asset ? '<a class="rel-get" href="' + esc(asset.browser_download_url) + '">' + esc(bytes(asset.size)) + ' .bin</a>' : '') + '</li>';
    }).join('');
  }

  /* ---- Wi-Fi and reboot ---- */
  // Progress of a join this page started: the device reports it in status.wifi.join. When the
  // device leaves its setup access point (or switches channel) this page loses it, so a timer
  // covers the case where the result never arrives.
  function trackJoin(j) {
    if (!S.joinWatch || !j) return;
    var host = (get(S.info, 'hostname', null) || 'cartpole') + '.local';
    if (j.state === 'connecting') {
      flash('wifi-msg', 'Joining "' + S.joinWatch + '"вЂ¦ (up to 20 s)', '', 0);
    } else if (j.state === 'ok') {
      flash('wifi-msg', 'Joined "' + esc(j.ssid) + '" at ' + addrLink(j.ip) + '. Put this computer back on that network, then open ' + addrLink(host) + ' or ' + addrLink(j.ip) + '.', 'good', 0, true);
      S.joinWatch = null;
      $('wifi-save').disabled = false;
    } else if (j.state === 'failed') {
      flash('wifi-msg', 'Could not join "' + S.joinWatch + '": ' + (j.error || 'unknown error') + '. Nothing was saved.', 'bad', 0);
      S.joinWatch = null;
      $('wifi-save').disabled = false;
    }
  }
  $('wifi-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var ssid = $('wifi-ssid').value.trim(), pass = $('wifi-pass').value;
    if (!ssid) return;
    if (S.run === 'armed') { flash('wifi-msg', 'Disarm first: saving the network writes flash.', 'bad'); return; }
    if (S.wifiMode !== 'ap' && !window.confirm('Join "' + ssid + '"?\n\nIf it works the device moves to that network and this page loses it; if not, it stays on the current one.')) return;
    fetchJSON('api/wifi', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ssid: ssid, password: pass }) }, 5000)
      .then(function () {
        S.joinWatch = ssid;
        $('wifi-save').disabled = true;
        $('wifi-pass').value = '';
        flash('wifi-msg', 'Joining "' + ssid + '"вЂ¦', '', 0);
        setTimeout(function () {
          if (S.joinWatch !== ssid) return;
          S.joinWatch = null;
          $('wifi-save').disabled = false;
          flash('wifi-msg', 'Lost contact with the device вЂ” it probably joined "' + esc(ssid) + '". Put this computer back on that network and open ' + addrLink((get(S.info, 'hostname', null) || 'cartpole') + '.local') + ' (or look up its IP in your router).', 'good', 0, true);
        }, 35000);
      }).catch(function (err) { flash('wifi-msg', err.message, 'bad'); });
  });
  // Hostname: saved to NVS and applied to mDNS at once (this page stays on its current address).
  $('host-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var name = $('host-name').value.trim().toLowerCase().replace(/\.local$/, '');
    if (!/^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$/.test(name)) { flash('host-msg', '1вЂ“32 of aвЂ“z, 0вЂ“9 and -, not starting or ending with -.', 'bad'); return; }
    fetchJSON('api/hostname', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ hostname: name }) }, 5000)
      .then(function (j) {
        $('host-name').value = '';
        flash('host-msg', 'Renamed: ' + addrLink((j && j.hostname || name) + '.local') + ' from now on (this page keeps working where it is).', 'good', 8000, true);
        loadInfo();
      }).catch(function (err) { flash('host-msg', err.message, 'bad'); });
  });
  // Forget: the device erases the network and reboots into its setup access point.
  $('wifi-forget').addEventListener('click', function () {
    if (S.run === 'armed') { flash('host-msg', 'Disarm first.', 'bad'); return; }
    var ap = 'cartpole-XXXX';
    if (!window.confirm('Forget the saved Wi-Fi network?\n\nThe device reboots into its setup access point (' + ap + ', http://192.168.4.1/) and this page loses it. Join that access point to set a new network.')) return;
    fetchJSON('api/wifi/forget', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }, 4000).then(function () {
      flash('host-msg', 'Forgotten. The device is rebooting into its access point ' + ap + ': join it and open ' + addrLink('192.168.4.1') + '.', 'good', 0, true);
      S.rebooting = { from: get(S.info, 'fw.version', ''), to: get(S.info, 'fw.version', ''), t0: performance.now() };
      setConn('rebooting');
      waitForReboot();
    }).catch(function (err) { flash('host-msg', err.message, 'bad'); });
  });

  $('reboot').addEventListener('click', function () {
    if (S.run === 'armed') { flash('cmd-msg', 'Disarm before rebooting.', 'bad'); return; }
    if (!window.confirm('Reboot the device?')) return;
    fetchJSON('api/reboot', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }, 4000).then(function () {
      S.rebooting = { from: get(S.info, 'fw.version', ''), to: get(S.info, 'fw.version', ''), t0: performance.now() };
      setConn('rebooting');
      waitForReboot();
    }).catch(function (err) { flash('cmd-msg', 'reboot: ' + err.message, 'bad'); });
  });

  /* ================================================================
     Record: logs for offline system identification (ncp_record.h, ncp_excite.h)
  ================================================================ */
  var PRESETS = [
    { id: 'ring', name: 'Ring-down', armed: false, mode: null, kind: 'none', seconds: 30,
      setup: 'Disarmed. Lift both links by hand, start the recording and let go: the free swing gives the pendulum periods and how fast they decay.',
      ids: 'joint friction, link COM and inertia' },
    { id: 'chirp', name: 'Cart chirp', armed: true, mode: 'manual', kind: 'chirp', amp: 3, f0: 0.2, f1: 6, duration: 40, seconds: 42,
      setup: 'Arm in Manual: the PD holds the cart at the slider while a 3 N chirp sweeps 0.2 в†’ 6 Hz on top.',
      ids: 'cart mass, viscous + Coulomb rail friction, force gain, link coupling' },
    { id: 'prbs', name: 'PRBS', armed: true, mode: 'manual', kind: 'prbs', amp: 3, period: 0.05, duration: 30, seconds: 32, seed: 1,
      setup: 'Arm in Manual: В±3 N, a new random sign every 50 ms, on top of the PD.',
      ids: 'the same as the chirp, broadband; the actuator delay' },
    { id: 'steps', name: 'Steps', armed: true, mode: 'manual', kind: 'steps', amp: 4, period: 0.5, duration: 20, seconds: 22,
      setup: 'Arm in Manual: +4 N, 0, в€’4 N, 0 вЂ¦, each held 0.5 s, on top of the PD.',
      ids: 'delay, slew limit, force gain' },
    { id: 'loop', name: 'Closed loop', armed: true, mode: 'ai', kind: 'none', seconds: 30,
      setup: 'Arm in AI and let the policy work: pick targets or Random. No excitation.',
      ids: 'validation of the fitted model under the policy' }
  ];
  var preset = PRESETS[0], recDownloads = 0, recKey = '';
  var recEl = { seconds: $('rec-seconds'), kind: $('rec-kind'), amp: $('rec-amp'), f0: $('rec-f0'), f1: $('rec-f1'), period: $('rec-period'), duration: $('rec-duration'), seed: $('rec-seed') };
  function pickPreset(p) {
    preset = p;
    recEl.seconds.value = p.seconds; recEl.kind.value = p.kind;
    recEl.amp.value = p.amp != null ? p.amp : 3; recEl.f0.value = p.f0 != null ? p.f0 : 0.2; recEl.f1.value = p.f1 != null ? p.f1 : 6;
    recEl.period.value = p.period != null ? p.period : 0.05; recEl.duration.value = p.duration != null ? p.duration : p.seconds;
    recEl.seed.value = p.seed != null ? p.seed : 1;
    document.querySelectorAll('#rec-presets .mode-btn').forEach(function (b) {
      var on = b.dataset.preset === p.id; b.classList.toggle('active', on); b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    setText('rec-setup', p.setup);
    $('rec-ids').innerHTML = '<strong>Identifies:</strong> ' + esc(p.ids) + '. Then offline: ' + copyCode('task sysid -- recordings/*.ncpr --config config/rig.toml --out config/rig-fitted.toml') + '.';
    kindFields(); renderRecord(true);
  }
  function kindFields() {
    var k = recEl.kind.value;
    document.querySelectorAll('.rec-fields [data-for]').forEach(function (f) { f.hidden = f.dataset.for.split(' ').indexOf(k) < 0; });
    setText('rec-period-l', k === 'steps' ? 'hold (s)' : 'bit (s)');
  }
  PRESETS.forEach(function (p) {
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'mode-btn'; b.dataset.preset = p.id; b.textContent = p.name;
    b.addEventListener('click', function () { pickPreset(p); });
    $('rec-presets').appendChild(b);
  });
  recEl.kind.addEventListener('change', function () { kindFields(); renderRecord(true); });
  function excitation() {
    var k = recEl.kind.value;
    if (k === 'none') return null;
    function v(e, d) { var x = parseFloat(e.value); return isFinite(x) ? x : d; }
    return { kind: k, amp: clamp(v(recEl.amp, 3), 0, 10), f0: v(recEl.f0, 0.2), f1: v(recEl.f1, 6), period: v(recEl.period, 0.05),
             duration: v(recEl.duration, 30), seed: Math.max(0, Math.round(v(recEl.seed, 1))) };
  }
  function renderRecord(force) {
    var r = get(S.status, 'record', null), x = get(S.status, 'excite', null), live = S.conn === 'live';
    var st = r ? r.state : null, recording = st === 'recording';
    var key = [force ? Math.random() : '', live, st, r && r.samples, x && x.active, x && x.t, S.run, S.mode, preset.id].join('|');
    if (key === recKey) return;
    recKey = key;
    // Header indicator
    $('rec-chip').hidden = !recording;
    if (recording) setText('rec-chip-t', (r.seconds || 0).toFixed(1) + ' s');
    var tag = $('rec-tag');
    tag.textContent = !r ? 'вЂ”' : recording ? 'в—Џ recording' : st === 'done' ? 'ready to download' : 'idle';
    tag.className = 'tag' + (recording ? ' bad' : st === 'done' ? ' ok' : '');
    // Setup check
    var w = '', fix = null, modeName = preset.mode === 'ai' ? 'AI' : 'Manual';
    if (live && S.run) {
      if (preset.armed && preset.mode && S.mode !== preset.mode) { w = 'Switch to ' + modeName + ' first' + (preset.mode === 'manual' ? ': the PD keeps the cart near the slider while the signal shakes it.' : '.'); fix = { mode: preset.mode, label: 'Switch to ' + modeName }; }
      else if (preset.armed && S.run !== 'armed') { w = 'Needs the device armed' + (preset.mode ? ' in ' + modeName : '') + ': the excitation only reaches the drive while armed.'; fix = { arm: true, label: S.run === 'fault' ? 'Re-arm' : 'Arm' }; }
      else if (!preset.armed && S.run === 'armed') { w = 'Disarm first: a ring-down is the links swinging freely, with the drive off.'; fix = { arm: false, label: 'Disarm' }; }
    }
    var we = $('rec-warn'); we.hidden = !w;
    we.innerHTML = esc(w) + (fix ? ' <button class="notice-btn" type="button" id="rec-fix">' + esc(fix.label) + '</button>' : '');
    if (fix) $('rec-fix').onclick = function () { (fix.mode ? send({ mode: fix.mode }) : requestArm(fix.arm)).catch(function (er) { flash('rec-msg', er.message, 'bad'); }); };
    // Progress
    var cap = r && r.capacity_s ? r.capacity_s : 0, secs = r ? r.seconds || 0 : 0;
    setText('rec-state', !r ? 'no recording yet' : recording ? 'recording' + (r.note ? ' В· ' + r.note : '') : st === 'done' ? 'last recording' + (r.note ? ' В· ' + r.note : '') : 'idle');
    setText('rec-secs', r && (recording || st === 'done') ? secs.toFixed(1) + ' / ' + num(cap, 0) + ' s' : 'вЂ”');
    var bar = $('rec-bar');
    bar.style.width = cap ? clamp(100 * secs / cap, 0, 100) + '%' : '0';
    bar.classList.toggle('rec-on', recording);
    var exc = x && x.kind && x.kind !== 'none' ? x.kind + (x.active ? ' В· active' : ' В· done') + ' В· t ' + num(x.t || 0, 1) + ' s' : 'none';
    kv('rec-kv', [
      ['samples', r && r.samples != null ? r.samples.toLocaleString('en-US') : 'вЂ”'],
      ['capacity', cap ? num(cap, 0) + ' s В· ' + bytes(Math.round(cap / geom().dt) * 128) : 'вЂ”'],
      ['dropped', r && r.dropped != null ? r.dropped : 'вЂ”', r && r.dropped ? 'bad' : ''],
      ['excitation', exc, x && x.active ? 'accent' : '']
    ]);
    $('rec-start').disabled = !live || recording;
    $('rec-stop').disabled = !live || !(recording || (x && x.active));
    setText('rec-stop', recording ? 'Stop' : x && x.active ? 'Stop excitation' : 'Stop');
    $('rec-try').disabled = !live || recording || recEl.kind.value === 'none';
    $('rec-dl').disabled = !live || st !== 'done';
  }
  $('rec-start').addEventListener('click', function () {
    var secs = clamp(parseFloat(recEl.seconds.value) || preset.seconds, 1, 600);
    send({ record: { action: 'start', seconds: secs, note: $('rec-note').value.slice(0, 63), excite: excitation() } })
      .then(function () { flash('rec-msg', 'Recording ' + secs + ' sвЂ¦', 'good'); }).catch(function (e) { flash('rec-msg', e.message, 'bad'); });
  });
  $('rec-stop').addEventListener('click', function () {
    var recording = get(S.status, 'record.state', '') === 'recording';
    send(recording ? { record: { action: 'stop' } } : { excite: null }).catch(function (e) { flash('rec-msg', e.message, 'bad'); });
  });
  $('rec-try').addEventListener('click', function () {
    var e = excitation();
    if (e) send({ excite: e }).then(function () { flash('rec-msg', 'Excitation on, not recording.', 'good'); }).catch(function (er) { flash('rec-msg', er.message, 'bad'); });
  });
  $('rec-dl').addEventListener('click', function () {
    fetch('api/record', { cache: 'no-store' }).then(function (r) {
      if (!r.ok) return r.json().catch(function () { return {}; }).then(function (j) { throw new Error(j.error || 'HTTP ' + r.status); });
      var cd = r.headers.get('Content-Disposition') || '', m = /filename="?([^";]+)"?/.exec(cd);
      return r.blob().then(function (b) { return { blob: b, name: m ? m[1] : null }; });
    }).then(function (d) {
      recDownloads++;
      var name = d.name || ((get(S.info, 'hostname', null) || 'cartpole') + '-' + recDownloads + '.ncpr');
      var a = document.createElement('a'), url = URL.createObjectURL(d.blob);
      a.href = url; a.download = name; document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 5000);
      flash('rec-msg', 'Saved ' + name + ' (' + bytes(d.blob.size) + ').', 'good', 6000);
    }).catch(function (e) { flash('rec-msg', 'download: ' + e.message, 'bad'); });
  });
  pickPreset(PRESETS[0]);

  /* ---- Tabs (Live / Health / Record / Settings) ----
     The URL hash selects a tab (#settings), the last choice is remembered, and a device in setup
     mode opens Settings on first load so the Wi-Fi form is the first thing seen. */
  var TABS = ['live', 'health', 'record', 'settings'];
  function tabFromHash() {
    var h = (location.hash || '').replace('#', '');
    return TABS.indexOf(h) >= 0 ? h : null;
  }
  function showTab(name) {
    if (TABS.indexOf(name) < 0) name = 'live';
    S.tab = name;
    TABS.forEach(function (t) {
      var on = t === name, b = $('tab-btn-' + t);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
      b.tabIndex = on ? 0 : -1;
      $('tab-' + t).hidden = !on;
    });
    try { localStorage.setItem('tab', name); } catch (e) {}
    if (name === 'health' && S.events.newBad) {
      var bad = S.events.list.filter(function (e) { return e.level === 'error'; });
      S.events.seenBad = bad.length ? bad[bad.length - 1].seq : 0;
      S.events.newBad = false;
      healthAlert();
    }
  }
  function setTabAlert(name, kind) {
    var b = $('tab-btn-' + name);
    if (!b) return;
    if (kind) b.setAttribute('data-alert', kind); else b.removeAttribute('data-alert');
  }
  TABS.forEach(function (t, i) {
    var b = $('tab-btn-' + t);
    b.addEventListener('click', function () { if (location.hash !== '#' + t) location.hash = t; else showTab(t); });
    b.addEventListener('keydown', function (e) {
      var j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? TABS.length - 1 : -1;
      if (j < 0) return;
      e.preventDefault();
      j = (j + TABS.length) % TABS.length;
      location.hash = TABS[j];
      $('tab-btn-' + TABS[j]).focus();
    });
  });
  window.addEventListener('hashchange', function () { var t = tabFromHash(); if (t) showTab(t); });
  (function () {
    var t = tabFromHash(), stored = null;
    if (!t) { try { stored = localStorage.getItem('tab'); } catch (e) {} }
    S.tabAuto = !t && TABS.indexOf(stored) < 0;
    showTab(t || (TABS.indexOf(stored) >= 0 ? stored : 'live'));
  })();

  /* ---- Boot ---- */
  buildGoalButtons();
  renderModel();
  renderControls(true);
  connect();
  requestAnimationFrame(frame);
})();
X␀/* n-cartpole dashboard вЂ” served by the ESP32-S3 (firmware/web/, embedded in the app image).
   The look is the personal site's (tsmorz.github.io, assets/css/main.css): its tokens are copied verbatim
   below, defined three times (bare :root, prefers-color-scheme dark guarded by :root:not([data-theme="light"]),
   and :root[data-theme="dark"]) so the theme toggle works in both directions. No build step.

   ---------------------------------------------------------------
   Tokens
   --------------------------------------------------------------- */
:root {
  color-scheme: light;
  --bg: #f5f5f6;
  --bg-soft: #ebebed;
  --surface: #ffffff;
  --border: #dcdde1;
  --border-strong: #c3c5cc;
  --text: #1d1e23;
  --text-muted: #5a5c67;
  --accent: #6459d3;
  --accent-soft: rgba(100, 89, 211, 0.07);
  --lav: #9b90ee;        /* lavender outlines */
  --lime: #5fae16;       /* outlines, markers */
  --lime-text: #3f7a0a;  /* small text */
  --nn-act-neg: #5fae16;  /* negative activations: lime, with violet for positive */
  --bad: #8a0f0f;  /* errors and failed checks */
  --nn-act-zero: #e6e7ea;
  --nn-act-pos: #5a4fd6;
  /* Data-viz series palette: violet / gold / red / teal. Chosen by search so that every pair stays at least
     CIEDE2000 24 apart under normal vision, deuteranopia, protanopia and tritanopia (Machado 2009 simulation), in
     light and dark, with at least 3:1 contrast against the background, and differs in lightness as well as hue.
     Used by every controls plot. Labels, dashes and marks always accompany the color, so identity is never color-alone. red doubles as the "problem" color. */
  --viz-1: #5a4fd6;  /* violet */
  --viz-2: #a58d12;  /* gold   */
  --viz-3: #8a0f0f;  /* red    */
  --viz-4: #12a599;  /* teal   */
  --viz-7: #556070;  /* slate вЂ” the simulated mass; kept off the series colors */
  --viz-total: #556070;  /* neutral gray вЂ” aggregate / total lines */
  --marker: rgba(170, 236, 56, .42);       /* hero highlighter ink: translucent, so overlapping passes read darker */
  --mass: #5fae16;       /* the simulated mass on /controls/ (the site's lime) */
  --mass-edge: #3f7a0a;
  --pend-cart: #9aa3af;
  --pend-rod: #556070;
  --pend-1: #8576f0;
  --pend-2: #5fae16;  /* double pendulum: gray cart, violet upper bob, lime lower bob, gray rods */
  --logo-ground: #4b505e;
  --logo-cart: #5d6373;
  --logo-rod: #2f3340;
  --logo-b1: #5a4fd6;
  --logo-b2: #35a02a;
  --shadow: 0 1px 2px rgba(16, 24, 40, .04), 0 8px 24px rgba(16, 24, 40, .06);
  --shadow-lift: 0 2px 4px rgba(16, 24, 40, .06), 0 16px 40px rgba(16, 24, 40, .12);
  --radius: 14px;
  --wrap: 1080px;
  --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  --serif: "STIX Two Text", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
  --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #1b1c1f;
    --bg-soft: #242529;
    --surface: #242529;
    --border: #34363b;
    --border-strong: #4a4c53;
    --text: #ececef;
    --text-muted: #a2a4ad;
    --accent: #c8c0ff;
    --accent-soft: rgba(200, 192, 255, 0.10);
  --lav: #a798ff;
  --lime: #adf45d;
  --lime-text: #adf45d;
    --nn-act-neg: #adf45d;  /* negative activations: lime, with violet for positive */
    --bad: #eb4763;  /* errors and failed checks */
    --nn-act-zero: #2c2d32;
    --nn-act-pos: #c8c0ff;
    --viz-1: #a798ff;
    --viz-2: #fbe160;
    --viz-3: #eb4763;
    --viz-4: #88fce9;
    --viz-7: #9aa7b6;
    --viz-total: #9aa7b6;
    --marker: rgba(173, 244, 93, .20);
    --mass: #adf45d;
    --mass-edge: #7bbf2e;
    --pend-cart: #6b7686;
    --pend-rod: #9aa7b6;
    --pend-1: #a798ff;
    --pend-2: #adf45d;
    --logo-ground: #aab0c0;
    --logo-cart: #c4c9d6;
    --logo-rod: #f1efff;
    --logo-b1: #b3a8ff;
    --logo-b2: #b8ff6a;
    --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 8px 24px rgba(0, 0, 0, .35);
    --shadow-lift: 0 2px 4px rgba(0, 0, 0, .45), 0 16px 40px rgba(0, 0, 0, .5);
  }
}

:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #1b1c1f;
  --bg-soft: #242529;
  --surface: #242529;
  --border: #34363b;
  --border-strong: #4a4c53;
  --text: #ececef;
  --text-muted: #a2a4ad;
  --accent: #c8c0ff;
  --accent-soft: rgba(200, 192, 255, 0.10);
  --lav: #a798ff;
  --lime: #adf45d;
  --lime-text: #adf45d;
  --nn-act-neg: #adf45d;  /* negative activations: lime, with violet for positive */
  --bad: #eb4763;  /* errors and failed checks */
  --nn-act-zero: #2c2d32;
  --nn-act-pos: #c8c0ff;
  --viz-1: #a798ff;
  --viz-2: #fbe160;
  --viz-3: #eb4763;
  --viz-4: #88fce9;
  --viz-7: #9aa7b6;
  --viz-total: #9aa7b6;
  --marker: rgba(173, 244, 93, .20);
  --mass: #adf45d;
  --mass-edge: #7bbf2e;
  --pend-cart: #6b7686;
  --pend-rod: #9aa7b6;
  --pend-1: #a798ff;
  --pend-2: #adf45d;
  --logo-ground: #aab0c0;
  --logo-cart: #c4c9d6;
  --logo-rod: #f1efff;
  --logo-b1: #b3a8ff;
  --logo-b2: #b8ff6a;
  --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 8px 24px rgba(0, 0, 0, .35);
  --shadow-lift: 0 2px 4px rgba(0, 0, 0, .45), 0 16px 40px rgba(0, 0, 0, .5);
}

/* The site's signature overrides (figure-frame look), plus the dashboard's own few tokens. */
:root { --radius: 3px; --serif: "Fraunces", "STIX Two Text", "Iowan Old Style", Georgia, serif; --grid: rgba(100, 100, 140, .09); --wrap: 1240px; }
:root[data-theme="dark"] { --grid: rgba(199, 192, 255, .09); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --grid: rgba(199, 192, 255, .09); } }

/* ---------------------------------------------------------------
   Base (main.css)
   --------------------------------------------------------------- */
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font-family: var(--font); font-size: 16px; line-height: 1.55; -webkit-font-smoothing: antialiased;
  min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column;
}
body > main { flex: 1 0 auto; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
h1, h2, h3, h4 { line-height: 1.2; letter-spacing: -0.01em; margin: 0 0 .5em; }
h1 { font-family: var(--serif); font-optical-sizing: auto; font-weight: 500; font-size: clamp(1.8rem, 4vw, 2.5rem); }
h3 { font-size: 1rem; font-weight: 600; }
code { font-family: var(--mono); font-size: .88em; background: var(--bg-soft); border: 1px solid var(--border); border-radius: 3px; padding: .05em .3em; }
button, input, select, textarea { font-family: var(--mono); }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }
[hidden] { display: none !important; }
.wrap { max-width: var(--wrap); margin-inline: auto; padding-inline: 1.25rem; }
.mono { font-family: var(--mono); }
.muted { color: var(--text-muted); }
.skip-link { position: absolute; left: -9999px; top: 0; z-index: 100; background: var(--accent); color: #fff; padding: .6rem 1rem; }
.skip-link:focus { left: 0; }

/* the site's plot-paper grid, edge to edge behind the page */
main { position: relative; z-index: 0; }
main::before {
  content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
  background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: 48px 48px; background-position: center top;
  -webkit-mask-image: radial-gradient(ellipse 75% 85% at 50% 45%, #000 30%, transparent 100%);
  mask-image: radial-gradient(ellipse 75% 85% at 50% 45%, #000 30%, transparent 100%);
}

/* ---------------------------------------------------------------
   Header: sticky, blurred (main.css .site-header / .nav)
   --------------------------------------------------------------- */
.site-header {
  position: sticky; top: 0; z-index: 50;
  background: var(--bg); background: color-mix(in srgb, var(--bg) 82%, transparent);
  -webkit-backdrop-filter: saturate(180%) blur(12px); backdrop-filter: saturate(180%) blur(12px);
  border-bottom: 1px solid var(--border);
}
.nav { max-width: var(--wrap); margin-inline: auto; padding: .7rem 1.25rem; display: flex; align-items: center; gap: .9rem; }
.nav-brand {
  display: flex; align-items: center; gap: .6rem; margin-right: .4rem; min-width: 0;
  color: var(--text); font-family: var(--mono); font-size: .8rem; font-weight: 500; letter-spacing: .02em;
}
.nav-brand:hover { text-decoration: none; color: var(--accent); }
.nav-brand .brand-host { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nav-brand .brand-sub { color: var(--text-muted); font-weight: 400; }
.nav-brand svg.logo-cartpole { width: 38px; height: 38px; margin: -3px; flex-shrink: 0; display: block; }
.logo-ground { stroke: var(--logo-ground); }
.logo-cart { fill: var(--logo-cart); }
.logo-rod { stroke: var(--logo-rod); }
.logo-b1 { fill: var(--logo-b1); }
.logo-b2 { fill: var(--logo-b2); }

.nav-chips { display: flex; align-items: center; gap: .4rem; min-width: 0; }

/* Section tabs in the header (Live / Health / Record / Settings). */
.tabs { display: flex; gap: .15rem; margin-right: auto; min-width: 0; }
.tab {
  position: relative; font-family: var(--mono); font-size: .78rem; letter-spacing: .02em; line-height: 1;
  padding: .55rem .8rem; border: 0; border-radius: 3px; background: transparent; color: var(--text-muted); cursor: pointer;
}
.tab:hover { color: var(--text); background: var(--bg-soft); }
.tab[aria-selected="true"] { color: var(--text); background: var(--bg-soft); box-shadow: inset 0 -2px 0 var(--lime); }
.tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
/* Something on a hidden tab wants attention (over budget, setup mode). */
.tab[data-alert]::after { content: ""; position: absolute; top: .3rem; right: .25rem; width: 6px; height: 6px; border-radius: 50%; background: var(--viz-2); }
.tab[data-alert="bad"]::after { background: var(--bad); }
.chip {
  display: inline-flex; align-items: center; gap: .4rem; height: 26px; padding: 0 .55rem;
  border: 1px solid var(--lav); border-radius: 3px; white-space: nowrap;
  font-family: var(--mono); font-size: .72rem; letter-spacing: .02em; color: var(--text-muted);
  max-width: 22rem; overflow: hidden; text-overflow: ellipsis;
}
.chip b { font-weight: 500; color: var(--text); overflow: hidden; text-overflow: ellipsis; }
.chip .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-muted); flex-shrink: 0; }
.chip-conn[data-state="live"] { border-color: var(--lime); color: var(--text); }
.chip-conn[data-state="live"] .dot { background: var(--lime); animation: pulse 2s ease-in-out infinite; }
.chip-conn[data-state="reconnecting"], .chip-conn[data-state="rebooting"] { border-color: var(--viz-2); color: var(--text); }
.chip-conn[data-state="reconnecting"] .dot, .chip-conn[data-state="rebooting"] .dot { background: var(--viz-2); animation: blink 1s steps(2) infinite; }
/* the controller state, on every tab; click to disarm */
.chip-run { background: transparent; cursor: pointer; font-weight: 600; letter-spacing: .08em; }
.chip-run:hover { background: var(--bg-soft); }
.chip-run[data-run="armed"] { border-color: var(--lime); color: var(--text); box-shadow: 0 0 0 1px var(--lime) inset; }
.chip-run[data-run="armed"] .dot { background: var(--lime); animation: pulse 1.2s ease-in-out infinite; }
.chip-run[data-run="fault"] { border-color: var(--bad); color: var(--bad); }
.chip-run[data-run="fault"] .dot { background: var(--bad); animation: blink 1s steps(2) infinite; }
.chip-run[data-run="maint"] { border-color: var(--viz-2); color: var(--text); }
.chip-run[data-run="maint"] .dot { background: var(--viz-2); }
.chip-run:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
.chip-model { max-width: 17rem; }
.chip-model:hover { text-decoration: none; border-color: var(--accent); }
.chip-backend { font-weight: 600; letter-spacing: .08em; color: var(--accent); }
.chip-backend[data-backend="rig"] { border-color: var(--lime); color: var(--lime-text); box-shadow: 0 0 0 1px var(--lime) inset; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
@keyframes blink { 50% { opacity: .2; } }
@media (prefers-reduced-motion: reduce) { .chip .dot, .arm-dot, .run-dot { animation: none !important; } }

/* Theme toggle: the site's two-cell segmented switch, a lime-outlined marker slides to the active theme. */
.theme-toggle {
  position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; align-items: stretch;
  padding: 0; border: 1px solid var(--lav); border-radius: 3px; background: transparent;
  cursor: pointer; flex-shrink: 0; color: var(--text-muted);
}
.theme-toggle::before {
  content: ""; position: absolute; top: -1px; bottom: -1px; left: -1px; width: calc(50% + 1px);
  border: 1.5px solid var(--lime); border-radius: 3px; background: var(--accent-soft);
  transition: transform .22s cubic-bezier(.3, .7, .2, 1); pointer-events: none;
}
.tt-opt { position: relative; z-index: 1; display: grid; place-items: center; width: 24px; height: 24px; transition: color .2s; }
.tt-opt svg { display: block; }
.tt-light { color: var(--text); }
:root[data-theme="dark"] .theme-toggle::before { transform: translateX(100%); }
:root[data-theme="dark"] .tt-light { color: var(--text-muted); }
:root[data-theme="dark"] .tt-dark { color: var(--text); }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .theme-toggle::before { transform: translateX(100%); }
  :root:not([data-theme="light"]) .tt-light { color: var(--text-muted); }
  :root:not([data-theme="light"]) .tt-dark { color: var(--text); }
}
.theme-toggle:hover .tt-opt { color: var(--text); }
.theme-toggle:focus-visible { outline: 2px solid var(--lime); outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) { .theme-toggle::before { transition: none; } }

/* ---------------------------------------------------------------
   Page head
   --------------------------------------------------------------- */
.page-head { padding: clamp(.9rem, 2vw, 1.3rem) 1.25rem .8rem; display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; }
.eyebrow { display: block; font-family: var(--mono); font-size: .76rem; letter-spacing: .03em; color: var(--lime-text); margin: 0 0 .3rem; }
.eyebrow::before { content: "// "; opacity: .6; }
.page-title { margin: 0 0 .15rem; font-size: clamp(1.5rem, 2.4vw, 1.95rem); }
.page-sub { color: var(--text-muted); font-size: .92rem; margin: 0; max-width: 62ch; text-wrap: pretty; }
.tab-head { padding: clamp(.9rem, 2vw, 1.3rem) 0 .2rem; }
.tab-title { margin: 0 0 .15rem; font-size: clamp(1.5rem, 2.4vw, 1.95rem); }
.tab-sub { color: var(--text-muted); font-size: .92rem; margin: 0; }
.head-facts { display: flex; gap: 1.5rem; margin: 0; padding: 0; list-style: none; font-family: var(--mono); font-size: .74rem; color: var(--text-muted); }
.head-facts li { display: flex; flex-direction: column; gap: .1rem; }
.head-facts b { font-weight: 500; font-size: 1.05rem; color: var(--text); letter-spacing: -.01em; }
.head-facts b.bad { color: var(--bad); }

/* ---------------------------------------------------------------
   Live sim: canvas stack + controller panel (main.css .sim-layout / .su-layout)
   --------------------------------------------------------------- */
.sim-layout { display: flex; gap: 1.25rem; align-items: stretch; flex-wrap: wrap; }
.sim-canvas-wrap { flex: 1 1 480px; min-width: 0; }
.sim-stack { display: grid; grid-template-rows: minmax(0, 1.45fr) minmax(0, 1fr); gap: .6rem; min-height: clamp(480px, calc(100vh - 235px), 700px); min-height: clamp(480px, calc(100dvh - 235px), 700px); }
.sim-cell { position: relative; min-height: 0; }
.sim-cell > canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.sim-canvas { border-radius: 3px; border: 1px solid var(--border); background: var(--bg-soft); }
.sim-states { border-radius: 3px; border: 1px solid var(--border); background: var(--bg); cursor: crosshair; }

/* run state over the scene, top-left; time to target, top-right */
.scene-overlay { position: absolute; top: 12px; left: 14px; right: 14px; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; pointer-events: none; }
.run-block { display: flex; flex-direction: column; gap: .35rem; min-width: 0; }
.run-badge {
  display: inline-flex; align-items: center; gap: .5rem; align-self: flex-start;
  padding: .28rem .6rem; border: 1px solid var(--lav); border-radius: 3px; background: color-mix(in srgb, var(--bg-soft) 80%, transparent);
  font-family: var(--mono); font-size: .8rem; font-weight: 600; letter-spacing: .12em; color: var(--text-muted);
}
.run-dot { width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid currentColor; }
.run-badge[data-run="armed"] { border-color: var(--lime); box-shadow: 0 0 0 1px var(--lime); color: var(--text); }
.run-badge[data-run="armed"] .run-dot { background: var(--lime); border-color: var(--lime); animation: pulse 1.2s ease-in-out infinite; }
.run-badge[data-run="fault"] { border-color: var(--bad); box-shadow: 0 0 0 1px var(--bad); color: var(--bad); }
.run-badge[data-run="fault"] .run-dot { background: var(--bad); border-color: var(--bad); animation: blink 1s steps(2) infinite; }
.run-badge[data-run="maint"] { border-color: var(--viz-2); color: var(--text); }
.run-badge[data-run="maint"] .run-dot { background: var(--viz-2); border-color: var(--viz-2); }
.run-badge .run-reason { font-weight: 400; letter-spacing: .02em; text-transform: none; }
.run-sub { font-size: .8rem; font-weight: 600; color: var(--accent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.run-sub .muted { font-weight: 400; font-family: var(--mono); font-size: .72rem; }
.reach { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: .15rem; }
.reach-val { font-family: var(--mono); font-weight: 700; font-size: 1.7rem; line-height: 1; color: var(--accent); }
.reach-lbl { font-size: .68rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .05em; white-space: nowrap; }
.reach-state { font-family: var(--mono); font-size: .7rem; color: var(--lime-text); min-height: 1em; }
.reach[hidden] { display: none; }
.reach-val.running { color: var(--text-muted); font-weight: 500; }
.run-last { font-family: var(--mono); font-size: .68rem; color: var(--bad); opacity: .8; min-height: 0; }
.run-last:empty { display: none; }

/* Stale: the connection dropped or the device went quiet. Live values fade; a banner says since when. */
.stale-banner {
  position: sticky; top: 0; z-index: 30; display: flex; align-items: center; justify-content: center; gap: .5rem;
  padding: .4rem 1rem; font-family: var(--mono); font-size: .74rem; color: var(--text);
  background: color-mix(in srgb, var(--viz-2) 22%, var(--bg)); border-bottom: 1px solid var(--viz-2);
}
.stale-banner[hidden] { display: none; }
.stale-banner .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--viz-2); animation: blink 1s steps(2) infinite; }
body.stale .head-facts, body.stale .readout, body.stale #ro-kv, body.stale #tab-health .card,
body.stale #rec-kv, body.stale .sim-states, body.stale #run-chip, body.stale .nn-meta { opacity: .45; transition: opacity .3s; }

/* the controller panel (.sim-panel) */
.sim-panel {
  flex: 0 0 272px; display: flex; flex-direction: column; gap: .55rem; min-width: 0;
  padding: .9rem 1rem 1rem; border: 1px solid var(--border); border-radius: 3px; background: var(--surface);
}
.sim-panel h3 { margin: .35rem 0 0; font-size: .92rem; }
.sim-panel h3:first-child { margin-top: 0; }
.h3-tag { font-family: var(--mono); font-weight: 400; font-size: .68rem; color: var(--text-muted); }
.sim-panel .panel-push { margin-top: auto; padding-top: .35rem; display: flex; align-items: baseline; justify-content: space-between; }

/* the state readout: estimate / encoders / true, decimal points aligned */
.readout { width: 100%; border-collapse: collapse; font-family: var(--mono); font-size: .72rem; font-variant-numeric: tabular-nums; }
.readout th, .readout td { padding: .12rem .3rem; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--border); }
.readout thead th { font-weight: 500; font-size: .64rem; letter-spacing: .04em; color: var(--text-muted); }
.readout tbody th { text-align: left; font-weight: 500; color: var(--text); }
.readout tbody th span { font-weight: 400; font-size: .6rem; color: var(--text-muted); }
.readout td { color: var(--text); }
.readout td:nth-of-type(2) { color: var(--text-muted); }
.readout tr:last-child th, .readout tr:last-child td { border-bottom: 0; }
.kv.kv-tight { font-size: .7rem; padding: .4rem .55rem; gap: .1rem .6rem; }
.panel-hint { font-size: .72rem; line-height: 1.4; color: var(--text-muted); margin: 0; }
.panel-hint strong { color: var(--text); font-weight: 600; }
.panel-msg { font-family: var(--mono); font-size: .72rem; line-height: 1.4; margin: 0; min-height: 1.4em; color: var(--text-muted); }
.panel-msg.bad { color: var(--bad); }
.panel-msg.good { color: var(--lime-text); }
.panel-hint.bad { color: var(--bad); }

/* Arm / Disarm: the one prominent control */
.arm-btn {
  position: relative; display: flex; align-items: center; gap: .6rem; width: 100%; min-height: 50px; padding: .55rem .8rem;
  border: 1px solid var(--lav); border-radius: 3px; background: var(--surface); color: var(--text);
  font-size: .95rem; font-weight: 600; letter-spacing: .04em; cursor: pointer; text-align: left;
  transition: background .12s ease, border-color .12s ease, box-shadow .12s ease;
}
.arm-btn:hover { background: var(--accent-soft); }
.arm-btn .arm-dot { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid var(--lav); flex-shrink: 0; }
.arm-btn .arm-label { flex: 1; }
.arm-btn .arm-key { font-size: .66rem; font-weight: 400; color: var(--text-muted); letter-spacing: .02em; border: 1px solid var(--border); border-radius: 3px; padding: 0 .3rem; }
.arm-btn.armed { border-color: var(--lime); box-shadow: 0 0 0 1px var(--lime), 0 0 0 4px color-mix(in srgb, var(--lime) 18%, transparent); background: color-mix(in srgb, var(--lime) 10%, var(--surface)); }
.arm-btn.armed .arm-dot { background: var(--lime); border-color: var(--lime); animation: pulse 1.2s ease-in-out infinite; }
.arm-btn.fault { border-color: var(--bad); }
.arm-btn.fault .arm-dot { border-color: var(--bad); background: var(--bad); }
.arm-btn:disabled { opacity: .5; cursor: not-allowed; }

.mode-toggle { display: flex; gap: .4rem; }
.mode-btn {
  flex: 1; padding: .35rem .3rem; font-size: .85rem; font-weight: 550; white-space: nowrap;
  border: 1px solid var(--lav); border-radius: 3px; background: var(--surface); color: var(--text-muted); cursor: pointer;
  transition: background .12s ease, color .12s ease;
}
.mode-btn:hover { background: var(--bg-soft); }
.mode-btn.active { background: transparent; border-color: var(--lime); color: var(--text); box-shadow: 0 0 0 1px var(--lime); }
.mode-btn:disabled { opacity: .45; cursor: not-allowed; }

/* goal grid (swingup.md) */
.goal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .25rem; }
.goal-btn {
  display: flex; align-items: center; justify-content: center; gap: .35rem; padding: .1rem .4rem; font: inherit;
  border: 1px solid var(--lav); border-radius: 3px; background: var(--surface); color: var(--text); cursor: pointer;
  transition: background .12s ease, border-color .12s ease;
}
.goal-btn:hover { background: var(--bg-soft); }
.goal-btn.active { background: transparent; border-color: var(--lime); box-shadow: 0 0 0 1px var(--lime); }
.goal-btn.pending { border-style: dashed; border-color: var(--lime); }
.goal-btn:disabled { opacity: .45; cursor: not-allowed; }
.goal-btn-random { grid-column: 1 / -1; padding: .25rem .4rem; }
.goal-icon { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; }
.goal-icon svg { display: block; width: 22px; height: 34px; }
.goal-label { font-family: var(--mono); font-weight: 700; font-size: .86rem; }
.gi-rail { stroke: var(--border-strong); stroke-width: 1.5; }
.gi-cart { fill: var(--pend-cart); }
.gi-rod { stroke: var(--pend-rod); stroke-width: 2; stroke-linecap: round; }
.gi-bob-0 { fill: var(--pend-1); }
.gi-bob-1 { fill: var(--pend-2); }
.pose-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: .25rem; }
.pose-row .goal-btn { flex-direction: column; gap: 0; padding: .2rem .1rem .25rem; }
.pose-row .goal-icon svg { width: 16px; height: 25px; }
.pose-row .goal-label { font-size: .7rem; font-weight: 500; }

/* slider group (main.css .pid-group + the site's hairline slider) */
.pid-group { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: .1rem; align-items: center; }
.pid-group > label { display: flex; align-items: baseline; font-family: var(--mono); font-size: .78rem; font-weight: 500; color: var(--text-muted); }
.pid-group > label span { margin-left: auto; font-family: var(--mono); font-size: .82rem; color: var(--accent); font-weight: 400; }
.range-scale { display: flex; justify-content: space-between; font-family: var(--mono); font-size: .64rem; color: var(--text-muted); }
input[type="range"] { -webkit-appearance: none; appearance: none; width: 100%; background: transparent; height: 22px; margin: 0; cursor: pointer; accent-color: var(--lime); }
input[type="range"]::-webkit-slider-runnable-track { height: 2px; background: var(--lav); border: 0; border-radius: 0; }
input[type="range"]::-moz-range-track { height: 2px; background: var(--lav); border: 0; border-radius: 0; }
input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 12px; height: 18px; margin-top: -8px; box-sizing: border-box; background: var(--bg); border: 1.5px solid var(--lime); border-radius: 3px; transition: background .12s ease; }
input[type="range"]::-moz-range-thumb { width: 12px; height: 18px; box-sizing: border-box; background: var(--bg); border: 1.5px solid var(--lime); border-radius: 3px; }
input[type="range"]:hover::-webkit-slider-thumb, input[type="range"]:active::-webkit-slider-thumb { background: var(--accent-soft); }
input[type="range"]:focus-visible { outline: none; }
input[type="range"]:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 2px var(--lav); }
input[type="range"]:disabled { opacity: .45; cursor: default; }

.sim-btn {
  width: 100%; padding: .4rem .6rem; border-radius: 3px; font-size: .8rem; font-weight: 600;
  border: 1px solid var(--lav); background: var(--surface); color: var(--text); cursor: pointer;
  transition: background .12s ease, border-color .12s ease;
}
.sim-btn:hover { background: var(--bg-soft); }
.sim-btn:disabled { opacity: .45; cursor: not-allowed; }
.sim-btn.primary { border: 1.5px solid var(--lime); }
.sim-btn.primary:hover { background: var(--accent-soft); }
.sim-btn.danger { border-color: var(--bad); color: var(--bad); }
.btn-row { display: flex; gap: .4rem; }
.btn-row .sim-btn { width: auto; flex: 1; white-space: nowrap; }

/* ---------------------------------------------------------------
   The network (main.css .nn-netviz / .su-net)
   --------------------------------------------------------------- */
.nn-netviz { margin-top: 1.25rem; padding: 1rem 1.1rem 1.05rem; border: 1px solid var(--border); border-radius: 3px; background: var(--surface); }
.nn-netviz-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem; margin-bottom: .6rem; }
.nn-netviz-head h3 { margin: 0; font-size: 1rem; }
.nn-meta { font-family: var(--mono); font-size: .72rem; color: var(--text-muted); margin-right: auto; }
.nn-meta .ok { color: var(--lime-text); }
.nn-legend { display: flex; align-items: center; gap: .4rem; }
.nn-legend-bar { width: 120px; height: 12px; border-radius: 3px; border: 1px solid var(--border); background: linear-gradient(90deg, var(--nn-act-neg) 0%, var(--nn-act-zero) 50%, var(--nn-act-pos) 100%); }
.nn-legend-cap { font-family: var(--mono); font-size: .85rem; color: var(--text-muted); line-height: 1; width: 1ch; text-align: center; }
.nn-legend-txt { font-size: .74rem; color: var(--text-muted); margin-left: .1rem; }
.su-net-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 3px; }
/* The diagram is drawn in a ~720 x 300 design space and scaled to fit the canvas, so the box follows
   the diagram's aspect ratio: a fixed height left it height-limited, ~60 % of the width, with empty
   margins on a wide screen. */
.su-net { display: block; width: 100%; aspect-ratio: 12 / 5; max-height: 660px; border: 1px solid var(--border); border-radius: 3px; background: var(--bg-soft); }
.su-net-hint { display: none; margin: .4rem 0 0; font-size: .76rem; color: var(--text-muted); }
.eqn-note { margin: .55rem 0 0; font-size: .74rem; color: var(--text-muted); font-style: italic; }
.eqn-note code { font-style: normal; }

/* ---------------------------------------------------------------
   Cards: figure frames with corner brackets on hover (main.css .card)
   --------------------------------------------------------------- */
.cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; margin: .9rem 0 2rem; align-items: start; }
.card {
  position: relative; display: flex; flex-direction: column; gap: .8rem; min-width: 0;
  background: var(--surface); border: 1px solid var(--border); border-radius: 3px; padding: 1rem 1.1rem 1.1rem;
  transition: border-color .15s ease;
}
.card.span-2 { grid-column: span 2; }
.card.span-3 { grid-column: 1 / -1; }
.card.row-2 { grid-row: span 2; }
.card::before, .card::after { content: ""; position: absolute; width: 12px; height: 12px; border: 0 solid var(--lime); pointer-events: none; opacity: 0; transition: opacity .15s ease; }
.card::before { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
.card::after { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }
@media (hover: hover) { .card:hover { border-color: var(--lav); } }
.card:hover::before, .card:hover::after, .card:focus-within::before, .card:focus-within::after { opacity: 1; }
.card-head { display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
.card-head h3 { margin: 0; font-size: 1rem; }
.card-label { font-family: var(--mono); font-size: .7rem; letter-spacing: .04em; color: var(--accent); }
.card-label::before { content: "// "; opacity: .6; }
.tag {
  margin-left: auto; font-family: var(--mono); font-size: .68rem; letter-spacing: .03em; white-space: nowrap;
  padding: .05rem .45rem; border: 1px solid var(--lav); border-radius: 3px; color: var(--text-muted);
}
.tag.ok { border-color: var(--lime); color: var(--lime-text); }
.tag.warn { border-color: var(--viz-2); color: var(--text); }
.tag.bad { border-color: var(--bad); color: var(--bad); }
.card-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.1rem; }
.card-split > .kv { align-self: start; }

/* key/value grids (main.css .telemetry) */
.kv {
  margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .2rem .9rem;
  font-family: var(--mono); font-size: .76rem; color: var(--text-muted);
  background: var(--bg-soft); border: 1px solid var(--border); border-radius: 3px; padding: .6rem .75rem;
}
.kv dt { color: var(--text-muted); white-space: nowrap; }
.kv dd { margin: 0; color: var(--text); text-align: right; overflow-wrap: anywhere; }
.kv dd.accent { color: var(--accent); }
.kv dd.good { color: var(--lime-text); }
.kv dd.bad { color: var(--bad); }
.kv .kv-head { grid-column: 1 / -1; color: var(--text); font-weight: 500; margin-top: .25rem; }
.kv .kv-head:first-child { margin-top: 0; }

/* meters */
.meter { display: flex; flex-direction: column; gap: .3rem; }
.meter-top { display: flex; align-items: baseline; justify-content: space-between; gap: .6rem; font-family: var(--mono); font-size: .74rem; color: var(--text-muted); }
.meter-top b { font-weight: 500; color: var(--text); font-size: .9rem; }
.meter-track { position: relative; height: 14px; border: 1px solid var(--border-strong); border-radius: 3px; background: var(--bg-soft); overflow: visible; }
.meter-fill { position: absolute; top: 0; bottom: 0; left: 0; width: 0; background: var(--viz-1); transition: width .35s ease; }
.meter-fill.seg-est { background: var(--viz-4); }
.meter-fill.seg-rest { background: var(--viz-7); opacity: .55; }
.meter-max { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: var(--viz-2); transition: left .35s ease; }
.meter-budget { position: absolute; top: -6px; bottom: -6px; width: 0; border-left: 1.5px dashed var(--lime); }
.meter-budget::after { content: attr(data-label); position: absolute; top: -1.15rem; left: 0; transform: translateX(-50%); font-family: var(--mono); font-size: .62rem; color: var(--lime-text); white-space: nowrap; }
.meter-legend { display: flex; flex-wrap: wrap; gap: .25rem .8rem; font-family: var(--mono); font-size: .68rem; color: var(--text-muted); }
.meter-legend i { display: inline-block; width: 8px; height: 8px; margin-right: .3rem; border-radius: 1px; vertical-align: -1px; }
.meter.over .meter-fill { background: var(--bad); }
.core-meter .meter-fill { background: var(--viz-1); }
.core-meter .meter-sub { font-family: var(--mono); font-size: .66rem; color: var(--text-muted); }
.spark { position: relative; height: 70px; }
.spark-long { height: 96px; }
.spark canvas { position: absolute; inset: 0; width: 100%; height: 100%; border: 1px solid var(--border); border-radius: 3px; background: var(--bg); }

/* task table */
.table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 3px; }
table.tasks { width: 100%; border-collapse: collapse; font-family: var(--mono); font-size: .74rem; }
.tasks th, .tasks td { padding: .32rem .6rem; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--border); }
.tasks th { font-weight: 500; color: var(--text-muted); background: var(--bg-soft); font-size: .68rem; letter-spacing: .03em; }
.tasks th:first-child, .tasks td:first-child { text-align: left; }
.tasks tr:last-child td { border-bottom: 0; }
.tasks td { color: var(--text); }
.tasks tr.hl td { background: var(--accent-soft); }
.tasks tr.idle td { color: var(--text-muted); }
.tasks tr.misplaced td:first-child { color: var(--bad); }
.core-badge { display: inline-block; min-width: 2.6em; text-align: center; padding: 0 .3rem; border: 1px solid var(--lav); border-radius: 3px; font-size: .66rem; }
.core-badge.c1 { border-color: var(--lime); color: var(--lime-text); }
.cpu-cell { display: inline-flex; align-items: center; gap: .45rem; justify-content: flex-end; }
.cpu-bar { display: inline-block; width: 48px; height: 6px; background: var(--bg-soft); border: 1px solid var(--border); border-radius: 1px; position: relative; overflow: hidden; }
.cpu-bar i { position: absolute; left: 0; top: 0; bottom: 0; background: var(--viz-1); }
.check-line { display: flex; align-items: center; gap: .45rem; font-family: var(--mono); font-size: .72rem; color: var(--text-muted); margin: 0; }
.check-line .ok { color: var(--lime-text); }
.check-line .bad { color: var(--bad); }
.check-line .warn { color: var(--viz-2); font-weight: 700; }
.check-line .muted { color: var(--text-muted); }
#model-check { align-items: flex-start; line-height: 1.45; font-family: var(--font); font-size: .74rem; }
#model-check:empty { display: none; }
.nowrap { white-space: nowrap; }

/* update: one drop zone for firmware images and model blobs */
.dropzone {
  position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .35rem;
  min-height: 132px; padding: 1rem; text-align: center; cursor: pointer;
  border: 1.5px dashed var(--lav); border-radius: 3px; background: var(--bg-soft);
  transition: border-color .12s ease, background .12s ease;
}
.dropzone:hover, .dropzone:focus-visible { border-color: var(--accent); }
.dropzone.over { border-color: var(--lime); border-style: solid; background: var(--accent-soft); }
.dropzone.locked { cursor: not-allowed; opacity: .8; }
.dz-icon { width: 30px; height: 30px; color: var(--accent); }
.dz-title { font-weight: 600; font-size: .92rem; }
.dz-sub { font-family: var(--mono); font-size: .7rem; color: var(--text-muted); }
.dz-sub code { font-size: .95em; }
.file-panel { display: flex; flex-direction: column; gap: .6rem; padding: .75rem .8rem; border: 1px solid var(--lav); border-radius: 3px; }
.file-panel.bad { border-color: var(--bad); }
.file-title { display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; font-weight: 600; font-size: .9rem; }
.file-title .mono { font-weight: 400; font-size: .74rem; color: var(--text-muted); overflow-wrap: anywhere; }
.notice { margin: 0; font-size: .76rem; line-height: 1.45; padding: .5rem .65rem; border-left: 2px solid var(--viz-2); background: var(--bg-soft); color: var(--text); }
.notice.bad { border-left-color: var(--bad); }
.notice.good { border-left-color: var(--lime); }
.progress { height: 8px; border: 1px solid var(--border-strong); border-radius: 3px; background: var(--bg-soft); overflow: hidden; }
.progress i { display: block; height: 100%; width: 0; background: var(--lime); transition: width .15s linear; }
.progress-row { display: flex; align-items: center; gap: .6rem; font-family: var(--mono); font-size: .72rem; color: var(--text-muted); }
.progress-row .progress { flex: 1; }
.releases { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .3rem; }
.releases li { display: flex; align-items: baseline; gap: .6rem; font-family: var(--mono); font-size: .74rem; padding: .3rem 0; border-bottom: 1px solid var(--border); }
.releases li.rel-hint { display: block; font-family: var(--font); line-height: 1.5; }
.releases li:last-child { border-bottom: 0; }
.releases .rel-tag { color: var(--text); font-weight: 500; }
.releases .rel-date { color: var(--text-muted); }
.releases .rel-get { margin-left: auto; white-space: nowrap; }
.rel-badge { font-size: .64rem; padding: 0 .35rem; border: 1px solid var(--lime); border-radius: 3px; color: var(--lime-text); }
.link-arrow { font-family: var(--mono); font-size: .78rem; }
.link-arrow::after { content: " в†’"; }

/* small conveniences: copy on click, fix-it buttons, "go there" highlight */
code.copy { cursor: copy; position: relative; }
code.copy:hover { outline: 1px dashed var(--lav); }
code.copy.copied::after {
  content: attr(data-tip); position: absolute; left: 50%; bottom: calc(100% + 4px); transform: translateX(-50%);
  padding: .05rem .35rem; border-radius: 3px; font-size: .64rem; color: var(--bg); background: var(--text); white-space: nowrap;
}
.notice-btn {
  margin-left: .4rem; padding: .1rem .55rem; font: inherit; font-size: .74rem; font-weight: 600; cursor: pointer;
  border: 1px solid var(--lime); border-radius: 3px; background: var(--surface); color: var(--text);
}
.notice-btn:hover { background: var(--accent-soft); }
.banner-btn { margin-left: .6rem; padding: .05rem .5rem; font: inherit; cursor: pointer; border: 1px solid var(--viz-2); border-radius: 3px; background: var(--bg); color: var(--text); }
.flash-hl { outline: 2px solid var(--lime); outline-offset: 3px; transition: outline-color .3s; }
.kv dd a, .events a { color: var(--accent); }

/* sensors & drive, event log */
.io-table td:nth-child(4) { white-space: normal; text-align: left; }
.io-table th:nth-child(4) { text-align: left; }
.io-table td.good { color: var(--lime-text); }
.io-table td.bad { color: var(--bad); }
.io-table td.accent { color: var(--accent); }
#io-body { display: flex; flex-direction: column; gap: .7rem; }
.events { list-style: none; margin: 0; padding: 0; max-height: 330px; overflow-y: auto; border: 1px solid var(--border); border-radius: 3px; font-family: var(--mono); font-size: .72rem; }
.events li { display: flex; gap: .8rem; padding: .3rem .6rem; border-bottom: 1px solid var(--border); border-left: 2px solid transparent; }
.events li:last-child { border-bottom: 0; }
.events li.muted { color: var(--text-muted); font-family: var(--font); }
.events time { flex: 0 0 4.2rem; color: var(--text-muted); text-align: right; font-variant-numeric: tabular-nums; }
.events span { color: var(--text); overflow-wrap: anywhere; }
.events .ev-warn { border-left-color: var(--viz-2); }
.events .ev-error { border-left-color: var(--bad); }
.events .ev-error span { color: var(--bad); }
.events .ev-sep { display: block; padding: .25rem .6rem; font-size: .66rem; letter-spacing: .04em; color: var(--text-muted); background: var(--bg-soft); }
.events .ev-prev span { opacity: .8; }

/* forms */
.col { display: flex; flex-direction: column; gap: .6rem; min-width: 0; }
.form-inline { display: flex; align-items: flex-end; gap: .5rem; }
.form-inline .field { flex: 1; min-width: 0; }
.form-inline .sim-btn { width: auto; flex: 0 0 auto; padding-block: .45rem; }
.input-suffix { display: flex; align-items: stretch; }
.input-suffix input { border-top-right-radius: 0; border-bottom-right-radius: 0; }
.input-suffix span { display: flex; align-items: center; padding: 0 .5rem; font-family: var(--mono); font-size: .76rem; color: var(--text-muted);
  border: 1px solid var(--lav); border-left: 0; border-radius: 0 3px 3px 0; background: var(--bg-soft); }
.form { display: grid; gap: .55rem; }
.field { display: grid; gap: .2rem; }
.field label { font-family: var(--mono); font-size: .72rem; color: var(--text-muted); }
.field input, .field select {
  width: 100%; padding: .45rem .6rem; font-size: .85rem; color: var(--text);
  background: var(--bg); border: 1px solid var(--lav); border-radius: 3px;
}
.field input:focus, .field select:focus { outline: none; border-color: var(--lime); box-shadow: 0 0 0 1px var(--lime); }
.rssi { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; margin-right: .35rem; vertical-align: -1px; }
.rssi i { width: 3px; background: var(--border-strong); border-radius: 1px; }
.rssi i.on { background: var(--lime); }

/* record card: the controls a preset needs, then the presets */
.rec-ctrl { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; padding-bottom: .8rem; border-bottom: 1px solid var(--border); }
.rec-ctrl .arm-btn-sm { width: auto; min-height: 36px; flex: 0 0 15rem; font-size: .85rem; white-space: nowrap; }
.rec-ctrl .mode-toggle { flex: 0 0 12rem; }
.rec-ctrl-note { font-family: var(--mono); font-size: .72rem; color: var(--text-muted); }
.rec-plot { position: relative; height: 190px; }
.rec-plot canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
/* record card */
.preset-row { display: flex; flex-wrap: wrap; gap: .35rem; }
.preset-row .mode-btn { flex: 1 1 auto; font-size: .8rem; }
.rec-fields { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: .5rem .6rem; }
.rec-fields .field[hidden] { display: none; }
.chip-rec { border-color: var(--bad); color: var(--bad); font-weight: 600; letter-spacing: .06em; }
.chip-rec b { color: var(--bad); font-weight: 500; letter-spacing: 0; }
.chip-rec .dot { background: var(--bad); animation: blink 1s steps(2) infinite; }
.progress i.rec-on { background: var(--bad); }

/* ---------------------------------------------------------------
   Footer
   --------------------------------------------------------------- */
.site-footer { border-top: 1px solid var(--lav); background: var(--bg-soft); }
.footer-inner { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; align-items: center; justify-content: space-between; padding-block: 1.1rem; font-family: var(--mono); font-size: .74rem; color: var(--text-muted); }
.footer-inner p { margin: 0; }

/* ---------------------------------------------------------------
   Responsive
   --------------------------------------------------------------- */
@media (max-width: 1100px) {
  .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card.span-2 { grid-column: 1 / -1; }
  .card.row-2 { grid-row: auto; }
}
@media (max-width: 900px) {
  .chip-hide-md { display: none; }
}
@media (max-width: 760px) {
  .nav { flex-wrap: wrap; row-gap: .35rem; }
  .tabs { order: 5; flex-basis: 100%; margin-right: 0; overflow-x: auto; }
  .tab { flex: 1 0 auto; text-align: center; }
  .sim-panel { flex-basis: 100%; order: 2; }
  /* The stack's cells become items of .sim-layout so the controls sit between the scene and the plot. */
  .sim-stack { display: contents; }
  .sim-stack > .sim-cell { flex: 1 1 100%; }
  .sim-stack > .sim-cell:first-child { order: 1; height: 330px; }
  .sim-stack > .sim-cell:last-child { order: 3; height: 300px; }
  .cards { grid-template-columns: minmax(0, 1fr); }
  .card-split { grid-template-columns: minmax(0, 1fr); }
  .su-net { min-width: 940px; height: 300px; aspect-ratio: auto; max-height: none; }
  .su-net-hint { display: block; }
  .site-header { background: var(--bg); -webkit-backdrop-filter: none; backdrop-filter: none; }
  .head-facts { display: none; }
}
@media (max-width: 560px) {
  .nav { gap: .5rem; padding-inline: 1rem; }
  .wrap { padding-inline: 1rem; }
  .page-head { padding-inline: 1rem; }
  .nav-brand .brand-sub { display: none; }
  .chip-hide-sm { display: none; }
  .nav-chips { gap: .3rem; }
  .chip { padding: 0 .45rem; }
  .chip-conn #conn-text { display: none; }
  .chip-rec b { display: none; }
  .rec-ctrl .arm-btn-sm, .rec-ctrl .mode-toggle { flex: 1 1 100%; }
  .sim-stack > .sim-cell:first-child { height: 300px; }
  .reach-val { font-size: 1.3rem; }
  .reach-lbl { font-size: .6rem; }
  .run-badge { font-size: .72rem; }
}
@media (pointer: coarse) {
  button, input, a { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .mode-btn, .sim-btn, .goal-btn { min-height: 44px; }
  .field input { font-size: 16px; min-height: 40px; }
  input[type="range"] { min-height: 32px; }
}
